fn split_store(cache: mut UOpCache, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != STORE && node_op(cache: read cache, id: x) != END { return None }
    if List.len<Int>(list: read uop_ranges(cache: read cache, id: x)) > 0 { return None }
    local ctx = rangeify_local_context_new()
    local olds = List.new<Int>()
    local news = List.new<Int>()
    local args = List.new<Int>()
    local vars = List.new<Int>()
    let body = rangeify_kernel_rewrite(cache: mut cache, ctx: mut ctx, id: x, olds: mut olds, news: mut news, args: mut args, vars: mut vars)
    let mut store_body = body
    if node_op(cache: read cache, id: body) == END && node_num_src(cache: read cache, id: body) > 0 { store_body = node_src_id(cache: read cache, id: body, k: 0) }
    let mut kernel_body = body
    if node_op(cache: read cache, id: store_body) == STORE {
        let stored = node_src_id(cache: read cache, id: store_body, k: 1)
        let stored_op = node_op(cache: read cache, id: stored)
        if stored_op == COPY || stored_op == SLICE {
            kernel_body = rangeify_special_kernel_body(cache: mut cache, stored: stored, owner: body)
        } else {
            local sink_srcs = List.new<Int>()
            List.push<Int>(list: mut sink_srcs, value: read body)
            kernel_body = mk_sink(cache: mut cache, ids: read sink_srcs)
        }
    }
    let mut vi = 0
    while vi < List.len<Int>(list: read vars) {
        let v = List.get<Int>(list: read vars, index: vi)
        if rangeify_pos(ids: read args, id: v) < 0 { List.push<Int>(list: mut args, value: read v) }
        vi = vi + 1
    }
    if List.len<Int>(list: read args) == 0 {
        let mut raw_body = x
        if node_op(cache: read cache, id: x) == END && node_num_src(cache: read cache, id: x) > 0 { raw_body = node_src_id(cache: read cache, id: x, k: 0) }
        if node_op(cache: read cache, id: raw_body) == STORE && node_num_src(cache: read cache, id: raw_body) >= 2 {
            let ptr_buf = uop_buf_uop(cache: mut cache, id: node_src_id(cache: read cache, id: raw_body, k: 0))
            if ptr_buf >= 0 { List.push<Int>(list: mut args, value: read ptr_buf) }
            let val_buf = uop_buf_uop(cache: mut cache, id: node_src_id(cache: read cache, id: raw_body, k: 1))
            if val_buf >= 0 && val_buf != ptr_buf { List.push<Int>(list: mut args, value: read val_buf) }
        }
    }
    local call = mk_call_arg(name: read "rangeify_kernel", has_name: true, precompile: false, precompile_backward: false)
    return Some(uop_call(cache: mut cache, id: kernel_body, args: read args, call: read call))
}

