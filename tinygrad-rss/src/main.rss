    let timage_dot1d = image_dot(cache: mut tcache, x: tdot_a, w: tdot_b, dt: read dt_void())
    let timage_dot1d_close = tensor_allclose(cache: mut tcache, x: timage_dot1d, other: tdot1d, rtol: 0.0, atol: 0.0, equal_nan: false)
