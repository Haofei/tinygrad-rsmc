// Integrated source-shaped slice of tinygrad/engine/realize.py.
//
// This is the first runtime-facing metadata surface used before actual device
// execution: call argument projection, output/input classification, and
// high-level estimate lookup. Real runtime caches, compilation, buffer
// execution, and graph execution remain later slices.
features: local

struct RealizeCallIO derives(Clone) {
    outs: List<Int>,
    ins: List<Int>,
}

struct RealizeExecContext {
    store: DeviceMemoryStore,
    buffers: List<TGBuffer>,
    input_slots: List<Int>,
    runtime_cache: Map<String, Int>,
    next_runtime_handle: Int,
}

struct RealizeProgramExec derives(Clone) {
    ok: Bool,
    function_name: String,
    global_count: Int,
    global_slots: List<Int>,
    buffer_indices: List<Int>,
    allocated_count: Int,
    source_id: Int,
    source_len: Int,
    global_dim_count: Int,
    has_local_size: Bool,
    local_dim_count: Int,
    val_count: Int,
    val_known_count: Int,
    val_runtime_count: Int,
    runtime_cache_hit: Bool,
    runtime_handle: Int,
}

struct RealizeHostProgramExec derives(Clone) {
    ok: Bool,
    staged: RealizeProgramExec,
    compile_status: Int,
    run_status: Int,
    output_nbytes: Int,
    parsed_nbytes: Int,
    stderr_len: Int,
}

struct RealizeScheduledRun derives(Clone) {
    executed: Int,
    planned: Int,
    arenas: Int,
    var_count: Int,
    ok: Bool,
}

fn realize_exec_context_new(store: take DeviceMemoryStore, buffers: take List<TGBuffer>) -> fresh RealizeExecContext {
    local input_slots = List.new<Int>()
    let mut i = 0
    while i < List.len<TGBuffer>(list: read buffers) {
        List.push<Int>(list: mut input_slots, value: read i)
        i = i + 1
    }
    local runtime_cache = Map.new<String, Int>()
    return RealizeExecContext(store: take store, buffers: take buffers, input_slots: take input_slots,
                              runtime_cache: take runtime_cache, next_runtime_handle: 1)
}

fn realize_exec_context_new_mapped(store: take DeviceMemoryStore, buffers: take List<TGBuffer>, input_slots: take List<Int>) -> fresh RealizeExecContext {
    local runtime_cache = Map.new<String, Int>()
    return RealizeExecContext(store: take store, buffers: take buffers, input_slots: take input_slots,
                              runtime_cache: take runtime_cache, next_runtime_handle: 1)
}

fn realize_exec_context_buffer_count(ctx: read RealizeExecContext) -> Int {
    return List.len<TGBuffer>(list: read ctx.buffers)
}

fn realize_exec_context_get_buffer(ctx: read RealizeExecContext, index: Int) -> fresh TGBuffer {
    let b = List.get<TGBuffer>(list: read ctx.buffers, index: index)
    return buffer_copy(buf: read b)
}

fn realize_exec_context_set_buffer(ctx: mut RealizeExecContext, index: Int, buf: read TGBuffer) -> Unit {
    local b = buffer_copy(buf: read buf)
    List.set<TGBuffer>(list: mut ctx.buffers, index: index, value: read (manage b))
    return Unit
}

fn realize_exec_context_get_slot(ctx: read RealizeExecContext, slot: Int) -> Int {
    if slot >= 0 && slot < List.len<Int>(list: read ctx.input_slots) {
        return List.get<Int>(list: read ctx.input_slots, index: slot)
    }
    return slot
}

fn realize_program_exec_copy(exec: read RealizeProgramExec) -> fresh RealizeProgramExec {
    return RealizeProgramExec(ok: exec.ok, function_name: String.copy(value: read exec.function_name),
                              global_count: exec.global_count,
                              global_slots: copy_int_list(l: read exec.global_slots),
                              buffer_indices: copy_int_list(l: read exec.buffer_indices),
                              allocated_count: exec.allocated_count, source_id: exec.source_id,
                              source_len: exec.source_len, global_dim_count: exec.global_dim_count,
                              has_local_size: exec.has_local_size, local_dim_count: exec.local_dim_count,
                              val_count: exec.val_count, val_known_count: exec.val_known_count,
                              val_runtime_count: exec.val_runtime_count,
                              runtime_cache_hit: exec.runtime_cache_hit, runtime_handle: exec.runtime_handle)
}

fn realize_host_program_exec_new(ok: Bool, staged: read RealizeProgramExec, compile_status: Int, run_status: Int,
                                 output_nbytes: Int, parsed_nbytes: Int, stderr_len: Int) -> fresh RealizeHostProgramExec {
    local staged_copy = realize_program_exec_copy(exec: read staged)
    return RealizeHostProgramExec(ok: ok, staged: take staged_copy, compile_status: compile_status,
                                  run_status: run_status, output_nbytes: output_nbytes,
                                  parsed_nbytes: parsed_nbytes, stderr_len: stderr_len)
}

fn realize_get_call_arg_uops(cache: read UOpCache, call: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    if node_op(cache: read cache, id: call) != CALL { return take out }
    let mut i = 1
    while i < node_num_src(cache: read cache, id: call) {
        let src = node_src_id(cache: read cache, id: call, k: i)
        if node_op(cache: read cache, id: src) != BIND {
            List.push<Int>(list: mut out, value: read src)
        }
        i = i + 1
    }
    return take out
}

fn realize_custom_function_name(cache: read UOpCache, id: Int) -> fresh String {
    if node_op(cache: read cache, id: id) != CUSTOM_FUNCTION { return String.copy(value: read "") }
    return uop_arg_to_string(arg: read node_arg(cache: read cache, id: id))
}

fn realize_get_call_outs_ins(cache: read UOpCache, call: Int) -> fresh RealizeCallIO {
    local outs = List.new<Int>()
    local ins = List.new<Int>()
    if node_op(cache: read cache, id: call) != CALL {
        return RealizeCallIO(outs: take outs, ins: take ins)
    }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    let op = node_op(cache: read cache, id: ast)
    if op == PROGRAM {
        local p = node_program_arg(cache: read cache, id: ast)
        return RealizeCallIO(outs: copy_int_list(l: read p.outs), ins: copy_int_list(l: read p.ins))
    }
    if op == COPY || op == SLICE {
        List.push<Int>(list: mut outs, value: read 0)
        List.push<Int>(list: mut ins, value: read 1)
        return RealizeCallIO(outs: take outs, ins: take ins)
    }
    if op == CUSTOM_FUNCTION && realize_custom_function_name(cache: read cache, id: ast) == "encdec" {
        List.push<Int>(list: mut outs, value: read 0)
        local args = realize_get_call_arg_uops(cache: read cache, call: call)
        let mut i = 1
        while i < List.len<Int>(list: read args) {
            List.push<Int>(list: mut ins, value: read i)
            i = i + 1
        }
        return RealizeCallIO(outs: take outs, ins: take ins)
    }
    return RealizeCallIO(outs: take outs, ins: take ins)
}

fn realize_nbytes(cache: read UOpCache, id: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: id)
    let numel = prod(x: read sh)
    let sz = DType.itemsize(self: read dtype_scalar(d: read node_full_dtype(cache: read cache, id: id)))
    return numel * sz
}

fn realize_estimate_uop(cache: read UOpCache, call: Int) -> fresh Estimates {
    if node_op(cache: read cache, id: call) != CALL { return Estimates(ops: 0, lds: 0, mem: 0) }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    let op = node_op(cache: read cache, id: ast)
    if op == PROGRAM { return node_program_estimates(cache: read cache, id: ast) }
    if op == COPY || (op == CUSTOM_FUNCTION && realize_custom_function_name(cache: read cache, id: ast) == "encdec") {
        local args = realize_get_call_arg_uops(cache: read cache, call: call)
        if List.len<Int>(list: read args) > 1 {
            let nbytes = realize_nbytes(cache: read cache, id: List.get<Int>(list: read args, index: 1))
            return Estimates(ops: 0, lds: nbytes, mem: nbytes)
        }
    }
    return Estimates(ops: 0, lds: 0, mem: 0)
}

fn realize_resolve_param_id(cache: read UOpCache, id: Int, inputs: read List<Int>) -> Int {
    let op = node_op(cache: read cache, id: id)
    if op == PARAM {
        let slot = node_param_slot(cache: read cache, id: id)
        if slot >= 0 && slot < List.len<Int>(list: read inputs) {
            return List.get<Int>(list: read inputs, index: slot)
        }
    }
    if (op == SLICE || op == MSELECT) && node_num_src(cache: read cache, id: id) > 0 {
        let base = node_src_id(cache: read cache, id: id, k: 0)
        if node_op(cache: read cache, id: base) == PARAM {
            let slot = node_param_slot(cache: read cache, id: base)
            if slot >= 0 && slot < List.len<Int>(list: read inputs) {
                return List.get<Int>(list: read inputs, index: slot)
            }
        }
    }
    return id
}

fn realize_resolve_params(cache: read UOpCache, call: Int, inputs: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    local args = realize_get_call_arg_uops(cache: read cache, call: call)
    let mut i = 0
    while i < List.len<Int>(list: read args) {
        let arg = List.get<Int>(list: read args, index: i)
        List.push<Int>(list: mut out, value: read realize_resolve_param_id(cache: read cache, id: arg, inputs: read inputs))
        i = i + 1
    }
    return take out
}

fn realize_exec_copy(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int) -> Unit {
    if node_op(cache: read cache, id: call) != CALL { return Unit }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    if node_op(cache: read cache, id: ast) != COPY { return Unit }
    if realize_exec_context_buffer_count(ctx: read ctx) < 2 { return Unit }

    let dest0 = realize_exec_context_get_buffer(ctx: read ctx, index: 0)
    let src0 = realize_exec_context_get_buffer(ctx: read ctx, index: 1)
    local src = buffer_ensure_allocated(store: mut ctx.store, buf: read src0)
    let mut dest = buffer_ensure_allocated(store: mut ctx.store, buf: read dest0)
    local bytes = buffer_copyout(store: read ctx.store, buf: read src)
    dest = buffer_copyin(store: mut ctx.store, buf: read dest, src: read bytes)
    realize_exec_context_set_buffer(ctx: mut ctx, index: 0, buf: read dest)
    realize_exec_context_set_buffer(ctx: mut ctx, index: 1, buf: read src)
    return Unit
}

fn realize_exec_view(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int) -> Unit {
    if node_op(cache: read cache, id: call) != CALL { return Unit }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    if node_op(cache: read cache, id: ast) != SLICE { return Unit }
    if realize_exec_context_buffer_count(ctx: read ctx) < 2 { return Unit }

    let out_desc = realize_exec_context_get_buffer(ctx: read ctx, index: 0)
    let src0 = realize_exec_context_get_buffer(ctx: read ctx, index: 1)
    local src = buffer_ensure_allocated(store: mut ctx.store, buf: read src0)
    let off_node = node_src_id(cache: read cache, id: ast, k: 1)
    let itemsize = DType.itemsize(self: read dtype_scalar(d: read src.dtype))
    let offset = node_const_int(cache: read cache, id: off_node) * itemsize
    local view = buffer_view(buf: read src, size: out_desc.size, dtype: read node_full_dtype(cache: read cache, id: ast), offset: offset)
    realize_exec_context_set_buffer(ctx: mut ctx, index: 0, buf: read view)
    realize_exec_context_set_buffer(ctx: mut ctx, index: 1, buf: read src)
    return Unit
}

fn realize_exec_copy_indices(ctx: mut RealizeExecContext, dest_idx: Int, src_idx: Int) -> Unit {
    let dest0 = realize_exec_context_get_buffer(ctx: read ctx, index: dest_idx)
    let src0 = realize_exec_context_get_buffer(ctx: read ctx, index: src_idx)
    local src = buffer_ensure_allocated(store: mut ctx.store, buf: read src0)
    let mut dest = buffer_ensure_allocated(store: mut ctx.store, buf: read dest0)
    local bytes = buffer_copyout(store: read ctx.store, buf: read src)
    dest = buffer_copyin(store: mut ctx.store, buf: read dest, src: read bytes)
    realize_exec_context_set_buffer(ctx: mut ctx, index: dest_idx, buf: read dest)
    realize_exec_context_set_buffer(ctx: mut ctx, index: src_idx, buf: read src)
    return Unit
}

fn realize_exec_view_indices(cache: read UOpCache, ctx: mut RealizeExecContext, ast: Int, dest_idx: Int, src_idx: Int) -> Unit {
    let out_desc = realize_exec_context_get_buffer(ctx: read ctx, index: dest_idx)
    let src0 = realize_exec_context_get_buffer(ctx: read ctx, index: src_idx)
    local src = buffer_ensure_allocated(store: mut ctx.store, buf: read src0)
    let off_node = node_src_id(cache: read cache, id: ast, k: 1)
    let itemsize = DType.itemsize(self: read dtype_scalar(d: read src.dtype))
    let offset = node_const_int(cache: read cache, id: off_node) * itemsize
    local view = buffer_view(buf: read src, size: out_desc.size, dtype: read node_full_dtype(cache: read cache, id: ast), offset: offset)
    realize_exec_context_set_buffer(ctx: mut ctx, index: dest_idx, buf: read view)
    realize_exec_context_set_buffer(ctx: mut ctx, index: src_idx, buf: read src)
    return Unit
}

fn realize_program_source_len(cache: read UOpCache, ast: Int) -> Int {
    let source = realize_program_source_id(cache: read cache, ast: ast)
    if source < 0 { return 0 }
    return node_arg_str_len(cache: read cache, id: source)
}

fn realize_program_source_id(cache: read UOpCache, ast: Int) -> Int {
    if node_op(cache: read cache, id: ast) != PROGRAM { return 0 - 1 }
    let mut i = 0
    while i < node_num_src(cache: read cache, id: ast) {
        let s = node_src_id(cache: read cache, id: ast, k: i)
        if node_op(cache: read cache, id: s) == SOURCE {
            return s
        }
        i = i + 1
    }
    return 0 - 1
}

fn realize_runtime_cache_key(function_name: read String, source_id: Int, source_len: Int) -> fresh String {
    let mut key = String.concat(left: read function_name, right: read "|")
    key = String.concat(left: read key, right: read Int.to_string(value: read source_id))
    key = String.concat(left: read key, right: read "|")
    return String.concat(left: read key, right: read Int.to_string(value: read source_len))
}

fn realize_runtime_cache_get_or_insert(ctx: mut RealizeExecContext, function_name: read String, source_id: Int, source_len: Int) -> Int {
    local key = realize_runtime_cache_key(function_name: read function_name, source_id: source_id, source_len: source_len)
    match Map.get<String, Int>(map: read ctx.runtime_cache, key: read key) {
        Some(handle) => { return handle }
        None => {
            let handle = ctx.next_runtime_handle
            ctx.next_runtime_handle = ctx.next_runtime_handle + 1
            Map.insert<String, Int>(map: mut ctx.runtime_cache, key: read (manage key), value: read handle)
            return handle
        }
    }
}

fn realize_runtime_cache_contains(ctx: read RealizeExecContext, function_name: read String, source_id: Int, source_len: Int) -> Bool {
    local key = realize_runtime_cache_key(function_name: read function_name, source_id: source_id, source_len: source_len)
    match Map.get<String, Int>(map: read ctx.runtime_cache, key: read key) {
        Some(handle) => { return true }
        None => { return false }
    }
}

fn realize_bytes_c_initializer(bytes: read List<Int>) -> fresh String {
    local parts = List.new<String>()
    let mut i = 0
    while i < List.len<Int>(list: read bytes) {
        let b = List.get<Int>(list: read bytes, index: i)
        List.push<String>(list: mut parts, value: read Int.to_string(value: read b))
        i = i + 1
    }
    return String.join(parts: read parts, separator: read ", ")
}

fn realize_parse_decimal_bytes(text: read String) -> fresh List<Int> {
    local out = List.new<Int>()
    let trimmed = String.trim(value: read text)
    if String.len(value: read trimmed) == 0 { return take out }
    let parts = String.split(value: read trimmed, delimiter: read " ")
    let mut i = 0
    while i < List.len<String>(list: read parts) {
        let tok = List.get<String>(list: read parts, index: i)
        match String.parse_int(value: read tok) {
            Some(v) => {
                if v >= 0 && v < 256 {
                    List.push<Int>(list: mut out, value: read v)
                }
            }
            None => {
            }
        }
        i = i + 1
    }
    return take out
}

fn realize_host_c_scalar_type(dt: read DType) -> fresh String {
    let s = dtype_scalar(d: read dt)
    if s.name == "bool" { return String.copy(value: read "_Bool") }
    return String.copy(value: read s.name)
}

fn realize_host_dtype_supported(dt: read DType) -> Bool {
    let s = dtype_scalar(d: read dt)
    let itemsize = DType.itemsize(self: read s)
    if itemsize != 1 && itemsize != 2 && itemsize != 4 && itemsize != 8 { return false }
    if s.name == "signed char" { return true }
    if s.name == "unsigned char" { return true }
    if s.name == "short" { return true }
    if s.name == "unsigned short" { return true }
    if s.name == "float" { return true }
    if s.name == "int" { return true }
    if s.name == "unsigned int" { return true }
    if s.name == "double" { return true }
    if s.name == "long" { return true }
    if s.name == "unsigned long" { return true }
    return false
}

fn realize_host_multiout_main(function_name: read String, output_types: read List<String>, input_types: read List<String>,
                              input_inits: read List<String>, input_nbytes: Int, output_nbytes: Int, n: Int) -> fresh String {
    let mut s = String.copy(value: read "int main(void) {\n")
    let mut oi = 0
    while oi < List.len<String>(list: read output_types) {
        let oidx = Int.to_string(value: read oi)
        s = String.concat(left: read s, right: read "  unsigned char out")
        s = String.concat(left: read s, right: read oidx)
        s = String.concat(left: read s, right: read "_bytes[")
        s = String.concat(left: read s, right: read Int.to_string(value: read output_nbytes))
        s = String.concat(left: read s, right: read "] = {0};\n")
        s = String.concat(left: read s, right: read "  ")
        s = String.concat(left: read s, right: read List.get<String>(list: read output_types, index: oi))
        s = String.concat(left: read s, right: read " out")
        s = String.concat(left: read s, right: read oidx)
        s = String.concat(left: read s, right: read "_vals[")
        s = String.concat(left: read s, right: read Int.to_string(value: read n))
        s = String.concat(left: read s, right: read "] = {0};\n")
        oi = oi + 1
    }
    let mut i = 0
    while i < List.len<String>(list: read input_inits) {
        let idx = Int.to_string(value: read i)
        s = String.concat(left: read s, right: read "  unsigned char in")
        s = String.concat(left: read s, right: read idx)
        s = String.concat(left: read s, right: read "_bytes[")
        s = String.concat(left: read s, right: read Int.to_string(value: read input_nbytes))
        s = String.concat(left: read s, right: read "] = {")
        s = String.concat(left: read s, right: read List.get<String>(list: read input_inits, index: i))
        s = String.concat(left: read s, right: read "};\n")
        s = String.concat(left: read s, right: read "  ")
        s = String.concat(left: read s, right: read List.get<String>(list: read input_types, index: i))
        s = String.concat(left: read s, right: read " in")
        s = String.concat(left: read s, right: read idx)
        s = String.concat(left: read s, right: read "_vals[")
        s = String.concat(left: read s, right: read Int.to_string(value: read n))
        s = String.concat(left: read s, right: read "];\n")
        s = String.concat(left: read s, right: read "  memcpy(in")
        s = String.concat(left: read s, right: read idx)
        s = String.concat(left: read s, right: read "_vals, in")
        s = String.concat(left: read s, right: read idx)
        s = String.concat(left: read s, right: read "_bytes, ")
        s = String.concat(left: read s, right: read Int.to_string(value: read input_nbytes))
        s = String.concat(left: read s, right: read ");\n")
        i = i + 1
    }
    s = String.concat(left: read s, right: read "  ")
    s = String.concat(left: read s, right: read function_name)
    s = String.concat(left: read s, right: read "(")
    let mut ok = 0
    while ok < List.len<String>(list: read output_types) {
        if ok > 0 { s = String.concat(left: read s, right: read ", ") }
        s = String.concat(left: read s, right: read "out")
        s = String.concat(left: read s, right: read Int.to_string(value: read ok))
        s = String.concat(left: read s, right: read "_vals")
        ok = ok + 1
    }
    let mut j = 0
    while j < List.len<String>(list: read input_inits) {
        s = String.concat(left: read s, right: read ", in")
        s = String.concat(left: read s, right: read Int.to_string(value: read j))
        s = String.concat(left: read s, right: read "_vals")
        j = j + 1
    }
    s = String.concat(left: read s, right: read ", ")
    s = String.concat(left: read s, right: read Int.to_string(value: read n))
    s = String.concat(left: read s, right: read ");\n")
    let mut om = 0
    while om < List.len<String>(list: read output_types) {
        let midx = Int.to_string(value: read om)
        s = String.concat(left: read s, right: read "  memcpy(out")
        s = String.concat(left: read s, right: read midx)
        s = String.concat(left: read s, right: read "_bytes, out")
        s = String.concat(left: read s, right: read midx)
        s = String.concat(left: read s, right: read "_vals, ")
        s = String.concat(left: read s, right: read Int.to_string(value: read output_nbytes))
        s = String.concat(left: read s, right: read ");\n")
        s = String.concat(left: read s, right: read "  for (int i = 0; i < ")
        s = String.concat(left: read s, right: read Int.to_string(value: read output_nbytes))
        s = String.concat(left: read s, right: read "; i++) { printf(\"%u \", (unsigned)out")
        s = String.concat(left: read s, right: read midx)
        s = String.concat(left: read s, right: read "_bytes[i]); }\n")
        om = om + 1
    }
    s = String.concat(left: read s, right: read "  return 0;\n}\n")
    return String.copy(value: read s)
}

fn realize_empty_host_exec(staged: read RealizeProgramExec, compile_status: Int, run_status: Int, stderr_len: Int) -> fresh RealizeHostProgramExec {
    return realize_host_program_exec_new(ok: false, staged: read staged, compile_status: compile_status,
                                         run_status: run_status, output_nbytes: 0, parsed_nbytes: 0,
                                         stderr_len: stderr_len)
}

fn realize_empty_var_vals() -> fresh Map<String, Int> {
    local vals = Map.new<String, Int>()
    return take vals
}

fn realize_program_vals_count(flags: read List<Bool>) -> Int {
    let mut count = 0
    let mut i = 0
    while i < List.len<Bool>(list: read flags) {
        if List.get<Bool>(list: read flags, index: i) { count = count + 1 }
        i = i + 1
    }
    return count
}

fn realize_exec_program_with_vars(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int, var_vals: read Map<String, Int>) -> fresh RealizeProgramExec {
    local empty_slots = List.new<Int>()
    local empty_indices = List.new<Int>()
    if node_op(cache: read cache, id: call) != CALL {
        return RealizeProgramExec(ok: false, function_name: "", global_count: 0,
                                  global_slots: take empty_slots, buffer_indices: take empty_indices,
                                  allocated_count: 0, source_id: 0 - 1, source_len: 0,
                                  global_dim_count: 0, has_local_size: false, local_dim_count: 0,
                                  val_count: 0, val_known_count: 0, val_runtime_count: 0,
                                  runtime_cache_hit: false, runtime_handle: 0)
    }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    if node_op(cache: read cache, id: ast) != PROGRAM {
        return RealizeProgramExec(ok: false, function_name: "", global_count: 0,
                                  global_slots: take empty_slots, buffer_indices: take empty_indices,
                                  allocated_count: 0, source_id: 0 - 1, source_len: 0,
                                  global_dim_count: 0, has_local_size: false, local_dim_count: 0,
                                  val_count: 0, val_known_count: 0, val_runtime_count: 0,
                                  runtime_cache_hit: false, runtime_handle: 0)
    }
    local prog = node_program_arg(cache: read cache, id: ast)
    local launch = program_arg_launch_dims(arg: read prog)
    local vals = program_arg_vals(cache: read cache, arg: read prog, var_vals: read var_vals)
    local global_slots = List.new<Int>()
    local buffer_indices = List.new<Int>()
    let mut allocated = 0
    let mut i = 0
    while i < List.len<Int>(list: read prog.globals) {
        let slot = List.get<Int>(list: read prog.globals, index: i)
        let idx = realize_exec_context_get_slot(ctx: read ctx, slot: slot)
        List.push<Int>(list: mut global_slots, value: read slot)
        List.push<Int>(list: mut buffer_indices, value: read idx)
        let b0 = realize_exec_context_get_buffer(ctx: read ctx, index: idx)
        local b = buffer_ensure_allocated(store: mut ctx.store, buf: read b0)
        if buffer_is_initialized(buf: read b) { allocated = allocated + 1 }
        realize_exec_context_set_buffer(ctx: mut ctx, index: idx, buf: read b)
        i = i + 1
    }
    let source = realize_program_source_id(cache: read cache, ast: ast)
    let source_len = realize_program_source_len(cache: read cache, ast: ast)
    local function_name = node_program_name(cache: read cache, id: ast)
    let cache_hit = realize_runtime_cache_contains(ctx: read ctx, function_name: read function_name, source_id: source, source_len: source_len)
    let runtime_handle = realize_runtime_cache_get_or_insert(ctx: mut ctx, function_name: read function_name, source_id: source, source_len: source_len)
    return RealizeProgramExec(ok: true, function_name: take function_name,
                              global_count: List.len<Int>(list: read prog.globals),
                              global_slots: take global_slots, buffer_indices: take buffer_indices,
                              allocated_count: allocated, source_id: source,
                              source_len: source_len,
                              global_dim_count: List.len<Int>(list: read launch.global_size),
                              has_local_size: take launch.has_local_size,
                              local_dim_count: List.len<Int>(list: read launch.local_size),
                              val_count: List.len<Int>(list: read vals.values),
                              val_known_count: realize_program_vals_count(flags: read vals.has_value),
                              val_runtime_count: realize_program_vals_count(flags: read vals.is_runtime),
                              runtime_cache_hit: cache_hit, runtime_handle: runtime_handle)
}

fn realize_exec_program(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int) -> fresh RealizeProgramExec {
    local vals = realize_empty_var_vals()
    return realize_exec_program_with_vars(cache: read cache, ctx: mut ctx, call: call, var_vals: read vals)
}

fn realize_exec_program_host_scalar_with_vars(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int,
                                              c_path_text: read String, exe_path_text: read String,
                                              var_vals: read Map<String, Int>) -> fresh RealizeHostProgramExec {
    local staged = realize_exec_program_with_vars(cache: read cache, ctx: mut ctx, call: call, var_vals: read var_vals)
    if staged.ok == false { return realize_empty_host_exec(staged: read staged, compile_status: 0 - 1, run_status: 0 - 1, stderr_len: 0) }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    local prog = node_program_arg(cache: read cache, id: ast)
    let out_count = List.len<Int>(list: read prog.outs)
    let in_count = List.len<Int>(list: read prog.ins)
    if out_count < 1 || in_count < 1 || List.len<Int>(list: read prog.globals) != (out_count + in_count) {
        return realize_empty_host_exec(staged: read staged, compile_status: 0 - 2, run_status: 0 - 1, stderr_len: 0)
    }
    let mut go = 0
    while go < out_count {
        if List.get<Int>(list: read prog.globals, index: go) != List.get<Int>(list: read prog.outs, index: go) {
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 3, run_status: 0 - 1, stderr_len: 0)
        }
        go = go + 1
    }
    let mut gi = 0
    while gi < List.len<Int>(list: read prog.ins) {
        if List.get<Int>(list: read prog.globals, index: out_count + gi) != List.get<Int>(list: read prog.ins, index: gi) {
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 3, run_status: 0 - 1, stderr_len: 0)
        }
        gi = gi + 1
    }
    let first_out_slot = List.get<Int>(list: read prog.outs, index: 0)
    let first_out_idx = realize_exec_context_get_slot(ctx: read ctx, slot: first_out_slot)
    let first_out = realize_exec_context_get_buffer(ctx: read ctx, index: first_out_idx)
    if realize_host_dtype_supported(dt: read first_out.dtype) == false {
        return realize_empty_host_exec(staged: read staged, compile_status: 0 - 4, run_status: 0 - 1, stderr_len: 0)
    }
    let out_itemsize = DType.itemsize(self: read dtype_scalar(d: read first_out.dtype))
    let first_out_nbytes = buffer_nbytes(buf: read first_out)
    let out_nbytes = first_out_nbytes
    if out_nbytes <= 0 || out_nbytes % out_itemsize != 0 {
        return realize_empty_host_exec(staged: read staged, compile_status: 0 - 5, run_status: 0 - 1, stderr_len: 0)
    }
    local output_indices = List.new<Int>()
    local output_types = List.new<String>()
    let mut oo = 0
    while oo < out_count {
        let out_slot = List.get<Int>(list: read prog.outs, index: oo)
        let out_idx = realize_exec_context_get_slot(ctx: read ctx, slot: out_slot)
        let out0 = realize_exec_context_get_buffer(ctx: read ctx, index: out_idx)
        if realize_host_dtype_supported(dt: read out0.dtype) == false || DType.itemsize(self: read dtype_scalar(d: read out0.dtype)) != out_itemsize || buffer_nbytes(buf: read out0) != out_nbytes {
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 5, run_status: 0 - 1, stderr_len: 0)
        }
        local out_buf = buffer_ensure_allocated(store: mut ctx.store, buf: read out0)
        realize_exec_context_set_buffer(ctx: mut ctx, index: out_idx, buf: read out_buf)
        List.push<Int>(list: mut output_indices, value: read out_idx)
        List.push<String>(list: mut output_types, value: read realize_host_c_scalar_type(dt: read out0.dtype))
        oo = oo + 1
    }
    local input_inits = List.new<String>()
    local input_types = List.new<String>()
    let mut ii = 0
    while ii < List.len<Int>(list: read prog.ins) {
        let in_slot = List.get<Int>(list: read prog.ins, index: ii)
        let in_idx = realize_exec_context_get_slot(ctx: read ctx, slot: in_slot)
        let in0 = realize_exec_context_get_buffer(ctx: read ctx, index: in_idx)
        if realize_host_dtype_supported(dt: read in0.dtype) == false {
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 4, run_status: 0 - 1, stderr_len: 0)
        }
        if DType.itemsize(self: read dtype_scalar(d: read in0.dtype)) != out_itemsize {
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 5, run_status: 0 - 1, stderr_len: 0)
        }
        List.push<String>(list: mut input_types, value: read realize_host_c_scalar_type(dt: read in0.dtype))
        local in_buf = buffer_ensure_allocated(store: mut ctx.store, buf: read in0)
        let in_nbytes = buffer_nbytes(buf: read in_buf)
        if in_nbytes != out_nbytes {
            realize_exec_context_set_buffer(ctx: mut ctx, index: in_idx, buf: read in_buf)
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 5, run_status: 0 - 1, stderr_len: 0)
        }
        local input_bytes = buffer_copyout(store: read ctx.store, buf: read in_buf)
        List.push<String>(list: mut input_inits, value: read realize_bytes_c_initializer(bytes: read input_bytes))
        realize_exec_context_set_buffer(ctx: mut ctx, index: in_idx, buf: read in_buf)
        ii = ii + 1
    }
    let n = out_nbytes / out_itemsize
    let source = uop_arg_to_string(arg: read node_arg(cache: read cache, id: staged.source_id))
    let harness = realize_host_multiout_main(function_name: read staged.function_name, output_types: read output_types,
                                             input_types: read input_types, input_inits: read input_inits,
                                             input_nbytes: out_nbytes, output_nbytes: out_nbytes, n: n)
    let combined = ["#include <stdio.h>\n#include <string.h>\n", source, "\n", harness].join("")
    let c_path = Path.from_string(value: read c_path_text)
    match Path.write_string(path: read c_path, text: read combined) {
        Ok(unit) => {
        }
        Err(error) => {
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 6, run_status: 0 - 1, stderr_len: String.len(value: read error.message()))
        }
    }
    let compile_args: List<String> = ["-std=c11", c_path_text, "-lm", "-o", exe_path_text]
    match Process.run(command: read "clang", args: read compile_args) {
        Ok(compile_output) => {
            if compile_output.status != 0 {
                return realize_host_program_exec_new(ok: false, staged: read staged, compile_status: compile_output.status,
                                                     run_status: 0 - 1, output_nbytes: out_nbytes, parsed_nbytes: 0,
                                                     stderr_len: String.len(value: read compile_output.stderr))
            }
        }
        Err(error) => {
            return realize_empty_host_exec(staged: read staged, compile_status: 0 - 7, run_status: 0 - 1, stderr_len: String.len(value: read error))
        }
    }
    let run_args = List.new<String>()
    match Process.run(command: read exe_path_text, args: read run_args) {
        Ok(run_output) => {
            local out_bytes = realize_parse_decimal_bytes(text: read run_output.stdout)
            let total_out_nbytes = out_nbytes * out_count
            if run_output.status == 0 && List.len<Int>(list: read out_bytes) == total_out_nbytes {
                let mut oi2 = 0
                while oi2 < out_count {
                    let out_idx2 = List.get<Int>(list: read output_indices, index: oi2)
                    let out_existing = realize_exec_context_get_buffer(ctx: read ctx, index: out_idx2)
                    local piece = bytes_slice(bytes: read out_bytes, start: oi2 * out_nbytes, len: out_nbytes)
                    local out_written = buffer_copyin(store: mut ctx.store, buf: read out_existing, src: read piece)
                    realize_exec_context_set_buffer(ctx: mut ctx, index: out_idx2, buf: read out_written)
                    oi2 = oi2 + 1
                }
                return realize_host_program_exec_new(ok: true, staged: read staged, compile_status: 0,
                                                     run_status: run_output.status, output_nbytes: total_out_nbytes,
                                                     parsed_nbytes: List.len<Int>(list: read out_bytes),
                                                     stderr_len: String.len(value: read run_output.stderr))
            }
            return realize_host_program_exec_new(ok: false, staged: read staged, compile_status: 0,
                                                 run_status: run_output.status, output_nbytes: total_out_nbytes,
                                                 parsed_nbytes: List.len<Int>(list: read out_bytes),
                                                 stderr_len: String.len(value: read run_output.stderr))
        }
        Err(error) => {
            return realize_empty_host_exec(staged: read staged, compile_status: 0, run_status: 0 - 2, stderr_len: String.len(value: read error))
        }
    }
}

fn realize_exec_program_host_scalar(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int,
                                    c_path_text: read String, exe_path_text: read String) -> fresh RealizeHostProgramExec {
    local vals = realize_empty_var_vals()
    return realize_exec_program_host_scalar_with_vars(cache: read cache, ctx: mut ctx, call: call,
                                                      c_path_text: read c_path_text, exe_path_text: read exe_path_text,
                                                      var_vals: read vals)
}

fn realize_exec_program_host_default(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int) -> fresh RealizeHostProgramExec {
    return realize_exec_program_host_scalar(cache: read cache, ctx: mut ctx, call: call,
                                           c_path_text: read "/tmp/tinygrad-rss-realize-program.c",
                                           exe_path_text: read "/tmp/tinygrad-rss-realize-program")
}

fn realize_exec_program_host_default_with_vars(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int, var_vals: read Map<String, Int>) -> fresh RealizeHostProgramExec {
    return realize_exec_program_host_scalar_with_vars(cache: read cache, ctx: mut ctx, call: call,
                                                     c_path_text: read "/tmp/tinygrad-rss-realize-program.c",
                                                     exe_path_text: read "/tmp/tinygrad-rss-realize-program",
                                                     var_vals: read var_vals)
}

fn realize_exec_call(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int) -> Bool {
    if node_op(cache: read cache, id: call) != CALL { return false }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    let op = node_op(cache: read cache, id: ast)
    if op == COPY {
        realize_exec_copy(cache: read cache, ctx: mut ctx, call: call)
        return true
    }
    if op == SLICE {
        realize_exec_view(cache: read cache, ctx: mut ctx, call: call)
        return true
    }
    if op == PROGRAM {
        local host_exec = realize_exec_program_host_default(cache: read cache, ctx: mut ctx, call: call)
        if host_exec.ok { return true }
        return host_exec.staged.ok
    }
    return false
}

fn realize_call_arg_buffer_index(cache: read UOpCache, ctx: read RealizeExecContext, arg: Int) -> Int {
    return realize_call_arg_buffer_index_default(cache: read cache, ctx: read ctx, arg: arg, default_index: 0)
}

fn realize_call_arg_buffer_index_default(cache: read UOpCache, ctx: read RealizeExecContext, arg: Int, default_index: Int) -> Int {
    let op = node_op(cache: read cache, id: arg)
    if op == PARAM {
        return realize_exec_context_get_slot(ctx: read ctx, slot: node_param_slot(cache: read cache, id: arg))
    }
    if (op == SLICE || op == MSELECT) && node_num_src(cache: read cache, id: arg) > 0 {
        return realize_call_arg_buffer_index_default(cache: read cache, ctx: read ctx, arg: node_src_id(cache: read cache, id: arg, k: 0), default_index: default_index)
    }
    return default_index
}

fn realize_exec_call_resolved(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int) -> Bool {
    local vals = realize_empty_var_vals()
    return realize_exec_call_resolved_with_vars(cache: read cache, ctx: mut ctx, call: call, var_vals: read vals)
}

fn realize_exec_call_resolved_with_vars(cache: read UOpCache, ctx: mut RealizeExecContext, call: Int, var_vals: read Map<String, Int>) -> Bool {
    if node_op(cache: read cache, id: call) != CALL { return false }
    local args = realize_get_call_arg_uops(cache: read cache, call: call)
    if List.len<Int>(list: read args) < 2 { return realize_exec_call(cache: read cache, ctx: mut ctx, call: call) }
    let ast = node_src_id(cache: read cache, id: call, k: 0)
    let op = node_op(cache: read cache, id: ast)
    let dest_idx = realize_call_arg_buffer_index_default(cache: read cache, ctx: read ctx, arg: List.get<Int>(list: read args, index: 0), default_index: 0)
    let src_idx = realize_call_arg_buffer_index_default(cache: read cache, ctx: read ctx, arg: List.get<Int>(list: read args, index: 1), default_index: 1)
    if op == COPY {
        realize_exec_copy_indices(ctx: mut ctx, dest_idx: dest_idx, src_idx: src_idx)
        return true
    }
    if op == SLICE {
        realize_exec_view_indices(cache: read cache, ctx: mut ctx, ast: ast, dest_idx: dest_idx, src_idx: src_idx)
        return true
    }
    if op == PROGRAM {
        local host_exec = realize_exec_program_host_default_with_vars(cache: read cache, ctx: mut ctx, call: call, var_vals: read var_vals)
        if host_exec.ok { return true }
        return host_exec.staged.ok
    }
    return false
}

fn realize_run_linear(cache: read UOpCache, ctx: mut RealizeExecContext, linear: Int) -> Int {
    local vals = realize_empty_var_vals()
    return realize_run_linear_with_vars(cache: read cache, ctx: mut ctx, linear: linear, var_vals: read vals)
}

fn realize_run_linear_with_vars(cache: read UOpCache, ctx: mut RealizeExecContext, linear: Int, var_vals: read Map<String, Int>) -> Int {
    if node_op(cache: read cache, id: linear) != LINEAR { return 0 }
    let mut executed = 0
    let mut i = 0
    while i < node_num_src(cache: read cache, id: linear) {
        let call = node_src_id(cache: read cache, id: linear, k: i)
        if realize_exec_call_resolved_with_vars(cache: read cache, ctx: mut ctx, call: call, var_vals: read var_vals) {
            executed = executed + 1
        }
        i = i + 1
    }
    return executed
}

fn realize_run_scheduled(cache: mut UOpCache, ctx: mut RealizeExecContext, big_sink: Int) -> fresh RealizeScheduledRun {
    local scheduled = schedule_create_linear_with_vars(cache: mut cache, big_sink: big_sink)
    let executed = realize_run_linear_with_vars(cache: read cache, ctx: mut ctx, linear: scheduled.linear, var_vals: read scheduled.var_vals)
    let vars = Map.len<String, Int>(map: read scheduled.var_vals)
    let planned = scheduled.planned
    let arenas = scheduled.arenas
    let ok = scheduled.ok
    return RealizeScheduledRun(executed: executed, planned: planned, arenas: arenas,
                               var_count: vars, ok: ok)
}
