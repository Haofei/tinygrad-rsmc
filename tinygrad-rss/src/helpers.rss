fn to_be64(x: Int) -> Int { return x }
fn getbits(x: Int, start: Int, len: Int) -> Int {
    let mut div = 1
    let mut i = 0
    while i < start {
        div = div * 2
        i = i + 1
    }
    let mut mask = 1
    let mut j = 0
    while j < len {
        mask = mask * 2
        j = j + 1
    }
    return (x / div) % mask
}
fn i2u(x: Int, bits: Int) -> Int {
    if x >= 0 { return x }
    let mut modv = 1
    let mut i = 0
    while i < bits {
        modv = modv * 2
        i = i + 1
    }
    return x + modv
}
