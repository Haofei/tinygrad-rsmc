// Integrated source-shaped slice of tinygrad/device.py.
//
// This covers the metadata side of Device/Buffer before native runtime allocators:
// canonical device strings, BufferSpec, Buffer, MultiBuffer, allocation state,
// nbytes, view descriptors, and an explicit byte-list allocator for the RSS
// runtime path. Native opaque handles, full LRU allocator behavior, compiler
// caches, dynamic runtime imports, and profile finalization remain later runtime
// slices. The RSS struct is named TGBuffer to avoid a generated Rust backend
// collision with std::io::Buffer.
features: local

struct BufferSpec derives(Clone, Eq, Hash) {
    uncached: Bool,
    cpu_access: Bool,
    host: Bool,
    nolru: Bool,
    has_external_ptr: Bool,
    external_ptr: Int,
}

struct TGBuffer derives(Clone) {
    device: String,
    size: Int,
    dtype: DType,
    has_options: Bool,
    options: BufferSpec,
    offset: Int,
    has_base: Bool,
    base_device: String,
    base_size: Int,
    base_offset: Int,
    allocated: Bool,
    allocated_views: Int,
    uop_refcount: Int,
    has_handle: Bool,
    handle: Int,
}

struct MultiBuffer derives(Clone) {
    bufs: List<TGBuffer>,
}

struct AllocatorCacheEntry derives(Clone) {
    size: Int,
    options: BufferSpec,
    data: List<Int>,
}

struct DeviceMemoryStore {
    next_handle: Int,
    bufs: Map<Int, List<Int>>,
    cache: List<AllocatorCacheEntry>,
    mem_used: Int,
}

struct CompileError derives(Clone) {
    message: String,
}

struct Compiler derives(Clone) {
    cachekey: String,
}

struct Compiled derives(Clone) {
    device: String,
    compiler: Compiler,
}

struct Allocator derives(Clone) {
    name: String,
}

struct LRUAllocator derives(Clone) {
    name: String,
    cache_enabled: Bool,
}

struct ProfileDeviceEvent derives(Clone) {
    device: String,
    tdiff_us: Int,
}

struct ProfileProgramEvent derives(Clone) {
