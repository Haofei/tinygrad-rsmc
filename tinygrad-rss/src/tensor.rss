// Tensor surface over the interned UOp graph. A "tensor" is a node id in the cache; ops build graph.
// (tinygrad Tensor wraps a UOp; here the cache is threaded explicitly.) Broadcasting binary op.
features: local

struct SortResult derives(Clone) {
    values: Int,
    indices: Int,
}

struct TensorPair derives(Clone) {
    first: Int,
    second: Int,
}

// _broadcast_to: reshape x to align its ndims (left-pad 1s), then EXPAND to the target shape.
fn broadcast_to(cache: mut UOpCache, x: Int, target: read List<Int>) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    let nt = List.len<Int>(list: read target)
    local aligned = align_left(s: read xs, max_dim: nt)
    let r = mk_reshape(cache: mut cache, x: x, new_shape: read aligned)
    return mk_expand(cache: mut cache, x: r, new_shape: read target)
}

// broadcasting binary op (tinygrad Tensor._apply_uop with _broadcast_to on both operands).
fn tensor_binary(cache: mut UOpCache, op: Ops, a: Int, b: Int) -> Int {
    local sa = uop_shape(cache: read cache, id: a)
    local sb = uop_shape(cache: read cache, id: b)
    local bshape = broadcast_shape(s1: read sa, s2: read sb)
    let a2 = broadcast_to(cache: mut cache, x: a, target: read bshape)
    let b2 = broadcast_to(cache: mut cache, x: b, target: read bshape)
    let dt = node_dtype(cache: read cache, id: a2)
    return mk_alu2(cache: mut cache, op: op, dt: read dt, x: a2, y: b2)
}

fn tensor_compare(cache: mut UOpCache, op: Ops, a: Int, b: Int) -> Int {
    local sa = uop_shape(cache: read cache, id: a)
    local sb = uop_shape(cache: read cache, id: b)
    local bshape = broadcast_shape(s1: read sa, s2: read sb)
    let a2 = broadcast_to(cache: mut cache, x: a, target: read bshape)
    let b2 = broadcast_to(cache: mut cache, x: b, target: read bshape)
    let bdt = dt_bool()
    return mk_alu2(cache: mut cache, op: op, dt: read bdt, x: a2, y: b2)
}

fn tensor_where(cache: mut UOpCache, cond: Int, x: Int, y: Int) -> Int {
    local cs = uop_shape(cache: read cache, id: cond)
    local xs = uop_shape(cache: read cache, id: x)
    local ys = uop_shape(cache: read cache, id: y)
    local cxs = broadcast_shape(s1: read cs, s2: read xs)
    local target = broadcast_shape(s1: read cxs, s2: read ys)
    let c2 = broadcast_to(cache: mut cache, x: cond, target: read target)
    let x2 = broadcast_to(cache: mut cache, x: x, target: read target)
    let y2 = broadcast_to(cache: mut cache, x: y, target: read target)
    let dt = node_dtype(cache: read cache, id: x2)
    return mk_where(cache: mut cache, dt: read dt, cond: c2, tval: x2, fval: y2)
}

fn tensor_unary(cache: mut UOpCache, op: Ops, x: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    return mk_alu1(cache: mut cache, op: op, dt: read dt, x: x)
}

fn tensor_const_like_float(cache: mut UOpCache, x: Int, value: Float) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    return mk_const_float(cache: mut cache, dt: read dt, v: value)
}

fn tensor_nbytes(cache: read UOpCache, x: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let dt = node_dtype(cache: read cache, id: x)
    return numel(shape: read shape) * DType.itemsize(self: read dt)
}

fn push1(l: mut List<Int>, a: Int) -> Unit {
    List.push<Int>(list: mut l, value: read a)
    return Unit
}

fn pushf1(l: mut List<Float>, a: Float) -> Unit {
    List.push<Float>(list: mut l, value: read a)
    return Unit
}

fn tensor_full(cache: mut UOpCache, dt: read DType, shape: read List<Int>, value: Float) -> Int {
    local data = List.new<Float>()
    let total = numel(shape: read shape)
    let mut i = 0
    while i < total {
        pushf1(l: mut data, a: value)
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_zeros(cache: mut UOpCache, dt: read DType, shape: read List<Int>) -> Int {
    return tensor_full(cache: mut cache, dt: read dt, shape: read shape, value: 0.0)
}

fn tensor_ones(cache: mut UOpCache, dt: read DType, shape: read List<Int>) -> Int {
    return tensor_full(cache: mut cache, dt: read dt, shape: read shape, value: 1.0)
}

fn tensor_full_like(cache: mut UOpCache, x: Int, dt: read DType, value: Float) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    return tensor_full(cache: mut cache, dt: read dt, shape: read shape, value: value)
}

fn tensor_full_like_same(cache: mut UOpCache, x: Int, value: Float) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    return tensor_full_like(cache: mut cache, x: x, dt: read dt, value: value)
}

fn tensor_zeros_like(cache: mut UOpCache, x: Int, dt: read DType) -> Int {
    return tensor_full_like(cache: mut cache, x: x, dt: read dt, value: 0.0)
}

fn tensor_zeros_like_same(cache: mut UOpCache, x: Int) -> Int {
    return tensor_full_like_same(cache: mut cache, x: x, value: 0.0)
}

fn tensor_ones_like(cache: mut UOpCache, x: Int, dt: read DType) -> Int {
    return tensor_full_like(cache: mut cache, x: x, dt: read dt, value: 1.0)
}

fn tensor_ones_like_same(cache: mut UOpCache, x: Int) -> Int {
    return tensor_full_like_same(cache: mut cache, x: x, value: 1.0)
}

fn tensor_arange(cache: mut UOpCache, dt: read DType, n: Int) -> Int {
    local shape = List.new<Int>()
    push1(l: mut shape, a: n)
    local data = List.new<Float>()
    let mut i = 0
    while i < n {
        pushf1(l: mut data, a: Int.to_float(value: read i))
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_arange_range_len(start: Int, stop: Int, step: Int) -> Int {
    if step > 0 {
        if stop <= start { return 0 }
        return ceildiv(num: stop - start, amt: step)
    }
    if step < 0 {
        if start <= stop { return 0 }
        return ceildiv(num: start - stop, amt: 0 - step)
    }
    return 0
}

fn tensor_arange_range(cache: mut UOpCache, dt: read DType, start: Int, stop: Int, step: Int) -> Int {
    let n = tensor_arange_range_len(start: start, stop: stop, step: step)
    local shape = List.new<Int>()
    push1(l: mut shape, a: n)
    local data = List.new<Float>()
    let mut i = 0
    while i < n {
        pushf1(l: mut data, a: Int.to_float(value: read (start + i * step)))
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_linspace(cache: mut UOpCache, dt: read DType, start: Float, stop: Float, steps: Int) -> Int {
    local shape = List.new<Int>()
    push1(l: mut shape, a: steps)
    local data = List.new<Float>()
    if steps <= 0 {
        return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
    }
    if steps == 1 {
        pushf1(l: mut data, a: start)
        return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
    }
    let step = (stop - start) / Int.to_float(value: read (steps - 1))
    let mut i = 0
    while i < steps {
        pushf1(l: mut data, a: start + Int.to_float(value: read i) * step)
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_eye(cache: mut UOpCache, dt: read DType, n: Int, m: Int) -> Int {
    let row = tensor_arange(cache: mut cache, dt: read dt_int32(), n: n)
    let rowu = tensor_unsqueeze(cache: mut cache, x: row, dim: 1)
    let col = tensor_arange(cache: mut cache, dt: read dt_int32(), n: m)
    let mask = tensor_eq(cache: mut cache, a: rowu, b: col)
    return tensor_cast(cache: mut cache, x: mask, dt: read dt)
}

fn rng_mask32() -> Int { return 4294967295 }

fn rng_u32(x: Int) -> Int {
    return Int.bit_and(left: x, right: rng_mask32())
}

fn rng_add32(a: Int, b: Int) -> Int {
    return rng_u32(x: a + b)
}

fn rng_xor32(a: Int, b: Int) -> Int {
    return Int.bit_xor(left: a, right: b)
}

fn rng_rotl32(x: Int, r: Int) -> Int {
    let lo = Int.shift_left(value: x, bits: r)
    let hi = Int.shift_right(value: x, bits: 32 - r)
    return rng_u32(x: Int.bit_or(left: lo, right: hi))
}

fn rng_threefry2x32(x0: Int, x1: Int, key0: Int, key1: Int, out: mut List<Int>) -> Unit {
    let k0 = rng_u32(x: key0)
    let k1 = rng_u32(x: key1)
    let ks0 = k1
    let ks1 = rng_u32(x: rng_xor32(a: rng_xor32(a: k0, b: k1), b: 466688986))
    let ks2 = k0
    let mut r0 = rng_add32(a: rng_u32(x: x0), b: ks2)
    let mut r1 = rng_add32(a: rng_u32(x: x1), b: ks0)
    let mut i = 0
    while i < 5 {
        let mut j = 0
        while j < 4 {
            let mut rot = 0
            if i % 2 == 0 {
                if j == 0 { rot = 13 }
                if j == 1 { rot = 15 }
                if j == 2 { rot = 26 }
                if j == 3 { rot = 6 }
            }
            if i % 2 == 1 {
                if j == 0 { rot = 17 }
                if j == 1 { rot = 29 }
                if j == 2 { rot = 16 }
                if j == 3 { rot = 24 }
            }
            let new0 = rng_add32(a: r0, b: r1)
            let new1 = rng_xor32(a: new0, b: rng_rotl32(x: r1, r: rot))
            r0 = new0
            r1 = new1
            j = j + 1
        }
        let mut a = ks0
        if i % 3 == 1 { a = ks1 }
        if i % 3 == 2 { a = ks2 }
        let ip1 = (i + 1) % 3
        let mut b = ks0
        if ip1 == 1 { b = ks1 }
        if ip1 == 2 { b = ks2 }
        r0 = rng_add32(a: r0, b: a)
        r1 = rng_add32(a: rng_add32(a: r1, b: b), b: i + 1)
        i = i + 1
    }
    List.push<Int>(list: mut out, value: read r0)
    List.push<Int>(list: mut out, value: read r1)
    return Unit
}

fn rng_key0_for_default_device() -> Int { return 347607321 }

fn tensor_rand_into(n: Int, seed: Int, out: mut List<Float>) -> Unit {
    let key0 = rng_key0_for_default_device()
    let key1 = rng_u32(x: seed)
    local nk = List.new<Int>()
    rng_threefry2x32(x0: 0, x1: 0, key0: key0, key1: key1, out: mut nk)
    let nk0 = List.get<Int>(list: read nk, index: 0)
    let nk1 = List.get<Int>(list: read nk, index: 1)
    let half = (n + 1) / 2
    local lows = List.new<Int>()
    local highs = List.new<Int>()
    let mut j = 0
    while j < half {
        local o = List.new<Int>()
        rng_threefry2x32(x0: j, x1: j + half, key0: nk0, key1: nk1, out: mut o)
        List.push<Int>(list: mut lows, value: read List.get<Int>(list: read o, index: 0))
        List.push<Int>(list: mut highs, value: read List.get<Int>(list: read o, index: 1))
        j = j + 1
    }
    local bits = List.new<Int>()
    let mut a = 0
    while a < half {
        List.push<Int>(list: mut bits, value: read List.get<Int>(list: read lows, index: a))
        a = a + 1
    }
    let mut c = 0
    while c < half {
        List.push<Int>(list: mut bits, value: read List.get<Int>(list: read highs, index: c))
        c = c + 1
    }
    let mut k = 0
    while k < n {
        let b = List.get<Int>(list: read bits, index: k)
        let mant = Int.shift_right(value: b, bits: 9)
        let f = Int.to_float(value: read mant) / 8388608.0
        List.push<Float>(list: mut out, value: read f)
        k = k + 1
    }
    return Unit
}

fn tensor_rand(cache: mut UOpCache, dt: read DType, shape: read List<Int>, seed: Int) -> Int {
    local data = List.new<Float>()
    tensor_rand_into(n: numel(shape: read shape), seed: seed, out: mut data)
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_rand_like(cache: mut UOpCache, x: Int, dt: read DType, seed: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    return tensor_rand(cache: mut cache, dt: read dt, shape: read shape, seed: seed)
}

fn tensor_rand_like_same(cache: mut UOpCache, x: Int, seed: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    return tensor_rand_like(cache: mut cache, x: x, dt: read dt, seed: seed)
}

fn tensor_uniform(cache: mut UOpCache, dt: read DType, shape: read List<Int>, low: Float, high: Float, seed: Int) -> Int {
    local r = List.new<Float>()
    tensor_rand_into(n: numel(shape: read shape), seed: seed, out: mut r)
    local data = List.new<Float>()
    let scale = high - low
    let mut i = 0
    while i < List.len<Float>(list: read r) {
        let v = List.get<Float>(list: read r, index: i)
        pushf1(l: mut data, a: low + scale * v)
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_randn_into(shape: read List<Int>, seed: Int, mean: Float, std: Float, out: mut List<Float>) -> Unit {
    let n = numel(shape: read shape)
    local r = List.new<Float>()
    tensor_rand_into(n: n * 2, seed: seed, out: mut r)
    let mut i = 0
    while i < n {
        let u0 = List.get<Float>(list: read r, index: i)
        let u1 = List.get<Float>(list: read r, index: n + i)
        let angle = 6.283185307179586 * u0
        let radius = Math.sqrt(value: (0.0 - 2.0) * Math.log(value: 1.0 - u1))
        let v = Math.cos(value: angle) * radius
        pushf1(l: mut out, a: mean + std * v)
        i = i + 1
    }
    return Unit
}

fn tensor_randn(cache: mut UOpCache, dt: read DType, shape: read List<Int>, seed: Int) -> Int {
    local data = List.new<Float>()
    tensor_randn_into(shape: read shape, seed: seed, mean: 0.0, std: 1.0, out: mut data)
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_randn_like(cache: mut UOpCache, x: Int, dt: read DType, seed: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    return tensor_randn(cache: mut cache, dt: read dt, shape: read shape, seed: seed)
}

fn tensor_randn_like_same(cache: mut UOpCache, x: Int, seed: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    return tensor_randn_like(cache: mut cache, x: x, dt: read dt, seed: seed)
}

fn tensor_normal(cache: mut UOpCache, dt: read DType, shape: read List<Int>, mean: Float, std: Float, seed: Int) -> Int {
    local data = List.new<Float>()
    tensor_randn_into(shape: read shape, seed: seed, mean: mean, std: std, out: mut data)
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_normal_like(cache: mut UOpCache, x: Int, dt: read DType, mean: Float, std: Float, seed: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    return tensor_normal(cache: mut cache, dt: read dt, shape: read shape, mean: mean, std: std, seed: seed)
}

fn tensor_scaled_uniform(cache: mut UOpCache, dt: read DType, shape: read List<Int>, seed: Int) -> Int {
    let scale = 1.0 / Math.sqrt(value: Int.to_float(value: read numel(shape: read shape)))
    return tensor_uniform(cache: mut cache, dt: read dt, shape: read shape, low: 0.0 - scale, high: scale, seed: seed)
}

fn shape_tail_prod_float(shape: read List<Int>) -> Float {
    let mut p = 1
    let mut i = 1
    while i < List.len<Int>(list: read shape) {
        p = p * List.get<Int>(list: read shape, index: i)
        i = i + 1
    }
    return Int.to_float(value: read p)
}

fn tensor_glorot_uniform(cache: mut UOpCache, dt: read DType, shape: read List<Int>, seed: Int) -> Int {
    let fan_in = List.get<Int>(list: read shape, index: 0)
    let fan_out = shape_tail_prod_float(shape: read shape)
    let denom = Int.to_float(value: read fan_in) + fan_out
    let bound = Math.sqrt(value: 6.0 / denom)
    return tensor_uniform(cache: mut cache, dt: read dt, shape: read shape, low: 0.0 - bound, high: bound, seed: seed)
}

fn tensor_kaiming_uniform(cache: mut UOpCache, dt: read DType, shape: read List<Int>, a: Float, seed: Int) -> Int {
    let denom = (1.0 + a * a) * shape_tail_prod_float(shape: read shape)
    let bound = Math.sqrt(value: 6.0 / denom)
    return tensor_uniform(cache: mut cache, dt: read dt, shape: read shape, low: 0.0 - bound, high: bound, seed: seed)
}

fn tensor_kaiming_normal(cache: mut UOpCache, dt: read DType, shape: read List<Int>, a: Float, seed: Int) -> Int {
    let denom = (1.0 + a * a) * shape_tail_prod_float(shape: read shape)
    let std = Math.sqrt(value: 2.0 / denom)
    return tensor_normal(cache: mut cache, dt: read dt, shape: read shape, mean: 0.0, std: std, seed: seed)
}

fn tensor_randint(cache: mut UOpCache, dt: read DType, shape: read List<Int>, low: Int, high: Int, seed: Int) -> Int {
    local r = List.new<Float>()
    tensor_rand_into(n: numel(shape: read shape), seed: seed, out: mut r)
    local data = List.new<Float>()
    let span = high - low
    let fspan = Int.to_float(value: read span)
    let mut i = 0
    while i < List.len<Float>(list: read r) {
        let v = List.get<Float>(list: read r, index: i)
        let bucket = Math.floor(value: fspan * v)
        let iv = low + bucket
        pushf1(l: mut data, a: Int.to_float(value: read iv))
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_argsort_float(vals: read List<Float>) -> fresh List<Int> {
    local out = List.new<Int>()
    local used = List.new<Int>()
    let n = List.len<Float>(list: read vals)
    let mut u = 0
    while u < n {
        push1(l: mut used, a: 0)
        u = u + 1
    }
    let mut pos = 0
    while pos < n {
        let mut best = 0
        let mut found = false
        let mut i = 0
        while i < n {
            if List.get<Int>(list: read used, index: i) == 0 {
                if found == false {
                    best = i
                    found = true
                } else {
                    let vi = List.get<Float>(list: read vals, index: i)
                    let vb = List.get<Float>(list: read vals, index: best)
                    if vi < vb { best = i }
                }
            }
            i = i + 1
        }
        List.set<Int>(list: mut used, index: best, value: read 1)
        push1(l: mut out, a: best)
        pos = pos + 1
    }
    return take out
}

fn tensor_randperm(cache: mut UOpCache, dt: read DType, n: Int, seed: Int) -> Int {
    local r = List.new<Float>()
    tensor_rand_into(n: n, seed: seed, out: mut r)
    local order = tensor_argsort_float(vals: read r)
    local data = List.new<Float>()
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let v = List.get<Int>(list: read order, index: i)
        pushf1(l: mut data, a: Int.to_float(value: read v))
        i = i + 1
    }
    local shape = List.new<Int>()
    push1(l: mut shape, a: n)
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_dropout(cache: mut UOpCache, x: Int, p: Float, training: Bool, seed: Int) -> Int {
    if training == false { return x }
    if p <= 0.0 { return x }
    if p >= 1.0 { return tensor_zeros_like_same(cache: mut cache, x: x) }
    let r = tensor_rand_like(cache: mut cache, x: x, dt: read dt_default_float(), seed: seed)
    let pc = tensor_const_like_float(cache: mut cache, x: r, value: p)
    let keep = tensor_ge(cache: mut cache, a: r, b: pc)
    let zero = tensor_zeros_like_same(cache: mut cache, x: x)
    let kept = tensor_where(cache: mut cache, cond: keep, x: x, y: zero)
    let scale = tensor_const_like_float(cache: mut cache, x: kept, value: 1.0 - p)
    return tensor_div(cache: mut cache, a: kept, b: scale)
}

fn tensor_add(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_binary(cache: mut cache, op: ADD, a: a, b: b)
}

fn tensor_sub(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_binary(cache: mut cache, op: SUB, a: a, b: b)
}

fn tensor_mul(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_binary(cache: mut cache, op: MUL, a: a, b: b)
}

fn tensor_div(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_binary(cache: mut cache, op: FDIV, a: a, b: b)
}

fn tensor_maximum(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_binary(cache: mut cache, op: MAX, a: a, b: b)
}

fn tensor_lt(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_compare(cache: mut cache, op: CMPLT, a: a, b: b)
}

fn tensor_gt(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_compare(cache: mut cache, op: CMPLT, a: b, b: a)
}

fn tensor_ge(cache: mut UOpCache, a: Int, b: Int) -> Int {
    let gt = tensor_gt(cache: mut cache, a: a, b: b)
    let eq = tensor_eq(cache: mut cache, a: a, b: b)
    return tensor_or(cache: mut cache, a: gt, b: eq)
}

fn tensor_ne(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_compare(cache: mut cache, op: CMPNE, a: a, b: b)
}

fn tensor_eq(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_compare(cache: mut cache, op: CMPEQ, a: a, b: b)
}

fn tensor_le(cache: mut UOpCache, a: Int, b: Int) -> Int {
    let lt = tensor_lt(cache: mut cache, a: a, b: b)
    let eq = tensor_eq(cache: mut cache, a: a, b: b)
    return tensor_or(cache: mut cache, a: lt, b: eq)
}

