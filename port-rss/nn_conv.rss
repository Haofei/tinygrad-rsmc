features: local
// Numeric port of tinygrad nn layer CLASSES (the struct-holding-weights flavor), faithful to
// /home/zoe/tinygrad/tinygrad/nn/__init__.py: Conv2d, BatchNorm/BatchNorm2d, Embedding.
// Companion to nn_layers.rss (free-function ops) / tensor_conv.rss (raw conv windows).
//
// Each layer is a small struct holding its weights as flat List<Float> (+ shape ints), with a
// forward fn that takes the struct `read` plus the input and writes the result via an out-param
// (the fresh-return restriction from BRIEFING.md). Numeric forward passes only, validated vs
// real tinygrad .tolist() (tol 1e-4). Reuses the conv windowed-sum from tensor_conv.rss, the
// fsqrt Newton iteration from nn_layers.rss (no sqrt intrinsic), and the same numeric idioms:
// flat data is List<Float>, typed fget/iget accessors, one statement per line, binary exprs
// bound to a let before push.
//
//   Conv2d.__call__  == x.conv2d(weight, bias, ...)  -> here single-channel and Cin/Cout, stride
//                       1, no pad: out[oc,oy,ox] = bias[oc] + sum_{ic,i,j} x[ic,oy+i,ox+j]*w[...].
//   BatchNorm.__call__ (inference, track_running_stats & not training) ==
//                       x.batchnorm(weight, bias, running_mean, (running_var+eps).rsqrt()) ->
//                       y_c = (x_c - running_mean_c) / sqrt(running_var_c + eps) * weight_c + bias_c.
//   Embedding.__call__ == weight[idx]  -> the idx-th row of the (vocab, dim) weight table.

// ---------- typed accessors / helpers (same as the other ports) ----------
fn iget(l: read List<Int>, i: Int) -> Int { return List.get(list: read l, index: i) }
fn fget(l: read List<Float>, i: Int) -> Float { return List.get(list: read l, index: i) }

// Newton sqrt (no sqrt intrinsic): y_{k+1} = 0.5*(y + a/y), seed 1.0, 20 iters; sqrt(0)=0.
fn fsqrt(a: Float) -> Float {
    if a <= 0.0 { return 0.0 }
    let mut y = 1.0
    let mut k = 0
    while k < 20 {
        let ny = 0.5 * (y + a / y)
        y = ny
        k = k + 1
    }
    return y
}

// ==========================================================================================
// Conv2d layer (struct holds the weight + bias, with channel/kernel dims)
// ==========================================================================================
// weight is flat row-major (cout, cin, kh, kw); bias is flat (cout,).
struct Conv2d derives(Clone) {
    cin: Int
    cout: Int
    kh: Int
    kw: Int
    weight: List<Float>
    bias: List<Float>
}

// Forward: x is flat (cin, h, w), stride 1, no pad -> out flat (cout, h-kh+1, w-kw+1).
// out[oc,oy,ox] = bias[oc] + sum_{ic in cin, i in kh, j in kw} x[ic,oy+i,ox+j] * w[oc,ic,i,j].
fn conv2d_forward(layer: read Conv2d, xdata: read List<Float>, h: Int, wd: Int,
                  out_shape: mut List<Int>, out: mut List<Float>) -> Unit {
    let cin = layer.cin
    let cout = layer.cout
    let kh = layer.kh
    let kw = layer.kw
    let oh = h - kh + 1
    let ow = wd - kw + 1
    List.push(list: mut out_shape, value: read cout)
    List.push(list: mut out_shape, value: read oh)
    List.push(list: mut out_shape, value: read ow)
    let xplane = h * wd
    let wplane = kh * kw
    let wic = cin * wplane
    let mut oc = 0
    while oc < cout {
        let bc = fget(l: read layer.bias, i: oc)
        let mut oy = 0
        while oy < oh {
            let mut ox = 0
            while ox < ow {
                let mut acc = bc
                let mut ic = 0
                while ic < cin {
                    let xbase = ic * xplane
                    let wbase = oc * wic + ic * wplane
                    let mut i = 0
                    while i < kh {
                        let mut j = 0
                        while j < kw {
                            let xidx = xbase + (oy + i) * wd + (ox + j)
                            let widx = wbase + i * kw + j
                            let xv = fget(l: read xdata, i: xidx)
                            let wv = fget(l: read layer.weight, i: widx)
                            let prod = xv * wv
                            acc = acc + prod
                            j = j + 1
                        }
                        i = i + 1
                    }
                    ic = ic + 1
                }
                List.push(list: mut out, value: read acc)
                ox = ox + 1
            }
            oy = oy + 1
        }
        oc = oc + 1
    }
    return Unit
}

// ==========================================================================================
// BatchNorm layer (inference mode): per-channel affine normalize with running stats
// ==========================================================================================
struct BatchNorm derives(Clone) {
    sz: Int
    eps: Float
    weight: List<Float>
    bias: List<Float>
    running_mean: List<Float>
    running_var: List<Float>
}

// Forward over a per-channel vector x (one value per channel; matches x.batchnorm reduced view):
// y_c = (x_c - running_mean_c) / sqrt(running_var_c + eps) * weight_c + bias_c.
fn batchnorm_forward(layer: read BatchNorm, xdata: read List<Float>, out: mut List<Float>) -> Unit {
    let sz = layer.sz
    let eps = layer.eps
    let mut c = 0
    while c < sz {
        let xc = fget(l: read xdata, i: c)
        let mc = fget(l: read layer.running_mean, i: c)
        let vc = fget(l: read layer.running_var, i: c)
        let wc = fget(l: read layer.weight, i: c)
        let bc = fget(l: read layer.bias, i: c)
        let denom = fsqrt(a: vc + eps)
        let centered = xc - mc
        let normed = centered / denom
        let scaled = normed * wc
        let yc = scaled + bc
        List.push(list: mut out, value: read yc)
        c = c + 1
    }
    return Unit
}

// ==========================================================================================
// Embedding layer: weight is (vocab, dim); forward(idx) -> the idx-th row
// ==========================================================================================
struct Embedding derives(Clone) {
    vocab: Int
    dim: Int
    weight: List<Float>
}

// Look up a single index -> push that row (dim floats) onto out.
fn embedding_lookup(layer: read Embedding, idx: Int, out: mut List<Float>) -> Unit {
    let dim = layer.dim
    let base = idx * dim
    let mut d = 0
    while d < dim {
        let v = fget(l: read layer.weight, i: base + d)
        List.push(list: mut out, value: read v)
        d = d + 1
    }
    return Unit
}

// Forward over a list of indices -> concatenated rows (len(idxs)*dim floats).
fn embedding_forward(layer: read Embedding, idxs: read List<Int>, out: mut List<Float>) -> Unit {
    let n = List.len(list: read idxs)
    let mut i = 0
    while i < n {
        let idx = iget(l: read idxs, i: i)
        embedding_lookup(layer: read layer, idx: idx, out: mut out)
        i = i + 1
    }
    return Unit
}

// ---------- printing ----------
fn show_shape(label: read String, shape: read List<Int>) -> Unit {
    let mut s = String.concat(left: read label, right: read "[")
    let n = List.len(list: read shape)
    let mut i = 0
    while i < n {
        s = String.concat(left: read s, right: read Int.to_string(value: read iget(l: read shape, i: i)))
        if i < n - 1 { s = String.concat(left: read s, right: read ", ") }
        i = i + 1
    }
    s = String.concat(left: read s, right: read "]")
    Log.write(message: read s)
    return Unit
}
fn show_vec(label: read String, v: read List<Float>) -> Unit {
    let mut s = String.concat(left: read label, right: read "[")
    let n = List.len(list: read v)
    let mut i = 0
    while i < n {
        s = String.concat(left: read s, right: read String.from_float(value: fget(l: read v, i: i)))
        if i < n - 1 { s = String.concat(left: read s, right: read ", ") }
        i = i + 1
    }
    s = String.concat(left: read s, right: read "]")
    Log.write(message: read s)
    return Unit
}

fn pushf(l: mut List<Float>, v: Float) -> Unit {
    List.push(list: mut l, value: read v)
    return Unit
}
fn pushi(l: mut List<Int>, v: Int) -> Unit {
    List.push(list: mut l, value: read v)
    return Unit
}

// ---------- layer builders ----------
// rss `take` only accepts a `local` value (BRIEFING.md), and the take must happen inside the
// `fresh`-returning constructor, so each layer is assembled here from `local` weight lists.

fn make_conv1() -> fresh Conv2d {
    local w = List.new<Float>()
    pushf(l: mut w, v: 1.0)
    pushf(l: mut w, v: 0.0)
    pushf(l: mut w, v: 0.0)
    pushf(l: mut w, v: 1.0)
    local b = List.new<Float>()
    pushf(l: mut b, v: 0.5)
    return Conv2d(cin: 1, cout: 1, kh: 2, kw: 2, weight: take w, bias: take b)
}

fn make_conv2() -> fresh Conv2d {
    local w = List.new<Float>()
    let mut wi = 0
    while wi < 16 {
        let m3 = wi - (wi / 3) * 3
        let wv = Int.to_float(value: read m3)
        pushf(l: mut w, v: wv)
        wi = wi + 1
    }
    local b = List.new<Float>()
    pushf(l: mut b, v: 0.5)
    pushf(l: mut b, v: -1.0)
    return Conv2d(cin: 2, cout: 2, kh: 2, kw: 2, weight: take w, bias: take b)
}

fn make_bn() -> fresh BatchNorm {
    local w = List.new<Float>()
    pushf(l: mut w, v: 2.0)
    pushf(l: mut w, v: 1.0)
    pushf(l: mut w, v: 0.5)
    local b = List.new<Float>()
    pushf(l: mut b, v: 0.1)
    pushf(l: mut b, v: -0.2)
    pushf(l: mut b, v: 0.3)
    local m = List.new<Float>()
    pushf(l: mut m, v: 1.0)
    pushf(l: mut m, v: 2.0)
    pushf(l: mut m, v: 3.0)
    local var = List.new<Float>()
    pushf(l: mut var, v: 4.0)
    pushf(l: mut var, v: 1.0)
    pushf(l: mut var, v: 9.0)
    return BatchNorm(sz: 3, eps: 0.00001, weight: take w, bias: take b, running_mean: take m, running_var: take var)
}

fn make_emb() -> fresh Embedding {
    local w = List.new<Float>()
    let mut ei = 0
    while ei < 15 {
        let ev = Int.to_float(value: read ei)
        let evs = ev / 10.0
        pushf(l: mut w, v: evs)
        ei = ei + 1
    }
    return Embedding(vocab: 5, dim: 3, weight: take w)
}

fn main() -> Unit {
    // ===== Conv2d single-channel: cin=1,cout=1, kh=kw=2, w=[[1,0],[0,1]], bias=[0.5] =====
    // x (1,4,4) = arange-ish [[1..4],[5..8],[9..12],[13..16]], stride 1 -> (1,3,3)
    let conv1 = make_conv1()
    let x1 = List.new<Float>()
    let mut xi = 1
    while xi < 17 {
        let xv = Int.to_float(value: read xi)
        pushf(l: mut x1, v: xv)
        xi = xi + 1
    }
    let c1shp = List.new<Int>()
    let c1out = List.new<Float>()
    conv2d_forward(layer: read conv1, xdata: read x1, h: 4, wd: 4, out_shape: mut c1shp, out: mut c1out)
    show_shape(label: read "Conv2d 1ch shape = ", shape: read c1shp)   // [1, 3, 3]
    show_vec(label: read "Conv2d 1ch       = ", v: read c1out)
    Log.write(message: read "  tinygrad:        [7.5, 9.5, 11.5, 15.5, 17.5, 19.5, 23.5, 25.5, 27.5]")

    // ===== Conv2d Cin=2,Cout=2, kh=kw=2: w=[i%3 for i in 16], bias=[0.5,-1.0] =====
    // x (2,3,3) = arange(18), stride 1 -> (2,2,2)
    let conv2 = make_conv2()
    let xm = List.new<Float>()
    let mut xmi = 0
    while xmi < 18 {
        let xv = Int.to_float(value: read xmi)
        pushf(l: mut xm, v: xv)
        xmi = xmi + 1
    }
    let c2shp = List.new<Int>()
    let c2out = List.new<Float>()
    conv2d_forward(layer: read conv2, xdata: read xm, h: 3, wd: 3, out_shape: mut c2shp, out: mut c2out)
    show_shape(label: read "Conv2d mc shape  = ", shape: read c2shp)   // [2, 2, 2]
    show_vec(label: read "Conv2d mc        = ", v: read c2out)
    Log.write(message: read "  tinygrad:        [49.5, 56.5, 70.5, 77.5, 44.0, 52.0, 68.0, 76.0]")

    // ===== BatchNorm inference: sz=3, eps=1e-5 =====
    // running_mean=[1,2,3], running_var=[4,1,9], weight=[2,1,0.5], bias=[0.1,-0.2,0.3]
    // x per-channel = [5, 0, 6]
    let bn = make_bn()
    let xbn = List.new<Float>()
    pushf(l: mut xbn, v: 5.0)
    pushf(l: mut xbn, v: 0.0)
    pushf(l: mut xbn, v: 6.0)
    let bnout = List.new<Float>()
    batchnorm_forward(layer: read bn, xdata: read xbn, out: mut bnout)
    show_vec(label: read "BatchNorm        = ", v: read bnout)
    Log.write(message: read "  tinygrad:        [4.0999951, -2.19999, 0.7999997]")

    // ===== Embedding: vocab=5, dim=3, weight = arange(15)/10, lookup [2,0,4] =====
    let emb = make_emb()
    let idxs = List.new<Int>()
    pushi(l: mut idxs, v: 2)
    pushi(l: mut idxs, v: 0)
    pushi(l: mut idxs, v: 4)
    let eout = List.new<Float>()
    embedding_forward(layer: read emb, idxs: read idxs, out: mut eout)
    show_vec(label: read "Embedding        = ", v: read eout)
    Log.write(message: read "  tinygrad:        [0.6, 0.7, 0.8, 0.0, 0.1, 0.2, 1.2, 1.3, 1.4]")
    return Unit
}
