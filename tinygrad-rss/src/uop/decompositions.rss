fn l2i(cache: mut UOpCache, op: Ops, dt: read DType, a0: Int, a1: Int, b0: Int, b1: Int) -> fresh DecompPair {
    if op == ADD {
        return decomp_pair(lo: mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: a0, y: b0),
                           hi: mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: a1, y: b1))
    }
    if op == SUB {
        return decomp_pair(lo: mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: a0, y: b0),
                           hi: mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: a1, y: b1))
    }
    if op == NEG {
        let z = mk_const_int(cache: mut cache, dt: read dt, v: 0)
        return decomp_pair(lo: mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: z, y: a0),
                           hi: mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: z, y: a1))
    }
    return decomp_pair(lo: a0, hi: a1)
}

