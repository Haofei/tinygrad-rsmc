        }
    }
    match devectorizer_no_vectorized_wmma(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_horizontal_reduce(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_no_vectorized_alu(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_render_const(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_render_gep(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_render_stack(cache: read cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    return None
}

fn _drop_valid_stmts(cache: read UOpCache, valid: Int, idx: Int, height: Int, width: Int) -> fresh List<Int> {
    // The current RSS IR has scalar validity simplification but not ImageDType
    // bounds reasoning, so no image-valid clauses are dropped yet.
    if node_num_src(cache: read cache, id: valid) < 0 {
        local impossible = List.new<Int>()
        return take impossible
    }
    if height < 0 || width < 0 || valid == idx {
        local empty = List.new<Int>()
        return take empty
    }
    local out = List.new<Int>()
    return take out
}

fn simplify_valid_load(cache: mut UOpCache, buf: Int, start_idx: Int, valid: Int) -> Option<Int> {
    let idx = uop_given_valid(cache: mut cache, valid: valid, uop: start_idx, try_simplex: false)
    if idx == start_idx { return None }
    let vidx = uop_valid(cache: mut cache, id: idx, cond: valid)
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read vidx)
    return Some(mk_index(cache: mut cache, base: buf, srcs: read srcs, ptr: true))
}

fn simplify_valid_image_load(cache: mut UOpCache, buf: Int, idx_y: Int, idx_x: Int, valid: Int) -> Option<Int> {
    // ImageDType is not represented in the current dtype model; keep the entry
    // point conservative while preserving the validity simplification callsite.
    if node_num_src(cache: read cache, id: buf) < 0 { return None }
    if buf == idx_y && idx_x == valid { return None }
    return None
}

fn expand_index(cache: mut UOpCache, idx: Int) -> Option<Int> {
    return devectorizer_expand_index_stack(cache: mut cache, id: idx)
}

fn fold_expanded_index(cache: mut UOpCache, midx: Int) -> Option<Int> {
    // Regrouping scattered INDEX lanes into PTRCAT requires root-offset
    // classification that is not yet represented directly in this slice.
    if node_op(cache: read cache, id: midx) != STACK { return None }
    return None
}

fn cat_after_store(cache: mut UOpCache, cat: Int, data: Int) -> Option<Int> {
    if node_op(cache: read cache, id: cat) != PTRCAT { return None }
    local stores = List.new<Int>()
    let mut offset = 0
    let mut i = 0
    while i < node_num_src(cache: read cache, id: cat) {
        let ptr = node_src_id(cache: read cache, id: cat, k: i)
        let cnt = node_full_dtype(cache: read cache, id: ptr).count
        local idxs = List.new<Int>()
        let mut j = 0
        while j < cnt {
            List.push<Int>(list: mut idxs, value: read (offset + j))
            j = j + 1
        }
        let val = mk_gep(cache: mut cache, x: data, idxs: read idxs)
        let st = mk_store(cache: mut cache, ptr: ptr, value: val, gate: read None)
        List.push<Int>(list: mut stores, value: read st)
        offset = offset + cnt
        i = i + 1
    }
    return Some(mk_group(cache: mut cache, srcs: read stores))
}

fn gep_on_store(cache: mut UOpCache, gep: Int, st: Int) -> Option<Int> {
    if node_op(cache: read cache, id: gep) != GEP { return None }
    if node_op(cache: read cache, id: st) != STORE { return None }
    local idxs = node_argints(cache: read cache, id: gep)
    local inv = argsort(x: read idxs)
    let data = node_src_id(cache: read cache, id: st, k: 1)
    let ndata = mk_gep(cache: mut cache, x: data, idxs: read inv)
    let base = node_src_id(cache: read cache, id: gep, k: 0)
    return Some(devectorizer_store_with_ptr_value(cache: mut cache, id: st, ptr: base, value: ndata))
}

fn devectorizer_index_base_for_split(cache: read UOpCache, ptr: Int) -> Int {
    if node_op(cache: read cache, id: ptr) == INDEX { return ptr }
    if node_op(cache: read cache, id: ptr) == CAST && node_num_src(cache: read cache, id: ptr) == 1 {
        let inner = node_src_id(cache: read cache, id: ptr, k: 0)
        if node_op(cache: read cache, id: inner) == INDEX { return inner }
    }
    return 0 - 1
}

fn split_load_store(cache: mut UOpCache, ls: Int, idx: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: ls)
    if op != LOAD && op != STORE { return None }
    let ptr0 = node_src_id(cache: read cache, id: ls, k: 0)
    let sz = node_full_dtype(cache: read cache, id: ptr0).count
    if sz <= 1 { return None }
    if node_op(cache: read cache, id: idx) != INDEX || node_num_src(cache: read cache, id: idx) < 2 { return None }
    let buf = node_src_id(cache: read cache, id: idx, k: 0)
    let off = node_src_id(cache: read cache, id: idx, k: 1)
    local pieces = List.new<Int>()
    let mut lane = 0
    while lane < sz {
        let c = mk_const_int(cache: mut cache, dt: read node_dtype(cache: read cache, id: off), v: lane)
        let noff = mk_alu2(cache: mut cache, op: ADD, dt: read node_dtype(cache: read cache, id: off), x: off, y: c)
        local isrcs = List.new<Int>()
        List.push<Int>(list: mut isrcs, value: read noff)
        let ptr = mk_index(cache: mut cache, base: buf, srcs: read isrcs, ptr: true)
        if op == LOAD {
            let ldt = dtype_scalar(d: read node_full_dtype(cache: read cache, id: ls))
            local extras = List.new<Int>()
            let mut extra_i = 1
            while extra_i < node_num_src(cache: read cache, id: ls) {
                List.push<Int>(list: mut extras, value: read node_src_id(cache: read cache, id: ls, k: extra_i))
                extra_i = extra_i + 1
            }
            List.push<Int>(list: mut pieces, value: read mk_load(cache: mut cache, ptr: ptr, srcs: read extras, dt: read ldt))
        } else {
            let data = node_src_id(cache: read cache, id: ls, k: 1)
            local one = List.new<Int>()
            List.push<Int>(list: mut one, value: read lane)
            let val = mk_gep(cache: mut cache, x: data, idxs: read one)
            if node_num_src(cache: read cache, id: ls) >= 3 {
                List.push<Int>(list: mut pieces, value: read mk_store(cache: mut cache, ptr: ptr, value: val, gate: read Some(node_src_id(cache: read cache, id: ls, k: 2))))
            } else {
                List.push<Int>(list: mut pieces, value: read mk_store(cache: mut cache, ptr: ptr, value: val, gate: read None))
            }
        }
        lane = lane + 1
    }
    if op == LOAD { return Some(mk_vcat(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: ls), srcs: read pieces)) }
    return Some(mk_group(cache: mut cache, srcs: read pieces))
}

fn get_image_idx(cache: mut UOpCache, idx: Int, width: Int) -> Option<Int> {
    if width <= 0 || node_op(cache: read cache, id: idx) != INDEX { return None }
    return None
}

fn image_fixup(cache: mut UOpCache, ls: Int) -> Option<Int> {
    if node_op(cache: read cache, id: ls) != LOAD && node_op(cache: read cache, id: ls) != STORE { return None }
    return None
}

fn no_vectorized_wmma(cache: mut UOpCache, wmma: Int) -> Option<Int> {
