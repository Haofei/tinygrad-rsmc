// Integrated source-shaped slice of tinygrad/codegen/simplify.py.
//
// The upstream file is mostly PatternMatcher composition. This port exposes the
// source-shaped helper names over the current cache-backed graph_rewrite,
// range, and reduction primitives.
features: local

struct SimplifySubst derives(Clone) {
    olds: List<Int>,
    news: List<Int>,
}

fn simplify_empty_subst() -> fresh SimplifySubst {
    local olds = List.new<Int>()
    local news = List.new<Int>()
    return SimplifySubst(olds: take olds, news: take news)
}

fn simplify_subst_put(ctx: mut SimplifySubst, old_id: Int, new_id: Int) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read ctx.olds) {
        if List.get<Int>(list: read ctx.olds, index: i) == old_id {
            List.set<Int>(list: mut ctx.news, index: i, value: read new_id)
            return Unit
        }
        i = i + 1
    }
    List.push<Int>(list: mut ctx.olds, value: read old_id)
    List.push<Int>(list: mut ctx.news, value: read new_id)
    return Unit
}

fn simplify_subst_find(ctx: read SimplifySubst, old_id: Int) -> Int {
    let mut i = 0
    while i < List.len<Int>(list: read ctx.olds) {
        if List.get<Int>(list: read ctx.olds, index: i) == old_id { return i }
        i = i + 1
    }
    return -1
}

fn simplify_subst_put_guard_bound(cache: read UOpCache, ctx: mut SimplifySubst, r: Int, bound: Int) -> Unit {
    let found = simplify_subst_find(ctx: read ctx, old_id: r)
    if found < 0 {
        simplify_subst_put(ctx: mut ctx, old_id: r, new_id: bound)
        return Unit
    }
    let old_bound = List.get<Int>(list: read ctx.news, index: found)
    if node_is_const_int(cache: read cache, id: old_bound) && node_is_const_int(cache: read cache, id: bound) {
        if node_const_int(cache: read cache, id: bound) > node_const_int(cache: read cache, id: old_bound) {
            List.set<Int>(list: mut ctx.news, index: found, value: read bound)
        }
        return Unit
    }
    List.set<Int>(list: mut ctx.news, index: found, value: read bound)
    return Unit
}

fn simplify_ranges_from_toposort(cache: read UOpCache, ids: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read ids) {
        local topo = uop_toposort(cache: read cache, id: List.get<Int>(list: read ids, index: i))
        let mut j = 0
        while j < List.len<Int>(list: read topo) {
            let u = List.get<Int>(list: read topo, index: j)
            if node_op(cache: read cache, id: u) == RANGE {
                uop_push_unique(vals: mut out, v: u)
            }
            j = j + 1
        }
        i = i + 1
    }
    return take out
}

fn flatten_range(cache: mut UOpCache, r: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: r)
    if op != REDUCE && op != END { return None }
    let off = uop_range_start_index(op: read op)
    if off < 0 || node_num_src(cache: read cache, id: r) <= off { return None }
    local front = List.new<Int>()
    let mut i = 0
    while i < off {
        List.push<Int>(list: mut front, value: read node_src_id(cache: read cache, id: r, k: i))
        i = i + 1
    }
    local tails = List.new<Int>()
    i = off
    while i < node_num_src(cache: read cache, id: r) {
        List.push<Int>(list: mut tails, value: read node_src_id(cache: read cache, id: r, k: i))
        i = i + 1
    }
    local flat = simplify_ranges_from_toposort(cache: read cache, ids: read tails)
    if List.len<Int>(list: read flat) == 0 { return None }
    local src = copy_int_list(l: read front)
    i = 0
    while i < List.len<Int>(list: read flat) {
        List.push<Int>(list: mut src, value: read List.get<Int>(list: read flat, index: i))
        i = i + 1
    }
    local arg = node_arg(cache: read cache, id: r)
    return Some(intern(cache: mut cache, op: op, dt: read node_full_dtype(cache: read cache, id: r), src: take src, arg: take arg))
}

fn count_divmod(cache: read UOpCache, x: Int) -> Int {
    local topo = uop_toposort(cache: read cache, id: x)
    let mut out = 0
    let mut i = 0
    while i < List.len<Int>(list: read topo) {
        let op = node_op(cache: read cache, id: List.get<Int>(list: read topo, index: i))
        if op == FLOORDIV || op == FLOORMOD { out = out + 1 }
        i = i + 1
    }
    return out
}

fn simplify_merge_adjacent(cache: mut UOpCache, u: Int) -> Option<Int> {
    let rewritten = graph_rewrite(cache: mut cache, id: u)
    match flatten_range(cache: mut cache, r: rewritten) {
        Some(flat) => {
            if count_divmod(cache: read cache, x: flat) <= count_divmod(cache: read cache, x: u) { return Some(flat) }
            return Some(rewritten)
        }
        None => {
            if rewritten != u { return Some(rewritten) }
        }
    }
    return None
}

fn simplify_single_range_expr(cache: read UOpCache, x: Int) -> Int {
    if node_op(cache: read cache, id: x) == RANGE { return x }
    if node_op(cache: read cache, id: x) == CAST && node_num_src(cache: read cache, id: x) == 1 {
        let child = node_src_id(cache: read cache, id: x, k: 0)
        if node_op(cache: read cache, id: child) == RANGE { return child }
    }
    return -1
}

fn simplify_mark_guard_clause(cache: read UOpCache, ctx: mut SimplifySubst, guarded: mut List<Int>, clause: Int) -> Unit {
    if node_op(cache: read cache, id: clause) != CMPLT || node_num_src(cache: read cache, id: clause) != 2 { return Unit }
    let lhs = node_src_id(cache: read cache, id: clause, k: 0)
    let rhs = node_src_id(cache: read cache, id: clause, k: 1)
    if node_is_const_int(cache: read cache, id: rhs) == false { return Unit }
    let r = simplify_single_range_expr(cache: read cache, x: lhs)
    if r < 0 { return Unit }
    simplify_subst_put_guard_bound(cache: read cache, ctx: mut ctx, r: r, bound: rhs)
    uop_push_unique(vals: mut guarded, v: r)
    return Unit
}

fn simplify_mark_valid_guards(cache: read UOpCache, ctx: mut SimplifySubst, valid: Int) -> fresh List<Int> {
    local guarded = List.new<Int>()
    local clauses = uop_split_by_op(cache: read cache, id: valid, sep: AND)
    let mut i = 0
    while i < List.len<Int>(list: read clauses) {
        simplify_mark_guard_clause(cache: read cache, ctx: mut ctx, guarded: mut guarded, clause: List.get<Int>(list: read clauses, index: i))
        i = i + 1
    }
    return take guarded
}

fn mark_gated(cache: mut UOpCache, ctx: mut SimplifySubst, idx: Int) -> Unit {
    if node_op(cache: read cache, id: idx) != INDEX { return Unit }
    let mut si = 1
    while si < node_num_src(cache: read cache, id: idx) {
        let raw = node_src_id(cache: read cache, id: idx, k: si)
        let x = uop_get_idx(cache: read cache, id: raw)
        let valid = uop_get_valid(cache: mut cache, id: raw)
        local guarded = simplify_mark_valid_guards(cache: read cache, ctx: mut ctx, valid: valid)
        local ranges = uop_ranges(cache: read cache, id: x)
        let mut i = 0
        while i < List.len<Int>(list: read ranges) {
            let r = List.get<Int>(list: read ranges, index: i)
            if uop_ints_contains(vals: read guarded, v: r) == false && node_num_src(cache: read cache, id: r) > 0 {
                simplify_subst_put(ctx: mut ctx, old_id: r, new_id: node_src_id(cache: read cache, id: r, k: 0))
            }
            i = i + 1
        }
        si = si + 1
    }
    return Unit
}

fn mark_range_mod(cache: mut UOpCache, ctx: mut SimplifySubst, r: Int, c: Int) -> Unit {
    if node_op(cache: read cache, id: r) != RANGE { return Unit }
    if node_range_type(cache: read cache, id: r) == AXIS_WARP { return Unit }
    if node_num_src(cache: read cache, id: r) == 0 { return Unit }
    let rend = node_src_id(cache: read cache, id: r, k: 0)
    if node_is_const_int(cache: read cache, id: rend) == false { return Unit }
    if node_is_const_int(cache: read cache, id: c) == false { return Unit }
    let rv = node_const_int(cache: read cache, id: rend)
    let cv = node_const_int(cache: read cache, id: c)
    if cv != 0 && rv % cv == 0 { simplify_subst_put(ctx: mut ctx, old_id: r, new_id: c) }
    return Unit
}

fn simplify_range_extra_with_marker(cache: read UOpCache, r: Int, marker: Int) -> fresh List<Int> {
    local axes = node_range_axes(cache: read cache, id: r)
    local extra = List.new<Int>()
    let mut i = 1
    while i < List.len<Int>(list: read axes) {
        List.push<Int>(list: mut extra, value: read List.get<Int>(list: read axes, index: i))
        i = i + 1
    }
    List.push<Int>(list: mut extra, value: read marker)
    return take extra
}

fn simplify_split_range_replacement(cache: mut UOpCache, r: Int, c: Int) -> Int {
    if node_op(cache: read cache, id: r) != RANGE || node_num_src(cache: read cache, id: r) == 0 { return c }
    let rend = node_src_id(cache: read cache, id: r, k: 0)
    let dt = node_dtype(cache: read cache, id: r)
    let hi_end_raw = mk_alu2(cache: mut cache, op: FLOORDIV, dt: read dt, x: rend, y: c)
    let hi_end = graph_rewrite(cache: mut cache, id: hi_end_raw)
    let axis_id = node_range_axis_id(cache: read cache, id: r)
    local hi_extra = simplify_range_extra_with_marker(cache: read cache, r: r, marker: 0)
    local lo_extra = simplify_range_extra_with_marker(cache: read cache, r: r, marker: 1)
    let hi = mk_range(cache: mut cache, end: hi_end, axis_id: axis_id, axis_type: read node_range_type(cache: read cache, id: r), extra_axes: read hi_extra, dt: read dt)
    let lo = mk_range(cache: mut cache, end: c, axis_id: axis_id, axis_type: read node_range_type(cache: read cache, id: r), extra_axes: read lo_extra, dt: read dt)
    let scaled_hi = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: hi, y: c)
    return mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: scaled_hi, y: lo)
}

fn do_split_ranges(cache: mut UOpCache, ctx: mut SimplifySubst, x: Int) -> Option<Int> {
    if List.len<Int>(list: read ctx.olds) == 0 { return None }
    local replacements = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read ctx.olds) {
        let old_id = List.get<Int>(list: read ctx.olds, index: i)
        let new_id = List.get<Int>(list: read ctx.news, index: i)
        List.push<Int>(list: mut replacements, value: read simplify_split_range_replacement(cache: mut cache, r: old_id, c: new_id))
        i = i + 1
    }
    let ret = memory_replace_many(cache: mut cache, id: x, olds: read ctx.olds, news: read replacements)
    ctx.olds = List.new<Int>()
    ctx.news = List.new<Int>()
    if ret == x { return None }
    return Some(graph_rewrite(cache: mut cache, id: ret))
}

fn do_substitute(cache: mut UOpCache, ctx: mut SimplifySubst, x: Int) -> Option<Int> {
    if List.len<Int>(list: read ctx.olds) == 0 { return None }
    let ret = memory_replace_many(cache: mut cache, id: x, olds: read ctx.olds, news: read ctx.news)
    ctx.olds = List.new<Int>()
    ctx.news = List.new<Int>()
    if ret == x { return None }
    return Some(graph_rewrite(cache: mut cache, id: ret))
}

fn no_range(cache: read UOpCache, u: Int) -> Bool {
    return uop_op_in_backward_slice_with_self(cache: read cache, id: u, op: RANGE) == false
}

fn simplify_ignores_generic_placeholder(op: Ops) -> Bool {
    return op == CONST || op == PARAM || op == DEFINE_LOCAL || op == DEFINE_VAR
}

fn simplify_node_uses_range(cache: read UOpCache, id: Int, r: Int) -> Bool {
    local ranges = uop_ranges(cache: read cache, id: id)
    return uop_ints_contains(vals: read ranges, v: r)
}

fn simplify_toposort_with_range(cache: read UOpCache, id: Int, r: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    local topo = uop_toposort(cache: read cache, id: id)
    let mut i = 0
    while i < List.len<Int>(list: read topo) {
        let node = List.get<Int>(list: read topo, index: i)
        if simplify_node_uses_range(cache: read cache, id: node, r: r) {
            List.push<Int>(list: mut out, value: read node)
        }
        i = i + 1
    }
    return take out
}

fn simplify_has_blocking_collapse_op(cache: read UOpCache, ids: read List<Int>) -> Bool {
    let mut i = 0
    while i < List.len<Int>(list: read ids) {
        let op = node_op(cache: read cache, id: List.get<Int>(list: read ids, index: i))
        if op == STORE || op == REDUCE { return true }
        i = i + 1
    }
    return false
}

fn simplify_collect_external_placeholders(cache: mut UOpCache, included: read List<Int>, olds: mut List<Int>, news: mut List<Int>) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read included) {
        let node = List.get<Int>(list: read included, index: i)
        let mut si = 0
        while si < node_num_src(cache: read cache, id: node) {
            let s = node_src_id(cache: read cache, id: node, k: si)
            if uop_ints_contains(vals: read included, v: s) == false && uop_ints_contains(vals: read olds, v: s) == false && simplify_ignores_generic_placeholder(op: node_op(cache: read cache, id: s)) == false {
                let nm = String.concat(left: read "in", right: read Int.to_string(value: read List.len<Int>(list: read olds)))
                let fake = uop_variable(cache: mut cache, name: read nm, min_val: uop_vmin(cache: read cache, id: s), max_val: uop_vmax(cache: read cache, id: s), dt: read node_dtype(cache: read cache, id: s))
                List.push<Int>(list: mut olds, value: read s)
                List.push<Int>(list: mut news, value: read fake)
            }
            si = si + 1
        }
        i = i + 1
    }
    return Unit
}

fn simplify_reduce_pattern_collapse(cache: mut UOpCache, red: Int) -> Option<Int> {
    match simplify_reduce_distribute_add(cache: mut cache, red: red) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match simplify_reduce_and_where(cache: mut cache, red: red) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match simplify_reduce_mul_casted_bool(cache: mut cache, red: red) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match reduce_bound_collapse(cache: mut cache, red: red) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match reduce_unparented(cache: mut cache, red: red) {
        Some(r) => { return Some(r) }
        None => {}
    }
    return None
}

fn simplify_generic_reduce_collapse(cache: mut UOpCache, red: Int, u: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE { return None }
    let mut cur = u
    let mut changed = false
    let mut ri = 1
    while ri < node_num_src(cache: read cache, id: red) {
        let r = node_src_id(cache: read cache, id: red, k: ri)
        if node_op(cache: read cache, id: r) == RANGE {
            local included = simplify_toposort_with_range(cache: read cache, id: cur, r: r)
            if List.len<Int>(list: read included) > 0 {
                if simplify_has_blocking_collapse_op(cache: read cache, ids: read included) { return None }
                local olds = List.new<Int>()
                local news = List.new<Int>()
                simplify_collect_external_placeholders(cache: mut cache, included: read included, olds: mut olds, news: mut news)
                let subbed = memory_replace_many(cache: mut cache, id: cur, olds: read olds, news: read news)
                local one_range = List.new<Int>()
                List.push<Int>(list: mut one_range, value: read r)
                let collapse_fxn = simplify_reduce_with_srcs(cache: mut cache, red: red, value: subbed, ranges: read one_range)
                match simplify_reduce_pattern_collapse(cache: mut cache, red: collapse_fxn) {
                    Some(sink) => {
                        if no_range(cache: read cache, u: sink) == false { return None }
                        let restored = memory_replace_many(cache: mut cache, id: sink, olds: read news, news: read olds)
                        cur = graph_rewrite(cache: mut cache, id: restored)
                        changed = true
                    }
                    None => {}
                }
            }
        }
        ri = ri + 1
    }
    if changed { return Some(cur) }
    return None
}

fn simplify_range_in_list(items: read List<Int>, v: Int) -> Bool {
    let mut i = 0
    while i < List.len<Int>(list: read items) {
        if List.get<Int>(list: read items, index: i) == v { return true }
        i = i + 1
    }
    return false
}

fn simplify_reduce_with_srcs(cache: mut UOpCache, red: Int, value: Int, ranges: read List<Int>) -> Int {
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read value)
    let mut i = 0
    while i < List.len<Int>(list: read ranges) {
        List.push<Int>(list: mut src, value: read List.get<Int>(list: read ranges, index: i))
        i = i + 1
    }
    local arg = node_arg(cache: read cache, id: red)
    return intern(cache: mut cache, op: REDUCE, dt: read node_full_dtype(cache: read cache, id: red), src: take src, arg: take arg)
}

fn reduce_unparented(cache: mut UOpCache, red: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE || node_num_src(cache: read cache, id: red) == 0 { return None }
    let rop = node_arg_op(cache: read cache, id: red)
    if rop != ADD && rop != MAX && rop != MUL { return None }
    let value = node_src_id(cache: read cache, id: red, k: 0)
    local value_ranges = uop_ranges(cache: read cache, id: value)
    local parented = List.new<Int>()
    local unparented = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: red) {
        let r = node_src_id(cache: read cache, id: red, k: i)
        if simplify_range_in_list(items: read value_ranges, v: r) {
            List.push<Int>(list: mut parented, value: read r)
        } else {
            List.push<Int>(list: mut unparented, value: read r)
        }
        i = i + 1
    }
    if List.len<Int>(list: read unparented) == 0 { return None }
    let mut ret = value
    let rdt = node_full_dtype(cache: read cache, id: red)
    let vdt = node_full_dtype(cache: read cache, id: value)
    if List.len<Int>(list: read parented) > 0 || rdt.name != vdt.name || rdt.count != vdt.count {
        ret = simplify_reduce_with_srcs(cache: mut cache, red: red, value: value, ranges: read parented)
    }
    if rop == ADD {
        i = 0
        while i < List.len<Int>(list: read unparented) {
            let r = List.get<Int>(list: read unparented, index: i)
            if node_num_src(cache: read cache, id: r) > 0 {
                let sz = node_src_id(cache: read cache, id: r, k: 0)
                let csz = mk_cast(cache: mut cache, x: sz, dt: read node_dtype(cache: read cache, id: ret))
                ret = mk_alu2(cache: mut cache, op: MUL, dt: read node_full_dtype(cache: read cache, id: ret), x: ret, y: csz)
            }
            i = i + 1
        }
    }
    if rop == MUL {
        i = 0
        while i < List.len<Int>(list: read unparented) {
            let r = List.get<Int>(list: read unparented, index: i)
            if node_num_src(cache: read cache, id: r) > 0 {
                let sz = node_src_id(cache: read cache, id: r, k: 0)
                let csz = mk_cast(cache: mut cache, x: sz, dt: read node_dtype(cache: read cache, id: ret))
                ret = mk_alu2(cache: mut cache, op: POW, dt: read node_full_dtype(cache: read cache, id: ret), x: ret, y: csz)
            }
            i = i + 1
        }
    }
    return Some(graph_rewrite(cache: mut cache, id: ret))
}

fn reduce_collapse(cache: mut UOpCache, red: Int, u: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE { return None }
    if no_range(cache: read cache, u: u) { return Some(graph_rewrite(cache: mut cache, id: u)) }
    match simplify_generic_reduce_collapse(cache: mut cache, red: red, u: u) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match simplify_reduce_pattern_collapse(cache: mut cache, red: red) {
        Some(r) => { return Some(r) }
        None => {}
    }
    return None
}

fn simplify_is_true_const(cache: read UOpCache, id: Int) -> Bool {
    if node_op(cache: read cache, id: id) != CONST { return false }
    if node_is_const_int(cache: read cache, id: id) { return node_const_int(cache: read cache, id: id) != 0 }
    return node_const_float(cache: read cache, id: id) != 0.0
}

fn simplify_reduce_is_add(cache: read UOpCache, red: Int) -> Bool {
    let rop = node_arg_op(cache: read cache, id: red)
    if rop == ADD { return true }
    if rop != NOOP { return false }
    return node_reduce_kind(cache: read cache, id: red) == 0
}

fn simplify_is_zero_const(cache: read UOpCache, id: Int) -> Bool {
    if node_op(cache: read cache, id: id) != CONST { return false }
    if node_is_const_int(cache: read cache, id: id) { return node_const_int(cache: read cache, id: id) == 0 }
    return node_const_float(cache: read cache, id: id) == 0.0
}

fn simplify_strip_cast(cache: read UOpCache, id: Int) -> Int {
    if node_op(cache: read cache, id: id) == CAST && node_num_src(cache: read cache, id: id) == 1 {
        return node_src_id(cache: read cache, id: id, k: 0)
    }
    return id
}

fn simplify_lift_add_compare(cache: mut UOpCache, cmp: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: cmp)
    if (op != CMPLT && op != CMPNE) || node_num_src(cache: read cache, id: cmp) != 2 { return None }
    let lhs0 = simplify_strip_cast(cache: read cache, id: node_src_id(cache: read cache, id: cmp, k: 0))
    let c = node_src_id(cache: read cache, id: cmp, k: 1)
    if node_op(cache: read cache, id: lhs0) != ADD || node_num_src(cache: read cache, id: lhs0) != 2 { return None }
    if no_range(cache: read cache, u: c) == false { return None }
    let a = node_src_id(cache: read cache, id: lhs0, k: 0)
    let b = node_src_id(cache: read cache, id: lhs0, k: 1)
    if no_range(cache: read cache, u: b) {
        let cdt = node_dtype(cache: read cache, id: c)
        let bc = mk_cast(cache: mut cache, x: b, dt: read cdt)
        let rhs = mk_alu2(cache: mut cache, op: SUB, dt: read cdt, x: c, y: bc)
        return Some(mk_alu2(cache: mut cache, op: op, dt: read dt_bool(), x: a, y: rhs))
    }
    if no_range(cache: read cache, u: a) {
        let cdt = node_dtype(cache: read cache, id: c)
        let ac = mk_cast(cache: mut cache, x: a, dt: read cdt)
        let rhs = mk_alu2(cache: mut cache, op: SUB, dt: read cdt, x: c, y: ac)
        return Some(mk_alu2(cache: mut cache, op: op, dt: read dt_bool(), x: b, y: rhs))
    }
    return None
}

fn simplify_lift_mul_lt(cache: mut UOpCache, cmp: Int) -> Option<Int> {
    if node_op(cache: read cache, id: cmp) != CMPLT || node_num_src(cache: read cache, id: cmp) != 2 { return None }
    let lhs0 = simplify_strip_cast(cache: read cache, id: node_src_id(cache: read cache, id: cmp, k: 0))
    let c = node_src_id(cache: read cache, id: cmp, k: 1)
    if node_op(cache: read cache, id: lhs0) != MUL || node_num_src(cache: read cache, id: lhs0) != 2 { return None }
    if no_range(cache: read cache, u: c) == false { return None }
    let a = node_src_id(cache: read cache, id: lhs0, k: 0)
    let b = node_src_id(cache: read cache, id: lhs0, k: 1)
    let mut x = a
    let mut y = b
    if no_range(cache: read cache, u: y) == false && no_range(cache: read cache, u: x) {
        x = b
        y = a
    }
    if no_range(cache: read cache, u: y) == false { return None }
    if dtype_is_int(d: read node_dtype(cache: read cache, id: y)) == false { return None }
    if uop_vmin(cache: read cache, id: y) <= 0 { return None }
    let cdt = node_dtype(cache: read cache, id: c)
    let yc = mk_cast(cache: mut cache, x: y, dt: read cdt)
    let c_plus_y = mk_alu2(cache: mut cache, op: ADD, dt: read cdt, x: c, y: yc)
    let one = mk_const_int(cache: mut cache, dt: read cdt, v: 1)
    let numerator = mk_alu2(cache: mut cache, op: SUB, dt: read cdt, x: c_plus_y, y: one)
    let rhs = mk_alu2(cache: mut cache, op: FLOORDIV, dt: read cdt, x: numerator, y: yc)
    return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: x, y: rhs))
}

fn simplify_lift_compare(cache: mut UOpCache, cmp: Int) -> Int {
    match simplify_lift_add_compare(cache: mut cache, cmp: cmp) {
        Some(v) => { return graph_rewrite(cache: mut cache, id: v) }
        None => {}
    }
    match simplify_lift_mul_lt(cache: mut cache, cmp: cmp) {
        Some(v) => { return graph_rewrite(cache: mut cache, id: v) }
        None => {}
    }
    return cmp
}

fn simplify_range_lt_cut(cache: read UOpCache, cond: Int, r: Int) -> Int {
    if node_op(cache: read cache, id: cond) != CMPLT || node_num_src(cache: read cache, id: cond) != 2 { return -1 }
    if simplify_single_range_expr(cache: read cache, x: node_src_id(cache: read cache, id: cond, k: 0)) != r { return -1 }
    return node_src_id(cache: read cache, id: cond, k: 1)
}

fn simplify_not_range_lt_cut(cache: read UOpCache, cond: Int, r: Int) -> Int {
    if node_op(cache: read cache, id: cond) != CMPNE || node_num_src(cache: read cache, id: cond) != 2 { return -1 }
    let lhs = node_src_id(cache: read cache, id: cond, k: 0)
    let rhs = node_src_id(cache: read cache, id: cond, k: 1)
    if simplify_is_true_const(cache: read cache, id: rhs) { return simplify_range_lt_cut(cache: read cache, cond: lhs, r: r) }
    if simplify_is_true_const(cache: read cache, id: lhs) { return simplify_range_lt_cut(cache: read cache, cond: rhs, r: r) }
    return -1
}

fn simplify_clamp_to_range(cache: mut UOpCache, x: Int, r: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    let zero = mk_const_int(cache: mut cache, dt: read dt, v: 0)
    let lo = smax(cache: mut cache, a: x, b: zero)
    let end = mk_cast(cache: mut cache, x: node_src_id(cache: read cache, id: r, k: 0), dt: read dt)
    return smin(cache: mut cache, a: lo, b: end)
}

fn simplify_reduce_count_times_value(cache: mut UOpCache, count: Int, r: Int, val: Int) -> Option<Int> {
    if no_range(cache: read cache, u: val) == false { return None }
    let clamped = simplify_clamp_to_range(cache: mut cache, x: count, r: r)
    let cval = mk_cast(cache: mut cache, x: clamped, dt: read node_dtype(cache: read cache, id: val))
    let mul = mk_alu2(cache: mut cache, op: MUL, dt: read node_full_dtype(cache: read cache, id: val), x: cval, y: val)
    return Some(graph_rewrite(cache: mut cache, id: mul))
}

fn simplify_rebuild_reduce_value(cache: mut UOpCache, red: Int, value: Int) -> Int {
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read value)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: red) {
        List.push<Int>(list: mut src, value: read node_src_id(cache: read cache, id: red, k: i))
        i = i + 1
    }
    local arg = node_arg(cache: read cache, id: red)
    return intern(cache: mut cache, op: REDUCE, dt: read node_full_dtype(cache: read cache, id: value), src: take src, arg: take arg)
}

fn simplify_reduce_distribute_add(cache: mut UOpCache, red: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE || simplify_reduce_is_add(cache: read cache, red: red) == false { return None }
    if node_num_src(cache: read cache, id: red) < 2 { return None }
    let value = node_src_id(cache: read cache, id: red, k: 0)
    if node_op(cache: read cache, id: value) != ADD || node_num_src(cache: read cache, id: value) != 2 { return None }
    let x = node_src_id(cache: read cache, id: value, k: 0)
    let y = node_src_id(cache: read cache, id: value, k: 1)
    let rx_raw = simplify_rebuild_reduce_value(cache: mut cache, red: red, value: x)
    let mut rx = rx_raw
    match simplify_reduce_pattern_collapse(cache: mut cache, red: rx_raw) {
        Some(v) => { rx = v }
        None => { rx = graph_rewrite(cache: mut cache, id: rx_raw) }
    }
    let ry_raw = simplify_rebuild_reduce_value(cache: mut cache, red: red, value: y)
    let mut ry = ry_raw
    match simplify_reduce_pattern_collapse(cache: mut cache, red: ry_raw) {
        Some(v) => { ry = v }
        None => { ry = graph_rewrite(cache: mut cache, id: ry_raw) }
    }
    let out_dt = node_full_dtype(cache: read cache, id: value)
    let add = mk_alu2(cache: mut cache, op: ADD, dt: read out_dt, x: rx, y: ry)
    return Some(graph_rewrite(cache: mut cache, id: add))
}

fn simplify_reduce_and_where(cache: mut UOpCache, red: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE || simplify_reduce_is_add(cache: read cache, red: red) == false { return None }
    if node_num_src(cache: read cache, id: red) < 2 { return None }
    let value = node_src_id(cache: read cache, id: red, k: 0)
    if node_op(cache: read cache, id: value) != WHERE || node_num_src(cache: read cache, id: value) != 3 { return None }
    let cond = node_src_id(cache: read cache, id: value, k: 0)
    let c = node_src_id(cache: read cache, id: value, k: 1)
    let fval = node_src_id(cache: read cache, id: value, k: 2)
    if simplify_is_zero_const(cache: read cache, id: fval) == false { return None }
    if node_op(cache: read cache, id: cond) != AND || node_num_src(cache: read cache, id: cond) != 2 { return None }
    let a = node_src_id(cache: read cache, id: cond, k: 0)
    let b = node_src_id(cache: read cache, id: cond, k: 1)
    let mut x = a
    let mut y = b
    if node_op(cache: read cache, id: x) != DEFINE_VAR && node_op(cache: read cache, id: y) == DEFINE_VAR {
        x = b
        y = a
    }
    if node_op(cache: read cache, id: x) != DEFINE_VAR { return None }
    let inner_dt = node_full_dtype(cache: read cache, id: c)
    let inner = mk_where(cache: mut cache, dt: read inner_dt, cond: y, tval: c, fval: fval)
    let rinner = simplify_rebuild_reduce_value(cache: mut cache, red: red, value: inner)
    let xcast_dt = node_dtype(cache: read cache, id: c)
    let xcast = mk_cast(cache: mut cache, x: x, dt: read xcast_dt)
    let out_dt = node_full_dtype(cache: read cache, id: c)
    let out = mk_alu2(cache: mut cache, op: MUL, dt: read out_dt, x: rinner, y: xcast)
    return Some(graph_rewrite(cache: mut cache, id: out))
}

fn simplify_mul_casted_bool(cache: mut UOpCache, value: Int) -> Option<Int> {
    if node_op(cache: read cache, id: value) != MUL || node_num_src(cache: read cache, id: value) != 2 { return None }
    let a = node_src_id(cache: read cache, id: value, k: 0)
    let b = node_src_id(cache: read cache, id: value, k: 1)
    let mut x = a
    let mut gate_cast = b
    if node_op(cache: read cache, id: gate_cast) != CAST && node_op(cache: read cache, id: x) == CAST {
        x = b
        gate_cast = a
    }
    if node_op(cache: read cache, id: gate_cast) != CAST || node_num_src(cache: read cache, id: gate_cast) != 1 { return None }
    let gate = node_src_id(cache: read cache, id: gate_cast, k: 0)
    if dtype_is_bool(d: read node_dtype(cache: read cache, id: gate)) == false { return None }
    let zero_dt = node_dtype(cache: read cache, id: x)
    let zero = mk_const_int(cache: mut cache, dt: read zero_dt, v: 0)
    let out_dt = node_full_dtype(cache: read cache, id: x)
    return Some(mk_where(cache: mut cache, dt: read out_dt, cond: gate, tval: x, fval: zero))
}

fn simplify_reduce_mul_casted_bool(cache: mut UOpCache, red: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE { return None }
    if node_num_src(cache: read cache, id: red) < 2 { return None }
    let value = node_src_id(cache: read cache, id: red, k: 0)
    match simplify_mul_casted_bool(cache: mut cache, value: value) {
        Some(v) => {
            let new_red = simplify_rebuild_reduce_value(cache: mut cache, red: red, value: v)
            match reduce_bound_collapse(cache: mut cache, red: new_red) {
                Some(r) => { return Some(r) }
                None => { return Some(graph_rewrite(cache: mut cache, id: new_red)) }
            }
        }
        None => {}
    }
    return None
}

fn reduce_bound_collapse(cache: mut UOpCache, red: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE || simplify_reduce_is_add(cache: read cache, red: red) == false { return None }
    if node_num_src(cache: read cache, id: red) < 2 { return None }
    let value = node_src_id(cache: read cache, id: red, k: 0)
    if node_op(cache: read cache, id: value) != WHERE || node_num_src(cache: read cache, id: value) != 3 { return None }
    let cond = node_src_id(cache: read cache, id: value, k: 0)
    let tval = node_src_id(cache: read cache, id: value, k: 1)
    let fval = node_src_id(cache: read cache, id: value, k: 2)
    let norm_cond = simplify_lift_compare(cache: mut cache, cmp: cond)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: red) {
        let r = node_src_id(cache: read cache, id: red, k: i)
        if node_op(cache: read cache, id: r) == RANGE && node_num_src(cache: read cache, id: r) > 0 {
            let cut = simplify_range_lt_cut(cache: read cache, cond: norm_cond, r: r)
            if cut >= 0 && simplify_is_zero_const(cache: read cache, id: fval) {
                return simplify_reduce_count_times_value(cache: mut cache, count: cut, r: r, val: tval)
            }
            if cut >= 0 && simplify_is_zero_const(cache: read cache, id: tval) {
                let end = mk_cast(cache: mut cache, x: node_src_id(cache: read cache, id: r, k: 0), dt: read node_dtype(cache: read cache, id: cut))
                let count = mk_alu2(cache: mut cache, op: SUB, dt: read node_dtype(cache: read cache, id: cut), x: end, y: cut)
                return simplify_reduce_count_times_value(cache: mut cache, count: count, r: r, val: fval)
            }
            if node_op(cache: read cache, id: norm_cond) == AND && node_num_src(cache: read cache, id: norm_cond) == 2 && simplify_is_zero_const(cache: read cache, id: fval) {
                let c0 = node_src_id(cache: read cache, id: norm_cond, k: 0)
                let c1 = node_src_id(cache: read cache, id: norm_cond, k: 1)
                let mut lower = simplify_not_range_lt_cut(cache: read cache, cond: c0, r: r)
                let mut upper = simplify_range_lt_cut(cache: read cache, cond: c1, r: r)
                if lower < 0 || upper < 0 {
                    lower = simplify_not_range_lt_cut(cache: read cache, cond: c1, r: r)
                    upper = simplify_range_lt_cut(cache: read cache, cond: c0, r: r)
                }
                if lower >= 0 && upper >= 0 {
                    let dt = node_dtype(cache: read cache, id: upper)
                    let end = mk_cast(cache: mut cache, x: node_src_id(cache: read cache, id: r, k: 0), dt: read dt)
                    let up = smin(cache: mut cache, a: upper, b: end)
                    let zero = mk_const_int(cache: mut cache, dt: read dt, v: 0)
                    let lo = smax(cache: mut cache, a: lower, b: zero)
                    let count = mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: up, y: lo)
                    return simplify_reduce_count_times_value(cache: mut cache, count: count, r: r, val: tval)
                }
            }
        }
        i = i + 1
    }
    return None
}

fn simplify_load_index_expr(cache: read UOpCache, cmp: Int, r: Int) -> Int {
    if node_op(cache: read cache, id: cmp) != CMPNE || node_num_src(cache: read cache, id: cmp) != 2 { return -1 }
    let lhs = node_src_id(cache: read cache, id: cmp, k: 0)
    let rhs = node_src_id(cache: read cache, id: cmp, k: 1)
    if simplify_single_range_expr(cache: read cache, x: lhs) == r { return rhs }
    if simplify_single_range_expr(cache: read cache, x: rhs) == r { return lhs }
    return -1
}

fn simplify_reduce_load_collapse_one(cache: mut UOpCache, r: Int, idx: Int, expr: Int) -> Option<Int> {
    if node_num_src(cache: read cache, id: r) == 0 { return None }
    let rdt = node_dtype(cache: read cache, id: r)
    let edt = node_dtype(cache: read cache, id: expr)
    let idx_cast = mk_cast(cache: mut cache, x: idx, dt: read rdt)
    let zero_r = mk_const_int(cache: mut cache, dt: read rdt, v: 0)
    let lt_zero = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: idx_cast, y: zero_r)
    let btrue = mk_const_int(cache: mut cache, dt: read dt_bool(), v: 1)
    let ge_zero = mk_alu2(cache: mut cache, op: CMPNE, dt: read dt_bool(), x: lt_zero, y: btrue)
    let lt_end = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: idx_cast, y: node_src_id(cache: read cache, id: r, k: 0))
    let valid = mk_alu2(cache: mut cache, op: AND, dt: read dt_bool(), x: ge_zero, y: lt_end)
    let vidx = uop_valid(cache: mut cache, id: idx_cast, cond: valid)
    local ctx = simplify_empty_subst()
    simplify_subst_put(ctx: mut ctx, old_id: r, new_id: vidx)
    local replaced = do_substitute(cache: mut cache, ctx: mut ctx, x: expr)
    let mut new_expr = expr
    match replaced {
        Some(v) => { new_expr = v }
        None => { new_expr = expr }
    }
    let zero_expr = mk_const_int(cache: mut cache, dt: read edt, v: 0)
    return Some(mk_where(cache: mut cache, dt: read edt, cond: valid, tval: new_expr, fval: zero_expr))
}

fn reduce_load_index_collapse(cache: mut UOpCache, red: Int) -> Option<Int> {
    if node_op(cache: read cache, id: red) != REDUCE || simplify_reduce_is_add(cache: read cache, red: red) == false { return None }
    if node_num_src(cache: read cache, id: red) < 2 { return None }
    let value = node_src_id(cache: read cache, id: red, k: 0)
    if node_op(cache: read cache, id: value) != WHERE || node_num_src(cache: read cache, id: value) != 3 { return None }
    let cond = node_src_id(cache: read cache, id: value, k: 0)
    let tval = node_src_id(cache: read cache, id: value, k: 1)
    let fval = node_src_id(cache: read cache, id: value, k: 2)
    if simplify_is_zero_const(cache: read cache, id: tval) == false { return None }
    let norm_cond = simplify_lift_compare(cache: mut cache, cmp: cond)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: red) {
        let r = node_src_id(cache: read cache, id: red, k: i)
        let idx = simplify_load_index_expr(cache: read cache, cmp: norm_cond, r: r)
        if idx >= 0 {
            return simplify_reduce_load_collapse_one(cache: mut cache, r: r, idx: idx, expr: fval)
        }
        i = i + 1
    }
    return None
}

fn reduce_load_collapse(cache: mut UOpCache, red: Int, u: Int) -> Option<Int> {
    match reduce_load_index_collapse(cache: mut cache, red: red) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match reduce_collapse(cache: mut cache, red: red, u: u) {
        Some(r) => {
            match simplify_load_compare_undo(cache: mut cache, cmp: r) {
                Some(v) => { return Some(v) }
                None => { return Some(r) }
            }
        }
        None => {}
    }
    return None
}

fn no_load(cache: read UOpCache, u: Int) -> Bool {
    return uop_op_in_backward_slice_with_self(cache: read cache, id: u, op: INDEX) == false
}

fn simplify_load_compare_undo(cache: mut UOpCache, cmp: Int) -> Option<Int> {
    if node_op(cache: read cache, id: cmp) != CMPLT || node_num_src(cache: read cache, id: cmp) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: cmp, k: 0)
    let c = node_src_id(cache: read cache, id: cmp, k: 1)
    if node_op(cache: read cache, id: lhs) != ADD || node_num_src(cache: read cache, id: lhs) != 2 { return None }
    if no_load(cache: read cache, u: c) == false { return None }
    let a = node_src_id(cache: read cache, id: lhs, k: 0)
    let b = node_src_id(cache: read cache, id: lhs, k: 1)
    let mut x = a
    let mut y = b
    if no_load(cache: read cache, u: x) && no_load(cache: read cache, u: y) == false {
        x = b
        y = a
    }
    if no_load(cache: read cache, u: x) { return None }
    if no_load(cache: read cache, u: y) == false { return None }
    if node_dtype(cache: read cache, id: x).name != "weakint" { return None }
    let cdt = node_dtype(cache: read cache, id: c)
    let yc = mk_cast(cache: mut cache, x: y, dt: read cdt)
    let rhs = mk_alu2(cache: mut cache, op: SUB, dt: read cdt, x: c, y: yc)
    let out = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: x, y: rhs)
    return Some(graph_rewrite(cache: mut cache, id: out))
}
