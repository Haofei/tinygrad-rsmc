fn node_effective_device_count(cache: read UOpCache, id: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if op == DEVICE {
        return node_device_count(cache: read cache, id: id)
    }
    if op == BUFFER {
        if node_is_upstream_buffer(cache: read cache, id: id) {
            let d = node_src_id(cache: read cache, id: id, k: 1)
            return node_effective_device_count(cache: read cache, id: d)
        }
        return 0
    }
    if op == COPY || op == ALLREDUCE {
        if node_num_src(cache: read cache, id: id) >= 2 {
            let d = node_src_id(cache: read cache, id: id, k: 1)
            return node_effective_device_count(cache: read cache, id: d)
        }
        return 0
    }
    if op == MSELECT {
        return 1
    }
    if op == MSTACK {
        return node_num_src(cache: read cache, id: id)
    }
    if op == PARAM {
        let name = node_param_device(cache: read cache, id: id)
        if String.len(value: read name) > 0 { return 1 }
        return 0
    }
    if node_num_src(cache: read cache, id: id) > 0 {
        let s = node_src_id(cache: read cache, id: id, k: 0)
        return node_effective_device_count(cache: read cache, id: s)
    }
    return 0
}

fn node_effective_device_name(cache: read UOpCache, id: Int, index: Int) -> fresh String {
    let op = node_op(cache: read cache, id: id)
    if op == DEVICE {
        return node_device_name(cache: read cache, id: id, index: index)
    }
    if op == BUFFER {
        if node_is_upstream_buffer(cache: read cache, id: id) {
            let d = node_src_id(cache: read cache, id: id, k: 1)
            return node_effective_device_name(cache: read cache, id: d, index: index)
        }
        return ""
    }
    if op == COPY || op == ALLREDUCE {
        if node_num_src(cache: read cache, id: id) >= 2 {
            let d = node_src_id(cache: read cache, id: id, k: 1)
            return node_effective_device_name(cache: read cache, id: d, index: index)
        }
        return ""
    }
    if op == MSELECT {
        if node_num_src(cache: read cache, id: id) == 0 { return "" }
        let src = node_src_id(cache: read cache, id: id, k: 0)
        return node_effective_device_name(cache: read cache, id: src, index: index)
    }
    if op == MSTACK {
        if index >= 0 && index < node_num_src(cache: read cache, id: id) {
            let src = node_src_id(cache: read cache, id: id, k: index)
            return node_effective_device_name(cache: read cache, id: src, index: 0)
        }
        return ""
    }
    if op == PARAM {
        if index == 0 { return node_param_device(cache: read cache, id: id) }
        return ""
    }
    if node_num_src(cache: read cache, id: id) > 0 {
        let s = node_src_id(cache: read cache, id: id, k: 0)
        return node_effective_device_name(cache: read cache, id: s, index: index)
    }
    return ""
}

fn node_is_upstream_buffer(cache: read UOpCache, id: Int) -> Bool {
    if node_op(cache: read cache, id: id) != BUFFER { return false }
    if node_num_src(cache: read cache, id: id) != 2 { return false }
    let u = node_src_id(cache: read cache, id: id, k: 0)
    let d = node_src_id(cache: read cache, id: id, k: 1)
    let uop = node_op(cache: read cache, id: u)
    if uop != UNIQUE && uop != LUNIQUE { return false }
    if node_op(cache: read cache, id: d) != DEVICE { return false }
    return node_arg_is_int(cache: read cache, id: id)
}

