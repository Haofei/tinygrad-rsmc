fn uop_as_shape(cache: read UOpCache, id: Int) -> fresh List<Int> {
    let op = node_op(cache: read cache, id: id)
    local out = List.new<Int>()
    if op == CONST {
        local ints = node_argints(cache: read cache, id: id)
        if List.len<Int>(list: read ints) > 0 { return take ints }
        if node_is_const_int(cache: read cache, id: id) {
            let dt = node_dtype(cache: read cache, id: id)
            let mut i = 0
            while i < dt.count {
                List.push<Int>(list: mut out, value: read node_const_int(cache: read cache, id: id))
                i = i + 1
            }
            return take out
        }
    }
    if op == STACK {
        let mut j = 0
        while j < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: j)
            if node_is_const_int(cache: read cache, id: child) {
                List.push<Int>(list: mut out, value: read node_const_int(cache: read cache, id: child))
            }
            j = j + 1
        }
        return take out
    }
    return take out
}

fn uop_movement_arg(cache: read UOpCache, id: Int) -> fresh List<Int> {
    let op = node_op(cache: read cache, id: id)
    local out = List.new<Int>()
    if op == RESHAPE {
        return node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1))
    }
    if op == EXPAND {
        return node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1))
    }
    if op == PERMUTE { return node_argints(cache: read cache, id: id) }
    if op == FLIP { return node_argints(cache: read cache, id: id) }
    if op == PAD {
        local before = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1))
        local after = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 2))
        let mut i = 0
        while i < List.len<Int>(list: read before) {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read before, index: i))
            i = i + 1
        }
        let mut j = 0
        while j < List.len<Int>(list: read after) {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read after, index: j))
            j = j + 1
        }
        return take out
    }
    if op == SHRINK {
        local starts = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1))
        local ends = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 2))
        let mut a = 0
        while a < List.len<Int>(list: read starts) {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read starts, index: a))
            a = a + 1
        }
        let mut b = 0
        while b < List.len<Int>(list: read ends) {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read ends, index: b))
            b = b + 1
        }
        return take out
    }
    return take out
}

fn uop_key_string(cache: read UOpCache, id: Int) -> fresh String {
    let op = node_op(cache: read cache, id: id)
    let dt = node_dtype(cache: read cache, id: id)
    local arg = node_arg(cache: read cache, id: id)
    let mut s = String.concat(left: read ops_name(op: read op), right: read "{")
    s = String.concat(left: read s, right: read dt.name)
    s = String.concat(left: read s, right: read ",")
    s = String.concat(left: read s, right: read uop_arg_to_string(arg: read arg))
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        s = String.concat(left: read s, right: read ",")
        s = String.concat(left: read s, right: read uop_key_string(cache: read cache, id: child))
        i = i + 1
    }
    return String.concat(left: read s, right: read "}")
}

fn uop_render(cache: read UOpCache, id: Int) -> fresh String {
    let op = node_op(cache: read cache, id: id)
    if op == CONST {
        if node_is_const_int(cache: read cache, id: id) {
            return Int.to_string(value: read node_const_int(cache: read cache, id: id))
        }
        return "CONST"
    }
    if op == SPECIAL {
        return String.concat(left: read "s", right: read Int.to_string(value: read id))
    }
    if node_num_src(cache: read cache, id: id) == 0 {
        return ops_name(op: read op)
    }
    if node_num_src(cache: read cache, id: id) == 1 {
        let c0 = node_src_id(cache: read cache, id: id, k: 0)
        let inner = uop_render(cache: read cache, id: c0)
        let mut s = String.concat(left: read ops_name(op: read op), right: read "(")
        s = String.concat(left: read s, right: read inner)
        return String.concat(left: read s, right: read ")")
    }
    if node_num_src(cache: read cache, id: id) == 2 {
        let c0 = node_src_id(cache: read cache, id: id, k: 0)
        let c1 = node_src_id(cache: read cache, id: id, k: 1)
        let l = uop_render(cache: read cache, id: c0)
        let r = uop_render(cache: read cache, id: c1)
        let mut s = String.concat(left: read "(", right: read l)
        if op == ADD { s = String.concat(left: read s, right: read " + ") }
        if op == MUL { s = String.concat(left: read s, right: read " * ") }
        if op == SUB { s = String.concat(left: read s, right: read " - ") }
        if op == MAX { s = String.concat(left: read s, right: read " max ") }
        if op == CMPLT { s = String.concat(left: read s, right: read " < ") }
        if op == ADD { } else {
            if op == MUL { } else {
                if op == SUB { } else {
                    if op == MAX { } else {
                        if op == CMPLT { } else {
                            s = String.concat(left: read s, right: read " , ")
                        }
                    }
                }
            }
        }
        s = String.concat(left: read s, right: read r)
        return String.concat(left: read s, right: read ")")
    }
    let mut out = String.concat(left: read ops_name(op: read op), right: read "[")
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        out = String.concat(left: read out, right: read uop_render(cache: read cache, id: child))
        if i < node_num_src(cache: read cache, id: id) - 1 { out = String.concat(left: read out, right: read ",") }
        i = i + 1
    }
    return String.concat(left: read out, right: read "]")
}

