fn get_transcendental_patterns(cache: mut UOpCache, id: Int, force_transcendental: Bool) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if op == SIN {
        let x = node_src_id(cache: read cache, id: id, k: 0)
        return Some(xsin(cache: mut cache, d: x, fast: force_transcendental))
    }
    if op == EXP2 {
        let x = node_src_id(cache: read cache, id: id, k: 0)
        return Some(xexp2(cache: mut cache, d: x))
    }
    if op == LOG2 {
        let x = node_src_id(cache: read cache, id: id, k: 0)
        return Some(xlog2(cache: mut cache, d: x))
    }
    if op == SQRT {
        let x = node_src_id(cache: read cache, id: id, k: 0)
        let half = mk_const_float(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: x), v: 0.5)
        return Some(xpow(cache: mut cache, base: x, exponent: half))
    }
    return None
}

