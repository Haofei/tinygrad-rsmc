fn uop_mstack(cache: mut UOpCache, id: Int, srcs: read List<Int>) -> Int {
    let dt = node_full_dtype(cache: read cache, id: id)
    local all = List.new<Int>()
    List.push<Int>(list: mut all, value: read id)
    let mut i = 0
    while i < List.len<Int>(list: read srcs) {
        List.push<Int>(list: mut all, value: read List.get<Int>(list: read srcs, index: i))
        i = i + 1
    }
    return mk_mstack(cache: mut cache, dt: read dt, srcs: read all)
