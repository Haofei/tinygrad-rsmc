fn mantissa_bits(d: read DType) -> Int {
    let s = dtype_scalar(d: read d)
    if s.name == "double" { return 52 }
    if s.name == "float" { return 23 }
    if s.name == "half" { return 10 }
    if s.name == "float8_e4m3" || s.name == "float8_e4m3fnuz" { return 3 }
    if s.name == "float8_e5m2" || s.name == "float8_e5m2fnuz" { return 2 }
    return 0
}

fn exponent_bits(d: read DType) -> Int {
    let s = dtype_scalar(d: read d)
    if s.name == "double" { return 11 }
    if s.name == "float" { return 8 }
    if s.name == "half" { return 5 }
    if s.name == "float8_e4m3" || s.name == "float8_e4m3fnuz" { return 4 }
    if s.name == "float8_e5m2" || s.name == "float8_e5m2fnuz" { return 5 }
    return 0
}

fn exponent_bias(d: read DType) -> Int {
    let eb = exponent_bits(d: read d)
    if eb <= 0 { return 0 }
    let s = dtype_scalar(d: read d)
    let mut b = (1 << (eb - 1))
    if s.name != "float8_e4m3fnuz" && s.name != "float8_e5m2fnuz" { b = b - 1 }
    return b
}

fn exponent_mask(d: read DType) -> Int {
    let eb = exponent_bits(d: read d)
    if eb <= 0 { return 0 }
    return (1 << eb) - 1
}

fn shr(cache: mut UOpCache, x: Int, y: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: x)
    let v = mk_const_int(cache: mut cache, dt: read dt, v: 1 << y)
    return mk_alu2(cache: mut cache, op: FLOORDIV, dt: read dt, x: x, y: v)
}

fn shl(cache: mut UOpCache, x: Int, y: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: x)
    let v = mk_const_int(cache: mut cache, dt: read dt, v: 1 << y)
    return mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: x, y: v)
}

fn rintk(cache: mut UOpCache, d: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: d)
    let scalar = dtype_scalar(d: read dt)
    let mut out_dt = dt_int32()
    if scalar.name == "double" { out_dt = dt_int64() }
    if scalar.name == "half" { out_dt = dt_int16() }
    let zero = mk_const_float(cache: mut cache, dt: read dt, v: 0.0)
    let neg_half = mk_const_float(cache: mut cache, dt: read dt, v: 0.0 - 0.5)
    let pos_half = mk_const_float(cache: mut cache, dt: read dt, v: 0.5)
    let is_neg = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: d, y: zero)
    let adj = mk_where(cache: mut cache, dt: read dt, cond: is_neg, tval: neg_half, fval: pos_half)
    let shifted = mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: d, y: adj)
    return mk_cast(cache: mut cache, x: shifted, dt: read out_dt)
}

fn pow2if(cache: mut UOpCache, q: Int, float_dtype: read DType) -> Int {
    local out_dt = dtype_scalar(d: read float_dtype)
    let qdt = node_full_dtype(cache: read cache, id: q)
    let ebias = mk_const_int(cache: mut cache, dt: read qdt, v: exponent_bias(d: read out_dt))
    let m = mk_const_int(cache: mut cache, dt: read qdt, v: mantissa_bits(d: read out_dt))
    let exp = mk_alu2(cache: mut cache, op: ADD, dt: read qdt, x: q, y: ebias)
    let bits = mk_alu2(cache: mut cache, op: SHL, dt: read qdt, x: exp, y: m)
    return mk_bitcast(cache: mut cache, x: bits, dt: read out_dt)
}

fn ilogb2k(cache: mut UOpCache, d: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: d)
    let mut idt = dt_int32()
    let s = dtype_scalar(d: read dt)
    if s.name == "double" { idt = dt_int64() }
    if s.name == "half" { idt = dt_int16() }
    let dint = mk_bitcast(cache: mut cache, x: d, dt: read idt)
    let mb = mk_const_int(cache: mut cache, dt: read idt, v: mantissa_bits(d: read dt))
    let em = mk_const_int(cache: mut cache, dt: read idt, v: exponent_mask(d: read dt))
    let eb = mk_const_int(cache: mut cache, dt: read idt, v: exponent_bias(d: read dt))
    let shifted = mk_alu2(cache: mut cache, op: SHR, dt: read idt, x: dint, y: mb)
    let masked = mk_alu2(cache: mut cache, op: AND, dt: read idt, x: shifted, y: em)
    return mk_alu2(cache: mut cache, op: SUB, dt: read idt, x: masked, y: eb)
}

fn ldexp3k(cache: mut UOpCache, d: Int, e: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: d)
    let mut idt = dt_int32()
    let s = dtype_scalar(d: read dt)
    if s.name == "double" { idt = dt_int64() }
    if s.name == "half" { idt = dt_int16() }
    let bits = mk_bitcast(cache: mut cache, x: d, dt: read idt)
    let ec = mk_cast(cache: mut cache, x: e, dt: read idt)
    let mb = mk_const_int(cache: mut cache, dt: read idt, v: mantissa_bits(d: read dt))
    let shift = mk_alu2(cache: mut cache, op: SHL, dt: read idt, x: ec, y: mb)
    let out_bits = mk_alu2(cache: mut cache, op: ADD, dt: read idt, x: bits, y: shift)
    return mk_bitcast(cache: mut cache, x: out_bits, dt: read dt)
}

fn ldexp2k(cache: mut UOpCache, d: Int, e: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: d)
    let half = mk_const_int(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: e), v: 1)
    let e0 = mk_alu2(cache: mut cache, op: SHR, dt: read node_full_dtype(cache: read cache, id: e), x: e, y: half)
    let e1 = mk_alu2(cache: mut cache, op: SUB, dt: read node_full_dtype(cache: read cache, id: e), x: e, y: e0)
    let p0 = pow2if(cache: mut cache, q: e0, float_dtype: read dt)
    let p1 = pow2if(cache: mut cache, q: e1, float_dtype: read dt)
    let a = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: d, y: p0)
    return mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: a, y: p1)
}

