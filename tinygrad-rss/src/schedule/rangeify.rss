// Source-shaped facade for tinygrad/schedule/rangeify.py.
//
// The current RSS scheduler already carries the first rangeify analysis and
// graph-rewrite machinery in schedule/indexing.rss. This module exposes the
// upstream rangeify names and delegates to those integrated pieces where the
// cache-backed IR can express the behavior. Kernel splitting, exact buffer
// cost modeling, ImageDType/WMMA lowering, and full assign dependency repair
// remain deeper slices.
features: local

struct RangeifyLocalContext derives(Clone) {
    next_lunique: Int,
    next_range: Int,
}

fn rangeify_local_context_new() -> fresh RangeifyLocalContext {
    return RangeifyLocalContext(next_lunique: 0, next_range: 0)
}

fn add_ranges_to_store(cache: mut UOpCache, ctx: mut IndexingContext, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != STORE { return None }
    if node_num_src(cache: read cache, id: x) < 2 { return None }
    let dest = node_src_id(cache: read cache, id: x, k: 0)
    let value = node_src_id(cache: read cache, id: x, k: 1)
    local shape = uop_shape(cache: read cache, id: value)
    if List.len<Int>(list: read shape) == 0 { return None }
    local ranges = indexing_ranges_for_shape(cache: mut cache, ctx: mut ctx, shape: read shape, axis_type: read AXIS_LOOP)
    let ndest = mk_index(cache: mut cache, base: dest, srcs: read ranges, ptr: true)
    let nval = mk_index(cache: mut cache, base: value, srcs: read ranges, ptr: false)
    let st = mk_store(cache: mut cache, ptr: ndest, value: nval, gate: read None)
    return Some(mk_end(cache: mut cache, id: st, srcs: read ranges))
}

fn rangeify_last_dim_or_count(cache: read UOpCache, id: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: id)
    if List.len<Int>(list: read shape) > 0 {
        return List.get<Int>(list: read shape, index: List.len<Int>(list: read shape) - 1)
    }
    let count = node_full_dtype(cache: read cache, id: id).count
    if count > 0 { return count }
    return 1
}

fn rangeify_contract_shaped_wmma_src(cache: mut UOpCache, ctx: mut IndexingContext, id: Int) -> Int {
    let size = rangeify_last_dim_or_count(cache: read cache, id: id)
    let axis_id = ctx.next_range
    let r = mk_range_int(cache: mut cache, end: size, axis_id: axis_id, axis_type: read AXIS_UPCAST, dt: read dt_int32())
    ctx.next_range = ctx.next_range + 1
    local idxs = List.new<Int>()
    List.push<Int>(list: mut idxs, value: read r)
    let indexed = mk_index(cache: mut cache, base: id, srcs: read idxs, ptr: false)
    local pairs = List.new<Int>()
    List.push<Int>(list: mut pairs, value: read axis_id)
    List.push<Int>(list: mut pairs, value: read size)
    return mk_contract(cache: mut cache, x: indexed, pairs: read pairs)
}

fn lower_shaped_wmma(cache: mut UOpCache, ctx: mut IndexingContext, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != SHAPED_WMMA { return None }
    if ctx.next_range < 0 { return None }
    if node_num_src(cache: read cache, id: x) != 3 { return None }
    let a_src = node_src_id(cache: read cache, id: x, k: 0)
    let b_src = node_src_id(cache: read cache, id: x, k: 1)
    let c_src = node_src_id(cache: read cache, id: x, k: 2)
    let a_contract = rangeify_contract_shaped_wmma_src(cache: mut cache, ctx: mut ctx, id: a_src)
    let b_contract = rangeify_contract_shaped_wmma_src(cache: mut cache, ctx: mut ctx, id: b_src)
    let c_contract = rangeify_contract_shaped_wmma_src(cache: mut cache, ctx: mut ctx, id: c_src)
    local arg = node_argints(cache: read cache, id: x)
    let wmma = mk_wmma(cache: mut cache, a_id: a_contract, b_id: b_contract, acc_id: c_contract, dt: read node_full_dtype(cache: read cache, id: x), arg: read arg)
    let lanes = rangeify_last_dim_or_count(cache: read cache, id: c_src)
    local reg_shape = List.new<Int>()
    List.push<Int>(list: mut reg_shape, value: read lanes)
    let reg = mk_define_reg(cache: mut cache, slot: ctx.next_range, dt: read node_dtype(cache: read cache, id: x), shape: read reg_shape)
    ctx.next_range = ctx.next_range + 1
    local deps = List.new<Int>()
    let mut i = 0
    while i < lanes {
        let ci = mk_const_int(cache: mut cache, dt: read dt_int32(), v: i)
        local idxs = List.new<Int>()
        List.push<Int>(list: mut idxs, value: read ci)
        let ptr = mk_index(cache: mut cache, base: reg, srcs: read idxs, ptr: true)
        local gidxs = List.new<Int>()
        List.push<Int>(list: mut gidxs, value: read i)
        let lane = mk_gep(cache: mut cache, x: wmma, idxs: read gidxs)
        List.push<Int>(list: mut deps, value: read mk_store(cache: mut cache, ptr: ptr, value: lane, gate: read None))
        i = i + 1
    }
    return Some(mk_after(cache: mut cache, id: reg, srcs: read deps))
}

fn found_after(cache: read UOpCache, after: Int, src: Int) -> Option<Int> {
    if node_op(cache: read cache, id: after) != AFTER { return None }
    if src < 0 { return None }
    return Some(after)
}

fn _mop_index(cache: mut UOpCache, r: Int, idx: Int) -> Option<Int> {
    if group_movement(op: read node_op(cache: read cache, id: r)) == false { return None }
    if node_op(cache: read cache, id: idx) != INDEX { return None }
    if node_num_src(cache: read cache, id: r) <= 0 || node_num_src(cache: read cache, id: idx) <= 1 { return None }
    local idxs = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: idx) {
        List.push<Int>(list: mut idxs, value: read node_src_id(cache: read cache, id: idx, k: i))
        i = i + 1
    }
    local rshape = uop_shape(cache: read cache, id: r)
    if List.len<Int>(list: read idxs) != List.len<Int>(list: read rshape) { return None }
    let src0 = node_src_id(cache: read cache, id: r, k: 0)
    local in_shape = uop_shape(cache: read cache, id: src0)
    local marg = indexing_movement_arg_for_node(cache: read cache, id: r)
    local mapped = indexing_apply_movement_op(cache: mut cache, op: read node_op(cache: read cache, id: r), in_shape: read in_shape, arg: read marg, rngs: read idxs)
    return Some(mk_index(cache: mut cache, base: src0, srcs: read mapped, ptr: node_index_is_ptr(cache: read cache, id: idx)))
}

fn rangeify_index_tail(cache: read UOpCache, idx: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: idx) {
        List.push<Int>(list: mut out, value: read node_src_id(cache: read cache, id: idx, k: i))
        i = i + 1
    }
    return take out
}

fn rangeify_syntactic_nested_index(cache: mut UOpCache, idx: Int) -> Option<Int> {
    if node_op(cache: read cache, id: idx) != INDEX { return None }
    if node_num_src(cache: read cache, id: idx) < 1 { return None }
    if node_index_is_ptr(cache: read cache, id: idx) { return None }
    let inner = node_src_id(cache: read cache, id: idx, k: 0)
    if node_op(cache: read cache, id: inner) != INDEX { return None }
    if node_index_is_ptr(cache: read cache, id: inner) == false { return None }
    let base = node_src_id(cache: read cache, id: inner, k: 0)
    local idxs = rangeify_index_tail(cache: read cache, idx: inner)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: idx) {
        List.push<Int>(list: mut idxs, value: read node_src_id(cache: read cache, id: idx, k: i))
        i = i + 1
    }
    return Some(mk_index(cache: mut cache, base: base, srcs: read idxs, ptr: false))
}

fn rangeify_syntactic_index_elementwise(cache: mut UOpCache, idx: Int) -> Option<Int> {
    if node_op(cache: read cache, id: idx) != INDEX { return None }
    if node_num_src(cache: read cache, id: idx) < 1 { return None }
    let base = node_src_id(cache: read cache, id: idx, k: 0)
    let op = node_op(cache: read cache, id: base)
    if op == CONST { return Some(base) }
    if group_elementwise(op: read op) == false { return None }
    local idxs = rangeify_index_tail(cache: read cache, idx: idx)
    local srcs = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: base) {
        let child = node_src_id(cache: read cache, id: base, k: i)
        List.push<Int>(list: mut srcs, value: read mk_index(cache: mut cache, base: child, srcs: read idxs, ptr: false))
        i = i + 1
    }
    local arg = node_arg(cache: read cache, id: base)
    return Some(intern(cache: mut cache, op: op, dt: read node_full_dtype(cache: read cache, id: idx), src: take srcs, arg: take arg))
}

fn rangeify_syntactic_sugar_node(cache: mut UOpCache, id: Int) -> Option<Int> {
    match rangeify_syntactic_nested_index(cache: mut cache, idx: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match rangeify_syntactic_index_elementwise(cache: mut cache, idx: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    return None
}

fn rangeify_apply_syntactic_sugar_node(cache: mut UOpCache, id: Int, olds: mut List<Int>, news: mut List<Int>) -> Int {
    let mut mi = 0
    while mi < List.len<Int>(list: read olds) {
        if id == List.get<Int>(list: read olds, index: mi) { return List.get<Int>(list: read news, index: mi) }
        mi = mi + 1
    }
    local srcs = List.new<Int>()
    let mut changed = false
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        let rewritten = rangeify_apply_syntactic_sugar_node(cache: mut cache, id: child, olds: mut olds, news: mut news)
        if rewritten != child { changed = true }
        List.push<Int>(list: mut srcs, value: read rewritten)
        i = i + 1
    }
    let mut cur = id
    if changed {
        let op = node_op(cache: read cache, id: id)
        let dt = node_full_dtype(cache: read cache, id: id)
        local arg = node_arg(cache: read cache, id: id)
        cur = intern(cache: mut cache, op: op, dt: read dt, src: take srcs, arg: take arg)
    }
    match rangeify_syntactic_sugar_node(cache: mut cache, id: cur) {
        Some(r) => { cur = r }
        None => {}
    }
    List.push<Int>(list: mut olds, value: read id)
    List.push<Int>(list: mut news, value: read cur)
    return cur
}

fn rangeify_apply_syntactic_sugar(cache: mut UOpCache, root: Int) -> Int {
    local olds = List.new<Int>()
    local news = List.new<Int>()
    return rangeify_apply_syntactic_sugar_node(cache: mut cache, id: root, olds: mut olds, news: mut news)
}

fn fix_store_hazard(cache: mut UOpCache, target: Int, src: Int) -> Option<Int> {
    let base = uop_base(cache: read cache, id: target)
    if indexing_backward_slice_with_self_contains(cache: read cache, id: src, value: base) == false { return None }
    let contig = mk_contiguous(cache: mut cache, x: src)
    return Some(mk_store(cache: mut cache, ptr: target, value: contig, gate: read None))
}

fn rangeify_reduce_by_kind(cache: mut UOpCache, x: Int, kind: Int, axes: read List<Int>) -> Int {
    if kind == 1 { return mk_prod_reduce(cache: mut cache, x: x, axes: read axes) }
    if kind == 2 { return mk_max_reduce(cache: mut cache, x: x, axes: read axes) }
    return mk_sum(cache: mut cache, x: x, axes: read axes)
}

fn rangeify_split_reduce_divisor(x_dim: Int, out_numel: Int) -> Int {
    if out_numel <= 0 { return 0 }
    let mut max_div = 4194304 / out_numel
    if max_div > 256 { max_div = 256 }
    if max_div < 8 { return 0 }
    let mut d = max_div
    while d >= 8 {
        if x_dim % d == 0 { return d }
        d = d - 1
    }
    return 0
}

fn split_reduceop(cache: mut UOpCache, reduce: Int, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: reduce) != REDUCE { return None }
    if x < 0 { return None }
    local reduce_shape = uop_shape(cache: read cache, id: reduce)
    if prod(x: read reduce_shape) == 0 { return None }
    local x_shape = uop_shape(cache: read cache, id: x)
    if prod(x: read x_shape) == 0 { return None }
    if prod(x: read x_shape) / prod(x: read reduce_shape) < 32768 { return None }
    local axes = node_argints(cache: read cache, id: reduce)
    let mut dim_to_split = 0 - 1
    let mut divisor = 0
    let out_numel = prod(x: read reduce_shape)
    let mut ai = 0
    while ai < List.len<Int>(list: read axes) {
        let axis = List.get<Int>(list: read axes, index: ai)
        if axis >= 0 && axis < List.len<Int>(list: read x_shape) {
            let dim = List.get<Int>(list: read x_shape, index: axis)
            let d = rangeify_split_reduce_divisor(x_dim: dim, out_numel: out_numel)
            if d > 0 {
                dim_to_split = axis
                divisor = d
                break
            }
        }
        ai = ai + 1
    }
    if dim_to_split < 0 { return None }

    local splitted_shape = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read x_shape) {
        let dim = List.get<Int>(list: read x_shape, index: i)
        if i == dim_to_split {
            List.push<Int>(list: mut splitted_shape, value: read divisor)
            let split_tail = dim / divisor
            List.push<Int>(list: mut splitted_shape, value: read split_tail)
        } else {
            List.push<Int>(list: mut splitted_shape, value: read dim)
        }
        i = i + 1
    }
    let reshaped = mk_reshape(cache: mut cache, x: x, new_shape: read splitted_shape)
    local perm = List.new<Int>()
    let mut pi = 0
    while pi < List.len<Int>(list: read splitted_shape) {
        if pi != dim_to_split { List.push<Int>(list: mut perm, value: read pi) }
        pi = pi + 1
    }
    List.push<Int>(list: mut perm, value: read dim_to_split)
    let permuted = mk_permute(cache: mut cache, x: reshaped, perm: read perm)
    let first_reduce = rangeify_reduce_by_kind(cache: mut cache, x: permuted, kind: node_reduce_kind(cache: read cache, id: reduce), axes: read axes)
    let contig = mk_contiguous(cache: mut cache, x: first_reduce)
    local split_axis = List.new<Int>()
    List.push<Int>(list: mut split_axis, value: read List.len<Int>(list: read reduce_shape))
    let second_reduce = rangeify_reduce_by_kind(cache: mut cache, x: contig, kind: node_reduce_kind(cache: read cache, id: reduce), axes: read split_axis)
    return Some(mk_reshape(cache: mut cache, x: second_reduce, new_shape: read reduce_shape))
}

fn rangeify_param_list_contains(params: read List<Int>, p: Int) -> Bool {
    let mut i = 0
    while i < List.len<Int>(list: read params) {
        if List.get<Int>(list: read params, index: i) == p { return true }
        i = i + 1
    }
    return false
}

fn rangeify_collect_params(cache: read UOpCache, body: Int) -> fresh List<Int> {
    local params = List.new<Int>()
    local order = uop_toposort_enter_calls(cache: read cache, id: body, enter_calls: false)
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let id = List.get<Int>(list: read order, index: i)
        if node_op(cache: read cache, id: id) == PARAM && rangeify_param_list_contains(params: read params, p: id) == false {
            List.push<Int>(list: mut params, value: read id)
        }
        i = i + 1
    }
    return take params
}

fn rangeify_function_args_dense(cache: read UOpCache, fn_id: Int, params: read List<Int>) -> Bool {
    let argc = node_num_src(cache: read cache, id: fn_id) - 1
    let mut i = 0
    while i < List.len<Int>(list: read params) {
        let slot = node_param_slot(cache: read cache, id: List.get<Int>(list: read params, index: i))
        if slot != i || slot < 0 || slot >= argc { return false }
        i = i + 1
    }
    return argc == List.len<Int>(list: read params)
}

fn rangeify_function_param_matches_arg(cache: read UOpCache, param: Int, arg: Int) -> Bool {
    if node_full_dtype(cache: read cache, id: param) != node_full_dtype(cache: read cache, id: arg) { return false }
    local pshape = uop_shape(cache: read cache, id: param)
    local ashape = uop_shape(cache: read cache, id: arg)
    if indexing_shape_equals(a: read pshape, b: read ashape) == false { return false }
    if uop_axis(cache: read cache, id: param) != uop_axis(cache: read cache, id: arg) { return false }
    return true
}

fn resolve_function(cache: mut UOpCache, c: Int, allow_param_mismatch: Bool) -> Option<Int> {
    if node_op(cache: read cache, id: c) != FUNCTION { return None }
    if node_num_src(cache: read cache, id: c) == 0 { return None }
    let body = node_src_id(cache: read cache, id: c, k: 0)
    local params = rangeify_collect_params(cache: read cache, body: body)
    if allow_param_mismatch == false && rangeify_function_args_dense(cache: read cache, fn_id: c, params: read params) == false { return None }
    local old_ids = List.new<Int>()
    local new_ids = List.new<Int>()
    let argc = node_num_src(cache: read cache, id: c) - 1
    let mut i = 0
    while i < List.len<Int>(list: read params) {
        let p = List.get<Int>(list: read params, index: i)
        let slot = node_param_slot(cache: read cache, id: p)
        if slot >= 0 && slot < argc {
            let arg = node_src_id(cache: read cache, id: c, k: slot + 1)
            if rangeify_function_param_matches_arg(cache: read cache, param: p, arg: arg) == false { return None }
            List.push<Int>(list: mut old_ids, value: read p)
            List.push<Int>(list: mut new_ids, value: read arg)
        }
        i = i + 1
    }
    if List.len<Int>(list: read old_ids) == 0 { return Some(body) }
    return Some(uop_substitute_many(cache: mut cache, id: body, old_ids: read old_ids, new_ids: read new_ids))
}

fn cleanup_dead_axes(cache: mut UOpCache, b: Int) -> Option<Int> {
    if node_op(cache: read cache, id: b) != STAGE { return None }
    if node_num_src(cache: read cache, id: b) <= 1 { return None }
    local keep = List.new<Int>()
    local reshape = List.new<Int>()
    let value = node_src_id(cache: read cache, id: b, k: 0)
    List.push<Int>(list: mut keep, value: read value)
    local stage_shape = uop_shape(cache: read cache, id: b)
    let mut hit = false
    let mut i = 1
    while i < node_num_src(cache: read cache, id: b) {
        let r = node_src_id(cache: read cache, id: b, k: i)
        if node_op(cache: read cache, id: r) == CONST {
            hit = true
            push1(l: mut reshape, a: 1)
        } else {
            List.push<Int>(list: mut keep, value: read r)
            if i - 1 < List.len<Int>(list: read stage_shape) {
                push1(l: mut reshape, a: List.get<Int>(list: read stage_shape, index: i - 1))
            }
        }
        i = i + 1
    }
    if hit == false { return None }
    local arg = node_arg(cache: read cache, id: b)
    let narrowed = intern(cache: mut cache, op: STAGE, dt: read node_full_dtype(cache: read cache, id: b), src: take keep, arg: take arg)
    if List.len<Int>(list: read stage_shape) == 0 { return Some(narrowed) }
    let reshaped = mk_reshape(cache: mut cache, x: narrowed, new_shape: read reshape)
    return Some(mk_expand(cache: mut cache, x: reshaped, new_shape: read stage_shape))
}

fn gate_substitute(cache: read UOpCache, b: Int, ranges: read List<Int>) -> Bool {
    local br = uop_ranges(cache: read cache, id: b)
    let mut i = 0
    while i < List.len<Int>(list: read ranges) {
        if indexing_list_contains(items: read br, value: List.get<Int>(list: read ranges, index: i)) { return true }
        i = i + 1
    }
    return false
}

fn remove_bufferize(cache: mut UOpCache, src: Int, buf: Int, idx: Int) -> Option<Int> {
    if node_op(cache: read cache, id: buf) != STAGE { return None }
    if node_op(cache: read cache, id: idx) != INDEX { return None }
    if node_bufferize_removable(cache: read cache, id: buf) == false { return None }
    if src < 0 { return None }
    if node_num_src(cache: read cache, id: buf) != node_num_src(cache: read cache, id: idx) { return None }
    let src_op = node_op(cache: read cache, id: src)
    if src_op == CONTIGUOUS || src_op == COPY || src_op == NOOP { return None }
    local old_ids = List.new<Int>()
    local new_ids = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: buf) {
        let old_range = node_src_id(cache: read cache, id: buf, k: i)
        let new_range = node_src_id(cache: read cache, id: idx, k: i)
        if node_op(cache: read cache, id: old_range) != CONST && uop_is_invalid(cache: read cache, id: new_range) == false {
            List.push<Int>(list: mut old_ids, value: read old_range)
            List.push<Int>(list: mut new_ids, value: read new_range)
        }
        i = i + 1
    }
    if List.len<Int>(list: read old_ids) == 0 { return None }
    return Some(uop_substitute_many(cache: mut cache, id: src, old_ids: read old_ids, new_ids: read new_ids))
}

fn remove_noop_bufferize(cache: mut UOpCache, idx: Int, b2: Int) -> Option<Int> {
    if node_op(cache: read cache, id: idx) != INDEX || node_op(cache: read cache, id: b2) != STAGE { return None }
    if node_op(cache: read cache, id: node_src_id(cache: read cache, id: idx, k: 0)) == SLICE { return None }
    if node_num_src(cache: read cache, id: idx) != node_num_src(cache: read cache, id: b2) { return None }
    let mut i = 1
    while i < node_num_src(cache: read cache, id: idx) {
        if node_src_id(cache: read cache, id: idx, k: i) != node_src_id(cache: read cache, id: b2, k: i) { return None }
        i = i + 1
    }
    let base = node_src_id(cache: read cache, id: idx, k: 0)
    local shape = uop_shape(cache: read cache, id: b2)
    if List.len<Int>(list: read shape) == 0 { return Some(base) }
    local starts = List.new<Int>()
    local ends = List.new<Int>()
    let mut j = 0
    while j < List.len<Int>(list: read shape) {
        push1(l: mut starts, a: 0)
        push1(l: mut ends, a: List.get<Int>(list: read shape, index: j))
        j = j + 1
    }
    return Some(mk_shrink(cache: mut cache, x: base, starts: read starts, ends: read ends))
}

fn late_buffer_view(cache: mut UOpCache, t: Int, b: Int) -> Option<Int> {
    if node_op(cache: read cache, id: b) != STAGE { return None }
    let dev = node_bufferize_device_name(cache: read cache, id: b)
    if String.starts_with(value: read dev, prefix: read "DISK") == false && String.starts_with(value: read dev, prefix: read "TINYFS") == false { return None }
    let mut cur = t
    let mut idx = 0 - 1
    while cur >= 0 {
        let mut i = 0
        while i < node_num_src(cache: read cache, id: cur) {
            let s = node_src_id(cache: read cache, id: cur, k: i)
            if node_op(cache: read cache, id: s) == INDEX { idx = s }
            i = i + 1
        }
        if idx >= 0 { break }
        if group_movement(op: read node_op(cache: read cache, id: cur)) == false && node_op(cache: read cache, id: cur) != BITCAST && node_op(cache: read cache, id: cur) != CONTIGUOUS { return None }
        if node_num_src(cache: read cache, id: cur) == 0 { return None }
        cur = node_src_id(cache: read cache, id: cur, k: 0)
    }
    if idx < 0 || node_num_src(cache: read cache, id: idx) < 2 { return None }
    let first_index = node_src_id(cache: read cache, id: idx, k: 1)
    let mut off = 0
    if node_op(cache: read cache, id: first_index) == CONST { off = trunc_float_to_int(v: node_const_float(cache: read cache, id: first_index)) }
    let slice = mk_slice(cache: mut cache, base: node_src_id(cache: read cache, id: idx, k: 0), offset: off, size: prod(x: read uop_shape(cache: read cache, id: b)), dt: read node_full_dtype(cache: read cache, id: t))
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read slice)
    let mut j = 1
    while j < node_num_src(cache: read cache, id: b) {
        List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: b, k: j))
        j = j + 1
    }
    local arg = node_arg(cache: read cache, id: b)
    return Some(intern(cache: mut cache, op: STAGE, dt: read node_full_dtype(cache: read cache, id: b), src: take srcs, arg: take arg))
}

fn rangeify_limit_device_cap(device: read String) -> Int {
    if String.starts_with(value: read device, prefix: read "METAL") { return 31 }
    if String.starts_with(value: read device, prefix: read "WEBGPU") { return 8 }
    return 0
}

fn rangeify_limit_is_load_leaf(op: read Ops) -> Bool {
    if op == STAGE { return true }
    if op == AFTER { return true }
    if op == PARAM { return true }
    if op == MSELECT { return true }
    if op == MSTACK { return true }
    if op == DEFINE_VAR { return true }
    return false
}

fn rangeify_limit_collect_bufs(cache: read UOpCache, id: Int, bufs: mut List<Int>) -> Unit {
    let op = node_op(cache: read cache, id: id)
    if rangeify_limit_is_load_leaf(op: read op) {
        indexing_add_unique(items: mut bufs, value: id)
        return Unit
    }
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        rangeify_limit_collect_bufs(cache: read cache, id: node_src_id(cache: read cache, id: id, k: i), bufs: mut bufs)
        i = i + 1
    }
    return Unit
}

fn rangeify_limit_fresh_loop_range(cache: mut UOpCache, ctx: mut IndexingContext, r: Int) -> Int {
    if node_op(cache: read cache, id: r) != RANGE { return r }
    local extra = List.new<Int>()
    let out = mk_range(cache: mut cache, end: node_src_id(cache: read cache, id: r, k: 0), axis_id: ctx.next_range,
                       axis_type: read AXIS_LOOP, extra_axes: read extra, dt: read node_dtype(cache: read cache, id: r))
    ctx.next_range = ctx.next_range + 1
    return out
}

fn rangeify_limit_stage_child(cache: mut UOpCache, ctx: mut IndexingContext, child: Int) -> Option<Int> {
    if group_elementwise(op: read node_op(cache: read cache, id: child)) == false { return None }
    local dev = node_effective_device_name(cache: read cache, id: child, index: 0)
    if String.len(value: read dev) == 0 { return None }
    local orig_ranges = uop_ranges(cache: read cache, id: child)
    if List.len<Int>(list: read orig_ranges) == 0 { return None }
    local old_ids = List.new<Int>()
    local new_ids = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read orig_ranges) {
        let old_r = List.get<Int>(list: read orig_ranges, index: i)
        let new_r = rangeify_limit_fresh_loop_range(cache: mut cache, ctx: mut ctx, r: old_r)
        List.push<Int>(list: mut old_ids, value: read old_r)
        List.push<Int>(list: mut new_ids, value: read new_r)
        i = i + 1
    }
    let subbed = uop_substitute_many(cache: mut cache, id: child, old_ids: read old_ids, new_ids: read new_ids)
    local opts = mk_bufferize_arg_device(device: read dev, addrspace: read ADDR_GLOBAL, removable: true)
    let staged = mk_stage(cache: mut cache, x: subbed, ranges: read new_ids, opts: read opts)
    return Some(mk_index(cache: mut cache, base: staged, srcs: read orig_ranges, ptr: false))
}

fn limit_bufs(cache: mut UOpCache, ctx: mut IndexingContext, root: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: root)
    if group_binary(op: read op) == false && group_ternary(op: read op) == false { return None }
    local device = node_effective_device_name(cache: read cache, id: root, index: 0)
    if String.len(value: read device) == 0 { return None }
    let max_bufs = rangeify_limit_device_cap(device: read device)
    if max_bufs <= 0 { return None }
    local bufs = List.new<Int>()
    rangeify_limit_collect_bufs(cache: read cache, id: root, bufs: mut bufs)
    if List.len<Int>(list: read bufs) <= max_bufs - 1 { return None }

    local srcs = List.new<Int>()
    let mut changed = false
    let mut i = 0
    while i < node_num_src(cache: read cache, id: root) {
        let child = node_src_id(cache: read cache, id: root, k: i)
        match rangeify_limit_stage_child(cache: mut cache, ctx: mut ctx, child: child) {
            Some(r) => {
                List.push<Int>(list: mut srcs, value: read r)
                changed = true
            }
            None => { List.push<Int>(list: mut srcs, value: read child) }
        }
        i = i + 1
    }
    if changed == false { return None }
    local arg = node_arg(cache: read cache, id: root)
    return Some(intern(cache: mut cache, op: op, dt: read node_full_dtype(cache: read cache, id: root), src: take srcs, arg: take arg))
}

fn bufferize_to_store(cache: mut UOpCache, ctx: mut RangeifyLocalContext, x: Int, idx: Int, allow_locals: Bool) -> Option<Int> {
    if node_op(cache: read cache, id: x) != STAGE { return None }
    if node_op(cache: read cache, id: idx) != INDEX { return None }
    if allow_locals == false && node_bufferize_addrspace(cache: read cache, id: x) == ADDR_LOCAL { return None }
    let value = node_src_id(cache: read cache, id: x, k: 0)
    local idx_ranges = List.new<Int>()
    let mut ri = 1
    while ri < node_num_src(cache: read cache, id: idx) {
        List.push<Int>(list: mut idx_ranges, value: read node_src_id(cache: read cache, id: idx, k: ri))
        ri = ri + 1
    }
    if node_op(cache: read cache, id: value) == AFTER {
        let buf = uop_buf_uop(cache: mut cache, id: value)
        local deps = List.new<Int>()
        let mut ai = 1
        while ai < node_num_src(cache: read cache, id: value) {
            let dep = node_src_id(cache: read cache, id: value, k: ai)
            if node_op(cache: read cache, id: dep) == STORE {
                let target = node_src_id(cache: read cache, id: dep, k: 0)
                let stored = node_src_id(cache: read cache, id: dep, k: 1)
                if target != stored {
                    let ended = mk_end(cache: mut cache, id: dep, srcs: read idx_ranges)
                    List.push<Int>(list: mut deps, value: read ended)
                }
            }
            if node_op(cache: read cache, id: dep) == END {
                List.push<Int>(list: mut deps, value: read dep)
            }
            ai = ai + 1
        }
        if List.len<Int>(list: read deps) == 0 { return Some(buf) }
        return Some(mk_after(cache: mut cache, id: buf, srcs: read deps))
    }
    if node_bufferize_addrspace(cache: read cache, id: x) == ADDR_LOCAL {
        if allow_locals == false { return None }
        let buf = mk_define_local(cache: mut cache, slot: ctx.next_lunique, dt: read node_full_dtype(cache: read cache, id: value), shape: read uop_shape(cache: read cache, id: x))
        let ptr = mk_index(cache: mut cache, base: buf, srcs: read idx_ranges, ptr: true)
        let st = mk_store(cache: mut cache, ptr: ptr, value: value, gate: read None)
        let ended = mk_end(cache: mut cache, id: st, srcs: read idx_ranges)
        let barrier = mk_barrier(cache: mut cache, id: ended, srcs: read idx_ranges)
        ctx.next_lunique = ctx.next_lunique + 1
        local deps = List.new<Int>()
        List.push<Int>(list: mut deps, value: read barrier)
        return Some(mk_after(cache: mut cache, id: buf, srcs: read deps))
    }
    let buf = mk_buffer(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: value), shape: read uop_shape(cache: read cache, id: x))
    let ptr = mk_index(cache: mut cache, base: buf, srcs: read idx_ranges, ptr: true)
    let mut store_value = value
    if node_op(cache: read cache, id: value) == SLICE {
        store_value = value
    }
    let st = mk_store(cache: mut cache, ptr: ptr, value: store_value, gate: read None)
    let ended = mk_end(cache: mut cache, id: st, srcs: read idx_ranges)
    ctx.next_lunique = ctx.next_lunique + 1
    local deps = List.new<Int>()
    List.push<Int>(list: mut deps, value: read ended)
    return Some(mk_after(cache: mut cache, id: buf, srcs: read deps))
}

fn flatten_bufferize(cache: mut UOpCache, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != STAGE { return None }
    if node_num_src(cache: read cache, id: x) <= 2 { return None }
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: x, k: 0))
    List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: x, k: 1))
    local arg = node_arg(cache: read cache, id: x)
    return Some(intern(cache: mut cache, op: STAGE, dt: read node_full_dtype(cache: read cache, id: x), src: take srcs, arg: take arg))
}

fn debuf(cache: mut UOpCache, ctx: mut RangeifyLocalContext, buf: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: buf)
    if op != BUFFER && op != PARAM { return None }
    local shape = uop_shape(cache: read cache, id: buf)
    local devices = List.new<String>()
    let p = mk_param_devices_full(cache: mut cache, slot: ctx.next_lunique, dt: read node_full_dtype(cache: read cache, id: buf),
                                  shape: read shape, name: read "", has_vmin_vmax: false, vmin: 0, vmax: 0,
                                  addrspace: read ADDR_GLOBAL, devices: read devices)
    ctx.next_lunique = ctx.next_lunique + 1
    return Some(p)
}

fn unbind_kernel(cache: read UOpCache, b: Int) -> Option<Int> {
    if node_op(cache: read cache, id: b) != BIND { return None }
    if node_num_src(cache: read cache, id: b) > 0 { return Some(node_src_id(cache: read cache, id: b, k: 0)) }
    return None
}

fn handle_after(cache: read UOpCache, after: Int) -> Option<Int> {
    if node_op(cache: read cache, id: after) != AFTER { return None }
    if node_num_src(cache: read cache, id: after) > 0 { return Some(node_src_id(cache: read cache, id: after, k: 0)) }
    return None
}

fn renumber_range(cache: mut UOpCache, ctx: mut RangeifyLocalContext, r: Int) -> Option<Int> {
    if node_op(cache: read cache, id: r) != RANGE { return None }
    let mm = uop_min_max(cache: read cache, id: r)
    let nr = mk_range_int(cache: mut cache, end: mm.hi + 1, axis_id: ctx.next_range, axis_type: read node_range_type(cache: read cache, id: r), dt: read node_dtype(cache: read cache, id: r))
    ctx.next_range = ctx.next_range + 1
    return Some(nr)
}

fn find_bufs(cache: read UOpCache, x: Int) -> Bool {
    local order = uop_toposort_enter_calls(cache: read cache, id: x, enter_calls: false)
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        if node_op(cache: read cache, id: List.get<Int>(list: read order, index: i)) == INDEX { return true }
        i = i + 1
    }
    return false
}

fn get_contiguous(cache: read UOpCache, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != CONTIGUOUS { return None }
    if node_num_src(cache: read cache, id: x) > 0 { return Some(node_src_id(cache: read cache, id: x, k: 0)) }
    return None
}

fn split_store(cache: mut UOpCache, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != STORE && node_op(cache: read cache, id: x) != END { return None }
    if List.len<Int>(list: read uop_ranges(cache: read cache, id: x)) > 0 { return None }
    local args = List.new<Int>()
    let mut body = x
    if node_op(cache: read cache, id: x) == END && node_num_src(cache: read cache, id: x) > 0 { body = node_src_id(cache: read cache, id: x, k: 0) }
    if node_op(cache: read cache, id: body) == STORE && node_num_src(cache: read cache, id: body) >= 2 {
        let ptr_buf = uop_buf_uop(cache: mut cache, id: node_src_id(cache: read cache, id: body, k: 0))
        if ptr_buf >= 0 { List.push<Int>(list: mut args, value: read ptr_buf) }
        let val_buf = uop_buf_uop(cache: mut cache, id: node_src_id(cache: read cache, id: body, k: 1))
        if val_buf >= 0 && val_buf != ptr_buf { List.push<Int>(list: mut args, value: read val_buf) }
    }
    local call = mk_call_arg(name: read "rangeify_kernel", has_name: true, precompile: false, precompile_backward: false)
    return Some(mk_call(cache: mut cache, body: x, args: read args, call: read call))
}

fn get_kernel_graph(cache: mut UOpCache, sink: Int) -> Int {
    let cleaned = rangeify_apply_syntactic_sugar(cache: mut cache, root: sink)
    local analysis = indexing_run_rangeify_analysis(cache: mut cache, root: cleaned)
    return indexing_apply_rangeify_rewrite(cache: mut cache, root: cleaned, analysis: read analysis)
}
