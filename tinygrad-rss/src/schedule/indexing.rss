// Integrated slice of tinygrad/schedule/indexing.py.
//
// This ports the source-shaped realize-map generation rules used before rangeify,
// range creation, movement/range rewrites, and a cache-backed run_rangeify facade.
features: local

struct IndexingRealizeResult derives(Clone) {
    nodes: List<Int>,
}

struct IndexingRangeRecord derives(Clone) {
    node: Int,
    in_ranges: List<Int>,
    out_ranges: List<Int>,
}

struct IndexingRealizeAxisRecord derives(Clone) {
    node: Int,
    axes: List<Int>,
}

struct IndexingEndingRecord derives(Clone) {
    node: Int,
    ranges: List<Int>,
}

struct IndexingRangeifyResult derives(Clone) {
    records: List<IndexingRangeRecord>,
    realize_axes: List<IndexingRealizeAxisRecord>,
    ok: Bool,
}

struct IndexingContext derives(Clone) {
    next_range: Int,
}

fn indexing_context_new() -> fresh IndexingContext {
    return IndexingContext(next_range: 0)
}

fn indexing_always_contiguous(op: read Ops) -> Bool {
    if op == CONTIGUOUS { return true }
    if op == AFTER { return true }
    if op == COPY { return true }
    if op == BUFFER { return true }
    if op == SLICE { return true }
    if op == CONST { return true }
    if op == BIND { return true }
    if op == DEVICE { return true }
    if op == MSELECT { return true }
    if op == MSTACK { return true }
    if op == PARAM { return true }
    if op == DEFINE_LOCAL { return true }
    if op == DEFINE_REG { return true }
    if op == LOAD { return true }
    if op == CALL { return true }
    if op == FUNCTION { return true }
    return false
}

fn indexing_list_contains(items: read List<Int>, value: Int) -> Bool {
    let mut i = 0
    while i < List.len<Int>(list: read items) {
        if List.get<Int>(list: read items, index: i) == value { return true }
        i = i + 1
    }
    return false
}

fn indexing_add_unique(items: mut List<Int>, value: Int) -> Unit {
    if indexing_list_contains(items: read items, value: value) { return Unit }
    List.push<Int>(list: mut items, value: read value)
    return Unit
}

fn indexing_remove_value(items: mut List<Int>, value: Int) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read items) {
        if List.get<Int>(list: read items, index: i) == value {
            List.remove_at<Int>(list: mut items, index: i)
            return Unit
        }
        i = i + 1
    }
    return Unit
}

fn indexing_backward_slice_with_self_contains(cache: read UOpCache, id: Int, value: Int) -> Bool {
    if id == value { return true }
    local nodes = uop_backward_slice(cache: read cache, id: id)
    return indexing_list_contains(items: read nodes, value: value)
}

fn indexing_store_dest_base(cache: read UOpCache, dest: Int) -> Int {
    if node_op(cache: read cache, id: dest) == INDEX && node_num_src(cache: read cache, id: dest) > 0 {
        return uop_base(cache: read cache, id: node_src_id(cache: read cache, id: dest, k: 0))
    }
    return uop_base(cache: read cache, id: dest)
}

fn indexing_realize_srcs(cache: read UOpCache, realize: mut List<Int>, rb: Int) -> Unit {
    let mut i = 0
    while i < node_num_src(cache: read cache, id: rb) {
        let s = node_src_id(cache: read cache, id: rb, k: i)
        let base = uop_base(cache: read cache, id: s)
        if indexing_always_contiguous(op: read node_op(cache: read cache, id: base)) == false {
            indexing_add_unique(items: mut realize, value: s)
        }
        i = i + 1
    }
    return Unit
}

fn indexing_realize_store_after_src(cache: read UOpCache, realize: mut List<Int>, store: Int) -> Unit {
    if node_op(cache: read cache, id: store) != STORE { return Unit }
    if node_num_src(cache: read cache, id: store) < 2 { return Unit }
    let dest = node_src_id(cache: read cache, id: store, k: 0)
    let src = node_src_id(cache: read cache, id: store, k: 1)
    let sop = node_op(cache: read cache, id: src)
    if sop == COPY || sop == SLICE {
        let mut hazard = false
        if uop_op_in_backward_slice_with_self(cache: read cache, id: dest, op: SHRINK) { hazard = true }
        if uop_op_in_backward_slice_with_self(cache: read cache, id: dest, op: PERMUTE) { hazard = true }
        if uop_op_in_backward_slice_with_self(cache: read cache, id: dest, op: FLIP) { hazard = true }
        if uop_op_in_backward_slice_with_self(cache: read cache, id: dest, op: PAD) { hazard = true }
        if hazard == false { indexing_remove_value(items: mut realize, value: src) }
    }
    let dest_base = indexing_store_dest_base(cache: read cache, dest: dest)
    if indexing_backward_slice_with_self_contains(cache: read cache, id: src, value: dest_base) {
        indexing_add_unique(items: mut realize, value: src)
    }
    return Unit
}

fn indexing_generate_realize_map(cache: read UOpCache, root: Int) -> fresh IndexingRealizeResult {
    local realize = List.new<Int>()
    local order = uop_toposort_enter_calls(cache: read cache, id: root, enter_calls: false)
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let u = List.get<Int>(list: read order, index: i)
        let op = node_op(cache: read cache, id: u)
        if op == COPY || op == CONTIGUOUS || op == STORE {
            indexing_add_unique(items: mut realize, value: u)
        }
        if op == COPY || op == MSELECT || op == MSTACK {
            indexing_realize_srcs(cache: read cache, realize: mut realize, rb: u)
        }
        if op == STORE {
            indexing_realize_store_after_src(cache: read cache, realize: mut realize, store: u)
        }
        i = i + 1
    }
    return IndexingRealizeResult(nodes: take realize)
}

fn realize(ctx: mut List<Int>, tr: Int) -> Unit {
    indexing_add_unique(items: mut ctx, value: tr)
    return Unit
}

fn realize_srcs(cache: read UOpCache, ctx: mut List<Int>, rb: Int) -> Unit {
    indexing_realize_srcs(cache: read cache, realize: mut ctx, rb: rb)
    return Unit
}

fn realize_store_after_src(cache: read UOpCache, ctx: mut List<Int>, store: Int) -> Unit {
    indexing_realize_store_after_src(cache: read cache, realize: mut ctx, store: store)
    return Unit
}

fn indexing_new_range(cache: mut UOpCache, ctx: mut IndexingContext, size: Int, axis_type: read AxisType) -> Int {
    let dt = dt_weakint()
    if size == 1 { return mk_const_int(cache: mut cache, dt: read dt, v: 0) }
    let axis = ctx.next_range
    ctx.next_range = ctx.next_range + 1
    return mk_range_int(cache: mut cache, end: size, axis_id: axis, axis_type: read axis_type, dt: read dt)
}

fn new_range(cache: mut UOpCache, ctx: mut IndexingContext, size: Int, axistype: read AxisType) -> Int {
    return indexing_new_range(cache: mut cache, ctx: mut ctx, size: size, axis_type: read axistype)
}

fn indexing_ranges_for_shape(cache: mut UOpCache, ctx: mut IndexingContext, shape: read List<Int>, axis_type: read AxisType) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        let sz = List.get<Int>(list: read shape, index: i)
        let r = indexing_new_range(cache: mut cache, ctx: mut ctx, size: sz, axis_type: read axis_type)
        List.push<Int>(list: mut out, value: read r)
        i = i + 1
    }
    return take out
}

fn indexing_apply_shrink(cache: mut UOpCache, rngs: read List<Int>, starts: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read rngs) {
        let r = List.get<Int>(list: read rngs, index: i)
        let off = List.get<Int>(list: read starts, index: i)
        if off == 0 {
            List.push<Int>(list: mut out, value: read r)
        } else {
            let c = mk_const_int(cache: mut cache, dt: read node_dtype(cache: read cache, id: r), v: off)
            let nr = mk_alu2(cache: mut cache, op: ADD, dt: read node_dtype(cache: read cache, id: r), x: r, y: c)
            List.push<Int>(list: mut out, value: read nr)
        }
        i = i + 1
    }
    return take out
}

fn indexing_apply_permute(rngs: read List<Int>, perm: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read perm) {
        let p = List.get<Int>(list: read perm, index: i)
        List.push<Int>(list: mut out, value: read List.get<Int>(list: read rngs, index: p))
        i = i + 1
    }
    return take out
}

fn indexing_apply_flip(cache: mut UOpCache, rngs: read List<Int>, in_shape: read List<Int>, axes: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read rngs) {
        let r = List.get<Int>(list: read rngs, index: i)
        if int_contains(items: read axes, v: i) {
            let dt = node_dtype(cache: read cache, id: r)
            let sz = List.get<Int>(list: read in_shape, index: i)
            let c = mk_const_int(cache: mut cache, dt: read dt, v: sz - 1)
            let nr = mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: c, y: r)
            List.push<Int>(list: mut out, value: read nr)
        } else {
            List.push<Int>(list: mut out, value: read r)
        }
        i = i + 1
    }
    return take out
}

fn indexing_apply_expand(cache: mut UOpCache, rngs: read List<Int>, in_shape: read List<Int>, out_shape: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read rngs) {
        let r = List.get<Int>(list: read rngs, index: i)
        let ish = List.get<Int>(list: read in_shape, index: i)
        let osh = List.get<Int>(list: read out_shape, index: i)
        if ish == osh {
            List.push<Int>(list: mut out, value: read r)
        } else {
            let z = mk_const_int(cache: mut cache, dt: read node_dtype(cache: read cache, id: r), v: 0)
            List.push<Int>(list: mut out, value: read z)
        }
        i = i + 1
    }
    return take out
}

fn indexing_bool_const(cache: mut UOpCache, v: Int) -> Int {
    return mk_const_int(cache: mut cache, dt: read dt_bool(), v: v)
}

fn indexing_ge_const(cache: mut UOpCache, r: Int, value: Int) -> Int {
    if value <= 0 { return indexing_bool_const(cache: mut cache, v: 1) }
    let dt = node_dtype(cache: read cache, id: r)
    let c = mk_const_int(cache: mut cache, dt: read dt, v: value - 1)
    return mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: c, y: r)
}

fn indexing_lt_const(cache: mut UOpCache, r: Int, value: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: r)
    let c = mk_const_int(cache: mut cache, dt: read dt, v: value)
    return mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: r, y: c)
}

fn indexing_apply_pad(cache: mut UOpCache, rngs: read List<Int>, in_shape: read List<Int>, pad_arg: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let rank = List.len<Int>(list: read in_shape)
    let mut i = 0
    while i < rank {
        let r = List.get<Int>(list: read rngs, index: i)
        let sh = List.get<Int>(list: read in_shape, index: i)
        let before = List.get<Int>(list: read pad_arg, index: i)
        let after = List.get<Int>(list: read pad_arg, index: i + rank)
        if before == 0 && after == 0 {
            List.push<Int>(list: mut out, value: read r)
        } else {
            let dt = node_dtype(cache: read cache, id: r)
            let lo_ok = indexing_ge_const(cache: mut cache, r: r, value: before)
            let hi_ok = indexing_lt_const(cache: mut cache, r: r, value: sh + before)
            let cond = mk_alu2(cache: mut cache, op: AND, dt: read dt_bool(), x: lo_ok, y: hi_ok)
            let mut idx = r
            if before != 0 {
                let off = mk_const_int(cache: mut cache, dt: read dt, v: before)
                idx = mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: r, y: off)
            }
            let valid = uop_valid(cache: mut cache, id: idx, cond: cond)
            List.push<Int>(list: mut out, value: read valid)
        }
        i = i + 1
    }
    return take out
}

fn indexing_mul_const(cache: mut UOpCache, x: Int, value: Int) -> Int {
    if value == 1 { return x }
    let dt = node_dtype(cache: read cache, id: x)
    let c = mk_const_int(cache: mut cache, dt: read dt, v: value)
    return mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: x, y: c)
}

fn indexing_add(cache: mut UOpCache, a: Int, b: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: a)
    return mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: a, y: b)
}

fn indexing_floordiv_const(cache: mut UOpCache, x: Int, value: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    let c = mk_const_int(cache: mut cache, dt: read dt, v: value)
    return mk_alu2(cache: mut cache, op: FLOORDIV, dt: read dt, x: x, y: c)
}

fn indexing_floormod_const(cache: mut UOpCache, x: Int, value: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: x)
    let c = mk_const_int(cache: mut cache, dt: read dt, v: value)
    return mk_alu2(cache: mut cache, op: FLOORMOD, dt: read dt, x: x, y: c)
}

fn indexing_shape_equals(a: read List<Int>, b: read List<Int>) -> Bool {
    if List.len<Int>(list: read a) != List.len<Int>(list: read b) { return false }
    let mut i = 0
    while i < List.len<Int>(list: read a) {
        if List.get<Int>(list: read a, index: i) != List.get<Int>(list: read b, index: i) { return false }
        i = i + 1
    }
    return true
}

fn indexing_copy_ranges(rngs: read List<Int>) -> fresh List<Int> {
    return rngs.clone()
}

fn indexing_apply_reshape(cache: mut UOpCache, rngs: read List<Int>, in_shape: read List<Int>, out_shape: read List<Int>) -> fresh List<Int> {
    if indexing_shape_equals(a: read in_shape, b: read out_shape) {
        return indexing_copy_ranges(rngs: read rngs)
    }
    let dt = dt_weakint()
    let mut flat = mk_const_int(cache: mut cache, dt: read dt, v: 0)
    let mut stride = 1
    let mut oi = List.len<Int>(list: read out_shape) - 1
    while oi >= 0 {
        let r = List.get<Int>(list: read rngs, index: oi)
        let term = indexing_mul_const(cache: mut cache, x: r, value: stride)
        flat = indexing_add(cache: mut cache, a: flat, b: term)
        stride = stride * List.get<Int>(list: read out_shape, index: oi)
        oi = oi - 1
    }
    local rev = List.new<Int>()
    let mut cur = flat
    let mut ii = List.len<Int>(list: read in_shape) - 1
    while ii >= 0 {
        let s = List.get<Int>(list: read in_shape, index: ii)
        let coord = indexing_floormod_const(cache: mut cache, x: cur, value: s)
        List.push<Int>(list: mut rev, value: read coord)
        cur = indexing_floordiv_const(cache: mut cache, x: cur, value: s)
        ii = ii - 1
    }
    local out = List.new<Int>()
    let mut ri = List.len<Int>(list: read rev) - 1
    while ri >= 0 {
        let simplified = graph_rewrite(cache: mut cache, id: List.get<Int>(list: read rev, index: ri))
        List.push<Int>(list: mut out, value: read simplified)
        ri = ri - 1
    }
    return take out
}

fn _apply_reshape(cache: mut UOpCache, in_shape: read List<Int>, out_shape: read List<Int>, urngs: read List<Int>) -> fresh List<Int> {
    return indexing_apply_reshape(cache: mut cache, rngs: read urngs, in_shape: read in_shape, out_shape: read out_shape)
}

fn indexing_apply_movement_op(cache: mut UOpCache, op: read Ops, in_shape: read List<Int>, arg: read List<Int>, rngs: read List<Int>) -> fresh List<Int> {
    if op == SHRINK {
        local starts = List.new<Int>()
        let rank = List.len<Int>(list: read in_shape)
        let mut i = 0
        while i < rank {
            List.push<Int>(list: mut starts, value: read List.get<Int>(list: read arg, index: i))
            i = i + 1
        }
        return indexing_apply_shrink(cache: mut cache, rngs: read rngs, starts: read starts)
    }
    if op == PERMUTE { return indexing_apply_permute(rngs: read rngs, perm: read arg) }
    if op == FLIP { return indexing_apply_flip(cache: mut cache, rngs: read rngs, in_shape: read in_shape, axes: read arg) }
    if op == EXPAND { return indexing_apply_expand(cache: mut cache, rngs: read rngs, in_shape: read in_shape, out_shape: read arg) }
    if op == PAD { return indexing_apply_pad(cache: mut cache, rngs: read rngs, in_shape: read in_shape, pad_arg: read arg) }
    if op == RESHAPE { return indexing_apply_reshape(cache: mut cache, rngs: read rngs, in_shape: read in_shape, out_shape: read arg) }
    local out = List.new<Int>()
    let mut j = 0
    while j < List.len<Int>(list: read rngs) {
        List.push<Int>(list: mut out, value: read List.get<Int>(list: read rngs, index: j))
        j = j + 1
    }
    return take out
}

fn apply_movement_op(cache: mut UOpCache, op: read Ops, in_shape: read List<Int>, arg: read List<Int>, rngs: read List<Int>) -> fresh List<Int> {
    return indexing_apply_movement_op(cache: mut cache, op: read op, in_shape: read in_shape, arg: read arg, rngs: read rngs)
}

fn indexing_record_index(records: read List<IndexingRangeRecord>, node: Int) -> Int {
    let mut i = 0
    while i < List.len<IndexingRangeRecord>(list: read records) {
        let rec = List.get<IndexingRangeRecord>(list: read records, index: i)
        if rec.node == node { return i }
        i = i + 1
    }
    return 0 - 1
}

fn indexing_realize_axis_index(records: read List<IndexingRealizeAxisRecord>, node: Int) -> Int {
    let mut i = 0
    while i < List.len<IndexingRealizeAxisRecord>(list: read records) {
        let rec = List.get<IndexingRealizeAxisRecord>(list: read records, index: i)
        if rec.node == node { return i }
        i = i + 1
    }
    return 0 - 1
}

fn indexing_consumer_uses(cache: read UOpCache, consumer: Int, node: Int) -> Bool {
    let mut i = 0
    while i < node_num_src(cache: read cache, id: consumer) {
        if node_src_id(cache: read cache, id: consumer, k: i) == node { return true }
        i = i + 1
    }
    return false
}

fn indexing_collect_consumer_records(cache: read UOpCache, order: read List<Int>, records: read List<IndexingRangeRecord>, node: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let cand = List.get<Int>(list: read order, index: i)
        if indexing_consumer_uses(cache: read cache, consumer: cand, node: node) {
            let ri = indexing_record_index(records: read records, node: cand)
            if ri >= 0 { indexing_add_unique(items: mut out, value: ri) }
        }
        i = i + 1
    }
    return take out
}

fn indexing_all_axes(rank: Int) -> fresh List<Int> {
    local axes = List.new<Int>()
    let mut i = 0
    while i < rank {
        List.push<Int>(list: mut axes, value: read i)
        i = i + 1
    }
    return take axes
}

fn indexing_ending_record_index(records: read List<IndexingEndingRecord>, node: Int) -> Int {
    let mut i = 0
    while i < List.len<IndexingEndingRecord>(list: read records) {
        let rec = List.get<IndexingEndingRecord>(list: read records, index: i)
        if rec.node == node { return i }
        i = i + 1
    }
    return 0 - 1
}

fn indexing_collect_consumer_ending_ranges(cache: read UOpCache, order: read List<Int>, endings: read List<IndexingEndingRecord>, node: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let cand = List.get<Int>(list: read order, index: i)
        if indexing_consumer_uses(cache: read cache, consumer: cand, node: node) {
            let ei = indexing_ending_record_index(records: read endings, node: cand)
            if ei >= 0 {
                let rec = List.get<IndexingEndingRecord>(list: read endings, index: ei)
                let mut j = 0
                while j < List.len<Int>(list: read rec.ranges) {
                    indexing_add_unique(items: mut out, value: List.get<Int>(list: read rec.ranges, index: j))
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return take out
}

fn indexing_set_ending_ranges(endings: mut List<IndexingEndingRecord>, node: Int, ranges: read List<Int>) -> Unit {
    let mut i = 0
    while i < List.len<IndexingEndingRecord>(list: read endings) {
        let rec = List.get<IndexingEndingRecord>(list: read endings, index: i)
        if rec.node == node {
            local copied = copy_int_list(l: read ranges)
            local nr = IndexingEndingRecord(node: node, ranges: take copied)
            List.set<IndexingEndingRecord>(list: mut endings, index: i, value: read manage nr)
            return Unit
        }
        i = i + 1
    }
    local copied2 = copy_int_list(l: read ranges)
    local nr2 = IndexingEndingRecord(node: node, ranges: take copied2)
    List.push<IndexingEndingRecord>(list: mut endings, value: read manage nr2)
    return Unit
}

fn indexing_collect_expand_ended_ranges(cache: read UOpCache, out_ranges: read List<Int>, in_ranges: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read out_ranges) {
        let ro = List.get<Int>(list: read out_ranges, index: i)
        let ri = List.get<Int>(list: read in_ranges, index: i)
        if ro != ri {
            local rr = uop_ranges(cache: read cache, id: ro)
            let mut j = 0
            while j < List.len<Int>(list: read rr) {
                indexing_add_unique(items: mut out, value: List.get<Int>(list: read rr, index: j))
                j = j + 1
            }
        }
        i = i + 1
    }
    return take out
}

fn indexing_consumer_axis_same_idx(cache: read UOpCache, records: read List<IndexingRangeRecord>, consumers: read List<Int>, axis: Int) -> Bool {
    if List.len<Int>(list: read consumers) == 0 { return false }
    let first_rec = List.get<IndexingRangeRecord>(list: read records, index: List.get<Int>(list: read consumers, index: 0))
    if axis >= List.len<Int>(list: read first_rec.in_ranges) { return false }
    let first_idx = uop_get_idx(cache: read cache, id: List.get<Int>(list: read first_rec.in_ranges, index: axis))
    let mut i = 1
    while i < List.len<Int>(list: read consumers) {
        let rec = List.get<IndexingRangeRecord>(list: read records, index: List.get<Int>(list: read consumers, index: i))
        if axis >= List.len<Int>(list: read rec.in_ranges) { return false }
        let idx = uop_get_idx(cache: read cache, id: List.get<Int>(list: read rec.in_ranges, index: axis))
        if idx != first_idx { return false }
        i = i + 1
    }
    return true
}

fn indexing_merge_consumer_axis(cache: mut UOpCache, records: read List<IndexingRangeRecord>, consumers: read List<Int>, axis: Int) -> Int {
    let first_rec = List.get<IndexingRangeRecord>(list: read records, index: List.get<Int>(list: read consumers, index: 0))
    let first_range = List.get<Int>(list: read first_rec.in_ranges, index: axis)
    let idx = uop_get_idx(cache: read cache, id: first_range)
    let mut valid = mk_const_int(cache: mut cache, dt: read dt_bool(), v: 0)
    let mut i = 0
    while i < List.len<Int>(list: read consumers) {
        let rec = List.get<IndexingRangeRecord>(list: read records, index: List.get<Int>(list: read consumers, index: i))
        let r = List.get<Int>(list: read rec.in_ranges, index: axis)
        let rv = uop_get_valid(cache: mut cache, id: r)
        valid = mk_alu2(cache: mut cache, op: OR, dt: read dt_bool(), x: valid, y: rv)
        i = i + 1
    }
    let simplified_valid = graph_rewrite(cache: mut cache, id: valid)
    let merged = uop_valid(cache: mut cache, id: idx, cond: simplified_valid)
    return graph_rewrite(cache: mut cache, id: merged)
}

fn indexing_merge_multi_consumer_ranges(cache: mut UOpCache, ctx: mut IndexingContext, records: read List<IndexingRangeRecord>, realize_axes: mut List<IndexingRealizeAxisRecord>, node: Int, shape: read List<Int>, consumers: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    local axes = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if indexing_consumer_axis_same_idx(cache: read cache, records: read records, consumers: read consumers, axis: i) {
            let merged = indexing_merge_consumer_axis(cache: mut cache, records: read records, consumers: read consumers, axis: i)
            List.push<Int>(list: mut out, value: read merged)
        } else {
            let nr = indexing_new_range(cache: mut cache, ctx: mut ctx, size: List.get<Int>(list: read shape, index: i), axis_type: read AXIS_LOOP)
            List.push<Int>(list: mut out, value: read nr)
            List.push<Int>(list: mut axes, value: read i)
        }
        i = i + 1
    }
    if List.len<Int>(list: read axes) > 0 {
        indexing_add_realize_axes(realize_axes: mut realize_axes, node: node, axes: read axes)
    }
    return take out
}

fn indexing_add_realize_axes(realize_axes: mut List<IndexingRealizeAxisRecord>, node: Int, axes: read List<Int>) -> Unit {
    let mut i = 0
    while i < List.len<IndexingRealizeAxisRecord>(list: read realize_axes) {
        let rec = List.get<IndexingRealizeAxisRecord>(list: read realize_axes, index: i)
        if rec.node == node {
            local merged = copy_int_list(l: read rec.axes)
            let mut j = 0
            while j < List.len<Int>(list: read axes) {
                indexing_add_unique(items: mut merged, value: List.get<Int>(list: read axes, index: j))
                j = j + 1
            }
            local nr = IndexingRealizeAxisRecord(node: node, axes: take merged)
            List.set<IndexingRealizeAxisRecord>(list: mut realize_axes, index: i, value: read manage nr)
            return Unit
        }
        i = i + 1
    }
    local copied = copy_int_list(l: read axes)
    local rec = IndexingRealizeAxisRecord(node: node, axes: take copied)
    List.push<IndexingRealizeAxisRecord>(list: mut realize_axes, value: read manage rec)
    return Unit
}

fn indexing_apply_ending_realization(cache: mut UOpCache, ctx: mut IndexingContext, realize_axes: mut List<IndexingRealizeAxisRecord>, node: Int, out_ranges: read List<Int>, shape: read List<Int>, ended_ranges: read List<Int>) -> fresh List<Int> {
    let op = node_op(cache: read cache, id: node)
    if List.len<Int>(list: read ended_ranges) == 0 { return copy_int_list(l: read out_ranges) }
    if group_elementwise(op: read op) == false && op != REDUCE { return copy_int_list(l: read out_ranges) }
    let mut axes = List.new<Int>()
    let rai = indexing_realize_axis_index(records: read realize_axes, node: node)
    if rai >= 0 {
        let rec = List.get<IndexingRealizeAxisRecord>(list: read realize_axes, index: rai)
        axes = copy_int_list(l: read rec.axes)
    }
    let mut i = 0
    while i < List.len<Int>(list: read out_ranges) {
        if indexing_list_contains(items: read axes, value: i) == false {
            List.push<Int>(list: mut axes, value: read i)
        }
        i = i + 1
    }
    if List.len<Int>(list: read axes) > 0 {
        indexing_add_realize_axes(realize_axes: mut realize_axes, node: node, axes: read axes)
    }
    local out = List.new<Int>()
    let mut j = 0
    while j < List.len<Int>(list: read out_ranges) {
        if indexing_list_contains(items: read axes, value: j) {
            let nr = indexing_new_range(cache: mut cache, ctx: mut ctx, size: List.get<Int>(list: read shape, index: j), axis_type: read AXIS_LOOP)
            List.push<Int>(list: mut out, value: read nr)
        } else {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read out_ranges, index: j))
        }
        j = j + 1
    }
    return take out
}

fn indexing_is_rangeify_skip(cache: read UOpCache, id: Int) -> Bool {
    let op = node_op(cache: read cache, id: id)
    if op == DEVICE || op == UNIQUE { return true }
    if op == CALL || op == FUNCTION || op == LINEAR { return true }
    if op == AFTER { return true }
    if op == MSTACK || op == MSELECT { return true }
    if node_dtype(cache: read cache, id: id).name == "weakint" { return true }
    return false
}

fn indexing_movement_arg_for_node(cache: read UOpCache, id: Int) -> fresh List<Int> {
    let op = node_op(cache: read cache, id: id)
    if op == RESHAPE || op == EXPAND { return uop_shape(cache: read cache, id: id) }
    if op == SHRINK || op == PAD {
        local out = List.new<Int>()
        if node_num_src(cache: read cache, id: id) > 1 {
            local a = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1))
            let mut i = 0
            while i < List.len<Int>(list: read a) {
                List.push<Int>(list: mut out, value: read List.get<Int>(list: read a, index: i))
                i = i + 1
            }
        }
        if node_num_src(cache: read cache, id: id) > 2 {
            local b = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 2))
            let mut j = 0
            while j < List.len<Int>(list: read b) {
                List.push<Int>(list: mut out, value: read List.get<Int>(list: read b, index: j))
                j = j + 1
            }
        }
        return take out
    }
    return node_argints(cache: read cache, id: id)
}

fn indexing_reduce_input_ranges(cache: mut UOpCache, ctx: mut IndexingContext, reduce: Int, out_ranges: read List<Int>) -> fresh List<Int> {
    local axes = node_argints(cache: read cache, id: reduce)
    if List.len<Int>(list: read axes) == 0 { return copy_int_list(l: read out_ranges) }
    let src = node_src_id(cache: read cache, id: reduce, k: 0)
    local src_shape = uop_shape(cache: read cache, id: src)
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read src_shape) {
        if int_contains(items: read axes, v: i) {
            let r = indexing_new_range(cache: mut cache, ctx: mut ctx, size: List.get<Int>(list: read src_shape, index: i), axis_type: read AXIS_REDUCE)
            List.push<Int>(list: mut out, value: read r)
        } else {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read out_ranges, index: i))
        }
        i = i + 1
    }
    return take out
}

fn indexing_source_like(op: read Ops) -> Bool {
    if op == PARAM || op == BUFFER || op == SLICE || op == MSTACK || op == MSELECT || op == AFTER { return true }
    return false
}

fn indexing_select_axes(items: read List<Int>, axes: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read axes) {
        let ax = List.get<Int>(list: read axes, index: i)
        if ax >= 0 && ax < List.len<Int>(list: read items) {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read items, index: ax))
        }
        i = i + 1
    }
    return take out
}

fn indexing_reduce_with_ranges(cache: mut UOpCache, id: Int, src0: Int, ranges: read List<Int>) -> Int {
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read src0)
    let mut i = 0
    while i < List.len<Int>(list: read ranges) {
        List.push<Int>(list: mut src, value: read List.get<Int>(list: read ranges, index: i))
        i = i + 1
    }
    local axes = List.new<Int>()
    local r = ReduceArg(kind: node_reduce_kind(cache: read cache, id: id), axes: take axes)
    local a = ArgReduce(value: take r)
    return intern(cache: mut cache, op: REDUCE, dt: read node_full_dtype(cache: read cache, id: id), src: take src, arg: take a)
}

fn indexing_zero_like(cache: mut UOpCache, like: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: like)
    if dtype_is_float(d: read dt) { return mk_const_float(cache: mut cache, dt: read dt, v: 0.0) }
    return mk_const_int(cache: mut cache, dt: read dt, v: 0)
}

fn indexing_valid_product(cache: mut UOpCache, ranges: read List<Int>) -> Int {
    let mut valid = mk_const_int(cache: mut cache, dt: read dt_bool(), v: 1)
    let mut i = 0
    while i < List.len<Int>(list: read ranges) {
        let v = uop_get_valid(cache: mut cache, id: List.get<Int>(list: read ranges, index: i))
        valid = mk_alu2(cache: mut cache, op: AND, dt: read dt_bool(), x: valid, y: v)
        i = i + 1
    }
    return valid
}

fn indexing_stage_opts(cache: read UOpCache, parent_orig: Int, child_orig: Int, out_ranges: read List<Int>, realized_axes: read List<Int>) -> fresh BufferizeArg {
    let parent_op = node_op(cache: read cache, id: parent_orig)
    let child_op = node_op(cache: read cache, id: child_orig)
    let removable = parent_op != COPY && indexing_always_contiguous(op: read child_op) == false
    if List.len<Int>(list: read out_ranges) == List.len<Int>(list: read realized_axes) {
        if node_effective_device_count(cache: read cache, id: child_orig) > 0 {
            local child_device = node_effective_device_name(cache: read cache, id: child_orig, index: 0)
            if String.len(value: read child_device) > 0 {
                return mk_bufferize_arg_device(device: read child_device, addrspace: read ADDR_GLOBAL, removable: removable)
            }
        }
        if node_effective_device_count(cache: read cache, id: parent_orig) > 0 {
            local parent_device = node_effective_device_name(cache: read cache, id: parent_orig, index: 0)
            if String.len(value: read parent_device) > 0 {
                return mk_bufferize_arg_device(device: read parent_device, addrspace: read ADDR_GLOBAL, removable: removable)
            }
        }
        return mk_bufferize_arg_none(addrspace: read ADDR_GLOBAL, removable: removable)
    }
    return mk_bufferize_arg_none(addrspace: read ADDR_LOCAL, removable: removable)
}

fn indexing_rewrite_child_for_ranges(cache: mut UOpCache, analysis: read IndexingRangeifyResult, parent_orig: Int, parent_rec_i: Int, child_orig: Int, child_rewritten: Int) -> Int {
    let child_op = node_op(cache: read cache, id: child_orig)
    if parent_rec_i >= 0 && indexing_source_like(op: read child_op) {
        let prec = List.get<IndexingRangeRecord>(list: read analysis.records, index: parent_rec_i)
        return mk_index(cache: mut cache, base: child_rewritten, srcs: read prec.in_ranges, ptr: false)
    }
    let rai = indexing_realize_axis_index(records: read analysis.realize_axes, node: child_orig)
    if rai >= 0 {
        let child_rec_i = indexing_record_index(records: read analysis.records, node: child_orig)
        if child_rec_i >= 0 {
            let child_rec = List.get<IndexingRangeRecord>(list: read analysis.records, index: child_rec_i)
            let arec = List.get<IndexingRealizeAxisRecord>(list: read analysis.realize_axes, index: rai)
            local closed = indexing_select_axes(items: read child_rec.out_ranges, axes: read arec.axes)
            let opts = indexing_stage_opts(cache: read cache, parent_orig: parent_orig, child_orig: child_orig, out_ranges: read child_rec.out_ranges, realized_axes: read arec.axes)
            let staged = mk_stage(cache: mut cache, x: child_rewritten, ranges: read closed, opts: read opts)
            if parent_rec_i >= 0 {
                let prec = List.get<IndexingRangeRecord>(list: read analysis.records, index: parent_rec_i)
                return mk_index(cache: mut cache, base: staged, srcs: read prec.in_ranges, ptr: false)
            }
            return staged
        }
    }
    return child_rewritten
}

fn indexing_rangeify_rewrite_node(cache: mut UOpCache, id: Int, analysis: read IndexingRangeifyResult, olds: mut List<Int>, news: mut List<Int>) -> Int {
    let mut mi = 0
    while mi < List.len<Int>(list: read olds) {
        if id == List.get<Int>(list: read olds, index: mi) { return List.get<Int>(list: read news, index: mi) }
        mi = mi + 1
    }
    let rec_i = indexing_record_index(records: read analysis.records, node: id)
    let op = node_op(cache: read cache, id: id)
    local rewritten_src = List.new<Int>()
    let mut si = 0
    while si < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: si)
        let child_rewritten = indexing_rangeify_rewrite_node(cache: mut cache, id: child, analysis: read analysis, olds: mut olds, news: mut news)
        let adjusted = indexing_rewrite_child_for_ranges(cache: mut cache, analysis: read analysis, parent_orig: id, parent_rec_i: rec_i, child_orig: child, child_rewritten: child_rewritten)
        List.push<Int>(list: mut rewritten_src, value: read adjusted)
        si = si + 1
    }
    let mut out = id
    if op == REDUCE && rec_i >= 0 && List.len<Int>(list: read node_argints(cache: read cache, id: id)) > 0 {
        let rec = List.get<IndexingRangeRecord>(list: read analysis.records, index: rec_i)
        local axes = node_argints(cache: read cache, id: id)
        local reduce_ranges = indexing_select_axes(items: read rec.in_ranges, axes: read axes)
        out = indexing_reduce_with_ranges(cache: mut cache, id: id, src0: List.get<Int>(list: read rewritten_src, index: 0), ranges: read reduce_ranges)
    } else {
        if op == PAD && rec_i >= 0 {
            let rec = List.get<IndexingRangeRecord>(list: read analysis.records, index: rec_i)
            let tval = List.get<Int>(list: read rewritten_src, index: 0)
            let valid = indexing_valid_product(cache: mut cache, ranges: read rec.in_ranges)
            let zero = indexing_zero_like(cache: mut cache, like: tval)
            out = mk_where(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: tval), cond: valid, tval: tval, fval: zero)
        } else {
            if group_movement(op: read op) && rec_i >= 0 {
                out = List.get<Int>(list: read rewritten_src, index: 0)
            } else {
                if node_num_src(cache: read cache, id: id) > 0 {
                    local arg = node_arg(cache: read cache, id: id)
                    out = intern(cache: mut cache, op: op, dt: read node_full_dtype(cache: read cache, id: id), src: take rewritten_src, arg: take arg)
                }
            }
        }
    }
    List.push<Int>(list: mut olds, value: read id)
    List.push<Int>(list: mut news, value: read out)
    return out
}

fn indexing_apply_rangeify_rewrite(cache: mut UOpCache, root: Int, analysis: read IndexingRangeifyResult) -> Int {
    local olds = List.new<Int>()
    local news = List.new<Int>()
    return indexing_rangeify_rewrite_node(cache: mut cache, id: root, analysis: read analysis, olds: mut olds, news: mut news)
}

fn indexing_run_rangeify_analysis(cache: mut UOpCache, root: Int) -> fresh IndexingRangeifyResult {
    local rctx = indexing_context_new()
    local realized = indexing_generate_realize_map(cache: read cache, root: root)
    local records = List.new<IndexingRangeRecord>()
    local realize_axes = List.new<IndexingRealizeAxisRecord>()
    local endings = List.new<IndexingEndingRecord>()
    local order = uop_toposort_enter_calls(cache: read cache, id: root, enter_calls: false)
    let mut oi = List.len<Int>(list: read order) - 1
    while oi >= 0 {
        let x = List.get<Int>(list: read order, index: oi)
        if indexing_is_rangeify_skip(cache: read cache, id: x) == false {
            let mut out_rngs = List.new<Int>()
            local shape = uop_shape(cache: read cache, id: x)
            let mut ended_ranges = indexing_collect_consumer_ending_ranges(cache: read cache, order: read order, endings: read endings, node: x)
            if indexing_list_contains(items: read realized.nodes, value: x) {
                out_rngs = indexing_ranges_for_shape(cache: mut cache, ctx: mut rctx, shape: read shape, axis_type: read AXIS_LOOP)
                local axes = indexing_all_axes(rank: List.len<Int>(list: read shape))
                indexing_add_realize_axes(realize_axes: mut realize_axes, node: x, axes: read axes)
                local cleared = List.new<Int>()
                ended_ranges = take cleared
            } else {
                local consumers = indexing_collect_consumer_records(cache: read cache, order: read order, records: read records, node: x)
                if List.len<Int>(list: read consumers) == 1 {
                    let cr = List.get<IndexingRangeRecord>(list: read records, index: List.get<Int>(list: read consumers, index: 0))
                    out_rngs = copy_int_list(l: read cr.in_ranges)
                } else {
                    if List.len<Int>(list: read consumers) > 1 {
                        out_rngs = indexing_merge_multi_consumer_ranges(cache: mut cache, ctx: mut rctx, records: read records, realize_axes: mut realize_axes, node: x, shape: read shape, consumers: read consumers)
                    }
                }
            }
            if List.len<Int>(list: read out_rngs) > 0 || List.len<Int>(list: read shape) == 0 {
                out_rngs = indexing_apply_ending_realization(cache: mut cache, ctx: mut rctx, realize_axes: mut realize_axes, node: x, out_ranges: read out_rngs, shape: read shape, ended_ranges: read ended_ranges)
                let mut in_rngs = copy_int_list(l: read out_rngs)
                let op = node_op(cache: read cache, id: x)
                if group_movement(op: read op) {
                    let src = node_src_id(cache: read cache, id: x, k: 0)
                    local src_shape = uop_shape(cache: read cache, id: src)
                    local marg = indexing_movement_arg_for_node(cache: read cache, id: x)
                    in_rngs = indexing_apply_movement_op(cache: mut cache, op: read op, in_shape: read src_shape, arg: read marg, rngs: read out_rngs)
                }
                if op == EXPAND {
                    local expanded_ended = indexing_collect_expand_ended_ranges(cache: read cache, out_ranges: read out_rngs, in_ranges: read in_rngs)
                    let mut ee = 0
                    while ee < List.len<Int>(list: read expanded_ended) {
                        indexing_add_unique(items: mut ended_ranges, value: List.get<Int>(list: read expanded_ended, index: ee))
                        ee = ee + 1
                    }
                }
                if op == REDUCE { in_rngs = indexing_reduce_input_ranges(cache: mut cache, ctx: mut rctx, reduce: x, out_ranges: read out_rngs) }
                local in_copy = copy_int_list(l: read in_rngs)
                local out_copy = copy_int_list(l: read out_rngs)
                local rec = IndexingRangeRecord(node: x, in_ranges: take in_copy, out_ranges: take out_copy)
                List.push<IndexingRangeRecord>(list: mut records, value: read manage rec)
                indexing_set_ending_ranges(endings: mut endings, node: x, ranges: read ended_ranges)
            }
        }
        oi = oi - 1
    }
    return IndexingRangeifyResult(records: take records, realize_axes: take realize_axes, ok: true)
}

fn create_bufferize_and_index_based_on_ranges(cache: mut UOpCache, analysis: read IndexingRangeifyResult, parent: Int, child: Int, child_rewritten: Int) -> Option<Int> {
    let parent_rec_i = indexing_record_index(records: read analysis.records, node: parent)
    let adjusted = indexing_rewrite_child_for_ranges(cache: mut cache, analysis: read analysis, parent_orig: parent, parent_rec_i: parent_rec_i, child_orig: child, child_rewritten: child_rewritten)
    if adjusted == child_rewritten { return None }
    return Some(adjusted)
}

fn convert_pad_to_where_to_keep_behavior_local(cache: mut UOpCache, analysis: read IndexingRangeifyResult, x: Int, value: Int) -> Option<Int> {
    let rec_i = indexing_record_index(records: read analysis.records, node: x)
    if rec_i < 0 { return None }
    let rec = List.get<IndexingRangeRecord>(list: read analysis.records, index: rec_i)
    let valid = indexing_valid_product(cache: mut cache, ranges: read rec.in_ranges)
    let zero = indexing_zero_like(cache: mut cache, like: value)
    return Some(mk_where(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: value), cond: valid, tval: value, fval: zero))
}

fn convert_reduce_to_reduce_with_ranges(cache: mut UOpCache, analysis: read IndexingRangeifyResult, x: Int, src0: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != REDUCE { return None }
    if List.len<Int>(list: read node_argints(cache: read cache, id: x)) == 0 { return None }
    let rec_i = indexing_record_index(records: read analysis.records, node: x)
    if rec_i < 0 { return None }
    let rec = List.get<IndexingRangeRecord>(list: read analysis.records, index: rec_i)
    local axes = node_argints(cache: read cache, id: x)
    local reduce_ranges = indexing_select_axes(items: read rec.in_ranges, axes: read axes)
    return Some(indexing_reduce_with_ranges(cache: mut cache, id: x, src0: src0, ranges: read reduce_ranges))
}

fn remove_movement_op_after_rangeify(cache: read UOpCache, analysis: read IndexingRangeifyResult, x: Int) -> Option<Int> {
    let rec_i = indexing_record_index(records: read analysis.records, node: x)
    if rec_i < 0 { return None }
    let op = node_op(cache: read cache, id: x)
    if group_movement(op: read op) == false { return None }
    if node_num_src(cache: read cache, id: x) <= 0 { return None }
    return Some(node_src_id(cache: read cache, id: x, k: 0))
}

fn run_rangeify(cache: mut UOpCache, tsink: Int, debug: Bool) -> fresh IndexingRangeifyResult {
    if debug {
        if node_num_src(cache: read cache, id: tsink) < 0 { return indexing_run_rangeify_analysis(cache: mut cache, root: tsink) }
    }
    return indexing_run_rangeify_analysis(cache: mut cache, root: tsink)
}

fn render_ranges(cache: read UOpCache, rngs: read List<Int>, realized: read List<Int>) -> fresh String {
    let mut out = String.copy(value: read "")
    let mut i = 0
    while i < List.len<Int>(list: read rngs) {
        let r = List.get<Int>(list: read rngs, index: i)
        out = String.concat(left: read out, right: read "[")
        if indexing_list_contains(items: read realized, value: i) {
            out = String.concat(left: read out, right: read "*")
        }
        out = String.concat(left: read out, right: read uop_render_expr(cache: read cache, id: r))
        if indexing_list_contains(items: read realized, value: i) {
            out = String.concat(left: read out, right: read "*")
        }
        out = String.concat(left: read out, right: read "]")
        i = i + 1
    }
    return String.copy(value: read out)
}
