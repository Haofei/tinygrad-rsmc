// An MLP trained with the AUTOGRAD ENGINE: the 2->2->1 relu net is built as scalar ops on
// the autograd tape, and ALL gradients are produced by the engine's reverse pass (no
// hand-derived gradients). Emits a complete hosted MC program that trains by SGD to fit
// |x0-x1| and writes the 4 predictions. (Same engine as autograd.rss; ag_node returns the
// node index so the graph can be wired up.)

fn AG_PARAM() -> Int { return 0 }
fn AG_ADD()   -> Int { return 1 }
fn AG_MUL()   -> Int { return 2 }
fn AG_SUB()   -> Int { return 3 }
fn AG_RELU()  -> Int { return 4 }
fn AG_CONST() -> Int { return 5 }

fn cat(a: read String, b: read String) -> fresh String {
    return String.concat(left: read a, right: read b)
}
fn cat3(a: read String, b: read String, c: read String) -> fresh String {
    return cat(a: read cat(a: read a, b: read b), b: read c)
}
fn pl(lines: mut List<String>, t: read String) -> Unit {
    List.push(list: mut lines, value: read t)
    return Unit
}
fn nname(i: Int) -> fresh String {
    return cat(a: read "n", b: read String.from_int(value: i))
}
fn gname(i: Int) -> fresh String {
    return cat(a: read "g", b: read String.from_int(value: i))
}

// push a tape node and return its index
fn ag_node(op: mut List<Int>, a: mut List<Int>, b: mut List<Int>, nm: mut List<String>,
           o: Int, x: Int, y: Int, name: read String) -> Int {
    let idx = List.len(list: read op)
    List.push(list: mut op, value: read o)
    List.push(list: mut a, value: read x)
    List.push(list: mut b, value: read y)
    List.push(list: mut nm, value: read name)
    return idx
}

fn fwd_line(lines: mut List<String>, op: read List<Int>, a: read List<Int>, b: read List<Int>, nm: read List<String>, i: Int) -> Unit {
    let o = List.get(list: read op, index: i)
    let ni = nname(i: i)
    if o == AG_PARAM() {
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    let ", b: read ni, c: read ": f32 = "), b: read List.get(list: read nm, index: i), c: read ";"))
    }
    if o == AG_CONST() {
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    let ", b: read ni, c: read ": f32 = "), b: read List.get(list: read nm, index: i), c: read ";"))
    }
    if o == AG_ADD() {
        let e = cat3(a: read "(", b: read nname(i: List.get(list: read a, index: i)), c: read cat3(a: read " + ", b: read nname(i: List.get(list: read b, index: i)), c: read ")"))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    let ", b: read ni, c: read ": f32 = "), b: read e, c: read ";"))
    }
    if o == AG_MUL() {
        let e = cat3(a: read "(", b: read nname(i: List.get(list: read a, index: i)), c: read cat3(a: read " * ", b: read nname(i: List.get(list: read b, index: i)), c: read ")"))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    let ", b: read ni, c: read ": f32 = "), b: read e, c: read ";"))
    }
    if o == AG_SUB() {
        let e = cat3(a: read "(", b: read nname(i: List.get(list: read a, index: i)), c: read cat3(a: read " - ", b: read nname(i: List.get(list: read b, index: i)), c: read ")"))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    let ", b: read ni, c: read ": f32 = "), b: read e, c: read ";"))
    }
    if o == AG_RELU() {
        let src = nname(i: List.get(list: read a, index: i))
        pl(lines: mut lines, t: read cat3(a: read "    var ", b: read ni, c: read ": f32 = 0.0;"))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    if ", b: read src, c: read " > 0.0 { "), b: read ni, c: read cat3(a: read " = ", b: read src, c: read "; }")))
    }
    return Unit
}

fn bwd_line(lines: mut List<String>, op: read List<Int>, a: read List<Int>, b: read List<Int>, i: Int) -> Unit {
    let o = List.get(list: read op, index: i)
    let gi = gname(i: i)
    if o == AG_ADD() {
        let ga = gname(i: List.get(list: read a, index: i))
        let gb = gname(i: List.get(list: read b, index: i))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    ", b: read ga, c: read " = "), b: read ga, c: read cat3(a: read " + ", b: read gi, c: read ";")))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    ", b: read gb, c: read " = "), b: read gb, c: read cat3(a: read " + ", b: read gi, c: read ";")))
    }
    if o == AG_SUB() {
        let ga = gname(i: List.get(list: read a, index: i))
        let gb = gname(i: List.get(list: read b, index: i))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    ", b: read ga, c: read " = "), b: read ga, c: read cat3(a: read " + ", b: read gi, c: read ";")))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    ", b: read gb, c: read " = "), b: read gb, c: read cat3(a: read " - ", b: read gi, c: read ";")))
    }
    if o == AG_MUL() {
        let ia = List.get(list: read a, index: i)
        let ib = List.get(list: read b, index: i)
        let ga = gname(i: ia)
        let gb = gname(i: ib)
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    ", b: read ga, c: read " = "), b: read ga, c: read cat3(a: read " + (", b: read gi, c: read cat3(a: read " * ", b: read nname(i: ib), c: read ");"))))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    ", b: read gb, c: read " = "), b: read gb, c: read cat3(a: read " + (", b: read gi, c: read cat3(a: read " * ", b: read nname(i: ia), c: read ");"))))
    }
    if o == AG_RELU() {
        let ia = List.get(list: read a, index: i)
        let ga = gname(i: ia)
        let src = nname(i: ia)
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    if ", b: read src, c: read " > 0.0 { "), b: read ga, c: read cat3(a: read " = ", b: read ga, c: read cat3(a: read " + ", b: read gi, c: read "; }"))))
    }
    return Unit
}

fn emit_mlp() -> fresh String {
    let op = List.new<Int>()
    let a = List.new<Int>()
    let b = List.new<Int>()
    let nm = List.new<String>()

    // weights (param nodes). Keep their indices, names, and init literals.
    let wi = List.new<Int>()
    let wn = List.new<String>()
    let winit = List.new<String>()
    let iw0 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "w1_0")
    List.push(list: mut wi, value: read iw0)
    List.push(list: mut wn, value: read "w1_0")
    List.push(list: mut winit, value: read "0.5")
    let iw1 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "w1_1")
    List.push(list: mut wi, value: read iw1)
    List.push(list: mut wn, value: read "w1_1")
    List.push(list: mut winit, value: read "-0.3")
    let iw2 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "w1_2")
    List.push(list: mut wi, value: read iw2)
    List.push(list: mut wn, value: read "w1_2")
    List.push(list: mut winit, value: read "-0.4")
    let iw3 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "w1_3")
    List.push(list: mut wi, value: read iw3)
    List.push(list: mut wn, value: read "w1_3")
    List.push(list: mut winit, value: read "0.6")
    let ib0 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "b1_0")
    List.push(list: mut wi, value: read ib0)
    List.push(list: mut wn, value: read "b1_0")
    List.push(list: mut winit, value: read "0.0")
    let ib1 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "b1_1")
    List.push(list: mut wi, value: read ib1)
    List.push(list: mut wn, value: read "b1_1")
    List.push(list: mut winit, value: read "0.0")
    let iv0 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "w2_0")
    List.push(list: mut wi, value: read iv0)
    List.push(list: mut wn, value: read "w2_0")
    List.push(list: mut winit, value: read "0.7")
    let iv1 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "w2_1")
    List.push(list: mut wi, value: read iv1)
    List.push(list: mut wn, value: read "w2_1")
    List.push(list: mut winit, value: read "0.8")
    let ibb = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_PARAM(), x: -1, y: -1, name: read "b2")
    List.push(list: mut wi, value: read ibb)
    List.push(list: mut wn, value: read "b2")
    List.push(list: mut winit, value: read "0.1")

    // dataset (fit |x0 - x1|)
    let dx0 = List.new<String>()
    List.push(list: mut dx0, value: read "0.0")
    List.push(list: mut dx0, value: read "1.0")
    List.push(list: mut dx0, value: read "0.0")
    List.push(list: mut dx0, value: read "3.0")
    let dx1 = List.new<String>()
    List.push(list: mut dx1, value: read "0.0")
    List.push(list: mut dx1, value: read "0.0")
    List.push(list: mut dx1, value: read "2.0")
    List.push(list: mut dx1, value: read "1.0")
    let dt = List.new<String>()
    List.push(list: mut dt, value: read "0.0")
    List.push(list: mut dt, value: read "1.0")
    List.push(list: mut dt, value: read "2.0")
    List.push(list: mut dt, value: read "2.0")

    // build the forward graph; accumulate the summed loss; record per-sample output nodes
    let outidx = List.new<Int>()
    let mut lossnode = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_CONST(), x: -1, y: -1, name: read "0.0")
    let mut s = 0
    while s < 4 {
        let x0n = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_CONST(), x: -1, y: -1, name: read List.get(list: read dx0, index: s))
        let x1n = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_CONST(), x: -1, y: -1, name: read List.get(list: read dx1, index: s))
        let tn  = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_CONST(), x: -1, y: -1, name: read List.get(list: read dt, index: s))
        // hidden 0
        let m00 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_MUL(), x: x0n, y: iw0, name: read "")
        let m01 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_MUL(), x: x1n, y: iw2, name: read "")
        let s0  = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_ADD(), x: m00, y: m01, name: read "")
        let z0  = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_ADD(), x: s0, y: ib0, name: read "")
        let h0  = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_RELU(), x: z0, y: -1, name: read "")
        // hidden 1
        let m10 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_MUL(), x: x0n, y: iw1, name: read "")
        let m11 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_MUL(), x: x1n, y: iw3, name: read "")
        let s1  = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_ADD(), x: m10, y: m11, name: read "")
        let z1  = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_ADD(), x: s1, y: ib1, name: read "")
        let h1  = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_RELU(), x: z1, y: -1, name: read "")
        // output
        let o0 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_MUL(), x: h0, y: iv0, name: read "")
        let o1 = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_MUL(), x: h1, y: iv1, name: read "")
        let os = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_ADD(), x: o0, y: o1, name: read "")
        let outn = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_ADD(), x: os, y: ibb, name: read "")
        List.push(list: mut outidx, value: read outn)
        // loss += (out - t)^2
        let diff = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_SUB(), x: outn, y: tn, name: read "")
        let sq   = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_MUL(), x: diff, y: diff, name: read "")
        lossnode = ag_node(op: mut op, a: mut a, b: mut b, nm: mut nm, o: AG_ADD(), x: lossnode, y: sq, name: read "")
        s = s + 1
    }
    let n = List.len(list: read op)
    let nw = List.len(list: read wi)

    let lines = List.new<String>()
    pl(lines: mut lines, t: read "import \"std/addr.mc\";")
    pl(lines: mut lines, t: read "import \"std/hosted_io.mc\";")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "export fn hosted_kernel_run() -> i32 {")
    // weight vars
    let mut wd = 0
    while wd < nw {
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "  var ", b: read List.get(list: read wn, index: wd), c: read ": f32 = "), b: read List.get(list: read winit, index: wd), c: read ";"))
        wd = wd + 1
    }
    pl(lines: mut lines, t: read "  var pred: [4]f32 = uninit;")
    pl(lines: mut lines, t: read "  let lr: f32 = 0.0125;")
    pl(lines: mut lines, t: read "  var ep: usize = 0;")
    pl(lines: mut lines, t: read "  while ep < 3000 {")
    // forward
    let mut i = 0
    while i < n {
        fwd_line(lines: mut lines, op: read op, a: read a, b: read b, nm: read nm, i: i)
        i = i + 1
    }
    // record predictions (current weights)
    let mut po = 0
    while po < 4 {
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    pred[", b: read String.from_int(value: po), c: read "] = "), b: read nname(i: List.get(list: read outidx, index: po)), c: read ";"))
        po = po + 1
    }
    // init adjoints
    let mut gi = 0
    while gi < n {
        pl(lines: mut lines, t: read cat3(a: read "    var ", b: read gname(i: gi), c: read ": f32 = 0.0;"))
        gi = gi + 1
    }
    pl(lines: mut lines, t: read cat3(a: read "    ", b: read gname(i: lossnode), c: read " = 1.0;"))
    // reverse pass
    let mut r = n - 1
    while r >= 0 {
        bwd_line(lines: mut lines, op: read op, a: read a, b: read b, i: r)
        r = r - 1
    }
    // SGD update of weights from engine-produced grads
    let mut u = 0
    while u < nw {
        let wnm = List.get(list: read wn, index: u)
        let wgi = gname(i: List.get(list: read wi, index: u))
        pl(lines: mut lines, t: read cat3(a: read cat3(a: read "    ", b: read wnm, c: read " = "), b: read wnm, c: read cat3(a: read " - (lr * ", b: read wgi, c: read ");")))
        u = u + 1
    }
    pl(lines: mut lines, t: read "    ep = ep + 1;")
    pl(lines: mut lines, t: read "  }")
    // output predictions
    pl(lines: mut lines, t: read "  let output: Fd = stdout_fd();")
    pl(lines: mut lines, t: read "  if let err(e) = io_write_all(output, pa((&pred[0]) as usize), 16) { return 9; }")
    pl(lines: mut lines, t: read "  return 0;")
    pl(lines: mut lines, t: read "}")
    return String.join(parts: read lines, separator: read "\n")
}

fn main() -> Unit {
    Log.write(message: read emit_mlp())
    return Unit
}
