// Integrated source-shaped slice of tinygrad/codegen/late/expander.py.
//
// This slice ports the axis-size choice/index helpers, the compact
// CONTRACT/UNROLL/END normalization rules, the common do_expand path, and the
// first pm_pre_expander rewrites, plus the first BufferizeOpts-local
// group-for-reduce lowering and REG value-INDEX scalarization. WMMA expansion
// remains a later slice.
features: local

fn expander_pairs_concat(a: read List<Int>, b: read List<Int>) -> fresh List<Int> {
    local out = copy_int_list(l: read a)
    let mut i = 0
    while i < List.len<Int>(list: read b) {
        List.push<Int>(list: mut out, value: read List.get<Int>(list: read b, index: i))
        i = i + 1
    }
    return take out
}

fn expander_pairs_contains_axis(pairs: read List<Int>, axis: Int) -> Bool {
    let mut i = 0
    while i + 1 < List.len<Int>(list: read pairs) {
        if List.get<Int>(list: read pairs, index: i) == axis { return true }
        i = i + 2
    }
    return false
}

fn expander_pairs_equal(a: read List<Int>, b: read List<Int>) -> Bool {
    if List.len<Int>(list: read a) != List.len<Int>(list: read b) { return false }
    let mut i = 0
    while i < List.len<Int>(list: read a) {
        if List.get<Int>(list: read a, index: i) != List.get<Int>(list: read b, index: i) { return false }
        i = i + 1
    }
    return true
}

fn expander_pairs_without_axes(pairs: read List<Int>, remove: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i + 1 < List.len<Int>(list: read pairs) {
        let axis = List.get<Int>(list: read pairs, index: i)
        let size = List.get<Int>(list: read pairs, index: i + 1)
        if expander_pairs_contains_axis(pairs: read remove, axis: axis) == false {
            List.push<Int>(list: mut out, value: read axis)
            List.push<Int>(list: mut out, value: read size)
        }
        i = i + 2
    }
    return take out
}

fn expander_pair_size(pairs: read List<Int>, axis: Int) -> Int {
    let mut i = 0
    while i + 1 < List.len<Int>(list: read pairs) {
        if List.get<Int>(list: read pairs, index: i) == axis { return List.get<Int>(list: read pairs, index: i + 1) }
        i = i + 2
    }
    return 0
}

fn expander_pairs_add_axis_sorted(pairs: read List<Int>, axis: Int, size: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut inserted = false
    let mut i = 0
    while i + 1 < List.len<Int>(list: read pairs) {
        let ax = List.get<Int>(list: read pairs, index: i)
        if inserted == false && axis < ax {
            List.push<Int>(list: mut out, value: read axis)
            List.push<Int>(list: mut out, value: read size)
            inserted = true
        }
        List.push<Int>(list: mut out, value: read ax)
        List.push<Int>(list: mut out, value: read List.get<Int>(list: read pairs, index: i + 1))
        i = i + 2
    }
    if inserted == false {
        List.push<Int>(list: mut out, value: read axis)
        List.push<Int>(list: mut out, value: read size)
    }
    return take out
}

fn expander_pairs_union(cache: read UOpCache, id: Int) -> fresh List<Int> {
    let mut pairs = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let src = node_src_id(cache: read cache, id: id, k: i)
        if node_op(cache: read cache, id: src) == UNROLL {
            let spairs = node_axis_size_pairs(cache: read cache, id: src)
            let mut j = 0
            while j + 1 < List.len<Int>(list: read spairs) {
                let axis = List.get<Int>(list: read spairs, index: j)
                let size = List.get<Int>(list: read spairs, index: j + 1)
                let existing = expander_pair_size(pairs: read pairs, axis: axis)
                if existing == 0 {
                    pairs = expander_pairs_add_axis_sorted(pairs: read pairs, axis: axis, size: size)
                } else {
                    if existing != size {
                        local empty = List.new<Int>()
                        return take empty
                    }
                }
                j = j + 2
            }
        }
        i = i + 1
    }
    return copy_int_list(l: read pairs)
}

fn expander_has_unroll_src(cache: read UOpCache, id: Int) -> Bool {
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        if node_op(cache: read cache, id: node_src_id(cache: read cache, id: id, k: i)) == UNROLL { return true }
        i = i + 1
    }
    return false
}

fn expander_supported_root_op(op: read Ops) -> Bool {
    if group_alu(op: read op) { return true }
    if op == CAST || op == BITCAST || op == GEP || op == LOAD || op == STORE { return true }
    if op == INDEX || op == STAGE || op == STACK || op == REDUCE || op == END || op == AFTER { return true }
    return false
}

fn expander_choice_count(pairs: read List<Int>) -> Int {
    if List.len<Int>(list: read pairs) == 0 { return 1 }
    return axis_size_pairs_product(pairs: read pairs)
}

fn expander_choice_value(pairs: read List<Int>, choice: Int, axis: Int) -> Int {
    let n = List.len<Int>(list: read pairs)
    let mut i = 0
    while i + 1 < n {
        let ax = List.get<Int>(list: read pairs, index: i)
        let sz = List.get<Int>(list: read pairs, index: i + 1)
        if ax == axis {
            let mut div = 1
            let mut j = i + 3
            while j < n {
                div = div * List.get<Int>(list: read pairs, index: j)
                j = j + 2
            }
            return (choice / div) % sz
        }
        i = i + 2
    }
    return 0
}

fn expander_axes_contains(axes: read List<Int>, axis: Int) -> Bool {
    let mut i = 0
    while i < List.len<Int>(list: read axes) {
        if List.get<Int>(list: read axes, index: i) == axis { return true }
        i = i + 1
    }
    return false
}

fn expander_expand_arg_to_idx(args: read List<Int>, choice_pairs: read List<Int>, choice: Int) -> Int {
    let mut idx = 0
    let mut mul = 1
    let mut i = List.len<Int>(list: read args) - 2
    while i >= 0 {
        let axis = List.get<Int>(list: read args, index: i)
        let size = List.get<Int>(list: read args, index: i + 1)
        idx = idx + expander_choice_value(pairs: read choice_pairs, choice: choice, axis: axis) * mul
        mul = mul * size
        i = i - 2
    }
    return idx
}

fn expander_expand_arg_to_idx_excluding(args: read List<Int>, choice_pairs: read List<Int>, choice: Int, exclude_args: read List<Int>) -> Int {
    let mut idx = 0
    let mut mul = 1
    let mut i = List.len<Int>(list: read args) - 2
    while i >= 0 {
        let axis = List.get<Int>(list: read args, index: i)
        let size = List.get<Int>(list: read args, index: i + 1)
        let mut value = 0
        if expander_axes_contains(axes: read exclude_args, axis: axis) == false {
            value = expander_choice_value(pairs: read choice_pairs, choice: choice, axis: axis)
        }
        idx = idx + value * mul
        mul = mul * size
        i = i - 2
    }
    return idx
}

fn _expand_arg_to_idx(args: read List<Int>, choice_pairs: read List<Int>, choice: Int) -> Int {
    return expander_expand_arg_to_idx(args: read args, choice_pairs: read choice_pairs, choice: choice)
}

fn _choices_from_args(args: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let total = expander_choice_count(pairs: read args)
    let mut choice = 0
    while choice < total {
        let mut i = 0
        while i + 1 < List.len<Int>(list: read args) {
            let axis = List.get<Int>(list: read args, index: i)
            List.push<Int>(list: mut out, value: read axis)
            List.push<Int>(list: mut out, value: read expander_choice_value(pairs: read args, choice: choice, axis: axis))
            i = i + 2
        }
        choice = choice + 1
    }
    return take out
}

fn _swizzle_args(cargs: read List<Int>, eargs: read List<Int>, exclude_args: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let total = expander_choice_count(pairs: read cargs)
    let mut choice = 0
    while choice < total {
        let idx = expander_expand_arg_to_idx_excluding(args: read eargs, choice_pairs: read cargs, choice: choice, exclude_args: read exclude_args)
        List.push<Int>(list: mut out, value: read idx)
        choice = choice + 1
    }
    return take out
}

fn expander_contract_indices(ex_pairs: read List<Int>, con_pairs: read List<Int>, new_pairs: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let new_count = expander_choice_count(pairs: read new_pairs)
    let con_count = expander_choice_count(pairs: read con_pairs)
    let all_pairs = expander_pairs_concat(a: read new_pairs, b: read con_pairs)
    let mut nc = 0
    while nc < new_count {
        let mut cc = 0
        while cc < con_count {
            let choice = nc * con_count + cc
            let idx = expander_expand_arg_to_idx(args: read ex_pairs, choice_pairs: read all_pairs, choice: choice)
            List.push<Int>(list: mut out, value: read idx)
            cc = cc + 1
        }
        nc = nc + 1
    }
    return take out
}

fn expander_swizzle_indices(cargs: read List<Int>, eargs: read List<Int>, base_count: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let total = expander_choice_count(pairs: read cargs)
    let mut choice = 0
    while choice < total {
        let idx = expander_expand_arg_to_idx(args: read eargs, choice_pairs: read cargs, choice: choice)
        if base_count > 1 {
            let mut lane = 0
            while lane < base_count {
                List.push<Int>(list: mut out, value: read (idx * base_count + lane))
                lane = lane + 1
            }
        } else {
            List.push<Int>(list: mut out, value: read idx)
        }
        choice = choice + 1
    }
    return take out
}

fn expander_repeated_vcat(cache: mut UOpCache, src: Int, expand_sz: Int) -> Int {
    let sdt = node_full_dtype(cache: read cache, id: src)
    let scalar = dtype_scalar(d: read sdt)
    let outdt = dtype_vec(base: read scalar, sz: sdt.count * expand_sz)
    local srcs = List.new<Int>()
    let mut i = 0
    while i < expand_sz {
        List.push<Int>(list: mut srcs, value: read src)
        i = i + 1
    }
    return mk_vcat(cache: mut cache, dt: read outdt, srcs: read srcs)
}

fn expander_gep_arg_for_expand(cache: read UOpCache, id: Int, expanded_src0: Int, expand_sz: Int) -> fresh Arg {
    local old_arg = node_argints(cache: read cache, id: id)
    let start = List.get<Int>(list: read old_arg, index: 0)
    let src_count = node_full_dtype(cache: read cache, id: expanded_src0).count
    let mut step = 1
    if expand_sz > 0 { step = src_count / expand_sz }
    local vals = List.new<Int>()
    let mut i = 0
    while i < expand_sz {
        List.push<Int>(list: mut vals, value: read (start + i * step))
        i = i + 1
    }
    return ArgInts(values: take vals)
}

fn expander_const_iota(cache: mut UOpCache, dt: read DType, count: Int) -> Int {
    let scalar = dtype_scalar(d: read dt)
    let vdt = dtype_vec(base: read scalar, sz: count)
    local src = List.new<Int>()
    local vals = List.new<Int>()
    let mut i = 0
    while i < count {
        List.push<Int>(list: mut vals, value: read i)
        i = i + 1
    }
    local arg = ArgInts(values: take vals)
    return intern(cache: mut cache, op: CONST, dt: read vdt, src: take src, arg: take arg)
}

fn expander_reduce_with_srcs(cache: mut UOpCache, id: Int, value: Int, tails: read List<Int>) -> Int {
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read value)
    let mut i = 0
    while i < List.len<Int>(list: read tails) {
        List.push<Int>(list: mut src, value: read List.get<Int>(list: read tails, index: i))
        i = i + 1
    }
    local axes = node_argints(cache: read cache, id: id)
    local rarg = ReduceArg(kind: node_reduce_kind(cache: read cache, id: id), axes: take axes)
    local arg = ArgReduce(value: take rarg)
    let dt = node_dtype(cache: read cache, id: id)
    return intern(cache: mut cache, op: REDUCE, dt: read dt, src: take src, arg: take arg)
}

fn expander_lane_src(cache: mut UOpCache, src: Int, lane: Int) -> Int {
    if node_full_dtype(cache: read cache, id: src).count <= 1 { return src }
    local idxs = List.new<Int>()
    List.push<Int>(list: mut idxs, value: read lane)
    return mk_gep(cache: mut cache, x: src, idxs: read idxs)
}

fn expander_reg_index_unroll(cache: mut UOpCache, id: Int, new_srcs: read List<Int>, pairs: read List<Int>, expand_sz: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != INDEX { return None }
    if node_index_is_ptr(cache: read cache, id: id) { return None }
    if List.len<Int>(list: read new_srcs) == 0 { return None }
    let base = List.get<Int>(list: read new_srcs, index: 0)
    if node_addrspace(cache: read cache, id: base) != ADDR_REG { return None }
    local idxs = List.new<Int>()
    let mut lane = 0
    while lane < expand_sz {
        local lane_srcs = List.new<Int>()
        let mut i = 0
        while i < List.len<Int>(list: read new_srcs) {
            let src = List.get<Int>(list: read new_srcs, index: i)
            List.push<Int>(list: mut lane_srcs, value: read expander_lane_src(cache: mut cache, src: src, lane: lane))
            i = i + 1
        }
        local arg = node_arg(cache: read cache, id: id)
        let scalar_idx = intern(cache: mut cache, op: INDEX, dt: read dtype_scalar(d: read node_full_dtype(cache: read cache, id: id)), src: take lane_srcs, arg: take arg)
        List.push<Int>(list: mut idxs, value: read scalar_idx)
        lane = lane + 1
    }
    let scalar = dtype_scalar(d: read node_full_dtype(cache: read cache, id: id))
    let stack_dt = dtype_vec(base: read scalar, sz: expand_sz)
    let stack = uop_stack(cache: mut cache, dt: read stack_dt, srcs: read idxs)
    return Some(mk_unroll(cache: mut cache, x: stack, pairs: read pairs))
}

fn expander_store_with_tail(cache: mut UOpCache, id: Int, tails: read List<Int>) -> Int {
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read node_src_id(cache: read cache, id: id, k: 0))
    List.push<Int>(list: mut src, value: read node_src_id(cache: read cache, id: id, k: 1))
    let mut i = 0
    while i < List.len<Int>(list: read tails) {
        List.push<Int>(list: mut src, value: read List.get<Int>(list: read tails, index: i))
        i = i + 1
    }
    local arg = node_arg(cache: read cache, id: id)
    let dt = node_dtype(cache: read cache, id: id)
    return intern(cache: mut cache, op: STORE, dt: read dt, src: take src, arg: take arg)
}

fn expander_do_expand(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if expander_supported_root_op(op: read op) == false { return None }
    if expander_has_unroll_src(cache: read cache, id: id) == false { return None }
    if op == WMMA || op == SHAPED_WMMA { return None }
    let pairs = expander_pairs_union(cache: read cache, id: id)
    if List.len<Int>(list: read pairs) == 0 { return None }
    let expand_sz = axis_size_pairs_product(pairs: read pairs)
    local new_srcs = List.new<Int>()
    let range_start = uop_range_start_index(op: read op)
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let src = node_src_id(cache: read cache, id: id, k: i)
        if node_op(cache: read cache, id: src) == UNROLL {
            let spairs = node_axis_size_pairs(cache: read cache, id: src)
            let base = node_src_id(cache: read cache, id: src, k: 0)
            if expander_pairs_equal(a: read pairs, b: read spairs) {
                List.push<Int>(list: mut new_srcs, value: read base)
            } else {
                let mut bcount = node_full_dtype(cache: read cache, id: base).count / expander_choice_count(pairs: read spairs)
                if bcount < 1 { bcount = 1 }
                let idxs = expander_swizzle_indices(cargs: read pairs, eargs: read spairs, base_count: bcount)
                let gep = mk_gep(cache: mut cache, x: base, idxs: read idxs)
                List.push<Int>(list: mut new_srcs, value: read gep)
            }
        } else {
            if range_start >= 0 && i >= range_start {
                List.push<Int>(list: mut new_srcs, value: read src)
            } else {
                if op == INDEX && i >= 1 {
                    List.push<Int>(list: mut new_srcs, value: read src)
                } else {
                    let sdt = node_full_dtype(cache: read cache, id: src)
                    if sdt.count > 1 {
                        let vcat = expander_repeated_vcat(cache: mut cache, src: src, expand_sz: expand_sz)
                        List.push<Int>(list: mut new_srcs, value: read vcat)
                    } else {
                        let bc = uop_broadcast(cache: mut cache, id: src, count: expand_sz)
                        List.push<Int>(list: mut new_srcs, value: read bc)
                    }
                }
            }
        }
        i = i + 1
    }
    let root_dt = node_full_dtype(cache: read cache, id: id)
    let root_scalar = dtype_scalar(d: read root_dt)
    let outdt = dtype_vec(base: read root_scalar, sz: root_dt.count * expand_sz)
    if op == GEP {
        let first = List.get<Int>(list: read new_srcs, index: 0)
        local arg = expander_gep_arg_for_expand(cache: read cache, id: id, expanded_src0: first, expand_sz: expand_sz)
        let expanded = intern(cache: mut cache, op: op, dt: read outdt, src: take new_srcs, arg: take arg)
        return Some(mk_unroll(cache: mut cache, x: expanded, pairs: read pairs))
    }
    match expander_reg_index_unroll(cache: mut cache, id: id, new_srcs: read new_srcs, pairs: read pairs, expand_sz: expand_sz) {
        Some(r) => { return Some(r) }
        None => {}
    }
    local arg = node_arg(cache: read cache, id: id)
    let expanded = intern(cache: mut cache, op: op, dt: read outdt, src: take new_srcs, arg: take arg)
    return Some(mk_unroll(cache: mut cache, x: expanded, pairs: read pairs))
}

fn expander_empty_unroll(cache: read UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != UNROLL { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    if List.len<Int>(list: read node_axis_size_pairs(cache: read cache, id: id)) != 0 { return None }
    return Some(node_src_id(cache: read cache, id: id, k: 0))
}

fn expander_broadcast_base(cache: read UOpCache, id: Int) -> Int {
    if node_op(cache: read cache, id: id) != STACK { return 0 - 1 }
    if node_num_src(cache: read cache, id: id) == 0 { return 0 - 1 }
    let base = node_src_id(cache: read cache, id: id, k: 0)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: id) {
        if node_src_id(cache: read cache, id: id, k: i) != base { return 0 - 1 }
        i = i + 1
    }
    return base
}

fn expander_push_broadcast_through_order(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if op != AFTER && op != END { return None }
    if node_num_src(cache: read cache, id: id) < 2 { return None }
    let bcast = node_src_id(cache: read cache, id: id, k: 0)
    let base = expander_broadcast_base(cache: read cache, id: bcast)
    if base < 0 { return None }
    local deps = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: id) {
        List.push<Int>(list: mut deps, value: read node_src_id(cache: read cache, id: id, k: i))
        i = i + 1
    }
    let mut ordered = base
    if op == AFTER {
        ordered = mk_after(cache: mut cache, id: base, srcs: read deps)
    } else {
        ordered = mk_end(cache: mut cache, id: base, srcs: read deps)
    }
    return Some(uop_broadcast(cache: mut cache, id: ordered, count: node_num_src(cache: read cache, id: bcast)))
}

fn expander_stage_unroll_contracts(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != STAGE { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let x0 = node_src_id(cache: read cache, id: id, k: 0)
    let x1 = node_src_id(cache: read cache, id: id, k: 1)
    if node_op(cache: read cache, id: x0) != UNROLL || node_op(cache: read cache, id: x1) != UNROLL { return None }
    let pairs = node_axis_size_pairs(cache: read cache, id: x1)
    let c0 = mk_contract(cache: mut cache, x: x0, pairs: read pairs)
    let c1 = mk_contract(cache: mut cache, x: x1, pairs: read pairs)
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read c0)
    List.push<Int>(list: mut src, value: read c1)
    local arg = node_arg(cache: read cache, id: id)
    return Some(intern(cache: mut cache, op: STAGE, dt: read node_full_dtype(cache: read cache, id: id), src: take src, arg: take arg))
}

fn expander_double_unroll(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != UNROLL { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    let inner = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: inner) != UNROLL { return None }
    let inner_src = node_src_id(cache: read cache, id: inner, k: 0)
    let inner_pairs = node_axis_size_pairs(cache: read cache, id: inner)
    let outer_pairs = node_axis_size_pairs(cache: read cache, id: id)
    let pairs = expander_pairs_concat(a: read inner_pairs, b: read outer_pairs)
    return Some(mk_unroll(cache: mut cache, x: inner_src, pairs: read pairs))
}

fn expander_do_contract(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CONTRACT { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    let ex = node_src_id(cache: read cache, id: id, k: 0)
    let con_dt = node_full_dtype(cache: read cache, id: id)
    if node_op(cache: read cache, id: ex) != UNROLL {
        local srcs = List.new<Int>()
        let mut i = 0
        while i < con_dt.count {
            List.push<Int>(list: mut srcs, value: read ex)
            i = i + 1
        }
        return Some(uop_stack(cache: mut cache, dt: read con_dt, srcs: read srcs))
    }
    let ex_pairs = node_axis_size_pairs(cache: read cache, id: ex)
    let con_pairs = node_axis_size_pairs(cache: read cache, id: id)
    let new_pairs = expander_pairs_without_axes(pairs: read ex_pairs, remove: read con_pairs)
    let base = node_src_id(cache: read cache, id: ex, k: 0)
    let idxs = expander_contract_indices(ex_pairs: read ex_pairs, con_pairs: read con_pairs, new_pairs: read new_pairs)
    let gep = mk_gep(cache: mut cache, x: base, idxs: read idxs)
    if List.len<Int>(list: read new_pairs) == 0 { return Some(gep) }
    return Some(mk_unroll(cache: mut cache, x: gep, pairs: read new_pairs))
}

fn expander_end_unrolls(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != END { return None }
    if node_num_src(cache: read cache, id: id) < 2 { return None }
    local con_pairs = List.new<Int>()
    local rest = List.new<Int>()
    let mut found = false
    let mut i = 1
    while i < node_num_src(cache: read cache, id: id) {
        let src = node_src_id(cache: read cache, id: id, k: i)
        if node_op(cache: read cache, id: src) == UNROLL {
            let pairs = node_axis_size_pairs(cache: read cache, id: src)
            let mut j = 0
            while j < List.len<Int>(list: read pairs) {
                List.push<Int>(list: mut con_pairs, value: read List.get<Int>(list: read pairs, index: j))
                j = j + 1
            }
            found = true
        } else {
            List.push<Int>(list: mut rest, value: read src)
        }
        i = i + 1
    }
    if found == false { return None }
    let first = node_src_id(cache: read cache, id: id, k: 0)
    let con = mk_contract(cache: mut cache, x: first, pairs: read con_pairs)
    return Some(mk_end(cache: mut cache, id: con, srcs: read rest))
}

