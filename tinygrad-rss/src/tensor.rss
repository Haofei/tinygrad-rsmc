fn tensor_avg_pool2d_nchw_pad_dilated_ceil(cache: mut UOpCache, x: Int, kh: Int, kw: Int, sh: Int, sw: Int, dh: Int, dw: Int, pad_top: Int, pad_bottom: Int, pad_left: Int, pad_right: Int) -> Int {
    local sh0 = uop_shape(cache: read cache, id: x)
    let h = List.get<Int>(list: read sh0, index: 2)
    let w = List.get<Int>(list: read sh0, index: 3)
    let ceil_bottom = tensor_pool_ceil_after(input: h, k: kh, stride: sh, dilation: dh, pad_before: pad_top, pad_after: pad_bottom)
    let ceil_right = tensor_pool_ceil_after(input: w, k: kw, stride: sw, dilation: dw, pad_before: pad_left, pad_after: pad_right)
    local before = List.new<Int>()
    push1(l: mut before, a: 0)
    push1(l: mut before, a: 0)
    push1(l: mut before, a: pad_top)
    push1(l: mut before, a: pad_left)
    local after = List.new<Int>()
    push1(l: mut after, a: 0)
    push1(l: mut after, a: 0)
    push1(l: mut after, a: ceil_bottom)
    push1(l: mut after, a: ceil_right)
    let xp = tensor_pad_constant(cache: mut cache, x: x, before: read before, after: read after, value: 0.0)
    let xw = tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: xp, kh: kh, kw: kw, sh: sh, sw: sw, dh: dh, dw: dw)
    let numerator = tensor_avg_pool2d_from_windows_sum(cache: mut cache, windows: xw)

    local reg_after = List.new<Int>()
    push1(l: mut reg_after, a: 0)
    push1(l: mut reg_after, a: 0)
    push1(l: mut reg_after, a: pad_bottom)
    push1(l: mut reg_after, a: pad_right)
    let reg_padded = tensor_pad_constant(cache: mut cache, x: x, before: read before, after: read reg_after, value: 0.0)
    local reg_shape = uop_shape(cache: read cache, id: reg_padded)
    let ones = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read reg_shape, value: 1.0)
    local extra_before = List.new<Int>()
    push1(l: mut extra_before, a: 0)
    push1(l: mut extra_before, a: 0)
    push1(l: mut extra_before, a: 0)
    push1(l: mut extra_before, a: 0)
    local extra_after = List.new<Int>()
    push1(l: mut extra_after, a: 0)
    push1(l: mut extra_after, a: 0)
    push1(l: mut extra_after, a: ceil_bottom - pad_bottom)
    push1(l: mut extra_after, a: ceil_right - pad_right)
    let op = tensor_pad_constant(cache: mut cache, x: ones, before: read extra_before, after: read extra_after, value: 0.0)
    let ow = tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: op, kh: kh, kw: kw, sh: sh, sw: sw, dh: dh, dw: dw)
    let denom = tensor_avg_pool2d_from_windows_sum(cache: mut cache, windows: ow)
    return tensor_div(cache: mut cache, a: numerator, b: denom)
}

