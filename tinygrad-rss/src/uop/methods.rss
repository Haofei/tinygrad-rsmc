fn _suop(cache: mut UOpCache, vals: read List<Int>, op: Ops) -> Int {
    if List.len<Int>(list: read vals) == 0 {
        return mk_const_int(cache: mut cache, dt: read dt_int32(), v: identity_element(op: read op))
    }
    let mut out = List.get<Int>(list: read vals, index: 0)
    let mut i = 1
    while i < List.len<Int>(list: read vals) {
        let v = List.get<Int>(list: read vals, index: i)
        if op == MAX { out = uop_smax(cache: mut cache, a: out, b: v) }
        else { if op == MUL { out = mk_alu2(cache: mut cache, op: MUL, dt: read node_full_dtype(cache: read cache, id: out), x: out, y: v) }
        else { out = mk_alu2(cache: mut cache, op: ADD, dt: read node_full_dtype(cache: read cache, id: out), x: out, y: v) } }
        i = i + 1
    }
    return uop_simplify(cache: mut cache, id: out)
}

