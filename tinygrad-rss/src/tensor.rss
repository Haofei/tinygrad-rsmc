fn tensor_conv2d_nchw_groups_dilated(cache: mut UOpCache, x: Int, weight: Int, groups: Int, sh: Int, sw: Int, dh: Int, dw: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    local ws = uop_shape(cache: read cache, id: weight)
    let bs = List.get<Int>(list: read xs, index: 0)
    let cin = List.get<Int>(list: read ws, index: 1)
    let cout = List.get<Int>(list: read ws, index: 0)
    let rcout = cout / groups
    let kh = List.get<Int>(list: read ws, index: 2)
    let kw = List.get<Int>(list: read ws, index: 3)
    let windows = tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: x, kh: kh, kw: kw, sh: sh, sw: sw, dh: dh, dw: dw)
    local wsh = uop_shape(cache: read cache, id: windows)
    let oh = List.get<Int>(list: read wsh, index: 2)
    let ow = List.get<Int>(list: read wsh, index: 3)
    local xshape = List.new<Int>()
    push1(l: mut xshape, a: bs)
    push1(l: mut xshape, a: groups)
    push1(l: mut xshape, a: cin)
    push1(l: mut xshape, a: 1)
    push1(l: mut xshape, a: oh)
    push1(l: mut xshape, a: ow)
    push1(l: mut xshape, a: kh)
    push1(l: mut xshape, a: kw)
    let xr = tensor_reshape(cache: mut cache, x: windows, new_shape: read xshape)
    local target = List.new<Int>()
    push1(l: mut target, a: bs)
    push1(l: mut target, a: groups)
    push1(l: mut target, a: cin)
    push1(l: mut target, a: rcout)
    push1(l: mut target, a: oh)
    push1(l: mut target, a: ow)
    push1(l: mut target, a: kh)
    push1(l: mut target, a: kw)
    let xe = tensor_expand(cache: mut cache, x: xr, new_shape: read target)
    local xperm = List.new<Int>()
    push1(l: mut xperm, a: 0)
    push1(l: mut xperm, a: 1)
    push1(l: mut xperm, a: 3)
    push1(l: mut xperm, a: 4)
    push1(l: mut xperm, a: 5)
    push1(l: mut xperm, a: 2)
    push1(l: mut xperm, a: 6)
    push1(l: mut xperm, a: 7)
    let xep = tensor_permute(cache: mut cache, x: xe, perm: read xperm)
    local wrshape = List.new<Int>()
    push1(l: mut wrshape, a: 1)
    push1(l: mut wrshape, a: groups)
    push1(l: mut wrshape, a: rcout)
    push1(l: mut wrshape, a: 1)
    push1(l: mut wrshape, a: 1)
    push1(l: mut wrshape, a: cin)
    push1(l: mut wrshape, a: kh)
    push1(l: mut wrshape, a: kw)
    let wr = tensor_reshape(cache: mut cache, x: weight, new_shape: read wrshape)
    let prod = tensor_mul(cache: mut cache, a: xep, b: wr)
    local axes = List.new<Int>()
    push1(l: mut axes, a: 5)
    push1(l: mut axes, a: 6)
    push1(l: mut axes, a: 7)
    let reduced = tensor_sum_axes(cache: mut cache, x: prod, axes: read axes)
    local out_shape = List.new<Int>()
    push1(l: mut out_shape, a: bs)
    push1(l: mut out_shape, a: cout)
    push1(l: mut out_shape, a: oh)
    push1(l: mut out_shape, a: ow)
    return tensor_reshape(cache: mut cache, x: reduced, new_shape: read out_shape)
}

