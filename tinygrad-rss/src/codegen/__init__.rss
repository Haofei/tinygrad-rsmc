// Integrated source-shaped slice of tinygrad/codegen/__init__.py.
//
// This wires the linearized program form into estimates and renderer output.
// Binary materialization and the full schedule/device rewrite path remain
// later slices.
features: local

struct CodegenHostCompileResult derives(Clone) {
    ok: Bool,
    source_id: Int,
    source_len: Int,
    status: Int,
    stderr_len: Int,
}

struct CodegenHostRunResult derives(Clone) {
    ok: Bool,
    source_id: Int,
    source_len: Int,
    compile_status: Int,
    run_status: Int,
    stdout: String,
    stderr_len: Int,
}

fn codegen_push_sorted_unique_int(vals: mut List<Int>, v: Int) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read vals) {
        let cur = List.get<Int>(list: read vals, index: i)
        if cur == v { return Unit }
        i = i + 1
    }
    List.push<Int>(list: mut vals, value: read v)
    let n = List.len<Int>(list: read vals)
    let mut a = 0
    while a < n {
        let mut b = a + 1
        while b < n {
            let va = List.get<Int>(list: read vals, index: a)
            let vb = List.get<Int>(list: read vals, index: b)
            if vb < va {
                List.set<Int>(list: mut vals, index: a, value: read vb)
                List.set<Int>(list: mut vals, index: b, value: read va)
            }
            b = b + 1
        }
        a = a + 1
    }
    return Unit
}

fn codegen_index_param_slot(cache: read UOpCache, ptr: Int) -> Int {
    let op = node_op(cache: read cache, id: ptr)
    let mut idx = ptr
    if op == CAST && node_num_src(cache: read cache, id: ptr) > 0 {
        idx = node_src_id(cache: read cache, id: ptr, k: 0)
    }
    let idx_op = node_op(cache: read cache, id: idx)
    if idx_op != INDEX && idx_op != SHRINK { return 0 - 1 }
    if node_num_src(cache: read cache, id: idx) == 0 { return 0 - 1 }
    let base = node_src_id(cache: read cache, id: idx, k: 0)
    if node_op(cache: read cache, id: base) != PARAM { return 0 - 1 }
    return node_param_slot(cache: read cache, id: base)
}

fn codegen_special_axis(name: read String) -> Int {
    let n = String.len(value: read name)
    if n == 0 { return 0 - 1 }
    match String.parse_int(value: read String.slice(value: read name, start: n - 1, len: 1)) {
        Some(v) => { return v }
        None => { return 0 - 1 }
    }
}

fn codegen_special_size(cache: read UOpCache, id: Int) -> Int {
    if node_num_src(cache: read cache, id: id) == 0 { return 1 }
    let size = node_src_id(cache: read cache, id: id, k: 0)
    if node_is_const_int(cache: read cache, id: size) { return node_const_int(cache: read cache, id: size) }
    return 1
}

fn codegen_set_dim(vals: mut List<Int>, axis: Int, value: Int) -> Unit {
    if axis < 0 { return Unit }
    if axis >= List.len<Int>(list: read vals) { return Unit }
    List.set<Int>(list: mut vals, index: axis, value: read value)
    return Unit
}

fn codegen_program_arg_from_sink(cache: read UOpCache, sink: Int, name: read String) -> fresh ProgramArg {
    local global_size = List.new<Int>()
    List.push<Int>(list: mut global_size, value: read 1)
    List.push<Int>(list: mut global_size, value: read 1)
    List.push<Int>(list: mut global_size, value: read 1)
    let mut local_size = List.new<Int>()
    List.push<Int>(list: mut local_size, value: read 1)
    List.push<Int>(list: mut local_size, value: read 1)
    List.push<Int>(list: mut local_size, value: read 1)
    local vars = List.new<Int>()
    local globals = List.new<Int>()
    local outs = List.new<Int>()
    local ins = List.new<Int>()
    local topo = uop_toposort(cache: read cache, id: sink)
    let mut i = 0
    while i < List.len<Int>(list: read topo) {
        let u = List.get<Int>(list: read topo, index: i)
        let op = node_op(cache: read cache, id: u)
        if op == DEFINE_VAR {
            uop_variables_push_sorted(cache: read cache, vars: mut vars, var_id: u)
            if node_var_name(cache: read cache, id: u) == "core_id" {
                List.set<Int>(list: mut global_size, index: 0, value: read (node_var_max(cache: read cache, id: u) + 1))
            }
        }
        if op == PARAM {
            codegen_push_sorted_unique_int(vals: mut globals, v: node_param_slot(cache: read cache, id: u))
        }
        if op == SPECIAL {
            let sname = node_special_name(cache: read cache, id: u)
            let axis = codegen_special_axis(name: read sname)
            let size = codegen_special_size(cache: read cache, id: u)
            if String.starts_with(value: read sname, prefix: read "i") {
                codegen_set_dim(vals: mut global_size, axis: axis, value: size)
                local_size = List.new<Int>()
            } else {
                if String.starts_with(value: read sname, prefix: read "l") {
                    codegen_set_dim(vals: mut local_size, axis: axis, value: size)
                } else {
                    if String.starts_with(value: read sname, prefix: read "g") {
                        codegen_set_dim(vals: mut global_size, axis: axis, value: size)
                    }
                }
            }
        }
        if op == LOAD || op == STORE {
            if node_num_src(cache: read cache, id: u) > 0 {
                let slot = codegen_index_param_slot(cache: read cache, ptr: node_src_id(cache: read cache, id: u, k: 0))
                if slot >= 0 {
                    if op == STORE {
                        codegen_push_sorted_unique_int(vals: mut outs, v: slot)
                    } else {
                        codegen_push_sorted_unique_int(vals: mut ins, v: slot)
                    }
                }
            }
        }
        i = i + 1
    }
    return mk_program_arg(name: read name, global_size: read global_size, has_local_size: List.len<Int>(list: read local_size) > 0,
                          local_size: read local_size, vars: read vars, globals: read globals,
                          outs: read outs, ins: read ins)
}

fn codegen_estimate_numel(cache: read UOpCache, id: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: id)
    let n = prod(x: read sh)
    if n <= 0 { return 1 }
    return n
}

fn codegen_estimate_scalar_itemsize(cache: read UOpCache, id: Int) -> Int {
    let dt = dtype_scalar(d: read node_full_dtype(cache: read cache, id: id))
    let sz = DType.itemsize(self: read dt)
    if sz <= 0 { return 0 }
    return sz
}

fn codegen_estimate_base_param(cache: read UOpCache, id: Int) -> Int {
    let mut cur = id
    while node_op(cache: read cache, id: cur) != PARAM && node_num_src(cache: read cache, id: cur) > 0 {
        cur = node_src_id(cache: read cache, id: cur, k: 0)
    }
    if node_op(cache: read cache, id: cur) == PARAM { return cur }
    return 0 - 1
}

fn codegen_estimate_param_cap(cache: read UOpCache, param: Int) -> Int {
    if param < 0 { return 0 }
    let mut sh = List.new<Int>()
    if node_op(cache: read cache, id: param) == PARAM && node_num_src(cache: read cache, id: param) > 0 {
        sh = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: param, k: 0))
    } else {
        sh = uop_shape(cache: read cache, id: param)
    }
    let n = prod(x: read sh)
    let mut numel = n
    if numel <= 0 { numel = 1 }
    return numel * codegen_estimate_scalar_itemsize(cache: read cache, id: param)
}

fn codegen_estimates_mem_index(params: read List<Int>, ops: read List<Int>, param: Int, op_kind: Int) -> Int {
    let mut i = 0
    while i < List.len<Int>(list: read params) {
        if List.get<Int>(list: read params, index: i) == param && List.get<Int>(list: read ops, index: i) == op_kind {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn codegen_estimates_mem_add(cache: read UOpCache, params: mut List<Int>, ops: mut List<Int>, vals: mut List<Int>,
                             param: Int, op_kind: Int, amount: Int) -> Unit {
    if param < 0 { return Unit }
    let cap = codegen_estimate_param_cap(cache: read cache, param: param)
    let idx = codegen_estimates_mem_index(params: read params, ops: read ops, param: param, op_kind: op_kind)
    if idx < 0 {
        let mut v = amount
        if cap > 0 && v > cap { v = cap }
        List.push<Int>(list: mut params, value: read param)
        List.push<Int>(list: mut ops, value: read op_kind)
        List.push<Int>(list: mut vals, value: read v)
    } else {
        let mut v2 = List.get<Int>(list: read vals, index: idx) + amount
        if cap > 0 && v2 > cap { v2 = cap }
        List.set<Int>(list: mut vals, index: idx, value: read v2)
    }
    return Unit
}

fn codegen_estimates_mem_sum(vals: read List<Int>) -> Int {
    let mut out = 0
    let mut i = 0
    while i < List.len<Int>(list: read vals) {
        out = out + List.get<Int>(list: read vals, index: i)
        i = i + 1
    }
    return out
}

fn codegen_estimates_mark_topo(cache: read UOpCache, id: Int, dont_count: mut List<Int>) -> Unit {
    local topo = uop_toposort(cache: read cache, id: id)
    let mut i = 0
    while i < List.len<Int>(list: read topo) {
        uop_push_unique(vals: mut dont_count, v: List.get<Int>(list: read topo, index: i))
        i = i + 1
    }
    return Unit
}

fn codegen_estimates_mark_ignored_indexing(cache: read UOpCache, order: read List<Int>, dont_count: mut List<Int>) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let id = List.get<Int>(list: read order, index: i)
        let op = node_op(cache: read cache, id: id)
        if op == LOAD || op == STORE {
            let ptr = node_src_id(cache: read cache, id: id, k: 0)
            if node_op(cache: read cache, id: ptr) == INDEX {
                let mut k = 1
                while k < node_num_src(cache: read cache, id: ptr) {
                    codegen_estimates_mark_topo(cache: read cache, id: node_src_id(cache: read cache, id: ptr, k: k), dont_count: mut dont_count)
                    k = k + 1
                }
            }
            if node_num_src(cache: read cache, id: id) > 2 {
                codegen_estimates_mark_topo(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 2), dont_count: mut dont_count)
            }
        }
        if op == IF {
            codegen_estimates_mark_topo(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0), dont_count: mut dont_count)
        }
        i = i + 1
    }
    return Unit
}

fn codegen_estimates_from_order(cache: read UOpCache, order: read List<Int>, ignore_indexing: Bool) -> fresh Estimates {
    local dont_count = List.new<Int>()
    if ignore_indexing {
        codegen_estimates_mark_ignored_indexing(cache: read cache, order: read order, dont_count: mut dont_count)
    }
    local mem_params = List.new<Int>()
    local mem_ops = List.new<Int>()
    local mem_vals = List.new<Int>()
    local mult_stack = List.new<Int>()
    let mut ops_count = 0
    let mut lds_count = 0
    let mut mults = 1
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let id = List.get<Int>(list: read order, index: i)
        let op = node_op(cache: read cache, id: id)
        if op == LOAD || op == STORE {
            let ptr = node_src_id(cache: read cache, id: id, k: 0)
            let param = codegen_estimate_base_param(cache: read cache, id: ptr)
            let mut bytes = codegen_estimate_numel(cache: read cache, id: id) * codegen_estimate_scalar_itemsize(cache: read cache, id: id)
            if op == STORE {
                let value = node_src_id(cache: read cache, id: id, k: 1)
                bytes = codegen_estimate_numel(cache: read cache, id: value) * codegen_estimate_scalar_itemsize(cache: read cache, id: value)
            }
            let scaled = bytes * mults
            if node_addrspace(cache: read cache, id: ptr) != ADDR_REG { lds_count = lds_count + scaled }
            if op == LOAD {
                codegen_estimates_mem_add(cache: read cache, params: mut mem_params, ops: mut mem_ops, vals: mut mem_vals,
                                          param: param, op_kind: 1, amount: scaled)
            } else {
                codegen_estimates_mem_add(cache: read cache, params: mut mem_params, ops: mut mem_ops, vals: mut mem_vals,
                                          param: param, op_kind: 2, amount: scaled)
            }
        }
        if op == RANGE {
            List.push<Int>(list: mut mult_stack, value: read mults)
            if node_num_src(cache: read cache, id: id) > 0 {
                let rr = uop_min_max(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
                if rr.hi > 0 { mults = mults * rr.hi }
            }
        } else {
            if op == END {
                if List.len<Int>(list: read mult_stack) > 0 {
                    let last = List.len<Int>(list: read mult_stack) - 1
                    mults = List.get<Int>(list: read mult_stack, index: last)
                    List.pop<Int>(list: mut mult_stack)
                }
            } else {
                if op == SPECIAL {
                    if node_num_src(cache: read cache, id: id) > 0 {
                        let sr = uop_min_max(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
                        if sr.hi > 0 { mults = mults * sr.hi }
                    }
                } else {
                    if op == DEFINE_VAR && node_var_name(cache: read cache, id: id) == "core_id" {
                        mults = mults * (node_var_max(cache: read cache, id: id) + 1)
                    } else {
                        if group_alu(op: read op) && int_contains(items: read dont_count, v: id) == false {
                            let mut mul = 1
                            if op == MULACC { mul = 2 }
                            ops_count = ops_count + (mults * mul * codegen_estimate_numel(cache: read cache, id: id))
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return Estimates(ops: ops_count, lds: lds_count, mem: codegen_estimates_mem_sum(vals: read mem_vals))
}

fn codegen_linear_order(cache: read UOpCache, linear: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    if node_op(cache: read cache, id: linear) != LINEAR { return take out }
    let mut i = 0
    while i < node_num_src(cache: read cache, id: linear) {
        List.push<Int>(list: mut out, value: read node_src_id(cache: read cache, id: linear, k: i))
        i = i + 1
    }
    return take out
}

fn codegen_render_function_name(cache: read UOpCache, prg: Int) -> fresh String {
    let name = node_program_name(cache: read cache, id: prg)
    if String.len(value: read name) > 0 { return String.copy(value: read name) }
    return String.copy(value: read "kernel")
}

fn codegen_do_estimates(cache: mut UOpCache, prg: Int) -> Int {
    if node_op(cache: read cache, id: prg) != PROGRAM { return prg }
    if node_num_src(cache: read cache, id: prg) < 3 { return prg }
    if node_program_has_estimates(cache: read cache, id: prg) { return prg }
    let lin = node_src_id(cache: read cache, id: prg, k: 2)
    if node_op(cache: read cache, id: lin) != LINEAR { return prg }
    local order = codegen_linear_order(cache: read cache, linear: lin)
    let estimates = codegen_estimates_from_order(cache: read cache, order: read order, ignore_indexing: true)
    local src = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: prg) {
        List.push<Int>(list: mut src, value: read node_src_id(cache: read cache, id: prg, k: i))
        i = i + 1
    }
    let dt = node_full_dtype(cache: read cache, id: prg)
    local old_arg = node_program_arg(cache: read cache, id: prg)
    local new_prog = program_arg_with_estimates(arg: read old_arg, estimates: read estimates)
    local arg = ArgProgram(value: take new_prog)
    return intern(cache: mut cache, op: PROGRAM, dt: read dt, src: take src, arg: take arg)
}

fn codegen_do_render_cstyle(cache: mut UOpCache, prg: Int) -> Int {
    if node_op(cache: read cache, id: prg) != PROGRAM { return prg }
    if node_num_src(cache: read cache, id: prg) < 3 { return prg }
    if node_op(cache: read cache, id: node_src_id(cache: read cache, id: prg, k: 2)) != LINEAR { return prg }
    if node_num_src(cache: read cache, id: prg) > 3 {
        if node_op(cache: read cache, id: node_src_id(cache: read cache, id: prg, k: 3)) == SOURCE { return prg }
        return prg
    }
    let lin = node_src_id(cache: read cache, id: prg, k: 2)
    let name = codegen_render_function_name(cache: read cache, prg: prg)
    let src_text = cstyle_render_linear_kernel(cache: read cache, linear: lin, function_name: read name)
    let source = mk_source(cache: mut cache, text: read src_text)
    local src = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: prg) {
        List.push<Int>(list: mut src, value: read node_src_id(cache: read cache, id: prg, k: i))
        i = i + 1
    }
    List.push<Int>(list: mut src, value: read source)
    let dt = node_full_dtype(cache: read cache, id: prg)
    local prog = node_program_arg(cache: read cache, id: prg)
    local arg = ArgProgram(value: take prog)
    return intern(cache: mut cache, op: PROGRAM, dt: read dt, src: take src, arg: take arg)
}

fn codegen_program_source_id(cache: read UOpCache, prg: Int) -> Int {
    if node_op(cache: read cache, id: prg) != PROGRAM { return 0 - 1 }
    let mut i = 0
    while i < node_num_src(cache: read cache, id: prg) {
        let s = node_src_id(cache: read cache, id: prg, k: i)
        if node_op(cache: read cache, id: s) == SOURCE { return s }
        i = i + 1
    }
    return 0 - 1
}

fn codegen_host_compile_check_c(cache: read UOpCache, prg: Int, path_text: read String) -> fresh CodegenHostCompileResult {
    let source_id = codegen_program_source_id(cache: read cache, prg: prg)
    if source_id < 0 {
        return CodegenHostCompileResult(ok: false, source_id: source_id, source_len: 0, status: 0 - 1, stderr_len: 0)
    }
    let source = uop_arg_to_string(arg: read node_arg(cache: read cache, id: source_id))
    let source_len = String.len(value: read source)
    let path = Path.from_string(value: read path_text)
    match Path.write_string(path: read path, text: read source) {
        Ok(unit) => {
        }
        Err(error) => {
            return CodegenHostCompileResult(ok: false, source_id: source_id, source_len: source_len, status: 0 - 2, stderr_len: 0)
        }
    }
    let args: List<String> = ["-x", "c", "-std=c11", "-fsyntax-only", path_text]
    match Process.run(command: read "clang", args: read args) {
        Ok(output) => {
            return CodegenHostCompileResult(ok: output.status == 0, source_id: source_id, source_len: source_len,
                                            status: output.status, stderr_len: String.len(value: read output.stderr))
        }
        Err(error) => {
            return CodegenHostCompileResult(ok: false, source_id: source_id, source_len: source_len,
                                            status: 0 - 3, stderr_len: String.len(value: read error))
        }
    }
}

fn codegen_host_run_c_harness(cache: read UOpCache, prg: Int, c_path_text: read String, exe_path_text: read String,
                              harness_main: read String) -> fresh CodegenHostRunResult {
    let source_id = codegen_program_source_id(cache: read cache, prg: prg)
    if source_id < 0 {
        return CodegenHostRunResult(ok: false, source_id: source_id, source_len: 0, compile_status: 0 - 1,
                                    run_status: 0 - 1, stdout: "", stderr_len: 0)
    }
    let source = uop_arg_to_string(arg: read node_arg(cache: read cache, id: source_id))
    let source_len = String.len(value: read source)
    let combined = ["#include <stdio.h>\n", source, "\n", harness_main].join("")
    let c_path = Path.from_string(value: read c_path_text)
    match Path.write_string(path: read c_path, text: read combined) {
        Ok(unit) => {
        }
        Err(error) => {
            return CodegenHostRunResult(ok: false, source_id: source_id, source_len: source_len,
                                        compile_status: 0 - 2, run_status: 0 - 1, stdout: "",
                                        stderr_len: String.len(value: read error.message()))
        }
    }
    let compile_args: List<String> = ["-std=c11", c_path_text, "-lm", "-o", exe_path_text]
    match Process.run(command: read "clang", args: read compile_args) {
        Ok(compile_output) => {
            if compile_output.status != 0 {
                return CodegenHostRunResult(ok: false, source_id: source_id, source_len: source_len,
                                            compile_status: compile_output.status, run_status: 0 - 1,
                                            stdout: String.copy(value: read compile_output.stdout),
                                            stderr_len: String.len(value: read compile_output.stderr))
            }
        }
        Err(error) => {
            return CodegenHostRunResult(ok: false, source_id: source_id, source_len: source_len,
                                        compile_status: 0 - 3, run_status: 0 - 1, stdout: "",
                                        stderr_len: String.len(value: read error))
        }
    }
    let run_args = List.new<String>()
    match Process.run(command: read exe_path_text, args: read run_args) {
        Ok(run_output) => {
            return CodegenHostRunResult(ok: run_output.status == 0, source_id: source_id, source_len: source_len,
                                        compile_status: 0, run_status: run_output.status,
                                        stdout: String.copy(value: read run_output.stdout),
                                        stderr_len: String.len(value: read run_output.stderr))
        }
        Err(error) => {
            return CodegenHostRunResult(ok: false, source_id: source_id, source_len: source_len,
                                        compile_status: 0, run_status: 0 - 2, stdout: "",
                                        stderr_len: String.len(value: read error))
        }
    }
}

fn codegen_to_program_cstyle(cache: mut UOpCache, prg: Int) -> Int {
    let lin = linearizer_do_linearize(cache: mut cache, prg: prg)
    let est = codegen_do_estimates(cache: mut cache, prg: lin)
    return codegen_do_render_cstyle(cache: mut cache, prg: est)
}

fn full_rewrite_to_sink(cache: mut UOpCache, ast: Int, optimize: Bool) -> Int {
    if node_op(cache: read cache, id: ast) == PROGRAM && node_num_src(cache: read cache, id: ast) > 0 {
        return codegen_normalize_define_buffers(cache: mut cache, id: node_src_id(cache: read cache, id: ast, k: 0))
    }
    return codegen_normalize_define_buffers(cache: mut cache, id: ast)
}

fn codegen_normalize_define_buffers(cache: mut UOpCache, id: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if op == DEFINE_LOCAL || op == DEFINE_REG {
        local sh = uop_shape(cache: read cache, id: id)
        let dt = node_full_dtype(cache: read cache, id: id)
        let slot = node_const_int(cache: read cache, id: id)
        if op == DEFINE_LOCAL {
            return mk_buffer_param(cache: mut cache, slot: slot, dt: read dt, shape: read sh, addrspace: read ADDR_LOCAL)
        }
        return mk_buffer_param(cache: mut cache, slot: slot, dt: read dt, shape: read sh, addrspace: read ADDR_REG)
    }
    local new_src = List.new<Int>()
    let mut changed = false
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        let next = codegen_normalize_define_buffers(cache: mut cache, id: child)
        if next != child { changed = true }
        List.push<Int>(list: mut new_src, value: read next)
        i = i + 1
    }
    if op == LOAD && List.len<Int>(list: read new_src) > 0 {
        let ptr = List.get<Int>(list: read new_src, index: 0)
        if node_addrspace(cache: read cache, id: ptr) == ADDR_REG { return ptr }
    }
    if changed {
        local arg = node_arg(cache: read cache, id: id)
        return intern(cache: mut cache, op: op, dt: read node_full_dtype(cache: read cache, id: id), src: take new_src, arg: take arg)
    }
    return id
}

fn line_rewrite(cache: mut UOpCache, order: read List<Int>) -> fresh List<Int> {
    return linearizer_line_rewrite_cleanups(cache: mut cache, order: read order)
}

fn do_linearize(cache: mut UOpCache, prg: Int) -> Int {
    return linearizer_do_linearize(cache: mut cache, prg: prg)
}

fn do_estimates(cache: mut UOpCache, prg: Int) -> Int {
    return codegen_do_estimates(cache: mut cache, prg: prg)
}

fn do_assemble(cache: mut UOpCache, prg: Int) -> Int {
    if node_op(cache: read cache, id: prg) != PROGRAM { return prg }
    if node_num_src(cache: read cache, id: prg) < 3 { return prg }
    let lin = node_src_id(cache: read cache, id: prg, k: 2)
    if node_op(cache: read cache, id: lin) != LINEAR { return prg }
    if node_num_src(cache: read cache, id: prg) > 4 { return prg }
    let mut text = ""
    let mut i = 0
    while i < node_num_src(cache: read cache, id: lin) {
        if i > 0 { text = String.concat(left: read text, right: read "\n") }
        let id = node_src_id(cache: read cache, id: lin, k: i)
        text = String.concat(left: read text, right: read uop_arg_to_string(arg: read node_arg(cache: read cache, id: id)))
        i = i + 1
    }
    let source = mk_source(cache: mut cache, text: read text)
    let binary = mk_binary(cache: mut cache, text: read "")
    local src = List.new<Int>()
    let mut j = 0
    while j < node_num_src(cache: read cache, id: prg) {
        List.push<Int>(list: mut src, value: read node_src_id(cache: read cache, id: prg, k: j))
        j = j + 1
    }
    if node_num_src(cache: read cache, id: prg) == 3 { List.push<Int>(list: mut src, value: read source) }
    List.push<Int>(list: mut src, value: read binary)
    let dt = node_full_dtype(cache: read cache, id: prg)
    local prog = node_program_arg(cache: read cache, id: prg)
    local arg = ArgProgram(value: take prog)
    return intern(cache: mut cache, op: PROGRAM, dt: read dt, src: take src, arg: take arg)
}

fn do_render(cache: mut UOpCache, prg: Int) -> Int {
    return codegen_do_render_cstyle(cache: mut cache, prg: prg)
}

fn do_compile(cache: mut UOpCache, prg: Int) -> Int {
    if node_op(cache: read cache, id: prg) != PROGRAM { return prg }
    if node_num_src(cache: read cache, id: prg) < 4 { return prg }
    if node_num_src(cache: read cache, id: prg) > 4 { return prg }
    let source = node_src_id(cache: read cache, id: prg, k: 3)
    if node_op(cache: read cache, id: source) != SOURCE { return prg }
    let binary = mk_binary(cache: mut cache, text: read "")
    local src = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: prg) {
        List.push<Int>(list: mut src, value: read node_src_id(cache: read cache, id: prg, k: i))
        i = i + 1
    }
    List.push<Int>(list: mut src, value: read binary)
    let dt = node_full_dtype(cache: read cache, id: prg)
    local prog = node_program_arg(cache: read cache, id: prg)
    local arg = ArgProgram(value: take prog)
    return intern(cache: mut cache, op: PROGRAM, dt: read dt, src: take src, arg: take arg)
}

fn do_to_program(cache: mut UOpCache, ast: Int) -> Int {
    if node_op(cache: read cache, id: ast) == PROGRAM {
        return codegen_to_program_cstyle(cache: mut cache, prg: ast)
    }
    if node_op(cache: read cache, id: ast) == SINK {
        local info = codegen_program_arg_from_sink(cache: read cache, sink: ast, name: read "kernel")
        local src = List.new<Int>()
        List.push<Int>(list: mut src, value: read ast)
        let dev = mk_device(cache: mut cache, device: read "CPU")
        List.push<Int>(list: mut src, value: read dev)
        let dt = dt_void()
        local arg = ArgProgram(value: take info)
        let prg = intern(cache: mut cache, op: PROGRAM, dt: read dt, src: take src, arg: take arg)
        return codegen_to_program_cstyle(cache: mut cache, prg: prg)
    }
    return ast
}

fn to_program(cache: mut UOpCache, ast: Int) -> Int {
    return do_to_program(cache: mut cache, ast: ast)
}
