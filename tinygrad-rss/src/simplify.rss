// Port of tinygrad/uop/symbolic.py — rewrite rules + graph_rewrite over the interned DAG.
// A rule has the PatternMatcher shape (cache, id) -> Option<Int> (Some = rewritten id, None = no match).
// graph_rewrite rebuilds bottom-up; intern dedups, so identical results share one node.
features: local

fn const_int_eq(cache: read UOpCache, id: Int, k: Int) -> Bool {
    if node_is_const_int(cache: read cache, id: id) {
        let v = node_const_int(cache: read cache, id: id)
        if v == k { return true }
    }
    return false
}

// fold a binary ALU of two integer CONSTs -> CONST(exec_alu_int(...))
fn rule_fold_const_alu(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if group_binary(op: read op) {
        if node_num_src(cache: read cache, id: id) == 2 {
            let s0 = node_src_id(cache: read cache, id: id, k: 0)
            let s1 = node_src_id(cache: read cache, id: id, k: 1)
            if node_is_const_int(cache: read cache, id: s0) {
                if node_is_const_int(cache: read cache, id: s1) {
                    local ops = List.new<Int>()
                    let v0 = node_const_int(cache: read cache, id: s0)
                    let v1 = node_const_int(cache: read cache, id: s1)
                    List.push<Int>(list: mut ops, value: read v0)
                    List.push<Int>(list: mut ops, value: read v1)
                    let folded = exec_alu_int(op: read op, operands: read ops)
                    let dt = node_dtype(cache: read cache, id: id)
                    return Some(mk_const_int(cache: mut cache, dt: read dt, v: folded))
                }
            }
        }
    }
    return None
}

// algebraic identities: x+0->x, x*1->x, x*0->0, x^0->x, x//1->x, x-0->x. Returning a child id reuses
// the (shared) node directly.
fn rule_identities(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if node_num_src(cache: read cache, id: id) == 2 {
        let s0 = node_src_id(cache: read cache, id: id, k: 0)
        let s1 = node_src_id(cache: read cache, id: id, k: 1)
        // same-operand rules: with interning, identical operands share an id, so this is id equality.
        // x-x->0, x^x->0, x%x->0, x//x->1 (tinygrad symbolic.py).
        if s0 == s1 {
            if op == SUB {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if op == XOR {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if op == FLOORMOD {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if op == FLOORDIV {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 1))
            }
        }
        if op == ADD {
            if const_int_eq(cache: read cache, id: s1, k: 0) { return Some(s0) }
            if const_int_eq(cache: read cache, id: s0, k: 0) { return Some(s1) }
        }
        if op == MUL {
            if const_int_eq(cache: read cache, id: s1, k: 1) { return Some(s0) }
            if const_int_eq(cache: read cache, id: s0, k: 1) { return Some(s1) }
            if const_int_eq(cache: read cache, id: s1, k: 0) {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if const_int_eq(cache: read cache, id: s0, k: 0) {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
        }
        if op == XOR {
            if const_int_eq(cache: read cache, id: s1, k: 0) { return Some(s0) }
            if const_int_eq(cache: read cache, id: s0, k: 0) { return Some(s1) }
        }
        if op == FLOORDIV {
            if const_int_eq(cache: read cache, id: s1, k: 1) { return Some(s0) }
        }
        if op == SUB {
            if const_int_eq(cache: read cache, id: s1, k: 0) { return Some(s0) }
        }
    }
    return None
}

// bound-dependent fold: a comparison whose value range collapses to a point is that constant.
fn rule_fold_known_bound(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if group_comparison(op: read op) {
        let r = uop_min_max(cache: read cache, id: id)
        if r.lo == r.hi {
            let dt = node_dtype(cache: read cache, id: id)
            return Some(mk_const_int(cache: mut cache, dt: read dt, v: r.lo))
        }
    }
    return None
}

// the PatternMatcher: try each rule in order, first match wins.
fn simplify_rule(cache: mut UOpCache, id: Int) -> Option<Int> {
    match rule_fold_const_alu(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match rule_identities(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    return rule_fold_known_bound(cache: mut cache, id: id)
}

// graph_rewrite: rebuild bottom-up (children first), intern (dedup), then apply rules.
fn graph_rewrite(cache: mut UOpCache, id: Int) -> Int {
    local new_src = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        let nc = graph_rewrite(cache: mut cache, id: child)
        List.push<Int>(list: mut new_src, value: read nc)
        i = i + 1
    }
    let op = node_op(cache: read cache, id: id)
    let dt = node_dtype(cache: read cache, id: id)
    local ag = node_arg(cache: read cache, id: id)
    let rebuilt = intern(cache: mut cache, op: op, dt: read dt, src: take new_src, arg: take ag)
    match simplify_rule(cache: mut cache, id: rebuilt) {
        Some(r) => { return r }
        None => { return rebuilt }
    }
}
