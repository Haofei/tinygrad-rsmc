fn tensor_max_pool2d_nchw_indices_dilated(cache: mut UOpCache, x: Int, kh: Int, kw: Int, sh: Int, sw: Int, dh: Int, dw: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    let h = List.get<Int>(list: read xs, index: 2)
    let w = List.get<Int>(list: read xs, index: 3)
    let spatial = h * w
    let windows = tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: x, kh: kh, kw: kw, sh: sh, sw: sw, dh: dh, dw: dw)
    local axes = List.new<Int>()
    push1(l: mut axes, a: 4)
    push1(l: mut axes, a: 5)
    let max_keep = tensor_max_axes_keepdim(cache: mut cache, x: windows, axes: read axes)
    let m = tensor_eq(cache: mut cache, a: windows, b: max_keep)
    let mf = tensor_cast(cache: mut cache, x: m, dt: read dt_float32())
    let desc = tensor_arange_desc(cache: mut cache, dt: read dt_float32(), start: spatial, n: spatial)
    local idx_shape = List.new<Int>()
    push1(l: mut idx_shape, a: 1)
    push1(l: mut idx_shape, a: 1)
    push1(l: mut idx_shape, a: h)
    push1(l: mut idx_shape, a: w)
    let idx_map = tensor_reshape(cache: mut cache, x: desc, new_shape: read idx_shape)
    let idx_windows = tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: idx_map, kh: kh, kw: kw, sh: sh, sw: sw, dh: dh, dw: dw)
    let weighted = tensor_mul(cache: mut cache, a: mf, b: idx_windows)
    let idx_desc = tensor_max_axes(cache: mut cache, x: weighted, axes: read axes)
    let ndt = node_dtype(cache: read cache, id: idx_desc)
    let nconst = mk_const_float(cache: mut cache, dt: read ndt, v: Int.to_float(value: read spatial))
    let idx = tensor_sub(cache: mut cache, a: nconst, b: idx_desc)
    return tensor_cast(cache: mut cache, x: idx, dt: read dt_int32())
}

