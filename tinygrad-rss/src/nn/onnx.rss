}

fn onnx_attr_ints_or(node: read OnnxNodeProto, name: read String, fallback: read List<Int>) -> fresh List<Int> {
    local a = onnx_find_attr(node: read node, name: read name)
    if List.len<Int>(list: read a.ints) > 0 { return onnx_copy_ints(values: read a.ints) }
    return onnx_copy_ints(values: read fallback)
}

fn onnx_tensor_to_tensor(cache: mut UOpCache, tensor: read OnnxTensorProto) -> Int {
    let mut dt = to_dtype(data_type: tensor.data_type)
    local shape = onnx_copy_ints(values: read tensor.dims)
    local data = List.new<Float>()
    if List.len<Float>(list: read tensor.float_data) > 0 {
        let mut i = 0
        while i < List.len<Float>(list: read tensor.float_data) {
            pushf(l: mut data, v: List.get<Float>(list: read tensor.float_data, index: i))
            i = i + 1
        }
    } else if List.len<Int>(list: read tensor.int64_data) > 0 {
        let mut i = 0
        while i < List.len<Int>(list: read tensor.int64_data) {
            pushf(l: mut data, v: Int.to_float(value: read List.get<Int>(list: read tensor.int64_data, index: i)))
            i = i + 1
        }
    } else if List.len<Int>(list: read tensor.raw_data) > 0 {
        let mut i = 0
        while i < List.len<Int>(list: read tensor.raw_data) {
            let raw_byte = List.get<Int>(list: read tensor.raw_data, index: i) & 255
            pushf(l: mut data, v: Int.to_float(value: read raw_byte))
            i = i + 1
        }
        dt = dt_uint8()
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn onnx_runner_set_value(runner: mut OnnxRunnerState, name: read String, tensor: Int) -> Unit {
    let mut i = 0
    while i < List.len<String>(list: read runner.value_names) {
        if List.get<String>(list: read runner.value_names, index: i) == name {
            List.set<Int>(list: mut runner.value_tensors, index: i, value: read tensor)
            return Unit
        }
        i = i + 1
    }
    List.push<String>(list: mut runner.value_names, value: read String.copy(value: read name))
    push1(l: mut runner.value_tensors, a: tensor)
    return Unit
}

fn onnx_runner_get_value(runner: read OnnxRunnerState, name: read String) -> Int {
    let mut i = 0
    while i < List.len<String>(list: read runner.value_names) {
        if List.get<String>(list: read runner.value_names, index: i) == name {
            return List.get<Int>(list: read runner.value_tensors, index: i)
        }
        i = i + 1
    }
    return 0 - 1
}

fn onnx_runner_get_tensor(cache: mut UOpCache, runner: mut OnnxRunnerState, name: read String) -> Int {
    let existing = onnx_runner_get_value(runner: read runner, name: read name)
    if existing >= 0 { return existing }
    let mut i = 0
    while i < List.len<String>(list: read runner.const_names) {
        if List.get<String>(list: read runner.const_names, index: i) == name {
            local proto = List.get<OnnxTensorProto>(list: read runner.const_values, index: i)
            let t = onnx_tensor_to_tensor(cache: mut cache, tensor: read proto)
            onnx_runner_set_value(runner: mut runner, name: read name, tensor: t)
            return t
        }
        i = i + 1
    }
    return 0 - 1
}

fn onnx_shape_from_tensor(cache: read UOpCache, x: Int) -> fresh List<Int> {
    local data = tensor_data(cache: read cache, x: x)
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Float>(list: read data) {
        push1(l: mut out, a: trunc_float_to_int(v: List.get<Float>(list: read data, index: i)))
        i = i + 1
    }
    return take out
}

fn onnx_default_perm(cache: read UOpCache, x: Int) -> fresh List<Int> {
    local shape = uop_shape(cache: read cache, id: x)
    local perm = List.new<Int>()
    let mut i = List.len<Int>(list: read shape) - 1
    while i >= 0 {
        push1(l: mut perm, a: i)
        i = i - 1
    }
    return take perm
}

fn onnx_conv_padding(pads: read List<Int>, pos: Int) -> Int {
    if List.len<Int>(list: read pads) > pos { return List.get<Int>(list: read pads, index: pos) }
    return 0
}

fn onnx_execute_node(cache: mut UOpCache, runner: mut OnnxRunnerState, node: read OnnxNodeProto) -> fresh List<Int> {
    local outs = List.new<Int>()
    let mut result = 0 - 1
    if node.op_type == "Add" || node.op_type == "Sub" || node.op_type == "Mul" || node.op_type == "Div" || node.op_type == "MatMul" {
        let a = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 0))
        let b = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 1))
        if node.op_type == "Add" { result = tensor_add(cache: mut cache, a: a, b: b) }
        if node.op_type == "Sub" { result = tensor_sub(cache: mut cache, a: a, b: b) }
        if node.op_type == "Mul" { result = tensor_mul(cache: mut cache, a: a, b: b) }
        if node.op_type == "Div" { result = tensor_div(cache: mut cache, a: a, b: b) }
        if node.op_type == "MatMul" { result = tensor_matmul(cache: mut cache, a: a, b: b) }
    } else if node.op_type == "Relu" {
        let x = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 0))
        result = tensor_relu(cache: mut cache, x: x)
    } else if node.op_type == "Reshape" {
        let x = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 0))
        let shape_tensor = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 1))
        local shape = onnx_shape_from_tensor(cache: read cache, x: shape_tensor)
        result = tensor_reshape(cache: mut cache, x: x, new_shape: read shape)
    } else if node.op_type == "Transpose" {
        let x = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 0))
        local fallback = onnx_default_perm(cache: read cache, x: x)
        local perm = onnx_attr_ints_or(node: read node, name: read "perm", fallback: read fallback)
        result = tensor_permute(cache: mut cache, x: x, perm: read perm)
    } else if node.op_type == "Gemm" {
        let mut a = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 0))
        let mut b = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 1))
        let trans_a = onnx_attr_int_or(node: read node, name: read "transA", default_value: 0)
        let trans_b = onnx_attr_int_or(node: read node, name: read "transB", default_value: 0)
        if trans_a != 0 { a = tensor_transpose(cache: mut cache, x: a, dim0: 0 - 1, dim1: 0 - 2) }
        if trans_b != 0 { b = tensor_transpose(cache: mut cache, x: b, dim0: 0 - 1, dim1: 0 - 2) }
        result = tensor_matmul(cache: mut cache, a: a, b: b)
        let alpha = onnx_attr_float_or(node: read node, name: read "alpha", default_value: 1.0)
        if alpha != 1.0 {
            let ac = tensor_const_like_float(cache: mut cache, x: result, value: alpha)
            result = tensor_mul(cache: mut cache, a: result, b: ac)
        }
        if List.len<String>(list: read node.inputs) > 2 {
            let c = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 2))
            let beta = onnx_attr_float_or(node: read node, name: read "beta", default_value: 1.0)
            let mut scaled_c = c
            if beta != 1.0 {
                let bc = tensor_const_like_float(cache: mut cache, x: c, value: beta)
                scaled_c = tensor_mul(cache: mut cache, a: c, b: bc)
            }
            result = tensor_add(cache: mut cache, a: result, b: scaled_c)
        }
    } else if node.op_type == "Conv" {
        let x = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 0))
        let w = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 1))
        let mut bias = 0 - 1
        if List.len<String>(list: read node.inputs) > 2 { bias = onnx_runner_get_tensor(cache: mut cache, runner: mut runner, name: read List.get<String>(list: read node.inputs, index: 2)) }
        local zero2 = shp(a: 0, b: 0)
        local one2 = shp(a: 1, b: 1)
        local pads = onnx_attr_ints_or(node: read node, name: read "pads", fallback: read zero2)
        local strides = onnx_attr_ints_or(node: read node, name: read "strides", fallback: read one2)
        local dilations = onnx_attr_ints_or(node: read node, name: read "dilations", fallback: read one2)
        let groups = onnx_attr_int_or(node: read node, name: read "group", default_value: 1)
        result = tensor_conv2d(cache: mut cache, x: x, weight: w, bias: bias, groups: groups, sh: List.get<Int>(list: read strides, index: 0), sw: List.get<Int>(list: read strides, index: 1), dh: List.get<Int>(list: read dilations, index: 0), dw: List.get<Int>(list: read dilations, index: 1), pad_top: onnx_conv_padding(pads: read pads, pos: 0), pad_bottom: onnx_conv_padding(pads: read pads, pos: 2), pad_left: onnx_conv_padding(pads: read pads, pos: 1), pad_right: onnx_conv_padding(pads: read pads, pos: 3))
    }
    if result >= 0 && List.len<String>(list: read node.outputs) > 0 {
        local out_name = List.get<String>(list: read node.outputs, index: 0)
        onnx_runner_set_value(runner: mut runner, name: read out_name, tensor: result)
        push1(l: mut outs, a: result)
    }
    return take outs
}

fn onnx_run_graph(cache: mut UOpCache, runner: mut OnnxRunnerState) -> fresh List<Int> {
    local outs = List.new<Int>()
    let mut i = 0
    while i < List.len<OnnxNodeProto>(list: read runner.graph.nodes) {
        local node = List.get<OnnxNodeProto>(list: read runner.graph.nodes, index: i)
        local node_outs = onnx_execute_node(cache: mut cache, runner: mut runner, node: read node)
        let mut j = 0
        while j < List.len<Int>(list: read node_outs) {
            push1(l: mut outs, a: List.get<Int>(list: read node_outs, index: j))
            j = j + 1
        }
        i = i + 1
    }
    return take outs
}

