fn no_vectorized_alu(cache: mut UOpCache, alu: Int) -> Option<Int> {
    return devectorizer_no_vectorized_alu(cache: mut cache, id: alu)
}

fn no_vectorized_buf(cache: mut UOpCache, buf: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: buf)
    let addrspace = node_addrspace(cache: read cache, id: buf)
    if op != DEFINE_LOCAL && op != DEFINE_REG && (op != BUFFER || (addrspace != ADDR_LOCAL && addrspace != ADDR_REG)) { return None }
    let dt = node_full_dtype(cache: read cache, id: buf)
    if dt.count <= 1 { return None }
    let scalar = dtype_scalar(d: read dt)
    local shape = uop_shape(cache: read cache, id: buf)
    if op == DEFINE_LOCAL || addrspace == ADDR_LOCAL {
        let rebuilt = mk_define_local(cache: mut cache, slot: 0, dt: read scalar, shape: read shape)
        return Some(mk_cast(cache: mut cache, x: rebuilt, dt: read dt))
    } else {
        let rebuilt = mk_define_reg(cache: mut cache, slot: 0, dt: read scalar, shape: read shape)
        return Some(mk_cast(cache: mut cache, x: rebuilt, dt: read dt))
    }
}

fn no_vectorized_index(cache: mut UOpCache, idx: Int) -> Option<Int> {
    if node_op(cache: read cache, id: idx) != INDEX { return None }
    if node_num_src(cache: read cache, id: idx) < 2 { return None }
    let buf = node_src_id(cache: read cache, id: idx, k: 0)
    if node_op(cache: read cache, id: buf) != CAST { return None }
    let cast_src = node_src_id(cache: read cache, id: buf, k: 0)
    let cnt = node_full_dtype(cache: read cache, id: buf).count
    if cnt <= 1 { return None }
    let raw_idx = node_src_id(cache: read cache, id: idx, k: 1)
    let raw_dt = node_dtype(cache: read cache, id: raw_idx)
    local lanes = List.new<Int>()
    let mut lane = 0
    while lane < cnt {
        let c = mk_const_int(cache: mut cache, dt: read raw_dt, v: lane)
        let cntc = mk_const_int(cache: mut cache, dt: read raw_dt, v: cnt)
        let mul = mk_alu2(cache: mut cache, op: MUL, dt: read raw_dt, x: raw_idx, y: cntc)
        let off = mk_alu2(cache: mut cache, op: ADD, dt: read raw_dt, x: mul, y: c)
        local isrcs = List.new<Int>()
        List.push<Int>(list: mut isrcs, value: read off)
        let p = mk_index(cache: mut cache, base: cast_src, srcs: read isrcs, ptr: true)
        List.push<Int>(list: mut lanes, value: read p)
        lane = lane + 1
    }
    let odt = node_full_dtype(cache: read cache, id: idx)
    return Some(uop_stack(cache: mut cache, dt: read odt, srcs: read lanes))
}

fn horizontal_reduce(cache: mut UOpCache, inp: Int, out_dtype: read DType) -> fresh List<Int> {
    local out = List.new<Int>()
    let in_dt = node_full_dtype(cache: read cache, id: inp)
    if in_dt.count != out_dtype.count && out_dtype.count > 0 {
        let amount = in_dt.count / out_dtype.count
        let mut i = 0
        while i < amount {
            local idxs = List.new<Int>()
            let mut lane = i
            while lane < in_dt.count {
                List.push<Int>(list: mut idxs, value: read lane)
                lane = lane + amount
            }
            List.push<Int>(list: mut out, value: read mk_gep(cache: mut cache, x: inp, idxs: read idxs))
            i = i + 1
        }
        return take out
    }
    List.push<Int>(list: mut out, value: read inp)
    return take out
}

