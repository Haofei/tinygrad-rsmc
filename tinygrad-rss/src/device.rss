}

fn device_memory_store_new() -> fresh DeviceMemoryStore {
    local bufs = Map.new<Int, List<Int>>()
    local cache = List.new<AllocatorCacheEntry>()
    return DeviceMemoryStore(next_handle: 1, bufs: take bufs, cache: take cache, mem_used: 0)
}

fn buffer_spec_default() -> fresh BufferSpec {
    return BufferSpec(uncached: false, cpu_access: false, host: false, nolru: false,
                      has_external_ptr: false, external_ptr: 0)
}

fn buffer_spec_external_ptr(ptr: Int) -> fresh BufferSpec {
    return BufferSpec(uncached: false, cpu_access: false, host: false, nolru: false,
                      has_external_ptr: true, external_ptr: ptr)
}

fn buffer_spec_copy(options: read BufferSpec) -> fresh BufferSpec {
    return BufferSpec(uncached: options.uncached, cpu_access: options.cpu_access, host: options.host,
                      nolru: options.nolru, has_external_ptr: options.has_external_ptr,
                      external_ptr: options.external_ptr)
}

fn device_default() -> fresh String { return String.copy(value: read "CPU") }

fn device_strip_zero_suffix(device: read String) -> fresh String {
    let n = String.len(value: read device)
    if n > 2 {
        if String.ends_with(value: read device, suffix: read ":0") {
            return String.slice(value: read device, start: 0, len: n - 2)
        }
    }
    return String.copy(value: read device)
}

fn device_canonicalize(device: read String) -> fresh String {
    if String.len(value: read device) == 0 { return device_default() }
    local stripped = device_strip_zero_suffix(device: read device)
    if stripped == "cpu" || stripped == "CPU" { return String.copy(value: read "CPU") }
    if stripped == "disk" || stripped == "DISK" { return String.copy(value: read "DISK") }
    if stripped == "tinyfs" || stripped == "TINYFS" { return String.copy(value: read "TINYFS") }
    if stripped == "npy" || stripped == "NPY" { return String.copy(value: read "NPY") }
    if stripped == "python" || stripped == "PYTHON" { return String.copy(value: read "PYTHON") }
    if stripped == "metal" || stripped == "METAL" { return String.copy(value: read "METAL") }
    if stripped == "amd" || stripped == "AMD" { return String.copy(value: read "AMD") }
    if stripped == "nv" || stripped == "NV" { return String.copy(value: read "NV") }
    if stripped == "cuda" || stripped == "CUDA" { return String.copy(value: read "CUDA") }
    if stripped == "qcom" || stripped == "QCOM" { return String.copy(value: read "QCOM") }
    if stripped == "cl" || stripped == "CL" { return String.copy(value: read "CL") }
    if stripped == "dsp" || stripped == "DSP" { return String.copy(value: read "DSP") }
    if stripped == "webgpu" || stripped == "WEBGPU" { return String.copy(value: read "WEBGPU") }
    if String.starts_with(value: read stripped, prefix: read "cpu:") {
        return String.concat(left: read "CPU:", right: read String.slice(value: read stripped, start: 4, len: String.len(value: read stripped) - 4))
    }
    if String.starts_with(value: read stripped, prefix: read "CPU:") { return String.copy(value: read stripped) }
    if String.starts_with(value: read stripped, prefix: read "disk:") {
        return String.concat(left: read "DISK:", right: read String.slice(value: read stripped, start: 5, len: String.len(value: read stripped) - 5))
    }
    if String.starts_with(value: read stripped, prefix: read "DISK:") { return String.copy(value: read stripped) }
    return String.copy(value: read stripped)
}

fn canonicalize_device(device: read String) -> fresh String {
    return device_canonicalize(device: read device)
}

fn canonicalize_devices(devices: read List<String>) -> fresh List<String> {
    local out = List.new<String>()
    let mut i = 0
    while i < List.len<String>(list: read devices) {
        let d = List.get<String>(list: read devices, index: i)
        List.push<String>(list: mut out, value: read canonicalize_device(device: read d))
        i = i + 1
    }
    return take out
}

fn canonicalize_device_tuple(devices: read List<String>) -> fresh List<String> {
    local canon = canonicalize_devices(devices: read devices)
    local out = List.new<String>()
    if List.len<String>(list: read canon) == 0 {
        List.push<String>(list: mut out, value: read device_default())
        return take out
    }
    let first = List.get<String>(list: read canon, index: 0)
    let mut same = true
    let mut i = 1
    while i < List.len<String>(list: read canon) {
        if List.get<String>(list: read canon, index: i) != first { same = false }
        i = i + 1
    }
    if same {
        List.push<String>(list: mut out, value: read first)
        return take out
    }
    return take canon
}

fn copy_bytes(bytes: read List<Int>) -> fresh List<Int> {
    return bytes.clone()
}

fn bytes_zeros(size: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < size {
        List.push<Int>(list: mut out, value: read 0)
        i = i + 1
    }
    return take out
}

fn bytes_slice(bytes: read List<Int>, start: Int, len: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < len {
        List.push<Int>(list: mut out, value: read List.get<Int>(list: read bytes, index: start + i))
        i = i + 1
    }
    return take out
}

fn bytes_copy_into(dst: read List<Int>, offset: Int, src: read List<Int>) -> fresh List<Int> {
    local out = copy_bytes(bytes: read dst)
    let mut i = 0
    while i < List.len<Int>(list: read src) {
        List.set<Int>(list: mut out, index: offset + i, value: read List.get<Int>(list: read src, index: i))
        i = i + 1
    }
    return take out
}

fn allocator_default_buffer_spec() -> fresh BufferSpec {
    return buffer_spec_default()
}

fn buffer_spec_equal(a: read BufferSpec, b: read BufferSpec) -> Bool {
    if a.uncached != b.uncached { return false }
    if a.cpu_access != b.cpu_access { return false }
    if a.host != b.host { return false }
    if a.nolru != b.nolru { return false }
    if a.has_external_ptr != b.has_external_ptr { return false }
    return a.external_ptr == b.external_ptr
}

fn allocator_cache_find(store: read DeviceMemoryStore, size: Int, options: read BufferSpec) -> Int {
    let mut i = List.len<AllocatorCacheEntry>(list: read store.cache) - 1
    while i >= 0 {
        let ent = List.get<AllocatorCacheEntry>(list: read store.cache, index: i)
        if ent.size == size && buffer_spec_equal(a: read ent.options, b: read options) { return i }
        i = i - 1
    }
    return 0 - 1
}

fn allocator_cache_take(store: mut DeviceMemoryStore, index: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    local new_cache = List.new<AllocatorCacheEntry>()
    let mut i = 0
    while i < List.len<AllocatorCacheEntry>(list: read store.cache) {
        let ent = List.get<AllocatorCacheEntry>(list: read store.cache, index: i)
        if i == index {
            let mut j = 0
            while j < List.len<Int>(list: read ent.data) {
                List.push<Int>(list: mut out, value: read List.get<Int>(list: read ent.data, index: j))
                j = j + 1
            }
        } else {
            List.push<AllocatorCacheEntry>(list: mut new_cache, value: read ent)
        }
        i = i + 1
    }
    store.cache = take new_cache
    return take out
}

fn allocator_alloc(store: mut DeviceMemoryStore, size: Int, options: read BufferSpec) -> Int {
    let handle = store.next_handle
    store.next_handle = store.next_handle + 1
    let found = allocator_cache_find(store: read store, size: size, options: read options)
    if found >= 0 {
        local data = allocator_cache_take(store: mut store, index: found)
        Map.insert<Int, List<Int>>(map: mut store.bufs, key: read handle, value: read (manage data))
    } else {
        local data = bytes_zeros(size: size)
        if options.has_external_ptr == false { store.mem_used = store.mem_used + size }
        Map.insert<Int, List<Int>>(map: mut store.bufs, key: read handle, value: read (manage data))
    }
    return handle
}

fn allocator_free(store: mut DeviceMemoryStore, handle: Int, size: Int, options: read BufferSpec) -> Unit {
    match Map.get<Int, List<Int>>(map: read store.bufs, key: read handle) {
        Some(data) => {
            if options.nolru || options.has_external_ptr {
                if options.has_external_ptr == false { store.mem_used = store.mem_used - size }
            } else {
                List.push<AllocatorCacheEntry>(list: mut store.cache,
                    value: read AllocatorCacheEntry(size: size, options: buffer_spec_copy(options: read options), data: copy_bytes(bytes: read data)))
            }
            local empty = List.new<Int>()
            Map.insert<Int, List<Int>>(map: mut store.bufs, key: read handle, value: read (manage empty))
        }
        None => { }
    }
    return Unit
}

fn allocator_free_cache(store: mut DeviceMemoryStore) -> Unit {
    let mut i = 0
    while i < List.len<AllocatorCacheEntry>(list: read store.cache) {
        let ent = List.get<AllocatorCacheEntry>(list: read store.cache, index: i)
        if ent.options.has_external_ptr == false { store.mem_used = store.mem_used - ent.size }
        i = i + 1
    }
    local cache = List.new<AllocatorCacheEntry>()
    store.cache = take cache
    return Unit
}

fn allocator_cache_bytes(store: read DeviceMemoryStore) -> Int {
    let mut total = 0
    let mut i = 0
    while i < List.len<AllocatorCacheEntry>(list: read store.cache) {
        let ent = List.get<AllocatorCacheEntry>(list: read store.cache, index: i)
        total = total + ent.size
        i = i + 1
    }
    return total
}

fn device_store_copyin(store: mut DeviceMemoryStore, handle: Int, offset: Int, src: read List<Int>) -> Unit {
    match Map.get<Int, List<Int>>(map: read store.bufs, key: read handle) {
        Some(dst) => {
            local new_data = bytes_copy_into(dst: read dst, offset: offset, src: read src)
            Map.insert<Int, List<Int>>(map: mut store.bufs, key: read handle, value: read (manage new_data))
        }
        None => { }
    }
    return Unit
}

fn device_store_copyout(store: read DeviceMemoryStore, handle: Int, offset: Int, size: Int) -> fresh List<Int> {
    match Map.get<Int, List<Int>>(map: read store.bufs, key: read handle) {
        Some(data) => { return bytes_slice(bytes: read data, start: offset, len: size) }
        None => { return bytes_zeros(size: size) }
    }
}

fn buffer_new(device: read String, size: Int, dtype: read DType) -> fresh TGBuffer {
    local opts = buffer_spec_default()
    return TGBuffer(device: canonicalize_device(device: read device), size: size, dtype: dtype_scalar(d: read dtype),
                  has_options: false, options: take opts, offset: 0, has_base: false,
                  base_device: "", base_size: 0, base_offset: 0, allocated: false,
                  allocated_views: 0, uop_refcount: 0, has_handle: false, handle: 0)
}

fn buffer_new_with_options(device: read String, size: Int, dtype: read DType, options: read BufferSpec) -> fresh TGBuffer {
    return TGBuffer(device: canonicalize_device(device: read device), size: size, dtype: dtype_scalar(d: read dtype),
                  has_options: true, options: buffer_spec_copy(options: read options), offset: 0, has_base: false,
                  base_device: "", base_size: 0, base_offset: 0, allocated: false,
                  allocated_views: 0, uop_refcount: 0, has_handle: false, handle: 0)
}

fn buffer_ref(buf: read TGBuffer, cnt: Int) -> fresh TGBuffer {
    return TGBuffer(device: String.copy(value: read buf.device), size: buf.size, dtype: dtype_copy(d: read buf.dtype),
                  has_options: buf.has_options, options: buffer_spec_copy(options: read buf.options), offset: buf.offset,
                  has_base: buf.has_base, base_device: String.copy(value: read buf.base_device),
                  base_size: buf.base_size, base_offset: buf.base_offset, allocated: buf.allocated,
                  allocated_views: buf.allocated_views, uop_refcount: buf.uop_refcount + cnt,
                  has_handle: buf.has_handle, handle: buf.handle)
}

fn buffer_is_allocated(buf: read TGBuffer) -> Bool { return buf.allocated }

fn buffer_is_initialized(buf: read TGBuffer) -> Bool { return buffer_is_allocated(buf: read buf) }

fn buffer_nbytes(buf: read TGBuffer) -> Int {
    return buf.size * DType.itemsize(self: read buf.dtype)
}

fn buffer_copy(buf: read TGBuffer) -> fresh TGBuffer {
    return TGBuffer(device: String.copy(value: read buf.device), size: buf.size, dtype: dtype_copy(d: read buf.dtype),
                  has_options: buf.has_options, options: buffer_spec_copy(options: read buf.options), offset: buf.offset,
                  has_base: buf.has_base, base_device: String.copy(value: read buf.base_device),
                  base_size: buf.base_size, base_offset: buf.base_offset, allocated: buf.allocated,
                  allocated_views: buf.allocated_views, uop_refcount: buf.uop_refcount,
                  has_handle: buf.has_handle, handle: buf.handle)
}

fn buffer_allocate(buf: read TGBuffer) -> fresh TGBuffer {
    return TGBuffer(device: String.copy(value: read buf.device), size: buf.size, dtype: dtype_copy(d: read buf.dtype),
                  has_options: buf.has_options, options: buffer_spec_copy(options: read buf.options), offset: buf.offset,
                  has_base: buf.has_base, base_device: String.copy(value: read buf.base_device),
                  base_size: buf.base_size, base_offset: buf.base_offset, allocated: true,
                  allocated_views: buf.allocated_views, uop_refcount: buf.uop_refcount,
                  has_handle: buf.has_handle, handle: buf.handle)
}

fn buffer_allocate_in_store(store: mut DeviceMemoryStore, buf: read TGBuffer) -> fresh TGBuffer {
    if buf.has_options {
        local options = buffer_spec_copy(options: read buf.options)
        let handle = allocator_alloc(store: mut store, size: buffer_nbytes(buf: read buf), options: read options)
        return TGBuffer(device: String.copy(value: read buf.device), size: buf.size, dtype: dtype_copy(d: read buf.dtype),
                      has_options: true, options: buffer_spec_copy(options: read options), offset: buf.offset,
                      has_base: buf.has_base, base_device: String.copy(value: read buf.base_device),
                      base_size: buf.base_size, base_offset: buf.base_offset, allocated: true,
                      allocated_views: buf.allocated_views, uop_refcount: buf.uop_refcount,
                      has_handle: true, handle: handle)
    }
    local options = allocator_default_buffer_spec()
    let handle = allocator_alloc(store: mut store, size: buffer_nbytes(buf: read buf), options: read options)
    return TGBuffer(device: String.copy(value: read buf.device), size: buf.size, dtype: dtype_copy(d: read buf.dtype),
                  has_options: false, options: buffer_spec_copy(options: read options), offset: buf.offset,
                  has_base: buf.has_base, base_device: String.copy(value: read buf.base_device),
                  base_size: buf.base_size, base_offset: buf.base_offset, allocated: true,
                  allocated_views: buf.allocated_views, uop_refcount: buf.uop_refcount,
                  has_handle: true, handle: handle)
}

fn buffer_ensure_allocated(store: mut DeviceMemoryStore, buf: read TGBuffer) -> fresh TGBuffer {
    if buffer_is_initialized(buf: read buf) { return buffer_copy(buf: read buf) }
    return buffer_allocate_in_store(store: mut store, buf: read buf)
}

fn buffer_deallocate(buf: read TGBuffer) -> fresh TGBuffer {
    return TGBuffer(device: String.copy(value: read buf.device), size: buf.size, dtype: dtype_copy(d: read buf.dtype),
                  has_options: buf.has_options, options: buffer_spec_copy(options: read buf.options), offset: buf.offset,
                  has_base: buf.has_base, base_device: String.copy(value: read buf.base_device),
                  base_size: buf.base_size, base_offset: buf.base_offset, allocated: false,
                  allocated_views: buf.allocated_views, uop_refcount: buf.uop_refcount,
                  has_handle: false, handle: 0)
}

fn buffer_deallocate_in_store(store: mut DeviceMemoryStore, buf: read TGBuffer) -> fresh TGBuffer {
    if buf.has_handle {
        if buf.has_options {
            local options = buffer_spec_copy(options: read buf.options)
            allocator_free(store: mut store, handle: buf.handle, size: buffer_nbytes(buf: read buf), options: read options)
        } else {
            local options = allocator_default_buffer_spec()
            allocator_free(store: mut store, handle: buf.handle, size: buffer_nbytes(buf: read buf), options: read options)
        }
    }
    return buffer_deallocate(buf: read buf)
}

fn buffer_view(buf: read TGBuffer, size: Int, dtype: read DType, offset: Int) -> fresh TGBuffer {
    let base_off = buf.offset
    return TGBuffer(device: String.copy(value: read buf.device), size: size, dtype: dtype_scalar(d: read dtype),
                  has_options: buf.has_options, options: buffer_spec_copy(options: read buf.options), offset: base_off + offset,
                  has_base: true, base_device: String.copy(value: read buf.device),
                  base_size: buf.size, base_offset: buf.offset, allocated: buf.allocated,
                  allocated_views: 0, uop_refcount: buf.uop_refcount,
                  has_handle: buf.has_handle, handle: buf.handle)
}

fn buffer_copyin(store: mut DeviceMemoryStore, buf: read TGBuffer, src: read List<Int>) -> fresh TGBuffer {
    local actual = buffer_ensure_allocated(store: mut store, buf: read buf)
    if actual.has_handle {
        device_store_copyin(store: mut store, handle: actual.handle, offset: actual.offset, src: read src)
    }
    return take actual
}

fn buffer_copyout(store: read DeviceMemoryStore, buf: read TGBuffer) -> fresh List<Int> {
    if buf.has_handle == false { return bytes_zeros(size: buffer_nbytes(buf: read buf)) }
    return device_store_copyout(store: read store, handle: buf.handle, offset: buf.offset, size: buffer_nbytes(buf: read buf))
}

fn buffer_repr(buf: read TGBuffer) -> fresh String {
    let mut s = String.copy(value: read "<buf real:")
    if buf.allocated { s = String.concat(left: read s, right: read "True") } else { s = String.concat(left: read s, right: read "False") }
    s = String.concat(left: read s, right: read " device:")
    s = String.concat(left: read s, right: read buf.device)
    s = String.concat(left: read s, right: read " size:")
    s = String.concat(left: read s, right: read Int.to_string(value: read buf.size))
    s = String.concat(left: read s, right: read " dtype:")
    s = String.concat(left: read s, right: read inverse_dtype_name(n: read buf.dtype.name))
    if buf.has_base {
        s = String.concat(left: read s, right: read " offset:")
        s = String.concat(left: read s, right: read Int.to_string(value: read buf.offset))
    }
    return String.concat(left: read s, right: read ">")
}

fn multibuffer_new(devices: read List<String>, size: Int, dtype: read DType) -> fresh MultiBuffer {
    local bufs = List.new<TGBuffer>()
    let mut i = 0
    while i < List.len<String>(list: read devices) {
        let d = List.get<String>(list: read devices, index: i)
        List.push<TGBuffer>(list: mut bufs, value: read buffer_new(device: read d, size: size, dtype: read dtype))
        i = i + 1
    }
    return MultiBuffer(bufs: take bufs)
}

fn multibuffer_size(mb: read MultiBuffer) -> Int {
    if List.len<TGBuffer>(list: read mb.bufs) == 0 { return 0 }
    let b = List.get<TGBuffer>(list: read mb.bufs, index: 0)
    return b.size
}

fn multibuffer_dtype(mb: read MultiBuffer) -> fresh DType {
    if List.len<TGBuffer>(list: read mb.bufs) == 0 { return dt_void() }
    let b = List.get<TGBuffer>(list: read mb.bufs, index: 0)
    return dtype_copy(d: read b.dtype)
}

fn multibuffer_is_allocated(mb: read MultiBuffer) -> Bool {
    if List.len<TGBuffer>(list: read mb.bufs) == 0 { return false }
    let mut i = 0
    while i < List.len<TGBuffer>(list: read mb.bufs) {
        let b = List.get<TGBuffer>(list: read mb.bufs, index: i)
        if buffer_is_allocated(buf: read b) == false { return false }
        i = i + 1
    }
    return true
}

fn multibuffer_ref(mb: read MultiBuffer, cnt: Int) -> fresh MultiBuffer {
    local bufs = List.new<TGBuffer>()
    let mut i = 0
    while i < List.len<TGBuffer>(list: read mb.bufs) {
        let b = List.get<TGBuffer>(list: read mb.bufs, index: i)
        List.push<TGBuffer>(list: mut bufs, value: read buffer_ref(buf: read b, cnt: cnt))
        i = i + 1
    }
    return MultiBuffer(bufs: take bufs)
}

struct CompiledDevice derives(Clone) {
    device: String,
    arch: String,
    renderer_name: String,
    compiler_name: String,
}

struct CompileArtifact derives(Clone) {
    src: String,
    lib: List<Int>,
}

fn _canonicalize(device: read String) -> fresh String {
    return device_canonicalize(device: read device)
}

fn canonicalize(device: read String) -> fresh String {
    return device_canonicalize(device: read device)
}

fn __get_canonicalized_item(device: read String) -> fresh CompiledDevice {
    let canon = canonicalize(device: read device)
    return CompiledDevice(device: String.copy(value: read canon), arch: String.copy(value: read canon),
                          renderer_name: _renderer_name(device: read canon, renderer_kind: read "CStyleRenderer"),
                          compiler_name: compiler(device: read canon))
}

fn default() -> fresh CompiledDevice {
    return __get_canonicalized_item(device: read device_default())
}

fn get_available_devices() -> fresh List<String> {
    local out = List.new<String>()
    List.push<String>(list: mut out, value: read "CPU")
    List.push<String>(list: mut out, value: read "PYTHON")
    List.push<String>(list: mut out, value: read "DISK")
    List.push<String>(list: mut out, value: read "NPY")
    return take out
}

fn DEFAULT() -> fresh String {
    return device_default()
}

fn _select_device() -> fresh String {
    return device_default()
}

fn size(buf: read TGBuffer) -> Int {
    return buf.size
}

fn ref(buf: read TGBuffer, cnt: Int) -> fresh TGBuffer {
    return buffer_ref(buf: read buf, cnt: cnt)
}

fn is_allocated(buf: read TGBuffer) -> Bool {
    return buffer_is_allocated(buf: read buf)
}

fn base(buf: read TGBuffer) -> fresh TGBuffer {
    if buf.has_base {
        local out = buffer_new(device: read buf.base_device, size: buf.base_size, dtype: read buf.dtype)
        if buf.allocated { return buffer_allocate(buf: read out) }
        return take out
    }
    return buffer_copy(buf: read buf)
}

fn uop_refcount(buf: read TGBuffer) -> Int {
    return buf.uop_refcount
}

fn _buf(buf: read TGBuffer) -> Int {
    if buf.has_handle { return buf.handle }
    return 0
}

fn is_initialized(buf: read TGBuffer) -> Bool {
    return buffer_is_initialized(buf: read buf)
}

fn get_buf(buf: read TGBuffer, device: read String) -> Int {
    let canon = canonicalize(device: read device)
    if canon == buf.device && buf.has_handle { return buf.handle }
    return 0
}

fn ensure_allocated(store: mut DeviceMemoryStore, buf: read TGBuffer) -> fresh TGBuffer {
    return buffer_ensure_allocated(store: mut store, buf: read buf)
}

fn allocate(store: mut DeviceMemoryStore, buf: read TGBuffer) -> fresh TGBuffer {
    return buffer_allocate_in_store(store: mut store, buf: read buf)
}

fn deallocate(store: mut DeviceMemoryStore, buf: read TGBuffer) -> fresh TGBuffer {
    return buffer_deallocate_in_store(store: mut store, buf: read buf)
}

fn __del__(store: mut DeviceMemoryStore, buf: read TGBuffer) -> fresh TGBuffer {
    if buffer_is_initialized(buf: read buf) { return buffer_deallocate_in_store(store: mut store, buf: read buf) }
    return buffer_copy(buf: read buf)
}

fn as_memoryview(store: read DeviceMemoryStore, buf: read TGBuffer, allow_zero_copy: Bool, force_zero_copy: Bool) -> fresh List<Int> {
    if allow_zero_copy || force_zero_copy { return buffer_copyout(store: read store, buf: read buf) }
    return buffer_copyout(store: read store, buf: read buf)
}

fn copyin(store: mut DeviceMemoryStore, buf: read TGBuffer, src: read List<Int>) -> fresh TGBuffer {
    return buffer_copyin(store: mut store, buf: read buf, src: read src)
}

fn copyout(store: read DeviceMemoryStore, buf: read TGBuffer) -> fresh List<Int> {
    return buffer_copyout(store: read store, buf: read buf)
}

fn alloc(store: mut DeviceMemoryStore, size: Int, options: read BufferSpec) -> Int {
    return allocator_alloc(store: mut store, size: size, options: read options)
}

fn free(store: mut DeviceMemoryStore, opaque: Int, size: Int, options: read BufferSpec) -> Unit {
    allocator_free(store: mut store, handle: opaque, size: size, options: read options)
    return Unit
}

fn free_cache(store: mut DeviceMemoryStore) -> Unit {
    allocator_free_cache(store: mut store)
    return Unit
}

fn _alloc(store: mut DeviceMemoryStore, size: Int, options: read BufferSpec) -> Int {
    return allocator_alloc(store: mut store, size: size, options: read options)
}

fn _free(store: mut DeviceMemoryStore, opaque: Int, options: read BufferSpec) -> Unit {
    allocator_free(store: mut store, handle: opaque, size: 0, options: read options)
    return Unit
}

fn _copyin(store: mut DeviceMemoryStore, dest: Int, src: read List<Int>) -> Unit {
    device_store_copyin(store: mut store, handle: dest, offset: 0, src: read src)
    return Unit
}

fn _copyout(store: read DeviceMemoryStore, src: Int, size: Int) -> fresh List<Int> {
    return device_store_copyout(store: read store, handle: src, offset: 0, size: size)
}

fn _map(buf: read TGBuffer) -> fresh TGBuffer {
    return buffer_copy(buf: read buf)
}

fn _unmap(buf: read TGBuffer) -> Bool {
    return buf.has_handle || buf.has_handle == false
}

fn _encode_decode(store: mut DeviceMemoryStore, bufout: read TGBuffer, bufin: read TGBuffer, desc: read String, hist: read List<Int>, shape: read List<Int>, frame_pos: Int) -> fresh TGBuffer {
    local data = buffer_copyout(store: read store, buf: read bufin)
    if String.len(value: read desc) < 0 || List.len<Int>(list: read hist) < 0 || List.len<Int>(list: read shape) < 0 || frame_pos < 0 {
        return buffer_copy(buf: read bufout)
    }
    return buffer_copyin(store: mut store, buf: read bufout, src: read data)
}

fn compile(src: read String) -> fresh List<Int> {
    return Bytes.to_uints(value: read String.to_bytes(value: read src))
}

fn compile_cached(src: read String, cachekey: read String) -> fresh CompileArtifact {
    local lib = compile(src: read src)
    if String.len(value: read cachekey) < 0 { List.push<Int>(list: mut lib, value: read 0) }
    return CompileArtifact(src: String.copy(value: read src), lib: take lib)
}

fn disassemble(lib: read List<Int>) -> fresh String {
    return String.concat(left: read "bytes:", right: read Int.to_string(value: read List.len<Int>(list: read lib)))
}

fn renderer(device: read String) -> fresh String {
    let canon = canonicalize(device: read device)
    if canon == "CPU" || String.starts_with(value: read canon, prefix: read "CPU:") { return String.copy(value: read "CLANG") }
    if canon == "CUDA" || canon == "NV" { return String.copy(value: read "CUDA") }
    if canon == "AMD" { return String.copy(value: read "HIP") }
    if canon == "CL" { return String.copy(value: read "OPENCL") }
    return String.copy(value: read "CSTYLE")
}

fn compiler(device: read String) -> fresh String {
    return String.concat(left: read renderer(device: read device), right: read "Compiler")
}

fn _renderer_name(device: read String, renderer_kind: read String) -> fresh String {
    let dev = canonicalize(device: read device)
    let mut name = String.copy(value: read renderer_kind)
    if String.ends_with(value: read name, suffix: read "Renderer") {
        name = String.slice(value: read name, start: 0, len: String.len(value: read name) - 8)
    }
    let prefix = String.concat(left: read dev, right: read "")
    if String.starts_with(value: read name, prefix: read prefix) {
        name = String.slice(value: read name, start: String.len(value: read prefix), len: String.len(value: read name) - String.len(value: read prefix))
    }
    if String.len(value: read name) == 0 { return String.copy(value: read dev) }
    return String.copy(value: read name)
}

fn _select_renderer(device: read String) -> fresh String {
    return renderer(device: read device)
}

fn count(device: read String) -> Int {
    if String.len(value: read device) >= 0 { return 1 }
    return 0
}

fn synchronize(device: read String) -> Bool {
    return String.len(value: read device) >= 0
}

fn _at_profile_finalize(device: read String) -> Bool {
    return String.len(value: read device) >= 0
}

fn finalize(device: read String) -> Bool {
    return String.len(value: read device) >= 0
}

fn enumerate_devices_str() -> fresh List<String> {
    local devices = get_available_devices()
    local out = List.new<String>()
    let mut i = 0
    while i < List.len<String>(list: read devices) {
        let d = List.get<String>(list: read devices, index: i)
        let prefix = "* "
        let line = String.concat(left: read prefix, right: read String.concat(left: read d, right: read ": PASS"))
        List.push<String>(list: mut out, value: read line)
        i = i + 1
    }
    return take out
}
