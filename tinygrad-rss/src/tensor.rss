fn tensor_uint_for_itemsize(sz: Int) -> fresh DType {
    if sz == 1 { return dt_uint8() }
    if sz == 2 { return dt_uint16() }
    if sz == 4 { return dt_uint32() }
    return dt_uint64()
}

fn tensor_empty_1d(cache: mut UOpCache, dt: read DType) -> Int {
    local shape = List.new<Int>()
    push1(l: mut shape, a: 0)
    local data = List.new<Float>()
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_shape_bitcast(cache: read UOpCache, x: Int, new_itemsize: Int, old_itemsize: Int) -> fresh List<Int> {
    local shape = uop_shape(cache: read cache, id: x)
    local out = List.new<Int>()
    let ndim = List.len<Int>(list: read shape)
    let mut i = 0
    while i < ndim - 1 {
        push1(l: mut out, a: List.get<Int>(list: read shape, index: i))
        i = i + 1
    }
    if ndim > 0 {
        let last = List.get<Int>(list: read shape, index: ndim - 1)
        push1(l: mut out, a: (last * old_itemsize) / new_itemsize)
    }
    return take out
}

fn tensor_slice_last_unit(cache: mut UOpCache, x: Int, start: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    local starts = List.new<Int>()
    local ends = List.new<Int>()
    let ndim = List.len<Int>(list: read shape)
    let mut i = 0
    while i < ndim {
        if i == ndim - 1 {
            push1(l: mut starts, a: start)
            push1(l: mut ends, a: start + 1)
        } else {
            push1(l: mut starts, a: 0)
            push1(l: mut ends, a: List.get<Int>(list: read shape, index: i))
        }
        i = i + 1
    }
    return tensor_slice(cache: mut cache, x: x, starts: read starts, ends: read ends)
}

fn tensor_bitcast_same(cache: mut UOpCache, x: Int, dt: read DType) -> Int {
    return mk_bitcast(cache: mut cache, x: x, dt: read dt)
}

fn tensor_bitcast(cache: mut UOpCache, x: Int, dt: read DType) -> Int {
    let xdt = node_dtype(cache: read cache, id: x)
    if xdt.name == dt.name { return x }
    let old_itemsize = DType.itemsize(self: read xdt)
    let new_itemsize = DType.itemsize(self: read dt)
    if old_itemsize == new_itemsize {
        return tensor_bitcast_same(cache: mut cache, x: x, dt: read dt)
    }

    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    if ndim == 0 { return tensor_empty_1d(cache: mut cache, dt: read dt) }
    let last = List.get<Int>(list: read shape, index: ndim - 1)
    if ((last * old_itemsize) % new_itemsize) != 0 {
        return tensor_empty_1d(cache: mut cache, dt: read dt)
    }

    let old_uint = tensor_uint_for_itemsize(sz: old_itemsize)
    let new_uint = tensor_uint_for_itemsize(sz: new_itemsize)
    let tmp = tensor_bitcast_same(cache: mut cache, x: x, dt: read old_uint)
    if new_itemsize > old_itemsize {
        let rate = new_itemsize / old_itemsize
        local rshape = tensor_shape_bitcast(cache: read cache, x: x, new_itemsize: new_itemsize, old_itemsize: old_itemsize)
        push1(l: mut rshape, a: rate)
        let reshaped = tensor_reshape(cache: mut cache, x: tmp, new_shape: read rshape)
        let mut acc = 0 - 1
        let mut i = 0
        while i < rate {
            let piece = tensor_slice_last_unit(cache: mut cache, x: reshaped, start: i)
            let wide = tensor_cast(cache: mut cache, x: piece, dt: read new_uint)
            let shift = tensor_const_like_float(cache: mut cache, x: wide, value: Int.to_float(value: read (8 * i * old_itemsize)))
            let shifted = tensor_shl(cache: mut cache, a: wide, b: shift)
            if acc < 0 {
                acc = shifted
            } else {
                acc = tensor_add(cache: mut cache, a: acc, b: shifted)
            }
            i = i + 1
        }
        let squeezed = tensor_squeeze_dim(cache: mut cache, x: acc, dim: 0 - 1)
        return tensor_bitcast_same(cache: mut cache, x: squeezed, dt: read dt)
    }

    let rate = old_itemsize / new_itemsize
    local parts = List.new<Int>()
    let mut j = 0
    while j < rate {
        let shift = tensor_const_like_float(cache: mut cache, x: tmp, value: Int.to_float(value: read (8 * j * new_itemsize)))
        let shifted = tensor_shr(cache: mut cache, a: tmp, b: shift)
        push1(l: mut parts, a: shifted)
        j = j + 1
    }
    let stacked = tensor_stack(cache: mut cache, tensors: read parts, dim: 0 - 1)
    let flat = tensor_flatten(cache: mut cache, x: stacked, start_dim: 0 - 2, end_dim: 0 - 1)
    let narrowed = tensor_cast(cache: mut cache, x: flat, dt: read new_uint)
    return tensor_bitcast_same(cache: mut cache, x: narrowed, dt: read dt)
}

fn tensor_resolve_dim(ndim: Int, dim: Int, extra: Bool) -> Int {
    let mut total = ndim
    if extra { total = total + 1 }
    let mut d = dim
    if d < 0 { d = d + total }
    return d
}

fn tensor_unsqueeze(cache: mut UOpCache, x: Int, dim: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: true)
    local out = List.new<Int>()
    let mut i = 0
    while i < ndim + 1 {
        if i == d {
            push1(l: mut out, a: 1)
        } else {
            let mut src_i = i
            if i > d { src_i = i - 1 }
            push1(l: mut out, a: List.get<Int>(list: read shape, index: src_i))
        }
        i = i + 1
    }
    return mk_reshape(cache: mut cache, x: x, new_shape: read out)
}

fn tensor_squeeze_dim(cache: mut UOpCache, x: Int, dim: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    if ndim == 0 { return x }
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    if List.get<Int>(list: read shape, index: d) != 1 { return x }
    local out = List.new<Int>()
    let mut i = 0
    while i < ndim {
        if i != d { push1(l: mut out, a: List.get<Int>(list: read shape, index: i)) }
        i = i + 1
    }
    return mk_reshape(cache: mut cache, x: x, new_shape: read out)
}

fn tensor_squeeze_all(cache: mut UOpCache, x: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        let d = List.get<Int>(list: read shape, index: i)
        if d != 1 { push1(l: mut out, a: d) }
        i = i + 1
    }
    return mk_reshape(cache: mut cache, x: x, new_shape: read out)
}

fn tensor_transpose(cache: mut UOpCache, x: Int, dim0: Int, dim1: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d0 = tensor_resolve_dim(ndim: ndim, dim: dim0, extra: false)
    let d1 = tensor_resolve_dim(ndim: ndim, dim: dim1, extra: false)
    local order = List.new<Int>()
    let mut i = 0
    while i < ndim {
        push1(l: mut order, a: i)
        i = i + 1
    }
    let o0 = List.get<Int>(list: read order, index: d0)
    let o1 = List.get<Int>(list: read order, index: d1)
    List.set<Int>(list: mut order, index: d0, value: read o1)
    List.set<Int>(list: mut order, index: d1, value: read o0)
    return mk_permute(cache: mut cache, x: x, perm: read order)
}

fn tensor_flatten(cache: mut UOpCache, x: Int, start_dim: Int, end_dim: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let start = tensor_resolve_dim(ndim: ndim, dim: start_dim, extra: false)
    let end = tensor_resolve_dim(ndim: ndim, dim: end_dim, extra: false)
    local out = List.new<Int>()
    let mut i = 0
    while i < start {
        push1(l: mut out, a: List.get<Int>(list: read shape, index: i))
        i = i + 1
    }
    let mut flat = 1
    let mut j = start
    while j <= end {
        flat = flat * List.get<Int>(list: read shape, index: j)
        j = j + 1
    }
    push1(l: mut out, a: flat)
    let mut k = end + 1
    while k < ndim {
        push1(l: mut out, a: List.get<Int>(list: read shape, index: k))
        k = k + 1
    }
    return mk_reshape(cache: mut cache, x: x, new_shape: read out)
}

fn tensor_unflatten(cache: mut UOpCache, x: Int, dim: Int, sizes: read List<Int>) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    local out = List.new<Int>()
    let mut i = 0
    while i < d {
        push1(l: mut out, a: List.get<Int>(list: read shape, index: i))
        i = i + 1
    }
    let mut j = 0
    while j < List.len<Int>(list: read sizes) {
        push1(l: mut out, a: List.get<Int>(list: read sizes, index: j))
        j = j + 1
    }
    let mut k = d + 1
    while k < ndim {
        push1(l: mut out, a: List.get<Int>(list: read shape, index: k))
        k = k + 1
    }
    return tensor_reshape(cache: mut cache, x: x, new_shape: read out)
}

fn tensor_shrink_to(cache: mut UOpCache, x: Int, new_shape: read List<Int>) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    local starts = List.new<Int>()
    local ends = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        push1(l: mut starts, a: 0)
        push1(l: mut ends, a: List.get<Int>(list: read new_shape, index: i))
        i = i + 1
    }
    return mk_shrink(cache: mut cache, x: x, starts: read starts, ends: read ends)
}

fn tensor_pad_to(cache: mut UOpCache, x: Int, new_shape: read List<Int>) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    local before = List.new<Int>()
    local after = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        let cur = List.get<Int>(list: read shape, index: i)
        let target = List.get<Int>(list: read new_shape, index: i)
        push1(l: mut before, a: 0)
        push1(l: mut after, a: target - cur)
        i = i + 1
    }
    return mk_pad(cache: mut cache, x: x, before: read before, after: read after)
}

fn tensor_norm_index(idx: Int, dim: Int) -> Int {
    if idx < 0 { return idx + dim }
    return idx
}

fn tensor_tail_numel(shape: read List<Int>, start_axis: Int) -> Int {
    let mut p = 1
    let mut i = start_axis
    while i < List.len<Int>(list: read shape) {
        let d = List.get<Int>(list: read shape, index: i)
        p = p * d
        i = i + 1
    }
    return p
}

fn tensor_one_hot_along_dim(cache: mut UOpCache, x: Int, num_classes: Int, dim: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read xs)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    let offset = ndim - d - 1
    let cls = tensor_arange(cache: mut cache, dt: read dt_int32(), n: num_classes)
    local cls_shape = List.new<Int>()
    push1(l: mut cls_shape, a: num_classes)
    let mut i = 0
    while i < offset {
        push1(l: mut cls_shape, a: 1)
        i = i + 1
    }
    let cls_view = tensor_reshape(cache: mut cache, x: cls, new_shape: read cls_shape)
    return tensor_eq(cache: mut cache, a: x, b: cls_view)
}

fn tensor_one_hot(cache: mut UOpCache, x: Int, num_classes: Int) -> Int {
    let xi = tensor_unsqueeze(cache: mut cache, x: x, dim: 0 - 1)
    let mask = tensor_one_hot_along_dim(cache: mut cache, x: xi, num_classes: num_classes, dim: 0 - 1)
    local ms = uop_shape(cache: read cache, id: mask)
    let one = tensor_full(cache: mut cache, dt: read dt_int32(), shape: read ms, value: 1.0)
    let zero = tensor_full(cache: mut cache, dt: read dt_int32(), shape: read ms, value: 0.0)
    return tensor_where(cache: mut cache, cond: mask, x: one, y: zero)
}

fn tensor_gather(cache: mut UOpCache, x: Int, dim: Int, index: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    local is = uop_shape(cache: read cache, id: index)
    let ndim = List.len<Int>(list: read xs)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    local narrowed_shape = List.new<Int>()
    let mut i = 0
    while i < ndim {
        if i == d {
            push1(l: mut narrowed_shape, a: List.get<Int>(list: read xs, index: i))
        } else {
            push1(l: mut narrowed_shape, a: List.get<Int>(list: read is, index: i))
        }
        i = i + 1
    }
    let narrowed = tensor_shrink_to(cache: mut cache, x: x, new_shape: read narrowed_shape)
    let xu = tensor_unsqueeze(cache: mut cache, x: narrowed, dim: 0 - 1)
    let xt = tensor_transpose(cache: mut cache, x: xu, dim0: 0 - 1, dim1: d)
    let iu = tensor_unsqueeze(cache: mut cache, x: index, dim: 0 - 1)
    let mask = tensor_one_hot_along_dim(cache: mut cache, x: iu, num_classes: List.get<Int>(list: read xs, index: d), dim: 0 - 1)
    local mask_shape = uop_shape(cache: read cache, id: mask)
    let zero = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read mask_shape, value: 0.0)
    let selected = tensor_where(cache: mut cache, cond: mask, x: xt, y: zero)
    return tensor_sum_axis(cache: mut cache, x: selected, axis: 0 - 1)
}

fn tensor_pad_to_prefix(cache: mut UOpCache, x: Int, prefix_shape: read List<Int>) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    local target = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read prefix_shape) {
        push1(l: mut target, a: List.get<Int>(list: read prefix_shape, index: i))
        i = i + 1
    }
    while i < List.len<Int>(list: read xs) {
        push1(l: mut target, a: List.get<Int>(list: read xs, index: i))
        i = i + 1
    }
    return tensor_pad_to(cache: mut cache, x: x, new_shape: read target)
}

fn tensor_scatter_pre_src(cache: mut UOpCache, base: Int, dim: Int, index: Int, src: Int) -> Int {
    local base_shape = uop_shape(cache: read cache, id: base)
    local index_shape = uop_shape(cache: read cache, id: index)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read base_shape), dim: dim, extra: false)
    let narrowed = tensor_shrink_to(cache: mut cache, x: src, new_shape: read index_shape)
    let su = tensor_unsqueeze(cache: mut cache, x: narrowed, dim: 0 - 1)
    local expanded_shape = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read index_shape) {
        push1(l: mut expanded_shape, a: List.get<Int>(list: read index_shape, index: i))
        i = i + 1
    }
    push1(l: mut expanded_shape, a: List.get<Int>(list: read base_shape, index: d))
    let expanded = tensor_expand(cache: mut cache, x: su, new_shape: read expanded_shape)
    let moved = tensor_transpose(cache: mut cache, x: expanded, dim0: 0 - 1, dim1: d)
    return tensor_pad_to_prefix(cache: mut cache, x: moved, prefix_shape: read base_shape)
}

fn tensor_scatter_pre_mask(cache: mut UOpCache, base: Int, dim: Int, index: Int) -> Int {
    local base_shape = uop_shape(cache: read cache, id: base)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read base_shape), dim: dim, extra: false)
    let iu = tensor_unsqueeze(cache: mut cache, x: index, dim: 0 - 1)
    let mask = tensor_one_hot_along_dim(cache: mut cache, x: iu, num_classes: List.get<Int>(list: read base_shape, index: d), dim: 0 - 1)
    let moved = tensor_transpose(cache: mut cache, x: mask, dim0: 0 - 1, dim1: d)
    return tensor_pad_to_prefix(cache: mut cache, x: moved, prefix_shape: read base_shape)
}

fn tensor_logical_not(cache: mut UOpCache, x: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    let f = tensor_full(cache: mut cache, dt: read dt_bool(), shape: read xs, value: 0.0)
    return tensor_eq(cache: mut cache, a: x, b: f)
}

fn tensor_any_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    return tensor_max_axis(cache: mut cache, x: x, axis: axis)
}

fn tensor_any_all(cache: mut UOpCache, x: Int) -> Int {
    return tensor_max_all(cache: mut cache, x: x)
}

fn tensor_all_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    return tensor_prod_axis(cache: mut cache, x: x, axis: axis)
}

fn tensor_all_all(cache: mut UOpCache, x: Int) -> Int {
    return tensor_prod_all(cache: mut cache, x: x)
}

fn tensor_scatter_inv_mask(cache: mut UOpCache, mask: Int, a: Int, b: Int) -> Int {
    let any = tensor_any_axis(cache: mut cache, x: mask, axis: 0 - 1)
    let inv = tensor_logical_not(cache: mut cache, x: any)
    return tensor_where(cache: mut cache, cond: inv, x: a, y: b)
}

fn tensor_scatter_reduce_sum(cache: mut UOpCache, base: Int, dim: Int, index: Int, src: Int, include_self: Bool) -> Int {
    let srcp = tensor_scatter_pre_src(cache: mut cache, base: base, dim: dim, index: index, src: src)
    let mask = tensor_scatter_pre_mask(cache: mut cache, base: base, dim: dim, index: index)
    local ms = uop_shape(cache: read cache, id: mask)
    let zero = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ms, value: 0.0)
    let selected = tensor_where(cache: mut cache, cond: mask, x: srcp, y: zero)
    let summed = tensor_sum_axis(cache: mut cache, x: selected, axis: 0 - 1)
    if include_self { return tensor_add(cache: mut cache, a: summed, b: base) }
    local ss = uop_shape(cache: read cache, id: base)
    let zself = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ss, value: 0.0)
    let base_part = tensor_scatter_inv_mask(cache: mut cache, mask: mask, a: base, b: zself)
    return tensor_add(cache: mut cache, a: summed, b: base_part)
}

fn tensor_scatter_reduce_prod(cache: mut UOpCache, base: Int, dim: Int, index: Int, src: Int, include_self: Bool) -> Int {
    let srcp = tensor_scatter_pre_src(cache: mut cache, base: base, dim: dim, index: index, src: src)
    let mask = tensor_scatter_pre_mask(cache: mut cache, base: base, dim: dim, index: index)
    local ms = uop_shape(cache: read cache, id: mask)
    let one = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ms, value: 1.0)
    let selected = tensor_where(cache: mut cache, cond: mask, x: srcp, y: one)
    let prodded = tensor_prod_axis(cache: mut cache, x: selected, axis: 0 - 1)
    if include_self { return tensor_mul(cache: mut cache, a: prodded, b: base) }
    local ss = uop_shape(cache: read cache, id: base)
    let oneself = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ss, value: 1.0)
    let base_part = tensor_scatter_inv_mask(cache: mut cache, mask: mask, a: base, b: oneself)
    return tensor_mul(cache: mut cache, a: prodded, b: base_part)
}

fn tensor_scatter_reduce_amax(cache: mut UOpCache, base: Int, dim: Int, index: Int, src: Int, include_self: Bool) -> Int {
    let srcp = tensor_scatter_pre_src(cache: mut cache, base: base, dim: dim, index: index, src: src)
    let mask = tensor_scatter_pre_mask(cache: mut cache, base: base, dim: dim, index: index)
    local ms = uop_shape(cache: read cache, id: mask)
    let low = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ms, value: 0.0 - 1000000000000000000.0)
    let selected = tensor_where(cache: mut cache, cond: mask, x: srcp, y: low)
    let maxed = tensor_max_axis(cache: mut cache, x: selected, axis: 0 - 1)
    if include_self { return tensor_maximum(cache: mut cache, a: maxed, b: base) }
    local ss = uop_shape(cache: read cache, id: base)
    let lowself = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ss, value: 0.0 - 1000000000000000000.0)
    let base_part = tensor_scatter_inv_mask(cache: mut cache, mask: mask, a: base, b: lowself)
    return tensor_maximum(cache: mut cache, a: maxed, b: base_part)
}

fn tensor_scatter_reduce_amin(cache: mut UOpCache, base: Int, dim: Int, index: Int, src: Int, include_self: Bool) -> Int {
    let srcp = tensor_scatter_pre_src(cache: mut cache, base: base, dim: dim, index: index, src: src)
    let mask = tensor_scatter_pre_mask(cache: mut cache, base: base, dim: dim, index: index)
    local ms = uop_shape(cache: read cache, id: mask)
    let high = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ms, value: 1000000000000000000.0)
    let selected = tensor_where(cache: mut cache, cond: mask, x: srcp, y: high)
    let mined = tensor_min_axis(cache: mut cache, x: selected, axis: 0 - 1)
    if include_self { return tensor_minimum(cache: mut cache, a: mined, b: base) }
    local ss = uop_shape(cache: read cache, id: base)
    let highself = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ss, value: 1000000000000000000.0)
    let base_part = tensor_scatter_inv_mask(cache: mut cache, mask: mask, a: base, b: highself)
    return tensor_minimum(cache: mut cache, a: mined, b: base_part)
}

fn tensor_scatter_reduce_mean(cache: mut UOpCache, base: Int, dim: Int, index: Int, src: Int, include_self: Bool) -> Int {
    let srcp = tensor_scatter_pre_src(cache: mut cache, base: base, dim: dim, index: index, src: src)
    let mask = tensor_scatter_pre_mask(cache: mut cache, base: base, dim: dim, index: index)
    local ms = uop_shape(cache: read cache, id: mask)
    let zero = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ms, value: 0.0)
    let one = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ms, value: 1.0)
    let selected = tensor_where(cache: mut cache, cond: mask, x: srcp, y: zero)
    let count_values = tensor_where(cache: mut cache, cond: mask, x: one, y: zero)
    let summed = tensor_sum_axis(cache: mut cache, x: selected, axis: 0 - 1)
    let count0 = tensor_sum_axis(cache: mut cache, x: count_values, axis: 0 - 1)
    local ss = uop_shape(cache: read cache, id: base)
    let zself = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ss, value: 0.0)
    let oneself = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ss, value: 1.0)
    if include_self {
        let numerator = tensor_add(cache: mut cache, a: summed, b: base)
        let count = tensor_add(cache: mut cache, a: count0, b: oneself)
        return tensor_div(cache: mut cache, a: numerator, b: count)
    }
    let base_num = tensor_scatter_inv_mask(cache: mut cache, mask: mask, a: base, b: zself)
    let base_count = tensor_scatter_inv_mask(cache: mut cache, mask: mask, a: oneself, b: zself)
    let numerator = tensor_add(cache: mut cache, a: summed, b: base_num)
    let count = tensor_add(cache: mut cache, a: count0, b: base_count)
    return tensor_div(cache: mut cache, a: numerator, b: count)
}

fn tensor_scatter_scalar_add(cache: mut UOpCache, base: Int, dim: Int, index: Int, value: Float) -> Int {
    local ishape = uop_shape(cache: read cache, id: index)
    let src = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ishape, value: value)
    return tensor_scatter_reduce_sum(cache: mut cache, base: base, dim: dim, index: index, src: src, include_self: true)
}

fn tensor_scatter_scalar_multiply(cache: mut UOpCache, base: Int, dim: Int, index: Int, value: Float) -> Int {
    local ishape = uop_shape(cache: read cache, id: index)
    let src = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: base), shape: read ishape, value: value)
    return tensor_scatter_reduce_prod(cache: mut cache, base: base, dim: dim, index: index, src: src, include_self: true)
}

fn tensor_slice_axis_unit(cache: mut UOpCache, x: Int, axis: Int, start: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read shape), dim: axis, extra: false)
    local starts = List.new<Int>()
    local ends = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if i == d {
            push1(l: mut starts, a: start)
            push1(l: mut ends, a: start + 1)
        } else {
            push1(l: mut starts, a: 0)
            push1(l: mut ends, a: List.get<Int>(list: read shape, index: i))
        }
        i = i + 1
    }
    return mk_shrink(cache: mut cache, x: x, starts: read starts, ends: read ends)
}

fn tensor_masked_merge_last(cache: mut UOpCache, base: Int, values: Int, mask: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: values)
    let last_axis = List.len<Int>(list: read shape) - 1
    let n = List.get<Int>(list: read shape, index: last_axis)
    let v0s = tensor_slice_axis_unit(cache: mut cache, x: values, axis: last_axis, start: 0)
    let m0s = tensor_slice_axis_unit(cache: mut cache, x: mask, axis: last_axis, start: 0)
    let mut acc_values = tensor_squeeze_dim(cache: mut cache, x: v0s, dim: last_axis)
    let mut acc_mask = tensor_squeeze_dim(cache: mut cache, x: m0s, dim: last_axis)
    let mut i = 1
    while i < n {
        let vs = tensor_slice_axis_unit(cache: mut cache, x: values, axis: last_axis, start: i)
        let ms = tensor_slice_axis_unit(cache: mut cache, x: mask, axis: last_axis, start: i)
        let v = tensor_squeeze_dim(cache: mut cache, x: vs, dim: last_axis)
        let m = tensor_squeeze_dim(cache: mut cache, x: ms, dim: last_axis)
        acc_values = tensor_where(cache: mut cache, cond: m, x: v, y: acc_values)
        acc_mask = tensor_or(cache: mut cache, a: acc_mask, b: m)
        i = i + 1
    }
    return tensor_where(cache: mut cache, cond: acc_mask, x: acc_values, y: base)
}

fn tensor_scatter(cache: mut UOpCache, base: Int, dim: Int, index: Int, src: Int) -> Int {
    let srcp = tensor_scatter_pre_src(cache: mut cache, base: base, dim: dim, index: index, src: src)
    let mask = tensor_scatter_pre_mask(cache: mut cache, base: base, dim: dim, index: index)
    return tensor_masked_merge_last(cache: mut cache, base: base, values: srcp, mask: mask)
}

// Materialized gather along axis 0. This mirrors the user-facing Tensor indexing case
// `x[Tensor([...])]` for the currently integrated evaluator-backed Tensor path.
fn tensor_gather_axis0(cache: mut UOpCache, x: Int, indices: read List<Int>) -> Int {
    local src = eval_tensor(cache: read cache, id: x)
    local shape = uop_shape(cache: read cache, id: x)
    let rows = List.get<Int>(list: read shape, index: 0)
    let tail = tensor_tail_numel(shape: read shape, start_axis: 1)
    local out_shape = List.new<Int>()
    push1(l: mut out_shape, a: List.len<Int>(list: read indices))
    let mut ax = 1
    while ax < List.len<Int>(list: read shape) {
        push1(l: mut out_shape, a: List.get<Int>(list: read shape, index: ax))
        ax = ax + 1
    }
    local out = List.new<Float>()
    let mut i = 0
    while i < List.len<Int>(list: read indices) {
        let raw = List.get<Int>(list: read indices, index: i)
        let row = tensor_norm_index(idx: raw, dim: rows)
        let base = row * tail
        let mut j = 0
        while j < tail {
            let v = List.get<Float>(list: read src, index: base + j)
            pushf1(l: mut out, a: v)
            j = j + 1
        }
        i = i + 1
    }
    let dt = node_dtype(cache: read cache, id: x)
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read out_shape, data: read out)
}

fn tensor_norm_slice_bound(v: Int, dim: Int) -> Int {
    let mut out = tensor_norm_index(idx: v, dim: dim)
    if out < 0 { out = 0 }
    if out > dim { out = dim }
    return out
}

fn tensor_slice_normalize_bounds(src_shape: read List<Int>, bounds: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read src_shape) {
        let dim = List.get<Int>(list: read src_shape, index: i)
        let b = List.get<Int>(list: read bounds, index: i)
        push1(l: mut out, a: tensor_norm_slice_bound(v: b, dim: dim))
        i = i + 1
    }
    return take out
}

// Basic slice with explicit per-axis start/end, represented as a SHRINK movement UOp.
fn tensor_slice(cache: mut UOpCache, x: Int, starts: read List<Int>, ends: read List<Int>) -> Int {
    local src_shape = uop_shape(cache: read cache, id: x)
    local s = tensor_slice_normalize_bounds(src_shape: read src_shape, bounds: read starts)
    local e = tensor_slice_normalize_bounds(src_shape: read src_shape, bounds: read ends)
    return mk_shrink(cache: mut cache, x: x, starts: read s, ends: read e)
}

fn tensor_split_sizes(cache: mut UOpCache, x: Int, sizes: read List<Int>, dim: Int) -> fresh List<Int> {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    local out = List.new<Int>()
    let mut offset = 0
    let mut i = 0
    while i < List.len<Int>(list: read sizes) {
        let part = List.get<Int>(list: read sizes, index: i)
        local starts = List.new<Int>()
        local ends = List.new<Int>()
        let mut ax = 0
        while ax < ndim {
            if ax == d {
                push1(l: mut starts, a: offset)
                push1(l: mut ends, a: offset + part)
            } else {
                push1(l: mut starts, a: 0)
                push1(l: mut ends, a: List.get<Int>(list: read shape, index: ax))
            }
            ax = ax + 1
        }
        let node = mk_shrink(cache: mut cache, x: x, starts: read starts, ends: read ends)
        push1(l: mut out, a: node)
        offset = offset + part
        i = i + 1
    }
    return take out
}

fn tensor_split_size(cache: mut UOpCache, x: Int, size: Int, dim: Int) -> fresh List<Int> {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    let dim_sz = List.get<Int>(list: read shape, index: d)
    let mut step = size
    if step < 1 { step = 1 }
    local sizes = List.new<Int>()
    let mut i = 0
    while i < dim_sz {
        let mut part = step
        if i + part > dim_sz { part = dim_sz - i }
        push1(l: mut sizes, a: part)
        i = i + step
    }
    if dim_sz == 0 { push1(l: mut sizes, a: 0) }
    return tensor_split_sizes(cache: mut cache, x: x, sizes: read sizes, dim: d)
}

fn tensor_chunk(cache: mut UOpCache, x: Int, chunks: Int, dim: Int) -> fresh List<Int> {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    let dim_sz = List.get<Int>(list: read shape, index: d)
    if dim_sz == 0 {
        local zeros = List.new<Int>()
        let mut i = 0
        while i < chunks {
            push1(l: mut zeros, a: 0)
            i = i + 1
        }
        return tensor_split_sizes(cache: mut cache, x: x, sizes: read zeros, dim: d)
    }
    let part = ceildiv(num: dim_sz, amt: chunks)
    return tensor_split_size(cache: mut cache, x: x, size: part, dim: d)
}

fn tensor_meshgrid_with_basis(cache: mut UOpCache, tensors: read List<Int>, basis: read List<Int>) -> fresh List<Int> {
    let n = List.len<Int>(list: read tensors)
    local output_shape = List.new<Int>()
    let mut ax = 0
    while ax < n {
        let mut src_index = 0
        let mut j = 0
        while j < n {
            let b = List.get<Int>(list: read basis, index: j)
            if b == ax { src_index = j }
            j = j + 1
        }
        let src = List.get<Int>(list: read tensors, index: src_index)
        local src_shape = uop_shape(cache: read cache, id: src)
        push1(l: mut output_shape, a: prod(x: read src_shape))
        ax = ax + 1
    }
    local reshaped = List.new<Int>()
    let mut i = 0
    while i < n {
        let t = List.get<Int>(list: read tensors, index: i)
        let b = List.get<Int>(list: read basis, index: i)
        local rshape = List.new<Int>()
        push1(l: mut rshape, a: 0 - 1)
        let mut j = b + 1
        while j < n {
            push1(l: mut rshape, a: 1)
            j = j + 1
        }
        let r = tensor_reshape(cache: mut cache, x: t, new_shape: read rshape)
        push1(l: mut reshaped, a: r)
        i = i + 1
    }
    local out = List.new<Int>()
    let mut q = 0
    while q < n {
        let r = List.get<Int>(list: read reshaped, index: q)
        let e = broadcast_to(cache: mut cache, x: r, target: read output_shape)
        push1(l: mut out, a: e)
        q = q + 1
    }
    return take out
}

fn tensor_meshgrid_ij(cache: mut UOpCache, tensors: read List<Int>) -> fresh List<Int> {
    local basis = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read tensors) {
        push1(l: mut basis, a: i)
        i = i + 1
    }
    return tensor_meshgrid_with_basis(cache: mut cache, tensors: read tensors, basis: read basis)
}

fn tensor_meshgrid_xy(cache: mut UOpCache, tensors: read List<Int>) -> fresh List<Int> {
    local basis = List.new<Int>()
    let n = List.len<Int>(list: read tensors)
    if n == 1 {
        push1(l: mut basis, a: 0)
    } else {
        push1(l: mut basis, a: 1)
        push1(l: mut basis, a: 0)
        let mut i = 2
        while i < n {
            push1(l: mut basis, a: i)
            i = i + 1
        }
    }
    return tensor_meshgrid_with_basis(cache: mut cache, tensors: read tensors, basis: read basis)
}

fn tensor_diag(cache: mut UOpCache, x: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let n = List.get<Int>(list: read shape, index: 0)
    let xu = tensor_unsqueeze(cache: mut cache, x: x, dim: 0 - 1)
    local pad_shape = List.new<Int>()
    push1(l: mut pad_shape, a: n)
    push1(l: mut pad_shape, a: n + 1)
    let xp = tensor_pad_to(cache: mut cache, x: xu, new_shape: read pad_shape)
    let xf = tensor_flatten(cache: mut cache, x: xp, start_dim: 0, end_dim: 0 - 1)
    local shrink_shape = List.new<Int>()
    push1(l: mut shrink_shape, a: n * n)
    let xs = tensor_shrink_to(cache: mut cache, x: xf, new_shape: read shrink_shape)
    local out_shape = List.new<Int>()
    push1(l: mut out_shape, a: n)
    push1(l: mut out_shape, a: n)
    return tensor_reshape(cache: mut cache, x: xs, new_shape: read out_shape)
}

fn tensor_min_int(a: Int, b: Int) -> Int {
    if a < b { return a }
    return b
}

fn tensor_tri_mask(cache: mut UOpCache, rows: Int, cols: Int, diagonal: Int) -> Int {
    let row = tensor_arange(cache: mut cache, dt: read dt_int32(), n: rows)
    let rowu = tensor_unsqueeze(cache: mut cache, x: row, dim: 1)
    let diag = mk_const_int(cache: mut cache, dt: read dt_int32(), v: diagonal)
    let rowd = tensor_add(cache: mut cache, a: rowu, b: diag)
    let col = tensor_arange(cache: mut cache, dt: read dt_int32(), n: cols)
    return tensor_le(cache: mut cache, a: rowd, b: col)
}

fn tensor_triu(cache: mut UOpCache, x: Int, diagonal: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read sh)
    let rows = List.get<Int>(list: read sh, index: ndim - 2)
    let cols = List.get<Int>(list: read sh, index: ndim - 1)
    let mask = tensor_tri_mask(cache: mut cache, rows: rows, cols: cols, diagonal: diagonal)
    let zero = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read sh, value: 0.0)
    return tensor_where(cache: mut cache, cond: mask, x: x, y: zero)
}

fn tensor_tril(cache: mut UOpCache, x: Int, diagonal: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read sh)
    let rows = List.get<Int>(list: read sh, index: ndim - 2)
    let cols = List.get<Int>(list: read sh, index: ndim - 1)
    let mask = tensor_tri_mask(cache: mut cache, rows: rows, cols: cols, diagonal: diagonal + 1)
    let zero = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read sh, value: 0.0)
    return tensor_where(cache: mut cache, cond: mask, x: zero, y: x)
}

fn tensor_diagonal(cache: mut UOpCache, x: Int, offset: Int, dim1: Int, dim2: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d1 = tensor_resolve_dim(ndim: ndim, dim: dim1, extra: false)
    let d2 = tensor_resolve_dim(ndim: ndim, dim: dim2, extra: false)
    local order = List.new<Int>()
    let mut ax = 0
    while ax < ndim {
        if ax != d1 {
            if ax != d2 { push1(l: mut order, a: ax) }
        }
        ax = ax + 1
    }
    push1(l: mut order, a: d1)
    push1(l: mut order, a: d2)
    let xp = tensor_permute(cache: mut cache, x: x, perm: read order)
    local ps = uop_shape(cache: read cache, id: xp)
    let pn = List.len<Int>(list: read ps)
    let rows = List.get<Int>(list: read ps, index: pn - 2)
    let cols = List.get<Int>(list: read ps, index: pn - 1)
    local starts = List.new<Int>()
    local ends = List.new<Int>()
    let mut i = 0
    while i < pn {
        let size = List.get<Int>(list: read ps, index: i)
        let mut s = 0
        let mut e = size
        if offset >= 0 {
            if i == pn - 1 { s = offset }
        } else {
            if i == pn - 2 { s = 0 - offset }
        }
        push1(l: mut starts, a: s)
        push1(l: mut ends, a: e)
        i = i + 1
    }
    let xoff = mk_shrink(cache: mut cache, x: xp, starts: read starts, ends: read ends)
    local off_shape = uop_shape(cache: read cache, id: xoff)
    let d = tensor_min_int(a: List.get<Int>(list: read off_shape, index: pn - 2), b: List.get<Int>(list: read off_shape, index: pn - 1))
    local square_shape = List.new<Int>()
    let mut q = 0
    while q < pn - 2 {
        push1(l: mut square_shape, a: List.get<Int>(list: read off_shape, index: q))
        q = q + 1
    }
    push1(l: mut square_shape, a: d)
    push1(l: mut square_shape, a: d)
    let xsq = tensor_shrink_to(cache: mut cache, x: xoff, new_shape: read square_shape)
    let xflat = tensor_flatten(cache: mut cache, x: xsq, start_dim: pn - 2, end_dim: pn - 1)
    local pad_shape = List.new<Int>()
    let mut p = 0
    while p < pn - 2 {
        push1(l: mut pad_shape, a: List.get<Int>(list: read square_shape, index: p))
        p = p + 1
    }
    push1(l: mut pad_shape, a: d * (d + 1))
    let xpad = tensor_pad_to(cache: mut cache, x: xflat, new_shape: read pad_shape)
    local sizes = List.new<Int>()
    push1(l: mut sizes, a: d)
    push1(l: mut sizes, a: d + 1)
    let xunf = tensor_unflatten(cache: mut cache, x: xpad, dim: 0 - 1, sizes: read sizes)
    local col_shape = uop_shape(cache: read cache, id: xunf)
    local keep_shape = List.new<Int>()
    let mut k = 0
    while k < List.len<Int>(list: read col_shape) {
        if k == List.len<Int>(list: read col_shape) - 1 {
            push1(l: mut keep_shape, a: 1)
        } else {
            push1(l: mut keep_shape, a: List.get<Int>(list: read col_shape, index: k))
        }
        k = k + 1
    }
    let xcol = tensor_shrink_to(cache: mut cache, x: xunf, new_shape: read keep_shape)
    return tensor_squeeze_dim(cache: mut cache, x: xcol, dim: 0 - 1)
}

fn tensor_repeat_interleave_dim(cache: mut UOpCache, x: Int, repeats: Int, dim: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    local rshape = List.new<Int>()
    let mut i = 0
    while i < ndim {
        push1(l: mut rshape, a: List.get<Int>(list: read shape, index: i))
        if i == d { push1(l: mut rshape, a: 1) }
        i = i + 1
    }
    let xr = tensor_reshape(cache: mut cache, x: x, new_shape: read rshape)
    local eshape = List.new<Int>()
    let mut j = 0
    while j < List.len<Int>(list: read rshape) {
        if j == d + 1 {
            push1(l: mut eshape, a: repeats)
        } else {
            push1(l: mut eshape, a: List.get<Int>(list: read rshape, index: j))
        }
        j = j + 1
    }
    let xe = tensor_expand(cache: mut cache, x: xr, new_shape: read eshape)
    local fshape = List.new<Int>()
    let mut k = 0
    while k < ndim {
        let val = List.get<Int>(list: read shape, index: k)
        if k == d {
            push1(l: mut fshape, a: val * repeats)
        } else {
            push1(l: mut fshape, a: val)
        }
        k = k + 1
    }
    return tensor_reshape(cache: mut cache, x: xe, new_shape: read fshape)
}

fn tensor_repeat_interleave_flat(cache: mut UOpCache, x: Int, repeats: Int) -> Int {
    let xf = tensor_flatten(cache: mut cache, x: x, start_dim: 0, end_dim: 0 - 1)
    return tensor_repeat_interleave_dim(cache: mut cache, x: xf, repeats: repeats, dim: 0)
}

fn tensor_repeat(cache: mut UOpCache, x: Int, repeats: read List<Int>) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    local base_shape = align_left(s: read shape, max_dim: List.len<Int>(list: read repeats))
    local unsqueezed_shape = List.new<Int>()
    local expanded_shape = List.new<Int>()
    local final_shape = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read repeats) {
        let r = List.get<Int>(list: read repeats, index: i)
        let s = List.get<Int>(list: read base_shape, index: i)
        if r == 1 {
            push1(l: mut unsqueezed_shape, a: s)
            push1(l: mut expanded_shape, a: s)
        } else {
            push1(l: mut unsqueezed_shape, a: 1)
            push1(l: mut unsqueezed_shape, a: s)
            push1(l: mut expanded_shape, a: r)
            push1(l: mut expanded_shape, a: s)
        }
        push1(l: mut final_shape, a: r * s)
        i = i + 1
    }
    let xr = tensor_reshape(cache: mut cache, x: x, new_shape: read unsqueezed_shape)
    let xe = tensor_expand(cache: mut cache, x: xr, new_shape: read expanded_shape)
    return tensor_reshape(cache: mut cache, x: xe, new_shape: read final_shape)
}

fn tensor_roll_dim(cache: mut UOpCache, x: Int, shifts: Int, dim: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    let dim_sz = List.get<Int>(list: read shape, index: d)
    let delta = dim_sz - floormod(x: shifts, y: dim_sz)
    local reps = List.new<Int>()
    let mut i = 0
    while i < ndim {
        if i == d { push1(l: mut reps, a: 2) }
        else { push1(l: mut reps, a: 1) }
        i = i + 1
    }
    let xr = tensor_repeat(cache: mut cache, x: x, repeats: read reps)
    local starts = List.new<Int>()
    local ends = List.new<Int>()
    let mut ax = 0
    while ax < ndim {
        let size = List.get<Int>(list: read shape, index: ax)
        if ax == d {
            push1(l: mut starts, a: delta)
            push1(l: mut ends, a: delta + size)
        } else {
            push1(l: mut starts, a: 0)
            push1(l: mut ends, a: size)
        }
        ax = ax + 1
    }
    return mk_shrink(cache: mut cache, x: xr, starts: read starts, ends: read ends)
}

fn tensor_roll_flat(cache: mut UOpCache, x: Int, shifts: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let xf = tensor_flatten(cache: mut cache, x: x, start_dim: 0, end_dim: 0 - 1)
    let xr = tensor_roll_dim(cache: mut cache, x: xf, shifts: shifts, dim: 0)
    return tensor_reshape(cache: mut cache, x: xr, new_shape: read shape)
}

fn tensor_pool1d_last_dilated(cache: mut UOpCache, x: Int, size: Int, step: Int, dilation: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let input = List.get<Int>(list: read shape, index: ndim - 1)
    let out = ceildiv(num: input - dilation * (size - 1), amt: step)
    let mut factor = ceildiv(num: out * step - dilation, amt: input)
    if factor < 1 { factor = 1 }
    let scaled = input * factor + dilation
    local reps = List.new<Int>()
    let mut r = 0
    while r < ndim - 1 {
        push1(l: mut reps, a: 1)
        r = r + 1
    }
    push1(l: mut reps, a: ceildiv(num: size * scaled, amt: input))
    let xr = tensor_repeat(cache: mut cache, x: x, repeats: read reps)
    local dil_shape = List.new<Int>()
    let mut d = 0
    while d < ndim - 1 {
        push1(l: mut dil_shape, a: List.get<Int>(list: read shape, index: d))
        d = d + 1
    }
    push1(l: mut dil_shape, a: size * scaled)
    let xd = tensor_shrink_to(cache: mut cache, x: xr, new_shape: read dil_shape)
    local rs1 = List.new<Int>()
    let mut a = 0
    while a < ndim - 1 {
        push1(l: mut rs1, a: List.get<Int>(list: read shape, index: a))
        a = a + 1
    }
    push1(l: mut rs1, a: size)
    push1(l: mut rs1, a: scaled)
    let xrs1 = tensor_reshape(cache: mut cache, x: xd, new_shape: read rs1)
    local stride_shape = List.new<Int>()
    let mut b = 0
    while b < ndim - 1 {
        push1(l: mut stride_shape, a: List.get<Int>(list: read shape, index: b))
        b = b + 1
    }
    push1(l: mut stride_shape, a: size)
    push1(l: mut stride_shape, a: out * step)
    let xs = tensor_shrink_to(cache: mut cache, x: xrs1, new_shape: read stride_shape)
    local rs2 = List.new<Int>()
    let mut c = 0
    while c < ndim - 1 {
        push1(l: mut rs2, a: List.get<Int>(list: read shape, index: c))
        c = c + 1
    }
    push1(l: mut rs2, a: size)
    push1(l: mut rs2, a: out)
    push1(l: mut rs2, a: step)
    let xrs2 = tensor_reshape(cache: mut cache, x: xs, new_shape: read rs2)
    local trim_shape = List.new<Int>()
    let mut e = 0
    while e < ndim - 1 {
        push1(l: mut trim_shape, a: List.get<Int>(list: read shape, index: e))
        e = e + 1
    }
    push1(l: mut trim_shape, a: size)
    push1(l: mut trim_shape, a: out)
    push1(l: mut trim_shape, a: 1)
    let xt = tensor_shrink_to(cache: mut cache, x: xrs2, new_shape: read trim_shape)
    local rs3 = List.new<Int>()
    let mut f = 0
    while f < ndim - 1 {
        push1(l: mut rs3, a: List.get<Int>(list: read shape, index: f))
        f = f + 1
    }
    push1(l: mut rs3, a: size)
    push1(l: mut rs3, a: out)
    let xrs3 = tensor_reshape(cache: mut cache, x: xt, new_shape: read rs3)
    local perm = List.new<Int>()
    let mut p = 0
    while p < ndim - 1 {
        push1(l: mut perm, a: p)
        p = p + 1
    }
    push1(l: mut perm, a: ndim)
    push1(l: mut perm, a: ndim - 1)
    return tensor_permute(cache: mut cache, x: xrs3, perm: read perm)
}

fn tensor_pool1d_last(cache: mut UOpCache, x: Int, size: Int, step: Int) -> Int {
    return tensor_pool1d_last_dilated(cache: mut cache, x: x, size: size, step: step, dilation: 1)
}

fn tensor_unfold(cache: mut UOpCache, x: Int, dim: Int, size: Int, step: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    local perm_to_last = List.new<Int>()
    let mut i = 0
    while i < ndim {
        if i != d { push1(l: mut perm_to_last, a: i) }
        i = i + 1
    }
    push1(l: mut perm_to_last, a: d)
    let xp = tensor_permute(cache: mut cache, x: x, perm: read perm_to_last)
    let pooled = tensor_pool1d_last(cache: mut cache, x: xp, size: size, step: step)
    local inv = argsort(x: read perm_to_last)
    local final_perm = List.new<Int>()
    let mut j = 0
    while j < List.len<Int>(list: read inv) {
        push1(l: mut final_perm, a: List.get<Int>(list: read inv, index: j))
        j = j + 1
    }
    push1(l: mut final_perm, a: ndim)
    return tensor_permute(cache: mut cache, x: pooled, perm: read final_perm)
}

fn tensor_pool2d_windows_nchw(cache: mut UOpCache, x: Int, kh: Int, kw: Int, sh: Int, sw: Int) -> Int {
    return tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: x, kh: kh, kw: kw, sh: sh, sw: sw, dh: 1, dw: 1)
}

fn tensor_pool2d_windows_nchw_dilated(cache: mut UOpCache, x: Int, kh: Int, kw: Int, sh: Int, sw: Int, dh: Int, dw: Int) -> Int {
    let xw = tensor_pool1d_last_dilated(cache: mut cache, x: x, size: kw, step: sw, dilation: dw)
    local xw_shape = uop_shape(cache: read cache, id: xw)
    let xw_ndim = List.len<Int>(list: read xw_shape)
    local perm_to_last = List.new<Int>()
    let mut i = 0
    while i < xw_ndim {
        if i != 2 { push1(l: mut perm_to_last, a: i) }
        i = i + 1
    }
    push1(l: mut perm_to_last, a: 2)
    let xhp = tensor_permute(cache: mut cache, x: xw, perm: read perm_to_last)
    let xhp_pool = tensor_pool1d_last_dilated(cache: mut cache, x: xhp, size: kh, step: sh, dilation: dh)
    local inv = argsort(x: read perm_to_last)
    local final_h_perm = List.new<Int>()
    let mut h = 0
    while h < List.len<Int>(list: read inv) {
        push1(l: mut final_h_perm, a: List.get<Int>(list: read inv, index: h))
        h = h + 1
    }
    push1(l: mut final_h_perm, a: xw_ndim)
    let xhw0 = tensor_permute(cache: mut cache, x: xhp_pool, perm: read final_h_perm)
    local perm = List.new<Int>()
    push1(l: mut perm, a: 0)
    push1(l: mut perm, a: 1)
    push1(l: mut perm, a: 2)
    push1(l: mut perm, a: 3)
    push1(l: mut perm, a: 5)
    push1(l: mut perm, a: 4)
    return tensor_permute(cache: mut cache, x: xhw0, perm: read perm)
}

fn tensor_avg_pool2d_nchw(cache: mut UOpCache, x: Int, kh: Int, kw: Int, sh: Int, sw: Int) -> Int {
    return tensor_avg_pool2d_nchw_dilated(cache: mut cache, x: x, kh: kh, kw: kw, sh: sh, sw: sw, dh: 1, dw: 1)
}

fn tensor_avg_pool2d_nchw_dilated(cache: mut UOpCache, x: Int, kh: Int, kw: Int, sh: Int, sw: Int, dh: Int, dw: Int) -> Int {
    let windows = tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: x, kh: kh, kw: kw, sh: sh, sw: sw, dh: dh, dw: dw)
    local axes = List.new<Int>()
    push1(l: mut axes, a: 4)
    push1(l: mut axes, a: 5)
    return tensor_mean_axes(cache: mut cache, x: windows, axes: read axes)
}

fn tensor_avg_pool2d_from_windows_sum(cache: mut UOpCache, windows: Int) -> Int {
    local axes = List.new<Int>()
    push1(l: mut axes, a: 4)
    push1(l: mut axes, a: 5)
    return tensor_sum_axes(cache: mut cache, x: windows, axes: read axes)
}

fn tensor_pool_ceil_after(input: Int, k: Int, stride: Int, dilation: Int, pad_before: Int, pad_after: Int) -> Int {
    let full_kernel = dilation * (k - 1) + 1
    let o = ceildiv(num: input + pad_before + pad_after - full_kernel, amt: stride) + 1
    let mut over = stride * (o - 1) - (pad_before + input - 1)
    if over < 0 { over = 0 }
    return pad_after + stride * (o - 1) + full_kernel - (input + pad_before + pad_after) - over
}

