fn uop_consumer_entry_index(entries: read List<UOpConsumerEntry>, id: Int) -> Int {
    let mut i = 0
    while i < List.len<UOpConsumerEntry>(list: read entries) {
        let e = List.get<UOpConsumerEntry>(list: read entries, index: i)
        if e.id == id { return i }
        i = i + 1
    }
    return 0 - 1
}

fn consumer_map_from_toposort(cache: read UOpCache, order: read List<Int>) -> fresh List<UOpConsumerEntry> {
    local entries = List.new<UOpConsumerEntry>()
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let id = List.get<Int>(list: read order, index: i)
        local consumers = List.new<Int>()
        List.push<UOpConsumerEntry>(list: mut entries, value: read UOpConsumerEntry(id: id, consumers: take consumers))
        i = i + 1
    }
    i = 0
    while i < List.len<Int>(list: read order) {
        let id = List.get<Int>(list: read order, index: i)
        let mut sidx = 0
        while sidx < node_num_src(cache: read cache, id: id) {
            let src = node_src_id(cache: read cache, id: id, k: sidx)
            let ei = uop_consumer_entry_index(entries: read entries, id: src)
            if ei >= 0 {
                local e = List.get<UOpConsumerEntry>(list: read entries, index: ei)
                uop_push_unique(vals: mut e.consumers, v: id)
                List.set<UOpConsumerEntry>(list: mut entries, index: ei, value: read (manage e))
            }
            sidx = sidx + 1
        }
        i = i + 1
    }
    return take entries
}

fn uop_sym_infer(cache: read UOpCache, id: Int, var_vals: read Map<String, Int>) -> Int {
    let op = node_op(cache: read cache, id: id)
    if node_is_const_int(cache: read cache, id: id) { return node_const_int(cache: read cache, id: id) }
    if op == DEFINE_VAR {
        let name = node_var_name(cache: read cache, id: id)
        match Map.get<String, Int>(map: read var_vals, key: read name) {
            Some(v) => { return v }
            None => { return node_var_min(cache: read cache, id: id) }
        }
    }
    if op == BIND && node_num_src(cache: read cache, id: id) > 1 {
        return uop_sym_infer(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1), var_vals: read var_vals)
    }
    local vals = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let v = uop_sym_infer(cache: read cache, id: node_src_id(cache: read cache, id: id, k: i), var_vals: read var_vals)
        List.push<Int>(list: mut vals, value: read v)
        i = i + 1
    }
    if op == NEG || op == ADD || op == SUB || op == MUL || op == MAX || op == CMPLT || op == CMPNE || op == CMPEQ ||
       op == SHL || op == SHR || op == AND || op == OR || op == XOR || op == CDIV || op == CMOD ||
       op == FLOORDIV || op == FLOORMOD || op == MULACC || op == WHERE {
        return exec_alu_int(op: read op, operands: read vals)
    }
    local vr = uop_min_max(cache: read cache, id: id)
    if vr.lo == vr.hi { return vr.lo }
    return vr.lo
}

fn sym_infer(cache: read UOpCache, id: Int, var_vals: read Map<String, Int>) -> Int {
    return uop_sym_infer(cache: read cache, id: id, var_vals: read var_vals)
}

fn uop_sintify(cache: read UOpCache, id: Int) -> Int {
