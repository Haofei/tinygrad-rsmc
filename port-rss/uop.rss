// Port of the CORE of tinygrad/uop/ops.py: the UOp IR node + structural identity/interning.
// tinygrad's UOp is metaclass-interned (uop/ops.py:98-124): structurally-equal UOps are the
// SAME object. UOp here is a recursive managed node (op/dtype/src/arg) deriving Eq+Hash, so
// structural equality + Set dedup reproduce that behavior (rss Hashable feature).
// uadd/umul build internal nodes from `read` UOp children -- this now works after fixing the
// rss read-param->owned-collection codegen bug (rsscript: lower_call_arg + retain arms).
// Faithful in shape; simplifications noted in PORT_STATUS (dtype as name, arg as Int, Ops subset).
//   e1 = (2+3)*4 ; e2 = (2+3)*4 (identical) ; e3 = (2+3)*5 (different) -> 2 unique interned nodes
features: local
sum Ops derives(Clone, Eq, Hash) { Const Add Mul Max }
struct UOp derives(Clone, Eq, Hash) {
    op: Ops
    dtype: String
    src: List<UOp>
    arg: Int
}
fn uconst(v: Int) -> fresh UOp { return UOp(op: Const, dtype: "float", src: List.new<UOp>(), arg: v) }
fn uadd(a: read UOp, b: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    List.push(list: mut s, value: read b)
    return UOp(op: Add, dtype: "float", src: take s, arg: 0)
}
fn umul(a: read UOp, b: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    List.push(list: mut s, value: read b)
    return UOp(op: Mul, dtype: "float", src: take s, arg: 0)
}
fn main() -> Unit {
    let e1 = umul(a: read uadd(a: read uconst(v: 2), b: read uconst(v: 3)), b: read uconst(v: 4))
    let e2 = umul(a: read uadd(a: read uconst(v: 2), b: read uconst(v: 3)), b: read uconst(v: 4))
    let e3 = umul(a: read uadd(a: read uconst(v: 2), b: read uconst(v: 3)), b: read uconst(v: 5))
    if e1 == e2 { Log.write(message: read "e1 == e2 (structural identity): yes") }
    if e1 == e3 { Log.write(message: read "e1 == e3: yes (unexpected)") }
    let seen = Set.new<UOp>()
    Set.insert(set: mut seen, value: read e1)
    Set.insert(set: mut seen, value: read e2)
    Set.insert(set: mut seen, value: read e3)
    Log.write(message: read String.concat(left: read "unique UOps = ", right: read Int.to_string(value: read Set.len(set: read seen))))
    return Unit
}
