fn tensor_scaled_dot_product_attention_gqa(cache: mut UOpCache, query: Int, key: Int, value: Int, dropout_p: Float, training: Bool, seed: Int) -> Int {
    local qshape = uop_shape(cache: read cache, id: query)
    local kshape = uop_shape(cache: read cache, id: key)
    let q_heads = List.get<Int>(list: read qshape, index: List.len<Int>(list: read qshape) - 3)
    let k_heads = List.get<Int>(list: read kshape, index: List.len<Int>(list: read kshape) - 3)
    let repeats = q_heads / k_heads
    let key_rep = tensor_repeat_interleave_dim(cache: mut cache, x: key, repeats: repeats, dim: 0 - 3)
    let value_rep = tensor_repeat_interleave_dim(cache: mut cache, x: value, repeats: repeats, dim: 0 - 3)
    return tensor_scaled_dot_product_attention(cache: mut cache, query: query, key: key_rep, value: value_rep, dropout_p: dropout_p, training: training, seed: seed)
}

fn tensor_newton_schulz_term(cache: mut UOpCache, g: Int, order: Int) -> Int {
    let gt = tensor_transpose(cache: mut cache, x: g, dim0: 0 - 2, dim1: 0 - 1)
    let a = tensor_matmul(cache: mut cache, a: g, b: gt)
    let mut out = g
    let mut i = 0
    while i < order {
        out = tensor_matmul(cache: mut cache, a: a, b: out)
        i = i + 1
    }
    return out
}

fn tensor_newton_schulz(cache: mut UOpCache, x: Int, steps: Int, p0: Float, p1: Float, p2: Float, eps: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read sh)
    let rows = List.get<Int>(list: read sh, index: ndim - 2)
    let cols = List.get<Int>(list: read sh, index: ndim - 1)
    if rows > cols {
        let xt = tensor_transpose(cache: mut cache, x: x, dim0: 0 - 2, dim1: 0 - 1)
        let yt = tensor_newton_schulz(cache: mut cache, x: xt, steps: steps, p0: p0, p1: p1, p2: p2, eps: eps)
        return tensor_transpose(cache: mut cache, x: yt, dim0: 0 - 2, dim1: 0 - 1)
    }
    let sq = tensor_square(cache: mut cache, x: x)
    local axes = List.new<Int>()
    push1(l: mut axes, a: ndim - 2)
    push1(l: mut axes, a: ndim - 1)
    let norm_sq = tensor_sum_axes_keepdim(cache: mut cache, x: sq, axes: read axes)
    let norm = tensor_sqrt(cache: mut cache, x: norm_sq)
    let epsc = tensor_const_like_float(cache: mut cache, x: norm, value: eps)
    let denom = tensor_add(cache: mut cache, a: norm, b: epsc)
    let mut g = tensor_div(cache: mut cache, a: x, b: denom)
    let mut step = 0
    while step < steps {
        let t0_base = tensor_newton_schulz_term(cache: mut cache, g: g, order: 0)
        let t0_scale = tensor_const_like_float(cache: mut cache, x: g, value: p0)
        let t0 = tensor_mul(cache: mut cache, a: t0_base, b: t0_scale)
        let t1_base = tensor_newton_schulz_term(cache: mut cache, g: g, order: 1)
        let t1_scale = tensor_const_like_float(cache: mut cache, x: g, value: p1)
        let t1 = tensor_mul(cache: mut cache, a: t1_base, b: t1_scale)
        let t2_base = tensor_newton_schulz_term(cache: mut cache, g: g, order: 2)
        let t2_scale = tensor_const_like_float(cache: mut cache, x: g, value: p2)
        let t2 = tensor_mul(cache: mut cache, a: t2_base, b: t2_scale)
        let s01 = tensor_add(cache: mut cache, a: t0, b: t1)
        g = tensor_add(cache: mut cache, a: s01, b: t2)
        step = step + 1
    }
    return g
}

fn tensor_linear(cache: mut UOpCache, x: Int, weight: Int, bias: Int) -> Int {
    let y = tensor_dot(cache: mut cache, x: x, w: weight)
    return tensor_add(cache: mut cache, a: y, b: bias)
}

// relu(x) = (x > 0).where(x, 0), matching tinygrad's gradient behavior at zero.
fn tensor_relu(cache: mut UOpCache, x: Int) -> Int {
    let zero = tensor_const_like_float(cache: mut cache, x: x, value: 0.0)
    let cond = tensor_gt(cache: mut cache, a: x, b: zero)
    return tensor_where(cache: mut cache, cond: cond, x: x, y: zero)
}

fn tensor_relu6(cache: mut UOpCache, x: Int) -> Int {
    let six = tensor_const_like_float(cache: mut cache, x: x, value: 6.0)
    let xminus6 = tensor_sub(cache: mut cache, a: x, b: six)
    let upper = tensor_relu(cache: mut cache, x: xminus6)
    let base = tensor_relu(cache: mut cache, x: x)
    return tensor_sub(cache: mut cache, a: base, b: upper)
}

// a dense/linear layer forward: relu(x @ W + b)  (tinygrad nn.Linear forward, sans bias-optional)
fn linear_forward(cache: mut UOpCache, x: Int, w: Int, b: Int) -> Int {
    let xw = tensor_matmul2d(cache: mut cache, a: x, b: w)
    let xwb = tensor_binary(cache: mut cache, op: ADD, a: xw, b: b)
    return tensor_relu(cache: mut cache, x: xwb)
}
