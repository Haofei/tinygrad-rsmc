// Integrated source-shaped slice of tinygrad/uop/decompositions.py late rewrites.
//
// These helpers lower high-level ALU nodes into backend-friendly UOps over the
// interned DAG. They are explicit helpers for now because the backend rewrite
// pipeline that decides which target ops are available is not integrated yet.
features: local

fn decomp_same_sign_divmod_ranges(cache: read UOpCache, a: Int, b: Int) -> Bool {
    let ar = uop_min_max(cache: read cache, id: a)
    let br = uop_min_max(cache: read cache, id: b)
    if ar.lo >= 0 && br.lo > 0 { return true }
    if ar.hi <= 0 && br.hi < 0 { return true }
    return false
}

fn decomp_const_zero_like(cache: mut UOpCache, x: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: x)
    if dtype_is_float(d: read dt) { return mk_const_float(cache: mut cache, dt: read dt, v: 0.0) }
    return mk_const_int(cache: mut cache, dt: read dt, v: 0)
}

fn decomp_const_one_like(cache: mut UOpCache, x: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: x)
    if dtype_is_float(d: read dt) { return mk_const_float(cache: mut cache, dt: read dt, v: 1.0) }
    return mk_const_int(cache: mut cache, dt: read dt, v: 1)
}

fn decomp_power_of_two_exp(v: Int) -> Option<Int> {
    if v <= 0 { return None }
    let mut p = 1
    let mut e = 0
    while e < 62 {
        if p == v { return Some(e) }
        if p > v { return None }
        p = p * 2
        e = e + 1
    }
    return None
}

fn decomp_const_power_exp(cache: read UOpCache, id: Int) -> Option<Int> {
    if node_is_const_int(cache: read cache, id: id) == false { return None }
    return decomp_power_of_two_exp(v: node_const_int(cache: read cache, id: id))
}

struct DecompPair derives(Clone) {
    lo: Int,
    hi: Int,
}

fn decomp_pair(lo: Int, hi: Int) -> fresh DecompPair {
    return DecompPair(lo: lo, hi: hi)
}

fn decomp_is_true_const(cache: read UOpCache, id: Int) -> Bool {
    if node_is_const_int(cache: read cache, id: id) == false { return false }
    let dt = node_dtype(cache: read cache, id: id)
    if dtype_is_bool(d: read dt) == false { return false }
    return node_const_int(cache: read cache, id: id) != 0
}

fn decomp_is_signed_int(cache: read UOpCache, id: Int) -> Bool {
    let dt = node_dtype(cache: read cache, id: id)
    if dtype_is_int(d: read dt) == false { return false }
    if dtype_is_unsigned(d: read dt) { return false }
    return true
}

fn decomp_sign_diff(cache: mut UOpCache, a: Int, b: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: a)
    let zero_a = decomp_const_zero_like(cache: mut cache, x: a)
    let zero_b = decomp_const_zero_like(cache: mut cache, x: b)
    let a_neg = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: a, y: zero_a)
    let b_neg = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: b, y: zero_b)
    return mk_alu2(cache: mut cache, op: CMPNE, dt: read dt_bool(), x: a_neg, y: b_neg)
}

fn decomp_floor_adjust(cache: mut UOpCache, a: Int, b: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: a)
    let r = mk_alu2(cache: mut cache, op: CMOD, dt: read dt, x: a, y: b)
    let zero_r = decomp_const_zero_like(cache: mut cache, x: r)
    let r_ne_zero = mk_alu2(cache: mut cache, op: CMPNE, dt: read dt_bool(), x: r, y: zero_r)
    let sign_diff = decomp_sign_diff(cache: mut cache, a: a, b: b)
    return mk_alu2(cache: mut cache, op: AND, dt: read dt_bool(), x: r_ne_zero, y: sign_diff)
}

fn decomp_floordiv_to_cdiv(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != FLOORDIV { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    let q = mk_alu2(cache: mut cache, op: CDIV, dt: read dt, x: a, y: b)
    if decomp_same_sign_divmod_ranges(cache: read cache, a: a, b: b) { return Some(q) }
    let adjust_bool = decomp_floor_adjust(cache: mut cache, a: a, b: b)
    let adjust = mk_cast(cache: mut cache, x: adjust_bool, dt: read dt)
    return Some(mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: q, y: adjust))
}

fn decomp_floormod_pow2_to_and(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != FLOORMOD { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if dtype_is_int(d: read dt) == false { return None }
    match decomp_const_power_exp(cache: read cache, id: b) {
        Some(_) => {
            let mask_value = node_const_int(cache: read cache, id: b) - 1
            let mask = mk_const_int(cache: mut cache, dt: read dt, v: mask_value)
            return Some(mk_alu2(cache: mut cache, op: AND, dt: read dt, x: a, y: mask))
        }
        None => {}
    }
    return None
}

fn decomp_floormod_to_cmod(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != FLOORMOD { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    let r = mk_alu2(cache: mut cache, op: CMOD, dt: read dt, x: a, y: b)
    if decomp_same_sign_divmod_ranges(cache: read cache, a: a, b: b) { return Some(r) }
    let adjust_bool = decomp_floor_adjust(cache: mut cache, a: a, b: b)
    let zero = decomp_const_zero_like(cache: mut cache, x: b)
    let addend = mk_where(cache: mut cache, dt: read dt, cond: adjust_bool, tval: b, fval: zero)
    return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: r, y: addend))
}

fn decomp_cmod_nonnegative_to_sub(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMOD { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if dtype_is_int(d: read dt) == false { return None }
    let ar = uop_min_max(cache: read cache, id: a)
    if ar.lo < 0 && dtype_is_unsigned(d: read dt) == false { return None }
    let q = mk_alu2(cache: mut cache, op: CDIV, dt: read dt, x: a, y: b)
    let dq = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: b, y: q)
    return Some(mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: a, y: dq))
}

fn decomp_u32_const(cache: mut UOpCache, v: Int) -> Int {
    return mk_const_int(cache: mut cache, dt: read dt_uint32(), v: v)
}

fn decomp_u64_const(cache: mut UOpCache, v: Int) -> Int {
    return mk_const_int(cache: mut cache, dt: read dt_uint64(), v: v)
}

fn decomp_threefry_mix(cache: mut UOpCache, x0: Int, x1: Int, rot: Int) -> fresh DecompPair {
    let u32 = dt_uint32()
    let r = decomp_u32_const(cache: mut cache, v: rot)
    let rr = decomp_u32_const(cache: mut cache, v: 32 - rot)
    let nx0 = mk_alu2(cache: mut cache, op: ADD, dt: read u32, x: x0, y: x1)
    let left = mk_alu2(cache: mut cache, op: SHL, dt: read u32, x: x1, y: r)
    let right = mk_alu2(cache: mut cache, op: SHR, dt: read u32, x: x1, y: rr)
    let roted = mk_alu2(cache: mut cache, op: ADD, dt: read u32, x: left, y: right)
    let nx1 = mk_alu2(cache: mut cache, op: XOR, dt: read u32, x: nx0, y: roted)
    return decomp_pair(lo: nx0, hi: nx1)
}

fn decomp_threefry_key(cache: mut UOpCache, k0: Int, k1: Int, idx: Int) -> Int {
    if idx == 0 { return k1 }
    if idx == 1 {
        let xor = mk_alu2(cache: mut cache, op: XOR, dt: read dt_uint32(), x: k0, y: k1)
        let c = decomp_u32_const(cache: mut cache, v: 466688986)
        return mk_alu2(cache: mut cache, op: XOR, dt: read dt_uint32(), x: xor, y: c)
    }
    return k0
}

fn decomp_threefry_round(cache: mut UOpCache, p: read DecompPair, k0: Int, k1: Int, round: Int, r0: Int, r1: Int, r2: Int, r3: Int) -> fresh DecompPair {
    local p0 = decomp_threefry_mix(cache: mut cache, x0: p.lo, x1: p.hi, rot: r0)
    local p1 = decomp_threefry_mix(cache: mut cache, x0: p0.lo, x1: p0.hi, rot: r1)
    local p2 = decomp_threefry_mix(cache: mut cache, x0: p1.lo, x1: p1.hi, rot: r2)
    local p3 = decomp_threefry_mix(cache: mut cache, x0: p2.lo, x1: p2.hi, rot: r3)
    let ki0 = round % 3
    let ki1 = (round + 1) % 3
    let add0 = decomp_threefry_key(cache: mut cache, k0: k0, k1: k1, idx: ki0)
    let add1_key = decomp_threefry_key(cache: mut cache, k0: k0, k1: k1, idx: ki1)
    let add1_round = decomp_u32_const(cache: mut cache, v: round + 1)
    let add1 = mk_alu2(cache: mut cache, op: ADD, dt: read dt_uint32(), x: add1_key, y: add1_round)
    let nx0 = mk_alu2(cache: mut cache, op: ADD, dt: read dt_uint32(), x: p3.lo, y: add0)
    let nx1 = mk_alu2(cache: mut cache, op: ADD, dt: read dt_uint32(), x: p3.hi, y: add1)
    return decomp_pair(lo: nx0, hi: nx1)
}

fn decomp_threefry2x32(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != THREEFRY { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let x = node_src_id(cache: read cache, id: id, k: 0)
    let key = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    let sdt = dtype_scalar(d: read dt)
    if sdt.name != "unsigned long" { return None }
    let u32 = dt_uint32()
    let u64 = dt_uint64()
    let mask = decomp_u64_const(cache: mut cache, v: 4294967295)
    let shift32 = decomp_u64_const(cache: mut cache, v: 32)
    let xlo64 = mk_alu2(cache: mut cache, op: AND, dt: read u64, x: x, y: mask)
    let xhi_shift = mk_alu2(cache: mut cache, op: SHR, dt: read u64, x: x, y: shift32)
    let xhi64 = mk_alu2(cache: mut cache, op: AND, dt: read u64, x: xhi_shift, y: mask)
    let keylo64 = mk_alu2(cache: mut cache, op: AND, dt: read u64, x: key, y: mask)
    let keyhi_shift = mk_alu2(cache: mut cache, op: SHR, dt: read u64, x: key, y: shift32)
    let keyhi64 = mk_alu2(cache: mut cache, op: AND, dt: read u64, x: keyhi_shift, y: mask)
    let x0 = mk_cast(cache: mut cache, x: xlo64, dt: read u32)
    let x1 = mk_cast(cache: mut cache, x: xhi64, dt: read u32)
    let key0 = mk_cast(cache: mut cache, x: keylo64, dt: read u32)
    let key1 = mk_cast(cache: mut cache, x: keyhi64, dt: read u32)
    let k2 = decomp_threefry_key(cache: mut cache, k0: key0, k1: key1, idx: 1)
    let mut p = decomp_pair(lo: mk_alu2(cache: mut cache, op: ADD, dt: read u32, x: x0, y: k2),
                            hi: mk_alu2(cache: mut cache, op: ADD, dt: read u32, x: x1, y: key1))
    p = decomp_threefry_round(cache: mut cache, p: read p, k0: key0, k1: key1, round: 0, r0: 13, r1: 15, r2: 26, r3: 6)
    p = decomp_threefry_round(cache: mut cache, p: read p, k0: key0, k1: key1, round: 1, r0: 17, r1: 29, r2: 16, r3: 24)
    p = decomp_threefry_round(cache: mut cache, p: read p, k0: key0, k1: key1, round: 2, r0: 13, r1: 15, r2: 26, r3: 6)
    p = decomp_threefry_round(cache: mut cache, p: read p, k0: key0, k1: key1, round: 3, r0: 17, r1: 29, r2: 16, r3: 24)
    p = decomp_threefry_round(cache: mut cache, p: read p, k0: key0, k1: key1, round: 4, r0: 13, r1: 15, r2: 26, r3: 6)
    let hi64 = mk_cast(cache: mut cache, x: p.hi, dt: read u64)
    let lo64 = mk_cast(cache: mut cache, x: p.lo, dt: read u64)
    let hi_shift = mk_alu2(cache: mut cache, op: SHL, dt: read u64, x: hi64, y: shift32)
    return Some(mk_alu2(cache: mut cache, op: OR, dt: read u64, x: hi_shift, y: lo64))
}

fn decomp_max_to_where(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != MAX { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    let cond = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: a, y: b)
    return Some(mk_where(cache: mut cache, dt: read dt, cond: cond, tval: b, fval: a))
}

fn decomp_mul_pow2_to_shl(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != MUL { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    if dtype_is_int(d: read dt) == false { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    if node_is_const_int(cache: read cache, id: b) {
        match decomp_const_power_exp(cache: read cache, id: b) {
            Some(e) => {
                if e > 0 {
                    let sh = mk_const_int(cache: mut cache, dt: read dt, v: e)
                    return Some(mk_alu2(cache: mut cache, op: SHL, dt: read dt, x: a, y: sh))
                }
            }
            None => {}
        }
    }
    if node_is_const_int(cache: read cache, id: a) {
        match decomp_const_power_exp(cache: read cache, id: a) {
            Some(e) => {
                if e > 0 {
                    let sh = mk_const_int(cache: mut cache, dt: read dt, v: e)
                    return Some(mk_alu2(cache: mut cache, op: SHL, dt: read dt, x: b, y: sh))
                }
            }
            None => {}
        }
    }
    return None
}

fn decomp_cdiv_pow2_to_shr(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CDIV { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if dtype_is_int(d: read dt) == false { return None }
    match decomp_const_power_exp(cache: read cache, id: b) {
        Some(e) => {
            if e == 0 { return None }
            let sh = mk_const_int(cache: mut cache, dt: read dt, v: e)
            if dtype_is_unsigned(d: read dt) {
                return Some(mk_alu2(cache: mut cache, op: SHR, dt: read dt, x: a, y: sh))
            }
            let zero = decomp_const_zero_like(cache: mut cache, x: a)
            let is_neg = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: a, y: zero)
            let bias_c = mk_const_int(cache: mut cache, dt: read dt, v: node_const_int(cache: read cache, id: b) - 1)
            let zero_i = decomp_const_zero_like(cache: mut cache, x: a)
            let bias = mk_where(cache: mut cache, dt: read dt, cond: is_neg, tval: bias_c, fval: zero_i)
            let adjusted = mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: a, y: bias)
            return Some(mk_alu2(cache: mut cache, op: SHR, dt: read dt, x: adjusted, y: sh))
        }
        None => {}
    }
    return None
}

fn decomp_mul_neg_one_to_neg(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != MUL { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if node_is_const_int(cache: read cache, id: b) {
        if node_const_int(cache: read cache, id: b) == 0 - 1 {
            return Some(mk_alu1(cache: mut cache, op: NEG, dt: read dt, x: a))
        }
    }
    if node_is_const_int(cache: read cache, id: a) {
        if node_const_int(cache: read cache, id: a) == 0 - 1 {
            return Some(mk_alu1(cache: mut cache, op: NEG, dt: read dt, x: b))
        }
    }
    return None
}

fn decomp_add_neg_to_sub(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != ADD { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if node_op(cache: read cache, id: b) == NEG {
        let y = node_src_id(cache: read cache, id: b, k: 0)
        return Some(mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: a, y: y))
    }
    return None
}

fn decomp_add_mul_to_mulacc(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != ADD { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let c = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if node_op(cache: read cache, id: a) == MUL {
        let x = node_src_id(cache: read cache, id: a, k: 0)
        let y = node_src_id(cache: read cache, id: a, k: 1)
        return Some(mk_alu3(cache: mut cache, op: MULACC, dt: read dt, x: x, y: y, z: c))
    }
    if node_op(cache: read cache, id: a) == SHL {
        let x = node_src_id(cache: read cache, id: a, k: 0)
        let sh = node_src_id(cache: read cache, id: a, k: 1)
        if node_is_const_int(cache: read cache, id: sh) {
            let mul = mk_const_int(cache: mut cache, dt: read dt, v: 1 << node_const_int(cache: read cache, id: sh))
            return Some(mk_alu3(cache: mut cache, op: MULACC, dt: read dt, x: x, y: mul, z: c))
        }
    }
    return None
}

fn decomp_recip_to_fdiv(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != RECIPROCAL { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    let x = node_src_id(cache: read cache, id: id, k: 0)
    let dt = node_full_dtype(cache: read cache, id: id)
    if dtype_is_float(d: read dt) == false { return None }
    let one = decomp_const_one_like(cache: mut cache, x: id)
    return Some(mk_alu2(cache: mut cache, op: FDIV, dt: read dt, x: one, y: x))
}

fn decomp_not_cmplt_to_bound(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPNE { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let cmp = node_src_id(cache: read cache, id: id, k: 0)
    let truth = node_src_id(cache: read cache, id: id, k: 1)
    if decomp_is_true_const(cache: read cache, id: truth) == false { return None }
    if node_op(cache: read cache, id: cmp) != CMPLT { return None }
    let a = node_src_id(cache: read cache, id: cmp, k: 0)
    let b = node_src_id(cache: read cache, id: cmp, k: 1)
    if decomp_is_signed_int(cache: read cache, id: a) == false { return None }
    let dt = node_full_dtype(cache: read cache, id: a)
    if node_is_const_int(cache: read cache, id: b) {
        let c = node_const_int(cache: read cache, id: b)
        let lower = mk_const_int(cache: mut cache, dt: read dt, v: c - 1)
        return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: lower, y: a))
    }
    if node_is_const_int(cache: read cache, id: a) {
        let c = node_const_int(cache: read cache, id: a)
        let upper = mk_const_int(cache: mut cache, dt: read dt, v: c + 1)
        return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: b, y: upper))
    }
    return None
}

fn decomp_negated_signed_lt(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPLT { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    if node_op(cache: read cache, id: lhs) != MUL { return None }
    let x0 = node_src_id(cache: read cache, id: lhs, k: 0)
    let x1 = node_src_id(cache: read cache, id: lhs, k: 1)
    let mut x = x0
    if node_is_const_int(cache: read cache, id: x1) {
        if node_const_int(cache: read cache, id: x1) != 0 - 1 { return None }
    } else {
        if node_is_const_int(cache: read cache, id: x0) == false { return None }
        if node_const_int(cache: read cache, id: x0) != 0 - 1 { return None }
        x = x1
    }
    if decomp_is_signed_int(cache: read cache, id: x) == false { return None }
    let dt = node_full_dtype(cache: read cache, id: x)
    if node_is_const_int(cache: read cache, id: rhs) {
        let c = node_const_int(cache: read cache, id: rhs)
        let nc = mk_const_int(cache: mut cache, dt: read dt, v: 0 - c)
        return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: nc, y: x))
    }
    if node_op(cache: read cache, id: rhs) == MUL {
        let y0 = node_src_id(cache: read cache, id: rhs, k: 0)
        let y1 = node_src_id(cache: read cache, id: rhs, k: 1)
        let mut y = y0
        let mut cnode = y1
        if node_is_const_int(cache: read cache, id: y0) {
            y = y1
            cnode = y0
        }
        if node_is_const_int(cache: read cache, id: cnode) {
            let c = node_const_int(cache: read cache, id: cnode)
            let nc = mk_const_int(cache: mut cache, dt: read dt, v: 0 - c)
            let ync = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: y, y: nc)
            return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: ync, y: x))
        }
    }
    return None
}

fn decomp_tight_range_to_eq(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != AND { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let left = node_src_id(cache: read cache, id: id, k: 0)
    let right = node_src_id(cache: read cache, id: id, k: 1)
    if node_op(cache: read cache, id: left) != CMPLT { return None }
    if node_op(cache: read cache, id: right) != CMPLT { return None }
    let c1 = node_src_id(cache: read cache, id: left, k: 0)
    let x1 = node_src_id(cache: read cache, id: left, k: 1)
    let x2 = node_src_id(cache: read cache, id: right, k: 0)
    let c2 = node_src_id(cache: read cache, id: right, k: 1)
    if x1 != x2 { return None }
    if node_is_const_int(cache: read cache, id: c1) == false { return None }
    if node_is_const_int(cache: read cache, id: c2) == false { return None }
    let lo = node_const_int(cache: read cache, id: c1)
    let hi = node_const_int(cache: read cache, id: c2)
    if lo + 1 != hi - 1 { return None }
    let dt = node_full_dtype(cache: read cache, id: x1)
    let target = mk_const_int(cache: mut cache, dt: read dt, v: lo + 1)
    return Some(mk_alu2(cache: mut cache, op: CMPEQ, dt: read dt_bool(), x: x1, y: target))
}

fn decomp_not_cmpne_to_cmpeq(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPNE { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let cmp = node_src_id(cache: read cache, id: id, k: 0)
    let truth = node_src_id(cache: read cache, id: id, k: 1)
    if decomp_is_true_const(cache: read cache, id: truth) == false { return None }
    if node_op(cache: read cache, id: cmp) != CMPNE { return None }
    let a = node_src_id(cache: read cache, id: cmp, k: 0)
    let b = node_src_id(cache: read cache, id: cmp, k: 1)
    return Some(mk_alu2(cache: mut cache, op: CMPEQ, dt: read dt_bool(), x: a, y: b))
}

fn decomp_mul_recip_to_fdiv(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != MUL { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if dtype_is_float(d: read dt) == false { return None }

    if node_op(cache: read cache, id: b) == RECIPROCAL {
        let denom = node_src_id(cache: read cache, id: b, k: 0)
        return Some(mk_alu2(cache: mut cache, op: FDIV, dt: read dt, x: a, y: denom))
    }
    if node_op(cache: read cache, id: b) == FDIV {
        let num = node_src_id(cache: read cache, id: b, k: 0)
        if node_is_const(cache: read cache, id: num) {
            let one = decomp_const_one_like(cache: mut cache, x: num)
            if one == num {
                let denom = node_src_id(cache: read cache, id: b, k: 1)
                return Some(mk_alu2(cache: mut cache, op: FDIV, dt: read dt, x: a, y: denom))
            }
        }
    }
    return None
}

