    let mut prodv = 1
    let mut i = 1
    while i < List.len<Int>(list: read pairs) {
        prodv = prodv * List.get<Int>(list: read pairs, index: i)
        i = i + 2
    }
    return prodv
}

fn axis_size_pairs_valid(pairs: read List<Int>) -> Bool {
    let n = List.len<Int>(list: read pairs)
    if n == 0 { return false }
    if n % 2 != 0 { return false }
    let mut i = 0
    while i < n {
        if List.get<Int>(list: read pairs, index: i + 1) <= 0 { return false }
        i = i + 2
    }
    return true
}

