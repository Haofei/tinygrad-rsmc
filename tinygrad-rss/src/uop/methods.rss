fn uop_invalid(cache: mut UOpCache, count: Int) -> Int {
    let base = dt_weakint()
    let dt = dtype_vec(base: read base, sz: count)
    local src = List.new<Int>()
    local a = ArgStr(text: String.copy(value: read "__INVALID__"))
    return intern(cache: mut cache, op: CONST, dt: read dt, src: take src, arg: take a)
}

fn uop_is_invalid(cache: read UOpCache, id: Int) -> Bool {
    if node_op(cache: read cache, id: id) != CONST { return false }
    local arg = node_arg(cache: read cache, id: id)
    match arg {
        ArgStr(t) => { return t == "__INVALID__" }
        ArgNone => { return false }
        ArgInt(v) => { return false }
        ArgFloat(f) => { return false }
        ArgBool(b) => { return false }
        ArgInts(vals) => { return false }
        ArgReduce(r) => { return false }
        ArgVar(v) => { return false }
        ArgRange(r) => { return false }
        ArgParam(p) => { return false }
        ArgAxisSizes(a) => { return false }
        ArgDevice(dv) => { return false }
        ArgOp(o) => { return false }
        ArgBufferize(b) => { return false }
        ArgProgram(p) => { return false }
        ArgCall(c) => { return false }
    }
}

fn uop_valid(cache: mut UOpCache, id: Int, cond: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: id)
    let wbase = dt_weakint()
    let wdt = dtype_vec(base: read wbase, sz: dt.count)
    let idx = mk_cast(cache: mut cache, x: id, dt: read wdt)
    let invalid = uop_invalid(cache: mut cache, count: dt.count)
    return mk_where(cache: mut cache, dt: read wdt, cond: cond, tval: idx, fval: invalid)
}

fn uop_get_idx(cache: read UOpCache, id: Int) -> Int {
    if node_op(cache: read cache, id: id) == WHERE {
        if node_num_src(cache: read cache, id: id) == 3 {
            let invalid = node_src_id(cache: read cache, id: id, k: 2)
            if uop_is_invalid(cache: read cache, id: invalid) {
                return node_src_id(cache: read cache, id: id, k: 1)
            }
        }
    }
    return id
}

fn uop_get_valid(cache: mut UOpCache, id: Int) -> Int {
    if node_op(cache: read cache, id: id) == WHERE {
        if node_num_src(cache: read cache, id: id) == 3 {
            let invalid = node_src_id(cache: read cache, id: id, k: 2)
            if uop_is_invalid(cache: read cache, id: invalid) {
                return node_src_id(cache: read cache, id: id, k: 0)
            }
        }
    }
    let mut v = 1
    if uop_is_invalid(cache: read cache, id: id) { v = 0 }
    let bdt = dt_bool()
    return mk_const_int(cache: mut cache, dt: read bdt, v: v)
}

fn uop_expr(cache: read UOpCache, id: Int) -> fresh String {
    return node_var_name(cache: read cache, id: id)
}

fn uop_unbind(cache: read UOpCache, id: Int) -> Option<UOpBindValue> {
    let op = node_op(cache: read cache, id: id)
    if op == BIND {
        if node_num_src(cache: read cache, id: id) == 2 {
            let var = node_src_id(cache: read cache, id: id, k: 0)
            let val = node_src_id(cache: read cache, id: id, k: 1)
            let vop = node_op(cache: read cache, id: var)
            if vop == DEFINE_VAR {
                if node_is_const_int(cache: read cache, id: val) {
                    return Some(UOpBindValue(var_id: var, value: node_const_int(cache: read cache, id: val)))
                }
            }
        }
    }
    return None
}

fn uop_val(cache: read UOpCache, id: Int) -> Int {
    match uop_unbind(cache: read cache, id: id) {
        Some(v) => { return v.value }
        None => { return 0 }
    }
}

fn uop_bind_values_upsert(bindings: mut List<UOpBindValue>, var_id: Int, value: Int) -> Unit {
    let mut i = 0
    while i < List.len<UOpBindValue>(list: read bindings) {
        let cur = List.get<UOpBindValue>(list: read bindings, index: i)
        if cur.var_id == var_id {
            local repl = UOpBindValue(var_id: var_id, value: value)
            List.set<UOpBindValue>(list: mut bindings, index: i, value: read (manage repl))
            return Unit
        }
        i = i + 1
    }
    local item = UOpBindValue(var_id: var_id, value: value)
    List.push<UOpBindValue>(list: mut bindings, value: read (manage item))
    return Unit
}

fn uop_unbind_all_rewrite(cache: mut UOpCache, id: Int, bindings: mut List<UOpBindValue>) -> Int {
    match uop_unbind(cache: read cache, id: id) {
        Some(v) => {
            uop_bind_values_upsert(bindings: mut bindings, var_id: v.var_id, value: v.value)
            return v.var_id
        }
        None => {}
    }
    local new_src = List.new<Int>()
    let mut changed = false
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        let repl = uop_unbind_all_rewrite(cache: mut cache, id: child, bindings: mut bindings)
        if repl != child { changed = true }
        List.push<Int>(list: mut new_src, value: read repl)
        i = i + 1
    }
    if changed == false { return id }
    let op = node_op(cache: read cache, id: id)
    let dt = node_full_dtype(cache: read cache, id: id)
    local arg = node_arg(cache: read cache, id: id)
    return intern(cache: mut cache, op: op, dt: read dt, src: take new_src, arg: take arg)
}

fn uop_unbind_all(cache: mut UOpCache, id: Int) -> fresh UOpUnbindAllResult {
    local bindings = List.new<UOpBindValue>()
    let root = uop_unbind_all_rewrite(cache: mut cache, id: id, bindings: mut bindings)
    return UOpUnbindAllResult(root: root, bindings: take bindings)
}

fn uop_variables_push_sorted(cache: read UOpCache, vars: mut List<Int>, var_id: Int) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read vars) {
        let cur = List.get<Int>(list: read vars, index: i)
        if cur == var_id { return Unit }
        i = i + 1
    }
    List.push<Int>(list: mut vars, value: read var_id)
    let n = List.len<Int>(list: read vars)
    let mut a = 0
    while a < n {
        let mut b = a + 1
        while b < n {
            let va = List.get<Int>(list: read vars, index: a)
            let vb = List.get<Int>(list: read vars, index: b)
            if uop_var_less(cache: read cache, a: vb, b: va) {
                List.set<Int>(list: mut vars, index: a, value: read vb)
                List.set<Int>(list: mut vars, index: b, value: read va)
            }
            b = b + 1
        }
        a = a + 1
    }
    return Unit
}

fn uop_variables(cache: read UOpCache, id: Int) -> fresh List<Int> {
    local vars = List.new<Int>()
    local order = uop_toposort(cache: read cache, id: id)
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let node = List.get<Int>(list: read order, index: i)
        if node_op(cache: read cache, id: node) == DEFINE_VAR {
            uop_variables_push_sorted(cache: read cache, vars: mut vars, var_id: node)
        }
        i = i + 1
    }
    return take vars
}

fn uop_replace_arg(cache: mut UOpCache, id: Int, arg: take Arg) -> Int {
    let op = node_op(cache: read cache, id: id)
    let dt = node_full_dtype(cache: read cache, id: id)
    local src = uop_copy_src(cache: read cache, id: id)
    return intern(cache: mut cache, op: op, dt: read dt, src: take src, arg: take arg)
}

fn uop_replace_dtype(cache: mut UOpCache, id: Int, dt: read DType) -> Int {
    let op = node_op(cache: read cache, id: id)
    local src = uop_copy_src(cache: read cache, id: id)
    local arg = node_arg(cache: read cache, id: id)
    return intern(cache: mut cache, op: op, dt: read dt, src: take src, arg: take arg)
}

fn uop_stack(cache: mut UOpCache, dt: read DType, srcs: read List<Int>) -> Int {
    local src = copy_int_list(l: read srcs)
    local arg = ArgNone
    return intern(cache: mut cache, op: STACK, dt: read dt, src: take src, arg: take arg)
}

fn uop_broadcast(cache: mut UOpCache, id: Int, count: Int) -> Int {
    if count == 1 { return id }
    let base = node_dtype(cache: read cache, id: id)
    let dt = dtype_vec(base: read base, sz: count)
    local src = List.new<Int>()
    let mut i = 0
    while i < count {
        List.push<Int>(list: mut src, value: read id)
        i = i + 1
    }
    return uop_stack(cache: mut cache, dt: read dt, srcs: read src)
}

fn uop_sink(cache: mut UOpCache, srcs: read List<Int>) -> Int {
    local src = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read srcs) {
        let child = List.get<Int>(list: read srcs, index: i)
        if child >= 0 { List.push<Int>(list: mut src, value: read child) }
        i = i + 1
    }
    local arg = ArgNone
    let vdt = dt_void()
    return intern(cache: mut cache, op: SINK, dt: read vdt, src: take src, arg: take arg)
}

