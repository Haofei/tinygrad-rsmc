// Source-shaped ElementwiseMixin wrappers over tensor elementwise helpers.
features: local

fn mixin_elementwise_package_marker() -> fresh String { return String.copy(value: read "mixin.elementwise") }

fn mixin_elementwise_alu(cache: mut UOpCache, op: Ops, x: Int, y: Int) -> Int { return tensor_alu(cache: mut cache, op: op, x: x, y: y) }
fn mixin_elementwise_ufix(cache: mut UOpCache, x: Int, value: Float, scalar_is_int_or_invalid: Bool) -> Int { return tensor_ufix(cache: mut cache, x: x, value: value, scalar_is_int_or_invalid: scalar_is_int_or_invalid) }
fn mixin_elementwise_binop(cache: mut UOpCache, op: Ops, x: Int, y: Int, reverse: Bool) -> Int { return tensor_binop(cache: mut cache, op: op, x: x, y: y, reverse: reverse) }
fn mixin_elementwise_usum(cache: mut UOpCache, x: Int, values: read List<Int>) -> Int { return usum(cache: mut cache, x: x, values: read values) }
fn mixin_elementwise_uprod(cache: mut UOpCache, x: Int, values: read List<Int>) -> Int { return uprod(cache: mut cache, x: x, values: read values) }
fn mixin_elementwise_detach(cache: mut UOpCache, x: Int) -> Int { return tensor_detach(cache: mut cache, x: x) }
