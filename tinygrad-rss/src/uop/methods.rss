fn uop_vectorize(cache: mut UOpCache, id: Int, srcs: read List<Int>) -> Int {
    let scalar = node_dtype(cache: read cache, id: id)
    let dt = dtype_vec(base: read scalar, sz: List.len<Int>(list: read srcs) + 1)
    local all = List.new<Int>()
    List.push<Int>(list: mut all, value: read id)
    let mut i = 0
    while i < List.len<Int>(list: read srcs) {
        List.push<Int>(list: mut all, value: read List.get<Int>(list: read srcs, index: i))
        i = i + 1
    }
    return uop_stack(cache: mut cache, dt: read dt, srcs: read all)
}

fn uop_cast(cache: mut UOpCache, id: Int, dt_in: read DType) -> Int {
    let mut dt = dtype_copy(d: read dt_in)
    let self_dt = node_full_dtype(cache: read cache, id: id)
    if dt.count == 1 && self_dt.count != 1 {
        let scalar = dtype_scalar(d: read dt)
        dt = dtype_vec(base: read scalar, sz: self_dt.count)
    }
    return mk_cast(cache: mut cache, x: id, dt: read dt)
}

