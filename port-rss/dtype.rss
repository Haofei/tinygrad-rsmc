// Faithful port of tinygrad/dtype.py (scalar DType + the `dtypes` namespace + predicates).
// Translates tinygrad's ACTUAL definitions -- the same priorities, bitsizes, C names, and
// fmt chars from dtype.py lines 176-223 -- into rsscript, not a re-imagining.
//
// DType derives(Eq, Hash) so it can be interned/compared exactly like tinygrad's
// metaclass-cached, eq=False dataclass (uses the rss Hashable feature). Covers: the scalar
// dtypes, count-aware itemsize, the is_* predicates, the promotion lattice + least_upper_dtype,
// and vec() (vectorized dtypes). PtrDType/ImageDType remain unported -- they must store a
// dynamic base DType, which hits the rss clone-gap (can't clone a String/managed field out of
// a `read` value); documented in PORT_STATUS.

struct DType derives(Clone, Eq, Hash) {
    priority: Int
    bitsize: Int
    name: String
    fmt: Option<String>
    count: Int
}

// itemsize = scalar_bytes * count   (dtype.py: vec multiplies itemsize by count, so a vec's
// itemsize is the per-lane byte size times the lane count; scalar count==1 is unchanged).
fn DType.itemsize(self: read DType) -> Int {
    return ((self.bitsize + 7) / 8) * self.count
}

// ---- the dtypes namespace (dtype.py:176-197), exact values ----
fn d_void()    -> fresh DType { return DType(priority: -1, bitsize: 0,   name: "void",           fmt: None,      count: 1) }
fn d_weakint() -> fresh DType { return DType(priority: 0,  bitsize: 800, name: "weakint",        fmt: None,      count: 1) }
fn d_bool()    -> fresh DType { return DType(priority: 0,  bitsize: 1,   name: "bool",           fmt: Some("?"), count: 1) }
fn d_int8()    -> fresh DType { return DType(priority: 1,  bitsize: 8,   name: "signed char",    fmt: Some("b"), count: 1) }
fn d_uint8()   -> fresh DType { return DType(priority: 2,  bitsize: 8,   name: "unsigned char",  fmt: Some("B"), count: 1) }
fn d_int16()   -> fresh DType { return DType(priority: 3,  bitsize: 16,  name: "short",          fmt: Some("h"), count: 1) }
fn d_uint16()  -> fresh DType { return DType(priority: 4,  bitsize: 16,  name: "unsigned short", fmt: Some("H"), count: 1) }
fn d_int32()   -> fresh DType { return DType(priority: 5,  bitsize: 32,  name: "int",            fmt: Some("i"), count: 1) }
fn d_uint32()  -> fresh DType { return DType(priority: 6,  bitsize: 32,  name: "unsigned int",   fmt: Some("I"), count: 1) }
fn d_int64()   -> fresh DType { return DType(priority: 7,  bitsize: 64,  name: "long",           fmt: Some("q"), count: 1) }
fn d_uint64()  -> fresh DType { return DType(priority: 8,  bitsize: 64,  name: "unsigned long",  fmt: Some("Q"), count: 1) }
fn d_float16() -> fresh DType { return DType(priority: 11, bitsize: 16,  name: "half",           fmt: Some("e"), count: 1) }
fn d_bfloat16()-> fresh DType { return DType(priority: 12, bitsize: 16,  name: "__bf16",         fmt: None,      count: 1) }
fn d_float32() -> fresh DType { return DType(priority: 13, bitsize: 32,  name: "float",          fmt: Some("f"), count: 1) }
fn d_float64() -> fresh DType { return DType(priority: 14, bitsize: 64,  name: "double",         fmt: Some("d"), count: 1) }

fn d_fp8e4m3()    -> fresh DType { return DType(priority: 9,  bitsize: 8, name: "float8_e4m3",     fmt: None, count: 1) }
fn d_fp8e5m2()    -> fresh DType { return DType(priority: 10, bitsize: 8, name: "float8_e5m2",     fmt: None, count: 1) }
fn d_fp8e4m3fnuz()-> fresh DType { return DType(priority: 9,  bitsize: 8, name: "float8_e4m3fnuz", fmt: None, count: 1) }
fn d_fp8e5m2fnuz()-> fresh DType { return DType(priority: 10, bitsize: 8, name: "float8_e5m2fnuz", fmt: None, count: 1) }

// vec(sz): vectorized dtype (dtype.py DType.vec) -- same scalar fields, count=sz, so
// itemsize = scalar_bytes * sz. Generic now that rss has Clone: clone the base (Clone.clone<T>)
// then rebuild with count=sz (the clone gives owned name/fmt to move into the new DType).
fn d_vec(base: read DType, sz: Int) -> fresh DType {
    let c = Clone.clone<DType>(self: read base)
    return DType(priority: c.priority, bitsize: c.bitsize, name: c.name, fmt: c.fmt, count: sz)
}

// PtrDType (dtype.py): pointer to `base` with `size` elements; `local` = scratch mem. Now
// portable since Clone lets us store a cloned dynamic base. Pointer itemsize = host ptr (8).
struct PtrDType derives(Clone) {
    base: DType
    size: Int
    local: Bool
}
fn d_ptr(base: read DType, size: Int, local: Bool) -> fresh PtrDType {
    return PtrDType(base: Clone.clone<DType>(self: read base), size: size, local: local)
}
fn PtrDType.itemsize(self: read PtrDType) -> Int { return 8 }

// inverse of the dtypes namespace: C name -> DType
fn dtype_by_name(n: read String) -> fresh DType {
    if n == "void" { return d_void() }
    if n == "weakint" { return d_weakint() }
    if n == "bool" { return d_bool() }
    if n == "signed char" { return d_int8() }
    if n == "unsigned char" { return d_uint8() }
    if n == "short" { return d_int16() }
    if n == "unsigned short" { return d_uint16() }
    if n == "int" { return d_int32() }
    if n == "unsigned int" { return d_uint32() }
    if n == "long" { return d_int64() }
    if n == "unsigned long" { return d_uint64() }
    if n == "float8_e4m3" { return d_fp8e4m3() }
    if n == "float8_e5m2" { return d_fp8e5m2() }
    if n == "float8_e4m3fnuz" { return d_fp8e4m3fnuz() }
    if n == "float8_e5m2fnuz" { return d_fp8e5m2fnuz() }
    if n == "half" { return d_float16() }
    if n == "__bf16" { return d_bfloat16() }
    if n == "float" { return d_float32() }
    return d_float64()
}

fn contains_name(l: read List<String>, n: read String) -> Bool {
    let mut i = 0
    let m = List.len(list: read l)
    while i < m {
        let e = List.get(list: read l, index: i)
        if e == n { return true }
        i = i + 1
    }
    return false
}

// immediate parents in the promotion lattice (dtype.py:235-241), by C name
fn imm_parents(n: read String, out: mut List<String>) -> Unit {
    if n == "bool" { List.push(list: mut out, value: read "weakint") }
    if n == "weakint" {
        List.push(list: mut out, value: read "signed char")
        List.push(list: mut out, value: read "unsigned char")
    }
    if n == "signed char" { List.push(list: mut out, value: read "short") }
    if n == "short" { List.push(list: mut out, value: read "int") }
    if n == "int" { List.push(list: mut out, value: read "long") }
    if n == "long" { List.push(list: mut out, value: read "unsigned long") }
    if n == "unsigned char" {
        List.push(list: mut out, value: read "short")
        List.push(list: mut out, value: read "unsigned short")
    }
    if n == "unsigned short" {
        List.push(list: mut out, value: read "int")
        List.push(list: mut out, value: read "unsigned int")
    }
    if n == "unsigned int" {
        List.push(list: mut out, value: read "long")
        List.push(list: mut out, value: read "unsigned long")
    }
    if n == "unsigned long" {
        List.push(list: mut out, value: read "float8_e4m3")
        List.push(list: mut out, value: read "float8_e5m2")
        List.push(list: mut out, value: read "float8_e4m3fnuz")
        List.push(list: mut out, value: read "float8_e5m2fnuz")
    }
    if n == "float8_e4m3" {
        List.push(list: mut out, value: read "half")
        List.push(list: mut out, value: read "__bf16")
    }
    if n == "float8_e5m2" {
        List.push(list: mut out, value: read "half")
        List.push(list: mut out, value: read "__bf16")
    }
    if n == "float8_e4m3fnuz" {
        List.push(list: mut out, value: read "half")
        List.push(list: mut out, value: read "__bf16")
    }
    if n == "float8_e5m2fnuz" {
        List.push(list: mut out, value: read "half")
        List.push(list: mut out, value: read "__bf16")
    }
    if n == "half" { List.push(list: mut out, value: read "float") }
    if n == "__bf16" { List.push(list: mut out, value: read "float") }
    if n == "float" { List.push(list: mut out, value: read "double") }
    return Unit
}

// recursive parents (self + all transitive parents), dedup  (dtype.py:243-245)
fn rec_parents(n: read String, out: mut List<String>) -> Unit {
    if contains_name(l: read out, n: read n) { return Unit }
    List.push(list: mut out, value: read n)
    let ps = List.new<String>()
    imm_parents(n: read n, out: mut ps)
    let mut i = 0
    let m = List.len(list: read ps)
    while i < m {
        let p = List.get(list: read ps, index: i)
        rec_parents(n: read p, out: mut out)
        i = i + 1
    }
    return Unit
}

// least_upper_dtype(a, b): min common ancestor in the lattice  (dtype.py:247-249)
fn least_upper_dtype(a: read DType, b: read DType) -> fresh DType {
    let ra = List.new<String>()
    rec_parents(n: read a.name, out: mut ra)
    let rb = List.new<String>()
    rec_parents(n: read b.name, out: mut rb)
    let mut best = "double"
    let mut have = false
    let mut bestp = 0
    let mut bestb = 0
    let mut i = 0
    let m = List.len(list: read ra)
    while i < m {
        let cand = List.get(list: read ra, index: i)
        if contains_name(l: read rb, n: read cand) {
            let cd = dtype_by_name(n: read cand)
            let mut better = false
            if have == false { better = true }
            if cd.priority < bestp { better = true }
            if cd.priority == bestp {
                if cd.bitsize < bestb { better = true }
            }
            if better {
                best = cand
                bestp = cd.priority
                bestb = cd.bitsize
                have = true
            }
        }
        i = i + 1
    }
    return dtype_by_name(n: read best)
}

// ---- predicates (dtype.py:150-160). count==1 here, so scalar(x) == x; check by C name. ----
fn dtypes_is_float(x: read DType) -> Bool {
    if x.name == "half" { return true }
    if x.name == "__bf16" { return true }
    if x.name == "float" { return true }
    if x.name == "double" { return true }
    if x.name == "float8_e4m3" { return true }
    if x.name == "float8_e5m2" { return true }
    if x.name == "float8_e4m3fnuz" { return true }
    if x.name == "float8_e5m2fnuz" { return true }
    return false
}
fn dtypes_is_unsigned(x: read DType) -> Bool {
    if x.name == "unsigned char" { return true }
    if x.name == "unsigned short" { return true }
    if x.name == "unsigned int" { return true }
    if x.name == "unsigned long" { return true }
    return false
}
fn dtypes_is_int(x: read DType) -> Bool {
    if dtypes_is_unsigned(x: read x) { return true }
    if x.name == "signed char" { return true }
    if x.name == "short" { return true }
    if x.name == "int" { return true }
    if x.name == "long" { return true }
    if x.name == "weakint" { return true }
    return false
}
fn dtypes_is_bool(x: read DType) -> Bool {
    return x.name == "bool"
}

// membership-by-name helpers (the fp8s/ints groups are checked by C name)
fn is_fp8(n: read String) -> Bool {
    if n == "float8_e4m3" { return true }
    if n == "float8_e5m2" { return true }
    if n == "float8_e4m3fnuz" { return true }
    if n == "float8_e5m2fnuz" { return true }
    return false
}

// can_lossless_cast(dt0, dt1): does dt1 preserve every value of dt0?  (dtype.py:255-272)
fn can_lossless_cast(dt0: read DType, dt1: read DType) -> Bool {
    if dt0.name == dt1.name { return true }
    if dt0.name == "bool" { return true }
    if dt1.name == "weakint" { return dtypes_is_int(x: read dt0) }
    if dt1.name == "double" {
        if dt0.name == "float" { return true }
        if dt0.name == "half" { return true }
        if dt0.name == "__bf16" { return true }
        if is_fp8(n: read dt0.name) { return true }
        if dt0.name == "unsigned int" { return true }
        if dt0.name == "unsigned short" { return true }
        if dt0.name == "unsigned char" { return true }
        if dt0.name == "int" { return true }
        if dt0.name == "short" { return true }
        if dt0.name == "signed char" { return true }
        return false
    }
    if dt1.name == "float" {
        if dt0.name == "half" { return true }
        if dt0.name == "__bf16" { return true }
        if is_fp8(n: read dt0.name) { return true }
        if dt0.name == "unsigned short" { return true }
        if dt0.name == "unsigned char" { return true }
        if dt0.name == "short" { return true }
        if dt0.name == "signed char" { return true }
        return false
    }
    if dt1.name == "half" {
        if is_fp8(n: read dt0.name) { return true }
        if dt0.name == "unsigned char" { return true }
        if dt0.name == "signed char" { return true }
        return false
    }
    if dt1.name == "unsigned long" {
        if dt0.name == "unsigned int" { return true }
        if dt0.name == "unsigned short" { return true }
        if dt0.name == "unsigned char" { return true }
        return false
    }
    if dt1.name == "unsigned int" {
        if dt0.name == "unsigned short" { return true }
        if dt0.name == "unsigned char" { return true }
        return false
    }
    if dt1.name == "unsigned short" {
        return dt0.name == "unsigned char"
    }
    if dt1.name == "long" {
        if dt0.name == "unsigned int" { return true }
        if dt0.name == "unsigned short" { return true }
        if dt0.name == "unsigned char" { return true }
        if dt0.name == "int" { return true }
        if dt0.name == "short" { return true }
        if dt0.name == "signed char" { return true }
        return false
    }
    if dt1.name == "int" {
        if dt0.name == "unsigned short" { return true }
        if dt0.name == "unsigned char" { return true }
        if dt0.name == "short" { return true }
        if dt0.name == "signed char" { return true }
        return false
    }
    if dt1.name == "short" {
        if dt0.name == "unsigned char" { return true }
        if dt0.name == "signed char" { return true }
        return false
    }
    return false
}

fn yn(b: Bool) -> fresh String {
    let r = String.concat(left: read "", right: read "")
    if b {
        return String.concat(left: read r, right: read "yes")
    }
    return String.concat(left: read r, right: read "no")
}
fn report(label: read String, v: Int) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read Int.to_string(value: read v)))
    return Unit
}
fn show(label: read String, b: Bool) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read yn(b: b)))
    return Unit
}
fn showname(label: read String, d: read DType) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read d.name))
    return Unit
}

fn main() -> Unit {
    let f32 = d_float32()
    let i32 = d_int32()
    let u8 = d_uint8()
    let bl = d_bool()
    report(label: read "float32.priority = ", v: f32.priority)                   // 13
    report(label: read "float32.itemsize = ", v: DType.itemsize(self: read f32)) // 4
    report(label: read "int32.itemsize = ",   v: DType.itemsize(self: read i32)) // 4
    report(label: read "bool.itemsize = ",    v: DType.itemsize(self: read bl))  // 1
    show(label: read "is_float(float32) = ",  b: dtypes_is_float(x: read f32))    // yes
    show(label: read "is_float(int32) = ",    b: dtypes_is_float(x: read i32))    // no
    show(label: read "is_int(int32) = ",      b: dtypes_is_int(x: read i32))      // yes
    show(label: read "is_unsigned(uint8) = ", b: dtypes_is_unsigned(x: read u8))  // yes
    show(label: read "is_bool(bool) = ",      b: dtypes_is_bool(x: read bl))      // yes
    // can_lossless_cast checks (validated against tinygrad)
    show(label: read "lossless(int8->int32) = ",   b: can_lossless_cast(dt0: read d_int8(),    dt1: read d_int32()))   // yes
    show(label: read "lossless(float32->int32) = ",b: can_lossless_cast(dt0: read d_float32(), dt1: read d_int32()))   // no
    show(label: read "lossless(uint8->int16) = ",  b: can_lossless_cast(dt0: read d_uint8(),   dt1: read d_int16()))   // yes
    show(label: read "lossless(half->float32) = ", b: can_lossless_cast(dt0: read d_float16(), dt1: read d_float32())) // yes
    show(label: read "lossless(int32->uint32) = ", b: can_lossless_cast(dt0: read d_int32(),   dt1: read d_uint32()))  // no
    // least_upper_dtype (validated against tinygrad)
    showname(label: read "lud(int32,float32) = ", d: read least_upper_dtype(a: read d_int32(),   b: read d_float32()))  // float
    showname(label: read "lud(int8,uint8) = ",    d: read least_upper_dtype(a: read d_int8(),    b: read d_uint8()))    // short
    showname(label: read "lud(uint64,int64) = ",  d: read least_upper_dtype(a: read d_uint64(),  b: read d_int64()))    // unsigned long
    showname(label: read "lud(half,bfloat16) = ", d: read least_upper_dtype(a: read d_float16(), b: read d_bfloat16())) // float
    showname(label: read "lud(int32,int64) = ",   d: read least_upper_dtype(a: read d_int32(),   b: read d_int64()))    // long
    showname(label: read "lud(bool,int8) = ",     d: read least_upper_dtype(a: read d_bool(),    b: read d_int8()))     // signed char
    // vec dtypes: float32.vec(4) itemsize 16 (4*4); bool.vec(4) itemsize 4 (1*4); count tracked
    let f32x4 = d_vec(base: read d_float32(), sz: 4)
    report(label: read "float32.vec(4).itemsize = ", v: DType.itemsize(self: read f32x4))   // 16
    report(label: read "float32.vec(4).count = ",    v: f32x4.count)                          // 4
    let blx4 = d_vec(base: read d_bool(), sz: 4)
    report(label: read "bool.vec(4).itemsize = ",    v: DType.itemsize(self: read blx4))      // 4
    let i32x8 = d_vec(base: read d_int32(), sz: 8)
    report(label: read "int32.vec(8).itemsize = ",   v: DType.itemsize(self: read i32x8))     // 32
    // PtrDType: itemsize is host pointer size (8); base preserved
    let pf = d_ptr(base: read d_float32(), size: 16, local: false)
    report(label: read "ptr(float32).itemsize = ",   v: PtrDType.itemsize(self: read pf))      // 8
    report(label: read "ptr(float32).size = ",       v: pf.size)                                // 16
    Log.write(message: read String.concat(left: read "ptr(float32).base.name = ", right: read pf.base.name))  // float
    return Unit
}
