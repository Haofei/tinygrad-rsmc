fn show(label: read String, l: read List<Float>) -> Unit {
    Log.write(message: read label)
    let mut i = 0
    while i < List.len<Float>(list: read l) {
        Log.write(message: read Float.to_string(value: read List.get<Float>(list: read l, index: i)))
        i = i + 1
    }
    return Unit
}
fn yn(b: Bool) -> fresh String {
    if b { return "yes" }
    return "no"
}
fn showi(label: read String, v: Int) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read Int.to_string(value: read v)))
    return Unit
}
fn showb(label: read String, v: Bool) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read yn(b: v)))
    return Unit
}
fn showdt(label: read String, d: read DType) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read d.name))
    return Unit
}
fn showstr(label: read String, v: read String) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read v))
    return Unit
}
fn showop(label: read String, op: read Ops) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read ops_name(op: read op)))
    return Unit
}
fn show_ints(label: read String, l: read List<Int>) -> Unit {
    let mut s = String.concat(left: read label, right: read "[")
    let mut i = 0
    while i < List.len<Int>(list: read l) {
        s = String.concat(left: read s, right: read Int.to_string(value: read List.get<Int>(list: read l, index: i)))
        if i < List.len<Int>(list: read l) - 1 { s = String.concat(left: read s, right: read ", ") }
        i = i + 1
    }
    Log.write(message: read String.concat(left: read s, right: read "]"))
    return Unit
}
fn show_contraction(label: read String, c: read Contraction) -> Unit {
    if c.ok == false {
        Log.write(message: read String.concat(left: read label, right: read "None"))
        return Unit
    }
    let mut s = String.concat(left: read label, right: read "[")
    let mut pos = 0
    let mut g = 0
    while g < List.len<Int>(list: read c.group_lens) {
        s = String.concat(left: read s, right: read "[")
        let glen = List.get<Int>(list: read c.group_lens, index: g)
        let mut j = 0
        while j < glen {
            s = String.concat(left: read s, right: read Int.to_string(value: read List.get<Int>(list: read c.groups, index: pos)))
            if j < glen - 1 { s = String.concat(left: read s, right: read ", ") }
            pos = pos + 1
            j = j + 1
        }
        s = String.concat(left: read s, right: read "]")
        if g < List.len<Int>(list: read c.group_lens) - 1 { s = String.concat(left: read s, right: read ", ") }
        g = g + 1
    }
    Log.write(message: read String.concat(left: read s, right: read "]"))
    return Unit
}
fn pushf(l: mut List<Float>, v: Float) -> Unit {
    List.push<Float>(list: mut l, value: read v)
    return Unit
}
fn pushi(l: mut List<Int>, v: Int) -> Unit {
    List.push<Int>(list: mut l, value: read v)
    return Unit
}
fn shp(a: Int, b: Int) -> fresh List<Int> {
    local s = List.new<Int>()
    pushi(l: mut s, v: a)
    pushi(l: mut s, v: b)
    return take s
}
fn shp1(a: Int) -> fresh List<Int> {
    local s = List.new<Int>()
    pushi(l: mut s, v: a)
    return take s
}
fn shp3(a: Int, b: Int, c: Int) -> fresh List<Int> {
    local s = List.new<Int>()
    pushi(l: mut s, v: a)
    pushi(l: mut s, v: b)
    pushi(l: mut s, v: c)
    return take s
}
fn shp4(a: Int, b: Int, c: Int, d: Int) -> fresh List<Int> {
    local s = List.new<Int>()
    pushi(l: mut s, v: a)
    pushi(l: mut s, v: b)
    pushi(l: mut s, v: c)
    pushi(l: mut s, v: d)
    return take s
}
