fn program_arg_vals(cache: read UOpCache, arg: read ProgramArg, var_vals: read Map<String, Int>) -> fresh ProgramVals {
    local values = List.new<Int>()
    local has_value = List.new<Bool>()
    local is_runtime = List.new<Bool>()
    let mut i = 0
    while i < List.len<Int>(list: read arg.vars) {
        let v = List.get<Int>(list: read arg.vars, index: i)
        let name = node_var_name(cache: read cache, id: v)
        if name == "core_id" {
            List.push<Int>(list: mut values, value: read 0)
            List.push<Bool>(list: mut has_value, value: read false)
            List.push<Bool>(list: mut is_runtime, value: read true)
        } else {
            match Map.get<String, Int>(map: read var_vals, key: read name) {
                Some(value) => {
                    List.push<Int>(list: mut values, value: read value)
                    List.push<Bool>(list: mut has_value, value: read true)
                    List.push<Bool>(list: mut is_runtime, value: read false)
                }
                None => {
                    List.push<Int>(list: mut values, value: read 0)
                    List.push<Bool>(list: mut has_value, value: read false)
                    List.push<Bool>(list: mut is_runtime, value: read false)
                }
            }
        }
        i = i + 1
    }
    return ProgramVals(values: take values, has_value: take has_value, is_runtime: take is_runtime)
}

