fn trig_poly(cache: mut UOpCache, d: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: d)
    let d2 = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: d, y: d)
    let c = mk_const_float(cache: mut cache, dt: read dt, v: 0.0 - 0.16666659712791443)
    let inner = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: d2, y: c)
    let one = mk_const_float(cache: mut cache, dt: read dt, v: 1.0)
    let poly = mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: inner, y: one)
    return mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: d, y: poly)
}

