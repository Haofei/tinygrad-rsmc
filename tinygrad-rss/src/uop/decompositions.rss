fn unpack32(cache: mut UOpCache, v: Int) -> fresh DecompPair {
    let u32 = dt_uint32()
    let mask = mk_const_int(cache: mut cache, dt: read u32, v: 65535)
    let bits = mk_bitcast(cache: mut cache, x: v, dt: read u32)
    let lo = mk_alu2(cache: mut cache, op: AND, dt: read u32, x: bits, y: mask)
    let hi = shr(cache: mut cache, x: bits, y: 16)
    return decomp_pair(lo: lo, hi: hi)
}

