// 1:1 port of tinygrad/uop/ops.py — the UOp IR node, as an INTERNED shared DAG.
// tinygrad interns via a global UOpMetaClass cache so identical subgraphs are the same object.
// rss has no global mutable state, so the cache is an explicit `UOpCache` struct threaded as `mut`
// (same dedup algorithm; only the cache's location differs). src are node ids into the cache table
// — the rss representation of tinygrad's "tuple of references to shared UOps".
features: local

struct ReduceArg derives(Clone) {
    kind: Int,
    axes: List<Int>,
}

struct VarArg derives(Clone) {
    name: String,
    min_val: Int,
    max_val: Int,
}

sum AxisType derives(Clone, Eq, Hash) {
    AXIS_GLOBAL
    AXIS_WARP
    AXIS_LOCAL
    AXIS_LOOP
    AXIS_GROUP_REDUCE
    AXIS_REDUCE
    AXIS_UPCAST
    AXIS_UNROLL
    AXIS_THREAD
    AXIS_PLACEHOLDER
}

struct RangeArg derives(Clone) {
    axes: List<Int>,
    axis_type: AxisType,
}

sum AddrSpace derives(Clone, Eq, Hash) {
    ADDR_GLOBAL
    ADDR_LOCAL
    ADDR_REG
}

struct ParamArg derives(Clone) {
    slot: Int,
    has_vmin_vmax: Bool,
    vmin: Int,
    vmax: Int,
    name: String,
    addrspace: AddrSpace,
    has_axis: Bool,
    axis: Int,
    device: String,
}

struct AxisSizeArg derives(Clone) {
    pairs: List<Int>,
}

struct DeviceArg derives(Clone) {
    devices: List<String>,
}

struct BufferizeArg derives(Clone) {
    has_device: Bool,
    is_device_int: Bool,
    device_int: Int,
    devices: List<String>,
    addrspace: AddrSpace,
    removable: Bool,
}

struct Estimates derives(Clone) {
    ops: Int,
    lds: Int,
    mem: Int,
}

struct ProgramArg derives(Clone) {
    name: String,
    global_size: List<Int>,
    has_local_size: Bool,
    local_size: List<Int>,
    vars: List<Int>,
    globals: List<Int>,
    outs: List<Int>,
    ins: List<Int>,
    has_estimates: Bool,
    estimate_ops: Int,
    estimate_lds: Int,
    estimate_mem: Int,
}

struct ProgramLaunchDims derives(Clone) {
    global_size: List<Int>,
    has_local_size: Bool,
    local_size: List<Int>,
}

struct ProgramVals derives(Clone) {
    values: List<Int>,
    has_value: List<Bool>,
    is_runtime: List<Bool>,
}

struct CallArg derives(Clone) {
    has_name: Bool,
    name: String,
    precompile: Bool,
    precompile_backward: Bool,
}

sum Arg derives(Clone) {
    ArgNone
    ArgInt(value: Int)
    ArgFloat(value: Float)
    ArgBool(value: Bool)
    ArgStr(text: String)
    ArgInts(values: List<Int>)
    ArgReduce(value: ReduceArg)
    ArgVar(value: VarArg)
    ArgRange(value: RangeArg)
    ArgParam(value: ParamArg)
    ArgAxisSizes(value: AxisSizeArg)
    ArgDevice(value: DeviceArg)
    ArgOp(value: Ops)
    ArgBufferize(value: BufferizeArg)
    ArgProgram(value: ProgramArg)
    ArgCall(value: CallArg)
}

// op:Ops, dtype:DType, src:tuple[UOp,...] (child ids), arg:Any (Arg)
struct UOp derives(Clone) {
    op: Ops,
    dtype: DType,
    src: List<Int>,
    arg: Arg,
}

// Structural identity key. Float isn't Eq/Hash, so arg is flattened (kind + int/float-as-string/str).
struct NodeKey derives(Clone, Eq, Hash) {
    op: Ops,
    dtype: String,
    src: List<Int>,
    ak: Int,
    ai: Int,
    af: String,
    sv: String,
    kd: List<Int>,
}

struct UOpCache {
    nodes: List<UOp>,
    index: Map<NodeKey, Int>,
    datas: List<List<Float>>,
}

fn cache_new() -> fresh UOpCache {
    local n = List.new<UOp>()
    local ix = Map.new<NodeKey, Int>()
    local d = List.new<List<Float>>()
    return UOpCache(nodes: take n, index: take ix, datas: take d)
}

fn cache_len(cache: read UOpCache) -> Int { return List.len<UOp>(list: read cache.nodes) }

fn bool_to_int(b: Bool) -> Int { if b { return 1 } return 0 }

fn addr_space_ord(a: read AddrSpace) -> Int {
    match a {
        ADDR_GLOBAL => { return 0 }
        ADDR_LOCAL => { return 1 }
        ADDR_REG => { return 2 }
    }
}

fn addr_space_copy(a: read AddrSpace) -> fresh AddrSpace {
    match a {
        ADDR_GLOBAL => { return ADDR_GLOBAL }
        ADDR_LOCAL => { return ADDR_LOCAL }
        ADDR_REG => { return ADDR_REG }
    }
}

fn addr_space_name(a: read AddrSpace) -> fresh String {
    match a {
        ADDR_GLOBAL => { return "GLOBAL" }
        ADDR_LOCAL => { return "LOCAL" }
        ADDR_REG => { return "REG" }
    }
}

