// Extends the ported codegen to MATMUL: a WxW row-major matmul lowers to nested i,j,k loops
// with an accumulator (out[i*W+j] = sum_k A[i*W+k]*B[k*W+j]) -- the nested-range + reduce
// shape tinygrad's codegen produces. Closes the real loop for matmul: render -> MC -> native.
// Demo: 3x3 matmul, validated numerically by the Python driver.

features: local

fn cat(a: read String, b: read String) -> fresh String { return String.concat(left: read a, right: read b) }
fn cat3(a: read String, b: read String, c: read String) -> fresh String { return cat(a: read cat(a: read a, b: read b), b: read c) }
fn pl(lines: mut List<String>, t: read String) -> Unit {
    List.push(list: mut lines, value: read t)
    return Unit
}

fn emit_matmul(w: Int) -> fresh String {
    let ws = String.from_int(value: w)
    let nn = w * w
    let nbytes = String.from_int(value: nn * 4)
    let lines = List.new<String>()
    pl(lines: mut lines, t: read "import \"std/addr.mc\";")
    pl(lines: mut lines, t: read "import \"std/hosted_io.mc\";")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "export fn MM(data0: PAddr, data1: PAddr, data2: PAddr) -> void {")
    pl(lines: mut lines, t: read "  unsafe {")
    pl(lines: mut lines, t: read "    var acc: [1]f32 = uninit;")
    pl(lines: mut lines, t: read "    var i: usize = 0;")
    pl(lines: mut lines, t: read cat3(a: read "    while i < ", b: read ws, c: read " {"))
    pl(lines: mut lines, t: read "      var j: usize = 0;")
    pl(lines: mut lines, t: read cat3(a: read "      while j < ", b: read ws, c: read " {"))
    pl(lines: mut lines, t: read "        acc[0] = 0.0;")
    pl(lines: mut lines, t: read "        var k: usize = 0;")
    pl(lines: mut lines, t: read cat3(a: read "        while k < ", b: read ws, c: read " {"))
    // a_idx = i*W + k ; b_idx = k*W + j
    pl(lines: mut lines, t: read cat3(a: read "          let ai: usize = (i * ", b: read ws, c: read ") + k;"))
    pl(lines: mut lines, t: read cat3(a: read "          let bi: usize = (k * ", b: read ws, c: read ") + j;"))
    pl(lines: mut lines, t: read "          let av: f32 = raw.load<f32>(pa_offset(data1, ai * 4));")
    pl(lines: mut lines, t: read "          let bv: f32 = raw.load<f32>(pa_offset(data2, bi * 4));")
    pl(lines: mut lines, t: read "          acc[0] = acc[0] + (av * bv);")
    pl(lines: mut lines, t: read "          k = k + 1;")
    pl(lines: mut lines, t: read "        }")
    pl(lines: mut lines, t: read cat3(a: read "        let oi: usize = (i * ", b: read ws, c: read ") + j;"))
    pl(lines: mut lines, t: read "        raw.store<f32>(pa_offset(data0, oi * 4), acc[0]);")
    pl(lines: mut lines, t: read "        j = j + 1;")
    pl(lines: mut lines, t: read "      }")
    pl(lines: mut lines, t: read "      i = i + 1;")
    pl(lines: mut lines, t: read "    }")
    pl(lines: mut lines, t: read "  }")
    pl(lines: mut lines, t: read "}")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "fn read_exact(f: Fd, buf: PAddr, m: usize) -> Result<bool, IoError> {")
    pl(lines: mut lines, t: read "  var done: usize = 0;")
    pl(lines: mut lines, t: read "  while done < m {")
    pl(lines: mut lines, t: read "    let r: usize = io_read(f, pa_offset(buf, done), m - done)?;")
    pl(lines: mut lines, t: read "    if r == 0 { return err(.ReadFailed); }")
    pl(lines: mut lines, t: read "    done = done + r;")
    pl(lines: mut lines, t: read "  }")
    pl(lines: mut lines, t: read "  return ok(true);")
    pl(lines: mut lines, t: read "}")
    pl(lines: mut lines, t: read "export fn hosted_kernel_run() -> i32 {")
    pl(lines: mut lines, t: read cat3(a: read "  var a: [", b: read String.from_int(value: nn), c: read "]f32 = uninit;"))
    pl(lines: mut lines, t: read cat3(a: read "  var b: [", b: read String.from_int(value: nn), c: read "]f32 = uninit;"))
    pl(lines: mut lines, t: read cat3(a: read "  var o: [", b: read String.from_int(value: nn), c: read "]f32 = uninit;"))
    pl(lines: mut lines, t: read "  let input: Fd = stdin_fd();")
    pl(lines: mut lines, t: read "  let output: Fd = stdout_fd();")
    pl(lines: mut lines, t: read cat3(a: read "  if let err(e) = read_exact(input, pa((&a[0]) as usize), ", b: read nbytes, c: read ") { return 1; }"))
    pl(lines: mut lines, t: read cat3(a: read "  if let err(e) = read_exact(input, pa((&b[0]) as usize), ", b: read nbytes, c: read ") { return 2; }"))
    pl(lines: mut lines, t: read "  MM(pa((&o[0]) as usize), pa((&a[0]) as usize), pa((&b[0]) as usize));")
    pl(lines: mut lines, t: read cat3(a: read "  if let err(e) = io_write_all(output, pa((&o[0]) as usize), ", b: read nbytes, c: read ") { return 9; }"))
    pl(lines: mut lines, t: read "  return 0;")
    pl(lines: mut lines, t: read "}")
    return String.join(parts: read lines, separator: read "\n")
}

fn main() -> Unit {
    Log.write(message: read emit_matmul(w: 3))
    return Unit
}
