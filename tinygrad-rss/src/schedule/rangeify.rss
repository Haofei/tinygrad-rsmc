    return mk_after(cache: mut cache, id: node_src_id(cache: read cache, id: after, k: 0), srcs: read deps)
}

fn rangeify_fix_assign(cache: mut UOpCache, root: Int) -> Int {
    local afters = rangeify_collect_after_nodes(cache: read cache, root: root)
    if List.len<Int>(list: read afters) <= 1 { return root }
    local olds = List.new<Int>()
    local news = List.new<Int>()
    let mut ui = 0
    while ui < List.len<Int>(list: read afters) {
        let reader_after = List.get<Int>(list: read afters, index: ui)
        let reader_kernel = rangeify_after_kernel(cache: read cache, after: reader_after)
        let reader_buf = rangeify_after_buf(cache: mut cache, after: reader_after)
        if reader_kernel >= 0 {
            let mut ai = 0
            while ai < List.len<Int>(list: read afters) {
                let writer_after = List.get<Int>(list: read afters, index: ai)
                if writer_after != reader_after {
                    let writer_buf = rangeify_after_buf(cache: mut cache, after: writer_after)
                    let writer_kernel = rangeify_after_kernel(cache: read cache, after: writer_after)
                    if writer_buf >= 0 && writer_buf != reader_buf && writer_kernel != reader_kernel {
                        if rangeify_kernel_arg_reads_buf(cache: mut cache, kernel: reader_kernel, buf: writer_buf) {
                            let cur_pos = rangeify_pos(ids: read olds, id: writer_after)
                            let mut cur_after = writer_after
                            if cur_pos >= 0 { cur_after = List.get<Int>(list: read news, index: cur_pos) }
                            let new_after = rangeify_append_after_dep(cache: mut cache, after: cur_after, dep: reader_after)
                            if new_after != cur_after {
                                if cur_pos >= 0 {
                                    List.set<Int>(list: mut news, index: cur_pos, value: read new_after)
                                } else {
                                    List.push<Int>(list: mut olds, value: read writer_after)
                                    List.push<Int>(list: mut news, value: read new_after)
                                }
                            }
                        }
                    }
                }
                ai = ai + 1
            }
        }
        ui = ui + 1
    }
    if List.len<Int>(list: read olds) == 0 { return root }
    return uop_substitute_many(cache: mut cache, id: root, old_ids: read olds, new_ids: read news)
}

fn get_kernel_graph(cache: mut UOpCache, sink: Int) -> Int {
    let cleaned = rangeify_apply_syntactic_sugar(cache: mut cache, root: sink)
    local analysis = indexing_run_rangeify_analysis(cache: mut cache, root: cleaned)
    let ranged = indexing_apply_rangeify_rewrite(cache: mut cache, root: cleaned, analysis: read analysis)
    local ictx = indexing_context_new()
    let limited = rangeify_apply_limit_bufs_pass(cache: mut cache, root: ranged, ctx: mut ictx)
    local lctx = rangeify_local_context_new()
    let mut buffered = limited
    let mut i = 0
    while i < 3 {
        buffered = rangeify_apply_bufferize_pass(cache: mut cache, root: buffered, ctx: mut lctx)
        i = i + 1
    }
    let split = rangeify_apply_split_pass(cache: mut cache, root: buffered)
    return rangeify_fix_assign(cache: mut cache, root: split)
}
