// Tensor-level (n-dim) reverse-mode autograd: each node is a tensor op over a buffer, and
// each op's vjp rule emits a BACKWARD KERNEL (a loop over the buffer), not scalar lines.
// The tensor-level analogue of autograd.rss, and the bridge toward tinygrad's
// "differentiate the graph into backward kernels".
//
// Demo: loss = sum(relu(x)^2). The engine emits forward kernels (relu, square, sum) and the
// auto-generated backward kernels (sum-vjp broadcast, square-vjp 2*a, relu-vjp gate), then
// writes dx. Analytic: dx_i = 2*x_i if x_i>0 else 0.

fn T_INPUT() -> Int { return 0 }
fn T_RELU()  -> Int { return 1 }
fn T_SQ()    -> Int { return 2 }
fn T_SUM()   -> Int { return 3 }

fn pl(lines: mut List<String>, t: read String) -> Unit {
    List.push(list: mut lines, value: read t)
    return Unit
}
// flat line builder: join string parts (avoids deep cat nesting / rss parser limits)
fn cp(x: read String) -> fresh String {
    return String.concat(left: read x, right: read "")
}
fn rowp(lines: mut List<String>, parts: read List<String>) -> Unit {
    List.push(list: mut lines, value: read String.join(parts: read parts, separator: read ""))
    return Unit
}
fn sint(i: Int) -> fresh String { return String.from_int(value: i) }
fn fb(i: Int) -> fresh String { return String.concat(left: read "fb", right: read sint(i: i)) }
fn gb(i: Int) -> fresh String { return String.concat(left: read "gb", right: read sint(i: i)) }
// buf[idx]
fn bi(buf: read String, iv: read String) -> fresh String {
    let p = List.new<String>()
    List.push(list: mut p, value: read cp(x: read buf))
    List.push(list: mut p, value: read "[")
    List.push(list: mut p, value: read cp(x: read iv))
    List.push(list: mut p, value: read "]")
    return String.join(parts: read p, separator: read "")
}

// emit a `var <iv>: usize = 0; while <iv> < N {` loop header, return the loop var name
fn loop_open(lines: mut List<String>, iv: read String, nstr: read String) -> Unit {
    let p = List.new<String>()
    List.push(list: mut p, value: read "    var ")
    List.push(list: mut p, value: read cp(x: read iv))
    List.push(list: mut p, value: read ": usize = 0; while ")
    List.push(list: mut p, value: read cp(x: read iv))
    List.push(list: mut p, value: read " < ")
    List.push(list: mut p, value: read cp(x: read nstr))
    List.push(list: mut p, value: read " {")
    rowp(lines: mut lines, parts: read p)
    return Unit
}
fn loop_close(lines: mut List<String>, iv: read String) -> Unit {
    let p = List.new<String>()
    List.push(list: mut p, value: read "      ")
    List.push(list: mut p, value: read cp(x: read iv))
    List.push(list: mut p, value: read " = ")
    List.push(list: mut p, value: read cp(x: read iv))
    List.push(list: mut p, value: read " + 1;")
    rowp(lines: mut lines, parts: read p)
    pl(lines: mut lines, t: read "    }")
    return Unit
}
fn emit_tensor_autograd(nstr: read String) -> fresh String {
    let op = List.new<Int>()
    let src = List.new<Int>()
    List.push(list: mut op, value: read T_INPUT())
    List.push(list: mut src, value: read -1)
    List.push(list: mut op, value: read T_RELU())
    List.push(list: mut src, value: read 0)
    List.push(list: mut op, value: read T_SQ())
    List.push(list: mut src, value: read 1)
    List.push(list: mut op, value: read T_SUM())
    List.push(list: mut src, value: read 2)
    let n = List.len(list: read op)

    let lines = List.new<String>()
    pl(lines: mut lines, t: read "import \"std/addr.mc\";")
    pl(lines: mut lines, t: read "import \"std/hosted_io.mc\";")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "export fn hosted_kernel_run() -> i32 {")
    // buffers (SUM node is scalar; others are [N])
    let mut i = 0
    while i < n {
        let o = List.get(list: read op, index: i)
        if o == T_SUM() {
            let p = List.new<String>()
            List.push(list: mut p, value: read "  var ")
            List.push(list: mut p, value: read fb(i: i))
            List.push(list: mut p, value: read ": f32 = 0.0;")
            rowp(lines: mut lines, parts: read p)
        }
        if o != T_SUM() {
            let p = List.new<String>()
            List.push(list: mut p, value: read "  var ")
            List.push(list: mut p, value: read fb(i: i))
            List.push(list: mut p, value: read ": [")
            List.push(list: mut p, value: read cp(x: read nstr))
            List.push(list: mut p, value: read "]f32 = uninit;")
            rowp(lines: mut lines, parts: read p)
        }
        i = i + 1
    }
    // read input x -> fb0
    pl(lines: mut lines, t: read "  let input: Fd = stdin_fd();")
    let pr = List.new<String>()
    List.push(list: mut pr, value: read "  var dn: usize = 0; while dn < ")
    List.push(list: mut pr, value: read cp(x: read nstr))
    List.push(list: mut pr, value: read " {")
    rowp(lines: mut lines, parts: read pr)
    let pr2 = List.new<String>()
    List.push(list: mut pr2, value: read "    let rr: usize = io_read(input, pa((&fb0[dn]) as usize), (")
    List.push(list: mut pr2, value: read cp(x: read nstr))
    List.push(list: mut pr2, value: read " - dn) * 4)?;")
    rowp(lines: mut lines, parts: read pr2)
    pl(lines: mut lines, t: read "    if rr == 0 { return 1; }")
    pl(lines: mut lines, t: read "    dn = dn + (rr / 4);")
    pl(lines: mut lines, t: read "  }")

    // ---- forward kernels ----
    let mut f = 0
    while f < n {
        let o = List.get(list: read op, index: f)
        let s = List.get(list: read src, index: f)
        let iv = String.concat(left: read "i", right: read sint(i: f))
        if o == T_RELU() {
            loop_open(lines: mut lines, iv: read iv, nstr: read nstr)
            // if src[iv] > 0.0 { dst[iv] = src[iv]; } else { dst[iv] = 0.0; }
            let p = List.new<String>()
            List.push(list: mut p, value: read "      if ")
            List.push(list: mut p, value: read bi(buf: read fb(i: s), iv: read iv))
            List.push(list: mut p, value: read " > 0.0 { ")
            List.push(list: mut p, value: read bi(buf: read fb(i: f), iv: read iv))
            List.push(list: mut p, value: read " = ")
            List.push(list: mut p, value: read bi(buf: read fb(i: s), iv: read iv))
            List.push(list: mut p, value: read "; } else { ")
            List.push(list: mut p, value: read bi(buf: read fb(i: f), iv: read iv))
            List.push(list: mut p, value: read " = 0.0; }")
            rowp(lines: mut lines, parts: read p)
            loop_close(lines: mut lines, iv: read iv)
        }
        if o == T_SQ() {
            loop_open(lines: mut lines, iv: read iv, nstr: read nstr)
            let p = List.new<String>()
            List.push(list: mut p, value: read "      ")
            List.push(list: mut p, value: read bi(buf: read fb(i: f), iv: read iv))
            List.push(list: mut p, value: read " = (")
            List.push(list: mut p, value: read bi(buf: read fb(i: s), iv: read iv))
            List.push(list: mut p, value: read " * ")
            List.push(list: mut p, value: read bi(buf: read fb(i: s), iv: read iv))
            List.push(list: mut p, value: read ");")
            rowp(lines: mut lines, parts: read p)
            loop_close(lines: mut lines, iv: read iv)
        }
        if o == T_SUM() {
            loop_open(lines: mut lines, iv: read iv, nstr: read nstr)
            let p = List.new<String>()
            List.push(list: mut p, value: read "      ")
            List.push(list: mut p, value: read fb(i: f))
            List.push(list: mut p, value: read " = (")
            List.push(list: mut p, value: read fb(i: f))
            List.push(list: mut p, value: read " + ")
            List.push(list: mut p, value: read bi(buf: read fb(i: s), iv: read iv))
            List.push(list: mut p, value: read ");")
            rowp(lines: mut lines, parts: read p)
            loop_close(lines: mut lines, iv: read iv)
        }
        f = f + 1
    }

    // ---- grad buffers ----
    let mut g = 0
    while g < n {
        let o = List.get(list: read op, index: g)
        if o == T_SUM() {
            let p = List.new<String>()
            List.push(list: mut p, value: read "  var ")
            List.push(list: mut p, value: read gb(i: g))
            List.push(list: mut p, value: read ": f32 = 1.0;")
            rowp(lines: mut lines, parts: read p)
        }
        if o != T_SUM() {
            let p = List.new<String>()
            List.push(list: mut p, value: read "  var ")
            List.push(list: mut p, value: read gb(i: g))
            List.push(list: mut p, value: read ": [")
            List.push(list: mut p, value: read cp(x: read nstr))
            List.push(list: mut p, value: read "]f32 = uninit;")
            rowp(lines: mut lines, parts: read p)
        }
        g = g + 1
    }

    // ---- backward kernels (reverse), auto-generated per-op vjp ----
    let mut r = n - 1
    while r >= 0 {
        let o = List.get(list: read op, index: r)
        let s = List.get(list: read src, index: r)
        let iv = String.concat(left: read "b", right: read sint(i: r))
        if o == T_SUM() {
            loop_open(lines: mut lines, iv: read iv, nstr: read nstr)
            let p = List.new<String>()
            List.push(list: mut p, value: read "      ")
            List.push(list: mut p, value: read bi(buf: read gb(i: s), iv: read iv))
            List.push(list: mut p, value: read " = ")
            List.push(list: mut p, value: read gb(i: r))
            List.push(list: mut p, value: read ";")
            rowp(lines: mut lines, parts: read p)
            loop_close(lines: mut lines, iv: read iv)
        }
        if o == T_SQ() {
            loop_open(lines: mut lines, iv: read iv, nstr: read nstr)
            let p = List.new<String>()
            List.push(list: mut p, value: read "      ")
            List.push(list: mut p, value: read bi(buf: read gb(i: s), iv: read iv))
            List.push(list: mut p, value: read " = ((")
            List.push(list: mut p, value: read bi(buf: read gb(i: r), iv: read iv))
            List.push(list: mut p, value: read " * 2.0) * ")
            List.push(list: mut p, value: read bi(buf: read fb(i: s), iv: read iv))
            List.push(list: mut p, value: read ");")
            rowp(lines: mut lines, parts: read p)
            loop_close(lines: mut lines, iv: read iv)
        }
        if o == T_RELU() {
            loop_open(lines: mut lines, iv: read iv, nstr: read nstr)
            let p = List.new<String>()
            List.push(list: mut p, value: read "      if ")
            List.push(list: mut p, value: read bi(buf: read fb(i: s), iv: read iv))
            List.push(list: mut p, value: read " > 0.0 { ")
            List.push(list: mut p, value: read bi(buf: read gb(i: s), iv: read iv))
            List.push(list: mut p, value: read " = ")
            List.push(list: mut p, value: read bi(buf: read gb(i: r), iv: read iv))
            List.push(list: mut p, value: read "; } else { ")
            List.push(list: mut p, value: read bi(buf: read gb(i: s), iv: read iv))
            List.push(list: mut p, value: read " = 0.0; }")
            rowp(lines: mut lines, parts: read p)
            loop_close(lines: mut lines, iv: read iv)
        }
        r = r - 1
    }

    // write dx = grad of the input node (node 0)
    pl(lines: mut lines, t: read "  let output: Fd = stdout_fd();")
    let pw = List.new<String>()
    List.push(list: mut pw, value: read "  if let err(e) = io_write_all(output, pa((&gb0[0]) as usize), ")
    List.push(list: mut pw, value: read cp(x: read nstr))
    List.push(list: mut pw, value: read " * 4) { return 9; }")
    rowp(lines: mut lines, parts: read pw)
    pl(lines: mut lines, t: read "  return 0;")
    pl(lines: mut lines, t: read "}")
    return String.join(parts: read lines, separator: read "\n")
}

fn main() -> Unit {
    Log.write(message: read emit_tensor_autograd(nstr: read "4"))
    return Unit
}
