fn tensor_logsumexp_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: axis, extra: false)
    let m = tensor_max_axis_keepdim(cache: mut cache, x: x, axis: d)
    let shifted = tensor_sub(cache: mut cache, a: x, b: m)
    let e = tensor_exp(cache: mut cache, x: shifted)
    let s = tensor_sum_axis_keepdim(cache: mut cache, x: e, axis: d)
    let l = tensor_log(cache: mut cache, x: s)
    let out = tensor_add(cache: mut cache, a: l, b: m)
    return tensor_squeeze_dim(cache: mut cache, x: out, dim: d)
}

fn tensor_softmax_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: axis, extra: false)
    let m0 = tensor_max_axis_keepdim(cache: mut cache, x: x, axis: d)
    let m = tensor_sub(cache: mut cache, a: x, b: m0)
    let e = tensor_exp(cache: mut cache, x: m)
    let ss = tensor_sum_axis_keepdim(cache: mut cache, x: e, axis: d)
    return tensor_div(cache: mut cache, a: e, b: ss)
}

fn tensor_log_softmax_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: axis, extra: false)
    let m0 = tensor_max_axis_keepdim(cache: mut cache, x: x, axis: d)
    let m = tensor_sub(cache: mut cache, a: x, b: m0)
    let e = tensor_exp(cache: mut cache, x: m)
    let ss = tensor_sum_axis_keepdim(cache: mut cache, x: e, axis: d)
    let lss = tensor_log(cache: mut cache, x: ss)
    return tensor_sub(cache: mut cache, a: m, b: lss)
}

fn tensor_logcumsumexp_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read sh)
    if ndim == 0 { return x }
    let d = tensor_resolve_dim(ndim: ndim, dim: axis, extra: false)
    let xt = tensor_transpose(cache: mut cache, x: x, dim0: d, dim1: 0 - 1)
    local tshape = uop_shape(cache: read cache, id: xt)
    let n = List.get<Int>(list: read tshape, index: ndim - 1)
    let x_uns = tensor_unsqueeze(cache: mut cache, x: xt, dim: 0 - 2)
    local expanded_shape = List.new<Int>()
    let mut i = 0
    while i < ndim + 1 {
        if i < ndim - 1 {
            push1(l: mut expanded_shape, a: List.get<Int>(list: read tshape, index: i))
        } else {
            push1(l: mut expanded_shape, a: n)
        }
        i = i + 1
    }
    let x_exp = tensor_expand(cache: mut cache, x: x_uns, new_shape: read expanded_shape)
    let x_cummax = tensor_cummax_values_axis(cache: mut cache, x: xt, axis: 0 - 1)
    let x_cummax_uns = tensor_unsqueeze(cache: mut cache, x: x_cummax, dim: 0 - 1)
    let shifted = tensor_sub(cache: mut cache, a: x_exp, b: x_cummax_uns)
    let mask = tensor_ones_tril_bool(cache: mut cache, n: n)
    let low = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read expanded_shape, value: 0.0 - 1000000000000000000.0)
    let selected = tensor_where(cache: mut cache, cond: mask, x: shifted, y: low)
    let expd = tensor_exp(cache: mut cache, x: selected)
    let summed = tensor_sum_axis(cache: mut cache, x: expd, axis: 0 - 1)
    let logged = tensor_log(cache: mut cache, x: summed)
    let ret = tensor_add(cache: mut cache, a: logged, b: x_cummax)
    return tensor_transpose(cache: mut cache, x: ret, dim0: 0 - 1, dim1: d)
}

fn tensor_ones_tril_bool(cache: mut UOpCache, n: Int) -> Int {
    local shape = List.new<Int>()
    push1(l: mut shape, a: n)
    push1(l: mut shape, a: n)
    local data = List.new<Float>()
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            if j <= i { pushf1(l: mut data, a: 1.0) }
            else { pushf1(l: mut data, a: 0.0) }
            j = j + 1
        }
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt_bool(), shape: read shape, data: read data)
}

fn tensor_sort_mask_shape(ndim: Int, dim: Int, n: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    push1(l: mut out, a: n)
    push1(l: mut out, a: n)
    let mut i = dim + 1
    while i < ndim {
        push1(l: mut out, a: 1)
        i = i + 1
    }
    return take out
}

fn tensor_sort_index_shape(shape: read List<Int>, dim: Int, n: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if i == dim { push1(l: mut out, a: n) }
        else { push1(l: mut out, a: 1) }
        i = i + 1
    }
    return take out
}

fn tensor_sort_duplicate_counts(cache: mut UOpCache, t: Int, mask: Int, dim: Int) -> Int {
    let a = tensor_unsqueeze(cache: mut cache, x: t, dim: dim)
    let b = tensor_unsqueeze(cache: mut cache, x: t, dim: dim + 1)
    let eq = tensor_eq(cache: mut cache, a: a, b: b)
    let masked = tensor_and(cache: mut cache, a: mask, b: eq)
    let as_int = tensor_cast(cache: mut cache, x: masked, dt: read dt_int32())
    return tensor_sum_axis(cache: mut cache, x: as_int, axis: dim + 1)
}

fn tensor_sort_axis(cache: mut UOpCache, x: Int, dim: Int, descending: Bool) -> SortResult {
    local orig_shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read orig_shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    let orig_len = List.get<Int>(list: read orig_shape, index: d)
    if orig_len <= 1 {
        let idx0 = tensor_full(cache: mut cache, dt: read dt_int32(), shape: read orig_shape, value: 0.0)
        return SortResult(values: x, indices: idx0)
    }

    let mut padded_len = 1
    let mut n_stages = 0
    while padded_len < orig_len {
        padded_len = padded_len * 2
        n_stages = n_stages + 1
    }
    local before = List.new<Int>()
    local after = List.new<Int>()
    let mut ax = 0
    while ax < ndim {
        push1(l: mut before, a: 0)
        if ax == d { push1(l: mut after, a: padded_len - orig_len) }
        else { push1(l: mut after, a: 0) }
        ax = ax + 1
    }
    let mut pad_value = 1000000000000000000.0
    if descending { pad_value = 0.0 - 1000000000000000000.0 }
    let padded = tensor_pad_constant(cache: mut cache, x: x, before: read before, after: read after, value: pad_value)
    local twos = List.new<Int>()
    let mut ns = 0
    while ns < n_stages {
        push1(l: mut twos, a: 2)
        ns = ns + 1
    }
    let mut cur = tensor_unflatten(cache: mut cache, x: padded, dim: d, sizes: read twos)

    let mut stage = 1
    while stage <= n_stages {
        let crossover_dim = d + n_stages - stage - 1
        local flip_dims = List.new<Int>()
        if stage != n_stages {
            local cur_shape0 = uop_shape(cache: read cache, id: cur)
            let cur_ndim0 = List.len<Int>(list: read cur_shape0)
            let mut fi = 1
            while fi <= stage + (ndim - d) {
                push1(l: mut flip_dims, a: cur_ndim0 - fi)
                fi = fi + 1
            }
            local parts0 = tensor_split_size(cache: mut cache, x: cur, size: 1, dim: crossover_dim)
            let blue = List.get<Int>(list: read parts0, index: 0)
            let green = List.get<Int>(list: read parts0, index: 1)
            let green_flip = tensor_flip(cache: mut cache, x: green, axes: read flip_dims)
            local pair0 = List.new<Int>()
            push1(l: mut pair0, a: blue)
            push1(l: mut pair0, a: green_flip)
            cur = tensor_cat(cache: mut cache, tensors: read pair0, dim: crossover_dim)
        }

        let mut substage = stage - 1
        while substage >= 0 {
            let partner_dim = d + n_stages - substage - 1
            local parts1 = tensor_split_size(cache: mut cache, x: cur, size: 1, dim: partner_dim)
            let top = List.get<Int>(list: read parts1, index: 0)
            let bottom = List.get<Int>(list: read parts1, index: 1)
            let larger = tensor_maximum(cache: mut cache, a: top, b: bottom)
            let smaller = tensor_minimum(cache: mut cache, a: top, b: bottom)
            local pair1 = List.new<Int>()
            if descending {
                push1(l: mut pair1, a: larger)
                push1(l: mut pair1, a: smaller)
            } else {
                push1(l: mut pair1, a: smaller)
                push1(l: mut pair1, a: larger)
            }
            cur = tensor_cat(cache: mut cache, tensors: read pair1, dim: partner_dim)
            substage = substage - 1
        }

        if stage != n_stages {
            local parts2 = tensor_split_size(cache: mut cache, x: cur, size: 1, dim: crossover_dim)
            let blue2 = List.get<Int>(list: read parts2, index: 0)
            let green2 = List.get<Int>(list: read parts2, index: 1)
            let green2_flip = tensor_flip(cache: mut cache, x: green2, axes: read flip_dims)
            local pair2 = List.new<Int>()
            push1(l: mut pair2, a: blue2)
            push1(l: mut pair2, a: green2_flip)
            cur = tensor_cat(cache: mut cache, tensors: read pair2, dim: crossover_dim)
        }
        stage = stage + 1
    }

    let flat = tensor_flatten(cache: mut cache, x: cur, start_dim: d, end_dim: d + n_stages - 1)
    let values = tensor_shrink_to(cache: mut cache, x: flat, new_shape: read orig_shape)

    let tril = tensor_ones_tril_bool(cache: mut cache, n: orig_len)
    local mask_shape = tensor_sort_mask_shape(ndim: ndim, dim: d, n: orig_len)
    let mask = tensor_reshape(cache: mut cache, x: tril, new_shape: read mask_shape)
    let count_orig = tensor_sort_duplicate_counts(cache: mut cache, t: x, mask: mask, dim: d)
    let count_sorted = tensor_sort_duplicate_counts(cache: mut cache, t: values, mask: mask, dim: d)
    let x_uns = tensor_unsqueeze(cache: mut cache, x: x, dim: d + 1)
    let sorted_uns = tensor_unsqueeze(cache: mut cache, x: values, dim: d)
    let value_eq = tensor_eq(cache: mut cache, a: x_uns, b: sorted_uns)
    let count_orig_uns = tensor_unsqueeze(cache: mut cache, x: count_orig, dim: d + 1)
    let count_sorted_uns = tensor_unsqueeze(cache: mut cache, x: count_sorted, dim: d)
    let count_eq = tensor_eq(cache: mut cache, a: count_orig_uns, b: count_sorted_uns)
    let cond = tensor_and(cache: mut cache, a: value_eq, b: count_eq)
    let cond_int = tensor_cast(cache: mut cache, x: cond, dt: read dt_int32())
    let idx_base = tensor_arange(cache: mut cache, dt: read dt_int32(), n: orig_len)
    local idx_shape = tensor_sort_index_shape(shape: read orig_shape, dim: d, n: orig_len)
    let idx_view = tensor_reshape(cache: mut cache, x: idx_base, new_shape: read idx_shape)
    let idx_uns = tensor_unsqueeze(cache: mut cache, x: idx_view, dim: d + 1)
    let weighted = tensor_mul(cache: mut cache, a: cond_int, b: idx_uns)
    let indices = tensor_sum_axis(cache: mut cache, x: weighted, axis: d)
    return SortResult(values: values, indices: indices)
}

fn tensor_argsort_axis(cache: mut UOpCache, x: Int, dim: Int, descending: Bool) -> Int {
    let sorted = tensor_sort_axis(cache: mut cache, x: x, dim: dim, descending: descending)
    return sorted.indices
}

fn tensor_topk_axis(cache: mut UOpCache, x: Int, k: Int, dim: Int, largest: Bool) -> SortResult {
    let sorted = tensor_sort_axis(cache: mut cache, x: x, dim: dim, descending: largest)
    local sh = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: dim, extra: false)
    local top_shape = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read sh) {
        if i == d { push1(l: mut top_shape, a: k) }
        else { push1(l: mut top_shape, a: List.get<Int>(list: read sh, index: i)) }
        i = i + 1
    }
    let values = tensor_shrink_to(cache: mut cache, x: sorted.values, new_shape: read top_shape)
    let indices = tensor_shrink_to(cache: mut cache, x: sorted.indices, new_shape: read top_shape)
    return SortResult(values: values, indices: indices)
}

fn tensor_binary_crossentropy_none(cache: mut UOpCache, x: Int, y: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let yf = tensor_cast(cache: mut cache, x: y, dt: read node_dtype(cache: read cache, id: x))
    let one = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read sh, value: 1.0)
    let logx = tensor_log(cache: mut cache, x: x)
    let y_logx = tensor_mul(cache: mut cache, a: yf, b: logx)
    let one_minus_y = tensor_sub(cache: mut cache, a: one, b: yf)
    let one_minus_x = tensor_sub(cache: mut cache, a: one, b: x)
    let log_one_minus_x = tensor_log(cache: mut cache, x: one_minus_x)
    let rest = tensor_mul(cache: mut cache, a: one_minus_y, b: log_one_minus_x)
    let loss = tensor_add(cache: mut cache, a: y_logx, b: rest)
    return tensor_neg(cache: mut cache, x: loss)
}

fn tensor_binary_crossentropy_sum(cache: mut UOpCache, x: Int, y: Int) -> Int {
    let loss = tensor_binary_crossentropy_none(cache: mut cache, x: x, y: y)
    return tensor_sum_all(cache: mut cache, x: loss)
}

fn tensor_binary_crossentropy_mean(cache: mut UOpCache, x: Int, y: Int) -> Int {
    let loss = tensor_binary_crossentropy_none(cache: mut cache, x: x, y: y)
    return tensor_mean_all(cache: mut cache, x: loss)
}

fn tensor_binary_crossentropy_logits_none(cache: mut UOpCache, x: Int, y: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let yf = tensor_cast(cache: mut cache, x: y, dt: read node_dtype(cache: read cache, id: x))
    let one = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read sh, value: 1.0)
    let log_p = tensor_logsigmoid(cache: mut cache, x: x)
    let nx = tensor_neg(cache: mut cache, x: x)
    let log_1_minus_p = tensor_logsigmoid(cache: mut cache, x: nx)
    let pos = tensor_mul(cache: mut cache, a: yf, b: log_p)
    let one_minus_y = tensor_sub(cache: mut cache, a: one, b: yf)
    let neg = tensor_mul(cache: mut cache, a: one_minus_y, b: log_1_minus_p)
    let loss = tensor_add(cache: mut cache, a: pos, b: neg)
    return tensor_neg(cache: mut cache, x: loss)
}

fn tensor_binary_crossentropy_logits_mean(cache: mut UOpCache, x: Int, y: Int) -> Int {
    let loss = tensor_binary_crossentropy_logits_none(cache: mut cache, x: x, y: y)
    return tensor_mean_all(cache: mut cache, x: loss)
}

fn tensor_binary_crossentropy_logits_pos_weight_none(cache: mut UOpCache, x: Int, y: Int, pos_weight: Int) -> Int {
