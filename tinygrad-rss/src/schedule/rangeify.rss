fn rangeify_special_kernel_body(cache: mut UOpCache, stored: Int, owner: Int) -> Int {
    let op = node_op(cache: read cache, id: stored)
    if op != COPY && op != SLICE { return stored }
    local srcs = uop_copy_src(cache: read cache, id: stored)
    local ended = uop_ended_ranges(cache: read cache, id: owner)
    let mut i = 0
    while i < List.len<Int>(list: read ended) {
        List.push<Int>(list: mut srcs, value: read List.get<Int>(list: read ended, index: i))
