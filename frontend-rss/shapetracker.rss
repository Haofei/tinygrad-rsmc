// A minimal ShapeTracker in rsscript -- a port of tinygrad's zero-copy movement-op model.
// A view is (shape, strides); movement ops (permute, expand) only rewrite shape/strides, and
// an index maps logical coordinates to a buffer offset via sum(idx[d]*stride[d]). No data is
// moved -- a transpose or broadcast is just a different stride view over the same buffer.
//
// Demonstrates: contiguous 2x3 strides; permute (transpose) gives the SAME element offset;
// expand (broadcast, stride 0) ignores the broadcast axis. Runs in rss; prints offsets.

fn push2(l: mut List<Int>, x: Int, y: Int) -> Unit {
    List.push(list: mut l, value: read x)
    List.push(list: mut l, value: read y)
    return Unit
}

// fill `strides` with the row-major contiguous strides of `shape`
fn fill_contig(shape: read List<Int>, strides: mut List<Int>) -> Unit {
    let n = List.len(list: read shape)
    let mut k = 0
    while k < n {
        List.push(list: mut strides, value: read 1)
        k = k + 1
    }
    let mut d = n - 2
    while d >= 0 {
        let nxt = List.get(list: read strides, index: d + 1) * List.get(list: read shape, index: d + 1)
        List.set(list: mut strides, index: d, value: read nxt)
        d = d - 1
    }
    return Unit
}

// offset = sum_d idx[d] * stride[d]   (the ShapeTracker index map)
fn offset(strides: read List<Int>, idx: read List<Int>) -> Int {
    let mut o = 0
    let mut d = 0
    let n = List.len(list: read strides)
    while d < n {
        let sv = List.get(list: read strides, index: d)
        let xv = List.get(list: read idx, index: d)
        let m = sv * xv
        o = o + m
        d = d + 1
    }
    return o
}

fn report(label: read String, value: Int) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read String.from_int(value: value)))
    return Unit
}

fn main() -> Unit {
    // contiguous 2x3 -> strides [3, 1]
    let shape = List.new<Int>()
    push2(l: mut shape, x: 2, y: 3)
    let strides = List.new<Int>()
    fill_contig(shape: read shape, strides: mut strides)
    report(label: read "contig stride[0] = ", value: List.get(list: read strides, index: 0))  // 3
    report(label: read "contig stride[1] = ", value: List.get(list: read strides, index: 1))  // 1
    // element (1,2) offset = 1*3 + 2*1 = 5
    let ix = List.new<Int>()
    push2(l: mut ix, x: 1, y: 2)
    report(label: read "offset[1,2] = ", value: offset(strides: read strides, idx: read ix))  // 5

    // permute (transpose) [1,0]: shape [3,2], strides [1,3] -- a VIEW, no data moved
    let pst = List.new<Int>()
    push2(l: mut pst, x: List.get(list: read strides, index: 1), y: List.get(list: read strides, index: 0)) // [1,3]
    // logical (2,1) in the transposed view addresses the same element as (1,2) above
    let pix = List.new<Int>()
    push2(l: mut pix, x: 2, y: 1)
    report(label: read "transposed offset[2,1] = ", value: offset(strides: read pst, idx: read pix))  // 5 (same!)

    // expand (broadcast) a 1x3 row to 4x3: shape [4,3], stride[0]=0
    let bsh = List.new<Int>()
    push2(l: mut bsh, x: 1, y: 3)
    let bst = List.new<Int>()
    fill_contig(shape: read bsh, strides: mut bst)   // [3,1]
    List.set(list: mut bst, index: 0, value: read 0)      // broadcast axis 0 -> stride 0
    // logical (2,1) ignores the broadcast axis: 2*0 + 1*1 = 1
    let bix = List.new<Int>()
    push2(l: mut bix, x: 2, y: 1)
    report(label: read "broadcast offset[2,1] = ", value: offset(strides: read bst, idx: read bix))  // 1
    return Unit
}
