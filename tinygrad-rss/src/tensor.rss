fn tensor_cat(cache: mut UOpCache, tensors: read List<Int>, dim: Int) -> Int {
    let first = List.get<Int>(list: read tensors, index: 0)
    local first_shape = uop_shape(cache: read cache, id: first)
    let ndim = List.len<Int>(list: read first_shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: dim, extra: false)
    let mut total_dim = 0
    let mut i = 0
    while i < List.len<Int>(list: read tensors) {
        let t = List.get<Int>(list: read tensors, index: i)
        local ts = uop_shape(cache: read cache, id: t)
        total_dim = total_dim + List.get<Int>(list: read ts, index: d)
        i = i + 1
    }
    let mut offset = 0
    let mut result = 0 - 1
    let mut j = 0
    while j < List.len<Int>(list: read tensors) {
        let t = List.get<Int>(list: read tensors, index: j)
        local ts = uop_shape(cache: read cache, id: t)
        let dim_size = List.get<Int>(list: read ts, index: d)
        local before = List.new<Int>()
        local after = List.new<Int>()
        let mut ax = 0
        while ax < ndim {
            if ax == d {
                push1(l: mut before, a: offset)
                push1(l: mut after, a: total_dim - offset - dim_size)
            } else {
                push1(l: mut before, a: 0)
                push1(l: mut after, a: 0)
            }
            ax = ax + 1
        }
        let padded = tensor_pad(cache: mut cache, x: t, before: read before, after: read after)
        if result < 0 {
            result = padded
        } else {
            result = tensor_add(cache: mut cache, a: result, b: padded)
        }
        offset = offset + dim_size
        j = j + 1
    }
    return result
}

fn tensor_stack(cache: mut UOpCache, tensors: read List<Int>, dim: Int) -> Int {
    local unsqueezed = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read tensors) {
        let t = List.get<Int>(list: read tensors, index: i)
        let u = tensor_unsqueeze(cache: mut cache, x: t, dim: dim)
        push1(l: mut unsqueezed, a: u)
        i = i + 1
    }
    return tensor_cat(cache: mut cache, tensors: read unsqueezed, dim: dim)
}

fn tensor_cumsum_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: axis, extra: false)
    let n = List.get<Int>(list: read shape, index: d)
    let xt = tensor_transpose(cache: mut cache, x: x, dim0: d, dim1: 0 - 1)
    local tshape = uop_shape(cache: read cache, id: xt)
    local before = List.new<Int>()
    local after = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read tshape) {
        if i == List.len<Int>(list: read tshape) - 1 {
            push1(l: mut before, a: n - 1)
        } else {
            push1(l: mut before, a: 0)
        }
        push1(l: mut after, a: 0)
        i = i + 1
    }
    let xp = tensor_pad(cache: mut cache, x: xt, before: read before, after: read after)
    let pooled = tensor_pool1d_last(cache: mut cache, x: xp, size: n, step: 1)
    local pooled_shape = uop_shape(cache: read cache, id: pooled)
    let summed = tensor_sum_axis(cache: mut cache, x: pooled, axis: List.len<Int>(list: read pooled_shape) - 1)
    return tensor_transpose(cache: mut cache, x: summed, dim0: d, dim1: 0 - 1)
}

