features: local

struct SQTTPacket derives(Clone) {
    raw: Int,
    time: Int,
    kind: String,
    simd: Int,
    cu_id: Int,
}

fn add_other_simd(base: Int, start: Int, end: Int, cycle: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut v = start
    while v <= end {
        List.push<Int>(list: mut out, value: read (base + v + cycle))
        v = v + 1
    }
    return take out
}

fn from_raw(raw: Int, time: Int) -> fresh SQTTPacket {
    return SQTTPacket(raw: raw, time: time, kind: String.copy(value: read "packet"), simd: raw & 3, cu_id: (raw >> 2) & 15)
}

fn is_marker(packet: read SQTTPacket) -> Bool { return packet.kind == "marker" || (packet.raw & 1) == 1 }

fn cu(packet: read SQTTPacket) -> Int { return packet.cu_id }

fn wave_interest(packet: read SQTTPacket, mask: Int) -> Bool { return ((1 << packet.simd) & mask) != 0 }

fn terminate_all(packet: read SQTTPacket) -> Bool { return packet.kind == "terminate" || packet.raw == 0 }

fn is_config(packet: read SQTTPacket) -> Bool { return packet.kind == "config" || ((packet.raw >> 4) & 3) == 3 }

fn _build_decode_tables(arch: read String) -> fresh List<String> {
    local out = List.new<String>()
    List.push<String>(list: mut out, value: read String.copy(value: read arch))
    List.push<String>(list: mut out, value: read "TS")
    List.push<String>(list: mut out, value: read "INST")
    return take out
}

fn decode_sqtt(data: read List<Int>, arch: read String) -> fresh List<SQTTPacket> {
    local out = List.new<SQTTPacket>()
    let mut i = 0
    while i < List.len<Int>(list: read data) {
        List.push<SQTTPacket>(list: mut out, value: read from_raw(raw: List.get<Int>(list: read data, index: i), time: i))
        i = i + 1
    }
    return take out
}

fn map_insts(packets: read List<SQTTPacket>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<SQTTPacket>(list: read packets) {
        List.push<Int>(list: mut out, value: read List.get<SQTTPacket>(list: read packets, index: i).raw)
        i = i + 1
    }
    return take out
}

fn format_packet(packet: read SQTTPacket) -> fresh String {
    return String.concat(left: read packet.kind, right: read String.concat(left: read "@", right: read Int.to_string(value: read packet.time)))
}

fn print_packets(packets: read List<SQTTPacket>) -> fresh String {
    let mut out = ""
    let mut i = 0
    while i < List.len<SQTTPacket>(list: read packets) {
        out = String.concat(left: read out, right: read format_packet(packet: read List.get<SQTTPacket>(list: read packets, index: i)))
        if i < List.len<SQTTPacket>(list: read packets) - 1 { out = String.concat(left: read out, right: read "\n") }
        i = i + 1
    }
    return String.copy(value: read out)
}
