fn magicgu(vmax: Int, d: Int) -> fresh DecompPair {
    let mut s = 0
    let mut p = 1
    while p < vmax + 1 {
        p = p * 2
        s = s + 1
    }
    let m = ceildiv(num: p, amt: d)
    return decomp_pair(lo: m, hi: s)
}

