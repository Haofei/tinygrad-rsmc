// 1:1 port of tinygrad/uop/ops.py UOp._min_max (vmin/vmax), integer cases, over the interned DAG.
// Operates on (cache, id): value-range inference [lo, hi] used by symbolic for bound-dependent rules.
features: local

struct VRange derives(Clone) {
    lo: Int,
    hi: Int,
}

fn b2i(b: Bool) -> Int { if b { return 1 } return 0 }
fn imin2(a: Int, b: Int) -> Int { if a < b { return a } return b }
fn imin4(a: Int, b: Int, c: Int, d: Int) -> Int { return imin2(a: imin2(a: a, b: b), b: imin2(a: c, b: d)) }
fn imax4(a: Int, b: Int, c: Int, d: Int) -> Int { return imax2(a: imax2(a: a, b: b), b: imax2(a: c, b: d)) }
fn vmin_int() -> Int { return 0 - 9223372036854775807 - 1 }
fn vmax_int() -> Int { return 9223372036854775807 }
fn sat_add_int(a: Int, b: Int) -> Int {
    if b > 0 && a > vmax_int() - b { return vmax_int() }
    if b == vmin_int() {
        if a < 0 { return vmin_int() }
        return a + b
    }
    if b < 0 && a < vmin_int() - b { return vmin_int() }
    return a + b
}
fn sat_sub_int(a: Int, b: Int) -> Int {
    if b == vmin_int() {
        if a >= 0 { return vmax_int() }
        return vmin_int()
    }
    return sat_add_int(a: a, b: 0 - b)
}
fn sat_mul_int(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 { return 0 }
    if a == vmin_int() || b == vmin_int() {
        if (a > 0 && b == vmin_int()) || (b > 0 && a == vmin_int()) { return vmin_int() }
        return vmax_int()
    }
    let neg = (a < 0 && b > 0) || (a > 0 && b < 0)
    let mut aa = a
    if a < 0 { aa = 0 - a }
    let mut bb = b
    if b < 0 { bb = 0 - b }
    if aa > vmax_int() / bb {
        if neg { return vmin_int() }
        return vmax_int()
    }
    return a * b
}

// DType.min/max for integers. Signed: [-2^(n-1), 2^(n-1)-1]; unsigned: [0, 2^n-1]; 64-bit clamps to i64.
fn dtype_imin(d: read DType) -> Int {
    if dtype_is_unsigned(d: read d) { return 0 }
    if d.bitsize >= 64 { return vmin_int() }
    return 0 - (1 << (d.bitsize - 1))
}
fn dtype_imax(d: read DType) -> Int {
    if d.bitsize >= 64 { return vmax_int() }
    if dtype_is_unsigned(d: read d) { return (1 << d.bitsize) - 1 }
    return (1 << (d.bitsize - 1)) - 1
}

fn uop_min_max(cache: read UOpCache, id: Int) -> fresh VRange {
    let op = node_op(cache: read cache, id: id)
    // CONST: exact single value
    if op == CONST {
        if node_is_const_int(cache: read cache, id: id) {
            let v = node_const_int(cache: read cache, id: id)
            return VRange(lo: v, hi: v)
        }
    }
    // DEFINE_VAR: declared symbolic variable bounds
    if op == DEFINE_VAR {
        return VRange(lo: node_var_min(cache: read cache, id: id), hi: node_var_max(cache: read cache, id: id))
    }
    // BIND: upstream range inference ignores the bound value and preserves the variable range.
    if op == BIND {
        if node_num_src(cache: read cache, id: id) == 2 {
            let var = node_src_id(cache: read cache, id: id, k: 0)
            return uop_min_max(cache: read cache, id: var)
        }
    }
    // PARAM: optional ParamArg.vmin_vmax bounds
    if op == PARAM {
        if node_param_has_vmin_vmax(cache: read cache, id: id) {
            return VRange(lo: node_param_vmin(cache: read cache, id: id), hi: node_param_vmax(cache: read cache, id: id))
        }
    }
    // SPECIAL/RANGE: [0, (src[0]-1).vmax] = [0, size_max - 1]
    if op == SPECIAL {
        if node_num_src(cache: read cache, id: id) == 1 {
            let szid = node_src_id(cache: read cache, id: id, k: 0)
            let rsz = uop_min_max(cache: read cache, id: szid)
            return VRange(lo: 0, hi: rsz.hi - 1)
        }
    }
    if op == RANGE {
        if node_num_src(cache: read cache, id: id) == 1 {
            let szid = node_src_id(cache: read cache, id: id, k: 0)
            let rsz = uop_min_max(cache: read cache, id: szid)
            return VRange(lo: 0, hi: rsz.hi - 1)
        }
    }
    // STACK/UNROLL: min/max over contained elements
    if op == STACK {
        let n = node_num_src(cache: read cache, id: id)
        if n > 0 {
            let first = node_src_id(cache: read cache, id: id, k: 0)
            let first_range = uop_min_max(cache: read cache, id: first)
            let mut lo = first_range.lo
            let mut hi = first_range.hi
            let mut i = 1
            while i < n {
                let child = node_src_id(cache: read cache, id: id, k: i)
                let cr = uop_min_max(cache: read cache, id: child)
                lo = imin2(a: lo, b: cr.lo)
                hi = imax2(a: hi, b: cr.hi)
                i = i + 1
            }
            return VRange(lo: lo, hi: hi)
        }
    }
    if op == UNROLL {
        if node_num_src(cache: read cache, id: id) == 1 {
            return uop_min_max(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
    }
    // binary integer ops
    if group_binary(op: read op) {
        if node_num_src(cache: read cache, id: id) == 2 {
            let s0 = node_src_id(cache: read cache, id: id, k: 0)
            let s1 = node_src_id(cache: read cache, id: id, k: 1)
            let r0 = uop_min_max(cache: read cache, id: s0)
            let r1 = uop_min_max(cache: read cache, id: s1)
            if op == ADD { return VRange(lo: sat_add_int(a: r0.lo, b: r1.lo), hi: sat_add_int(a: r0.hi, b: r1.hi)) }
            if op == SUB { return VRange(lo: sat_sub_int(a: r0.lo, b: r1.hi), hi: sat_sub_int(a: r0.hi, b: r1.lo)) }
            if op == MUL {
                let a = sat_mul_int(a: r0.lo, b: r1.lo)
                let b = sat_mul_int(a: r0.lo, b: r1.hi)
                let c = sat_mul_int(a: r0.hi, b: r1.lo)
                let e = sat_mul_int(a: r0.hi, b: r1.hi)
                return VRange(lo: imin4(a: a, b: b, c: c, d: e), hi: imax4(a: a, b: b, c: c, d: e))
            }
            if op == MAX { return VRange(lo: imax2(a: r0.lo, b: r1.lo), hi: imax2(a: r0.hi, b: r1.hi)) }
            if op == CMPLT {
                let lt_lo = r0.hi < r1.lo
                let lt_hi = r0.lo < r1.hi
                return VRange(lo: b2i(b: lt_lo), hi: b2i(b: lt_hi))
            }
        }
    }
    // default: full dtype range
    let dt = node_dtype(cache: read cache, id: id)
    return VRange(lo: dtype_imin(d: read dt), hi: dtype_imax(d: read dt))
}
