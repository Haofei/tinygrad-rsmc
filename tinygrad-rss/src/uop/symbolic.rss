    if node_op(cache: read cache, id: id) == BITCAST && node_num_src(cache: read cache, id: id) == 1 {
        let bc_src = node_src_id(cache: read cache, id: id, k: 0)
        match fold_bitcast(cache: mut cache, root: id, c: bc_src) {
