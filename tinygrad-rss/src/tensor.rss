fn tensor_nll_loss_none(cache: mut UOpCache, log_probs: Int, target: Int) -> Int {
    let idx = tensor_unsqueeze(cache: mut cache, x: target, dim: 1)
    let picked = tensor_gather(cache: mut cache, x: log_probs, dim: 1, index: idx)
    let squeezed = tensor_squeeze_dim(cache: mut cache, x: picked, dim: 1)
    return tensor_neg(cache: mut cache, x: squeezed)
}

fn tensor_nll_loss_mean(cache: mut UOpCache, log_probs: Int, target: Int) -> Int {
    let loss = tensor_nll_loss_none(cache: mut cache, log_probs: log_probs, target: target)
    return tensor_mean_all(cache: mut cache, x: loss)
}

fn tensor_cross_entropy_sparse_none(cache: mut UOpCache, logits: Int, target: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: logits)
    let classes = List.get<Int>(list: read sh, index: 1)
    let log_probs = tensor_log_softmax_axis(cache: mut cache, x: logits, axis: 1)
    let target_u = tensor_unsqueeze(cache: mut cache, x: target, dim: 1)
    let y = tensor_one_hot_along_dim(cache: mut cache, x: target_u, num_classes: classes, dim: 1)
    let yf = tensor_cast(cache: mut cache, x: y, dt: read node_dtype(cache: read cache, id: logits))
    let selected = tensor_mul(cache: mut cache, a: log_probs, b: yf)
    let summed = tensor_sum_axis(cache: mut cache, x: selected, axis: 1)
    return tensor_neg(cache: mut cache, x: summed)
}

fn tensor_cross_entropy_sparse_mean(cache: mut UOpCache, logits: Int, target: Int) -> Int {
    let loss = tensor_cross_entropy_sparse_none(cache: mut cache, logits: logits, target: target)
    return tensor_mean_all(cache: mut cache, x: loss)
}

fn tensor_cumprod_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: axis, extra: false)
    let n = List.get<Int>(list: read shape, index: d)
    let xt = tensor_transpose(cache: mut cache, x: x, dim0: d, dim1: 0 - 1)
    local tshape = uop_shape(cache: read cache, id: xt)
    local before = List.new<Int>()
    local after = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read tshape) {
        if i == List.len<Int>(list: read tshape) - 1 {
            push1(l: mut before, a: n - 1)
        } else {
            push1(l: mut before, a: 0)
        }
        push1(l: mut after, a: 0)
        i = i + 1
    }
    let xp = tensor_pad(cache: mut cache, x: xt, before: read before, after: read after)
    local one_shape = uop_shape(cache: read cache, id: xp)
    let one = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read one_shape, value: 1.0)
    local pad_mask_starts = List.new<Int>()
    local pad_mask_ends = List.new<Int>()
    let mut m = 0
    while m < List.len<Int>(list: read one_shape) {
        if m == List.len<Int>(list: read one_shape) - 1 {
            push1(l: mut pad_mask_starts, a: 0)
            push1(l: mut pad_mask_ends, a: n - 1)
        } else {
            push1(l: mut pad_mask_starts, a: 0)
            push1(l: mut pad_mask_ends, a: List.get<Int>(list: read one_shape, index: m))
        }
        m = m + 1
    }
    let one_pad = mk_shrink(cache: mut cache, x: one, starts: read pad_mask_starts, ends: read pad_mask_ends)
    local one_before = List.new<Int>()
    local one_after = List.new<Int>()
    let mut p = 0
    while p < List.len<Int>(list: read one_shape) {
        push1(l: mut one_before, a: 0)
        if p == List.len<Int>(list: read one_shape) - 1 {
            push1(l: mut one_after, a: List.get<Int>(list: read one_shape, index: p) - (n - 1))
        } else {
            push1(l: mut one_after, a: 0)
        }
        p = p + 1
    }
    let one_region = tensor_pad(cache: mut cache, x: one_pad, before: read one_before, after: read one_after)
    let xfilled = tensor_where(cache: mut cache, cond: one_region, x: one_region, y: xp)
    let pooled = tensor_pool1d_last(cache: mut cache, x: xfilled, size: n, step: 1)
    local pooled_shape = uop_shape(cache: read cache, id: pooled)
    let prodded = tensor_prod_axis(cache: mut cache, x: pooled, axis: List.len<Int>(list: read pooled_shape) - 1)
    return tensor_transpose(cache: mut cache, x: prodded, dim0: d, dim1: 0 - 1)
}

fn tensor_cummax_values_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: axis, extra: false)
    let n = List.get<Int>(list: read shape, index: d)
    let xt = tensor_transpose(cache: mut cache, x: x, dim0: d, dim1: 0 - 1)
    local tshape = uop_shape(cache: read cache, id: xt)
    local before = List.new<Int>()
    local after = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read tshape) {
        if i == List.len<Int>(list: read tshape) - 1 {
            push1(l: mut before, a: n - 1)
        } else {
            push1(l: mut before, a: 0)
        }
        push1(l: mut after, a: 0)
        i = i + 1
    }
    let xp = tensor_pad(cache: mut cache, x: xt, before: read before, after: read after)
    local fill_shape = uop_shape(cache: read cache, id: xp)
    let mask_full = tensor_full(cache: mut cache, dt: read dt_bool(), shape: read fill_shape, value: 1.0)
    let low_full = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read fill_shape, value: 0.0 - 1000000000000000000.0)
    local mask_starts = List.new<Int>()
    local mask_ends = List.new<Int>()
    let mut m = 0
    while m < List.len<Int>(list: read fill_shape) {
        push1(l: mut mask_starts, a: 0)
        if m == List.len<Int>(list: read fill_shape) - 1 {
            push1(l: mut mask_ends, a: n - 1)
        } else {
            push1(l: mut mask_ends, a: List.get<Int>(list: read fill_shape, index: m))
        }
        m = m + 1
    }
    let mask_left = mk_shrink(cache: mut cache, x: mask_full, starts: read mask_starts, ends: read mask_ends)
    let low_left = mk_shrink(cache: mut cache, x: low_full, starts: read mask_starts, ends: read mask_ends)
    local pad_before = List.new<Int>()
    local pad_after = List.new<Int>()
    let mut p = 0
    while p < List.len<Int>(list: read fill_shape) {
        push1(l: mut pad_before, a: 0)
        if p == List.len<Int>(list: read fill_shape) - 1 {
            push1(l: mut pad_after, a: List.get<Int>(list: read fill_shape, index: p) - (n - 1))
        } else {
            push1(l: mut pad_after, a: 0)
        }
        p = p + 1
    }
    let mask_region = tensor_pad(cache: mut cache, x: mask_left, before: read pad_before, after: read pad_after)
    let low_region = tensor_pad(cache: mut cache, x: low_left, before: read pad_before, after: read pad_after)
    let xfilled = tensor_where(cache: mut cache, cond: mask_region, x: low_region, y: xp)
    let pooled = tensor_pool1d_last(cache: mut cache, x: xfilled, size: n, step: 1)
    local pooled_shape = uop_shape(cache: read cache, id: pooled)
    let maxed = tensor_max_axis(cache: mut cache, x: pooled, axis: List.len<Int>(list: read pooled_shape) - 1)
    return tensor_transpose(cache: mut cache, x: maxed, dim0: d, dim1: 0 - 1)
}

fn tensor_arange_desc(cache: mut UOpCache, dt: read DType, start: Int, n: Int) -> Int {
    local shape = List.new<Int>()
    push1(l: mut shape, a: n)
    local data = List.new<Float>()
    let mut i = 0
    while i < n {
        pushf1(l: mut data, a: Int.to_float(value: read (start - i)))
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_ones_triu(cache: mut UOpCache, dt: read DType, n: Int) -> Int {
    local shape = List.new<Int>()
    push1(l: mut shape, a: n)
    push1(l: mut shape, a: n)
    local data = List.new<Float>()
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            if j >= i { pushf1(l: mut data, a: 1.0) }
            else { pushf1(l: mut data, a: 0.0) }
            j = j + 1
        }
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt, shape: read shape, data: read data)
}

fn tensor_cummax_indices_axis(cache: mut UOpCache, x: Int, values: Int, axis: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read shape)
    let d = tensor_resolve_dim(ndim: ndim, dim: axis, extra: false)
    let n = List.get<Int>(list: read shape, index: d)
    let xt = tensor_transpose(cache: mut cache, x: x, dim0: d, dim1: 0 - 1)
    let vt = tensor_transpose(cache: mut cache, x: values, dim0: d, dim1: 0 - 1)
    let xu = tensor_unsqueeze(cache: mut cache, x: xt, dim: 0 - 1)
    let vu = tensor_unsqueeze(cache: mut cache, x: vt, dim: 0 - 2)
    let eq = tensor_eq(cache: mut cache, a: xu, b: vu)
    let f32 = dt_float32()
    let eqf = tensor_cast(cache: mut cache, x: eq, dt: read f32)
    let tri = tensor_ones_triu(cache: mut cache, dt: read dt_float32(), n: n)
    let match_mask = tensor_mul(cache: mut cache, a: eqf, b: tri)
    let desc = tensor_arange_desc(cache: mut cache, dt: read dt_float32(), start: n, n: n)
    local dshape = List.new<Int>()
    push1(l: mut dshape, a: n)
    push1(l: mut dshape, a: 1)
    let desc_col = tensor_reshape(cache: mut cache, x: desc, new_shape: read dshape)
    let weighted = tensor_mul(cache: mut cache, a: match_mask, b: desc_col)
    local weighted_shape = uop_shape(cache: read cache, id: weighted)
    let maxed = tensor_max_axis(cache: mut cache, x: weighted, axis: List.len<Int>(list: read weighted_shape) - 2)
    let neg = tensor_neg(cache: mut cache, x: maxed)
    let ndt = node_dtype(cache: read cache, id: neg)
    let nconst = mk_const_float(cache: mut cache, dt: read ndt, v: Int.to_float(value: read n))
    let idxf = tensor_add(cache: mut cache, a: neg, b: nconst)
    let i32 = dt_int32()
    let idx = tensor_cast(cache: mut cache, x: idxf, dt: read i32)
    return tensor_transpose(cache: mut cache, x: idx, dim0: 0 - 1, dim1: d)
}

fn tensor_cummin_values_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    let nx = tensor_neg(cache: mut cache, x: x)
    let vmax = tensor_cummax_values_axis(cache: mut cache, x: nx, axis: axis)
    return tensor_neg(cache: mut cache, x: vmax)
}

fn tensor_cummin_indices_axis(cache: mut UOpCache, x: Int, values: Int, axis: Int) -> Int {
    let nx = tensor_neg(cache: mut cache, x: x)
    let nvalues = tensor_neg(cache: mut cache, x: values)
    return tensor_cummax_indices_axis(cache: mut cache, x: nx, values: nvalues, axis: axis)
}

fn shape_drop_axis(shape: read List<Int>, axis: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if i != axis {
            let d = List.get<Int>(list: read shape, index: i)
            push1(l: mut out, a: d)
        }
        i = i + 1
    }
    return take out
}

fn tensor_sum_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local sh0 = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read sh0), dim: axis, extra: false)
    local axes = List.new<Int>()
    push1(l: mut axes, a: d)
    let reduced = mk_sum(cache: mut cache, x: x, axes: read axes)
    local dropped = shape_drop_axis(shape: read sh0, axis: d)
    return mk_reshape(cache: mut cache, x: reduced, new_shape: read dropped)
}

fn axis_list_contains(axes: read List<Int>, axis: Int) -> Bool {
    let mut i = 0
    while i < List.len<Int>(list: read axes) {
        if List.get<Int>(list: read axes, index: i) == axis { return true }
        i = i + 1
    }
    return false
}

fn tensor_resolve_axes(ndim: Int, axes: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read axes) {
        let d = tensor_resolve_dim(ndim: ndim, dim: List.get<Int>(list: read axes, index: i), extra: false)
        if axis_list_contains(axes: read out, axis: d) == false { push1(l: mut out, a: d) }
        i = i + 1
    }
    return take out
}

fn shape_drop_axes(shape: read List<Int>, axes: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if axis_list_contains(axes: read axes, axis: i) == false {
            push1(l: mut out, a: List.get<Int>(list: read shape, index: i))
        }
        i = i + 1
    }
    return take out
}

fn shape_axes_numel(shape: read List<Int>, axes: read List<Int>) -> Int {
    let mut n = 1
    let mut i = 0
    while i < List.len<Int>(list: read axes) {
        n = n * List.get<Int>(list: read shape, index: List.get<Int>(list: read axes, index: i))
        i = i + 1
    }
    return n
}

fn tensor_sum_axes_keepdim(cache: mut UOpCache, x: Int, axes: read List<Int>) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    return mk_sum(cache: mut cache, x: x, axes: read resolved)
}

fn tensor_sum_axes(cache: mut UOpCache, x: Int, axes: read List<Int>) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    let reduced = mk_sum(cache: mut cache, x: x, axes: read resolved)
    local dropped = shape_drop_axes(shape: read sh, axes: read resolved)
    return mk_reshape(cache: mut cache, x: reduced, new_shape: read dropped)
}

fn tensor_sum_all(cache: mut UOpCache, x: Int) -> Int {
    let mut cur = x
    local sh = uop_shape(cache: read cache, id: x)
    let mut axis = List.len<Int>(list: read sh) - 1
    while axis >= 0 {
        cur = tensor_sum_axis(cache: mut cache, x: cur, axis: axis)
        axis = axis - 1
    }
    local scalar = List.new<Int>()
    return mk_reshape(cache: mut cache, x: cur, new_shape: read scalar)
}

fn tensor_mean_axis(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d_axis = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: axis, extra: false)
    let denom_i = List.get<Int>(list: read sh, index: d_axis)
    let denom = Int.to_float(value: read denom_i)
    let s = tensor_sum_axis(cache: mut cache, x: x, axis: d_axis)
    let dt = node_dtype(cache: read cache, id: x)
    let d = mk_const_float(cache: mut cache, dt: read dt, v: denom)
    return tensor_div(cache: mut cache, a: s, b: d)
}

fn tensor_mean_axis_keepdim(cache: mut UOpCache, x: Int, axis: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d_axis = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: axis, extra: false)
    let denom_i = List.get<Int>(list: read sh, index: d_axis)
    let denom = Int.to_float(value: read denom_i)
    let s = tensor_sum_axis_keepdim(cache: mut cache, x: x, axis: d_axis)
    let dt = node_dtype(cache: read cache, id: x)
    let d = mk_const_float(cache: mut cache, dt: read dt, v: denom)
    return tensor_div(cache: mut cache, a: s, b: d)
}

fn tensor_mean_axes_keepdim(cache: mut UOpCache, x: Int, axes: read List<Int>) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    let denom = Int.to_float(value: read shape_axes_numel(shape: read sh, axes: read resolved))
    let s = mk_sum(cache: mut cache, x: x, axes: read resolved)
    let dt = node_dtype(cache: read cache, id: x)
    let d = mk_const_float(cache: mut cache, dt: read dt, v: denom)
    return tensor_div(cache: mut cache, a: s, b: d)
}

fn tensor_mean_axes(cache: mut UOpCache, x: Int, axes: read List<Int>) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    let denom = Int.to_float(value: read shape_axes_numel(shape: read sh, axes: read resolved))
    let reduced = mk_sum(cache: mut cache, x: x, axes: read resolved)
    let dt = node_dtype(cache: read cache, id: x)
    let d = mk_const_float(cache: mut cache, dt: read dt, v: denom)
    let mean = tensor_div(cache: mut cache, a: reduced, b: d)
    local dropped = shape_drop_axes(shape: read sh, axes: read resolved)
    return mk_reshape(cache: mut cache, x: mean, new_shape: read dropped)
}

fn tensor_mean_all(cache: mut UOpCache, x: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let denom = Int.to_float(value: read numel(shape: read sh))
    let s = tensor_sum_all(cache: mut cache, x: x)
    let dt = node_dtype(cache: read cache, id: x)
    let d = mk_const_float(cache: mut cache, dt: read dt, v: denom)
    return tensor_div(cache: mut cache, a: s, b: d)
}

fn tensor_var_axis(cache: mut UOpCache, x: Int, axis: Int, correction: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d_axis = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: axis, extra: false)
    let m = tensor_mean_axis_keepdim(cache: mut cache, x: x, axis: d_axis)
    let centered = tensor_sub(cache: mut cache, a: x, b: m)
    let sq = tensor_square(cache: mut cache, x: centered)
    let reduced = tensor_sum_axis(cache: mut cache, x: sq, axis: d_axis)
    let n = Int.to_float(value: read List.get<Int>(list: read sh, index: d_axis))
    let denom = tensor_const_like_float(cache: mut cache, x: reduced, value: n - correction)
    let denom_pos = tensor_relu(cache: mut cache, x: denom)
    return tensor_div(cache: mut cache, a: reduced, b: denom_pos)
}

fn tensor_var_axes(cache: mut UOpCache, x: Int, axes: read List<Int>, correction: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    let m = tensor_mean_axes_keepdim(cache: mut cache, x: x, axes: read resolved)
    let centered = tensor_sub(cache: mut cache, a: x, b: m)
    let sq = tensor_square(cache: mut cache, x: centered)
    let reduced = tensor_sum_axes(cache: mut cache, x: sq, axes: read resolved)
    let n = Int.to_float(value: read shape_axes_numel(shape: read sh, axes: read resolved))
    let denom = tensor_const_like_float(cache: mut cache, x: reduced, value: n - correction)
    let denom_pos = tensor_relu(cache: mut cache, x: denom)
    return tensor_div(cache: mut cache, a: reduced, b: denom_pos)
}

fn tensor_var_axes_keepdim(cache: mut UOpCache, x: Int, axes: read List<Int>, correction: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    let m = tensor_mean_axes_keepdim(cache: mut cache, x: x, axes: read resolved)
    let centered = tensor_sub(cache: mut cache, a: x, b: m)
    let sq = tensor_square(cache: mut cache, x: centered)
    let reduced = mk_sum(cache: mut cache, x: sq, axes: read resolved)
    let n = Int.to_float(value: read shape_axes_numel(shape: read sh, axes: read resolved))
    let denom = tensor_const_like_float(cache: mut cache, x: reduced, value: n - correction)
    let denom_pos = tensor_relu(cache: mut cache, x: denom)
    return tensor_div(cache: mut cache, a: reduced, b: denom_pos)
}

fn tensor_var_all(cache: mut UOpCache, x: Int, correction: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let m = tensor_mean_all(cache: mut cache, x: x)
    let centered = tensor_sub(cache: mut cache, a: x, b: m)
    let sq = tensor_square(cache: mut cache, x: centered)
    let reduced = tensor_sum_all(cache: mut cache, x: sq)
    let n = Int.to_float(value: read numel(shape: read sh))
    let denom = tensor_const_like_float(cache: mut cache, x: reduced, value: n - correction)
    let denom_pos = tensor_relu(cache: mut cache, x: denom)
    return tensor_div(cache: mut cache, a: reduced, b: denom_pos)
}

fn tensor_var_mean_axis(cache: mut UOpCache, x: Int, axis: Int, correction: Float) -> fresh TensorPair {
    let v = tensor_var_axis(cache: mut cache, x: x, axis: axis, correction: correction)
