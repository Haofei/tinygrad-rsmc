fn rangeify_pos(ids: read List<Int>, id: Int) -> Int {
    let mut i = 0
    while i < List.len<Int>(list: read ids) {
        if List.get<Int>(list: read ids, index: i) == id { return i }
        i = i + 1
    }
    return 0 - 1
}

fn rangeify_add_unique_id(ids: mut List<Int>, id: Int) -> Unit {
    if rangeify_pos(ids: read ids, id: id) < 0 { List.push<Int>(list: mut ids, value: read id) }
    return Unit
}

fn rangeify_debuf_for_arg(cache: mut UOpCache, ctx: mut RangeifyLocalContext, key: Int, arg: Int, olds: mut List<Int>, news: mut List<Int>, args: mut List<Int>) -> Int {
    let found = rangeify_pos(ids: read olds, id: key)
    if found >= 0 { return List.get<Int>(list: read news, index: found) }
    local max_shape = uop_max_shape(cache: read cache, id: key)
    local shape = uop_shape(cache: read cache, id: key)
    let mut devices = List.new<String>()
    if node_op(cache: read cache, id: key) == PARAM {
        devices = node_param_devices(cache: read cache, id: key)
    }
    let mut addr = ADDR_GLOBAL
    if node_op(cache: read cache, id: key) == PARAM {
        addr = node_param_addrspace(cache: read cache, id: key)
    }
    let p = mk_param_devices_full(cache: mut cache, slot: ctx.next_lunique, dt: read node_full_dtype(cache: read cache, id: key),
                                  shape: read max_shape, name: read "", has_vmin_vmax: false, vmin: 0, vmax: 0,
                                  addrspace: read addr, devices: read devices)
    let mut ret = p
    if indexing_shape_equals(a: read max_shape, b: read shape) == false {
        local starts = List.new<Int>()
        local ends = List.new<Int>()
        let weak = dt_weakint()
        let mut si = 0
        while si < List.len<Int>(list: read shape) {
            let zero = mk_const_int(cache: mut cache, dt: read weak, v: 0)
            let end = mk_const_int(cache: mut cache, dt: read weak, v: List.get<Int>(list: read shape, index: si))
            List.push<Int>(list: mut starts, value: read zero)
            List.push<Int>(list: mut ends, value: read end)
            si = si + 1
        }
        ret = mk_shrink_expr(cache: mut cache, x: p, starts: read starts, ends: read ends)
    }
    ctx.next_lunique = ctx.next_lunique + 1
    List.push<Int>(list: mut olds, value: read key)
    List.push<Int>(list: mut news, value: read ret)
    List.push<Int>(list: mut args, value: read arg)
    return ret
}

fn rangeify_kernel_rewrite(cache: mut UOpCache, ctx: mut RangeifyLocalContext, id: Int, olds: mut List<Int>, news: mut List<Int>, args: mut List<Int>, vars: mut List<Int>) -> Int {
    let memo = rangeify_pos(ids: read olds, id: id)
    if memo >= 0 { return List.get<Int>(list: read news, index: memo) }
    local srcs = List.new<Int>()
    let mut changed = false
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        let rewritten = rangeify_kernel_rewrite(cache: mut cache, ctx: mut ctx, id: child, olds: mut olds, news: mut news, args: mut args, vars: mut vars)
        if rewritten != child { changed = true }
        List.push<Int>(list: mut srcs, value: read rewritten)
        i = i + 1
    }
    let op = node_op(cache: read cache, id: id)
    let mut cur = id
    if changed {
        local arg = node_arg(cache: read cache, id: id)
        cur = intern(cache: mut cache, op: op.clone(), dt: read node_full_dtype(cache: read cache, id: id), src: take srcs, arg: take arg)
    }

    if op == CONTIGUOUS && node_num_src(cache: read cache, id: cur) > 0 {
        cur = node_src_id(cache: read cache, id: cur, k: 0)
    } else if op == NOOP && node_num_src(cache: read cache, id: cur) > 0 {
        cur = node_src_id(cache: read cache, id: cur, k: 0)
    } else if op == BIND && node_num_src(cache: read cache, id: cur) > 0 {
        rangeify_add_unique_id(ids: mut vars, id: id)
        cur = node_src_id(cache: read cache, id: cur, k: 0)
    } else if op == INDEX && node_num_src(cache: read cache, id: cur) == 1 && node_op(cache: read cache, id: node_src_id(cache: read cache, id: cur, k: 0)) == DEFINE_VAR {
        cur = node_src_id(cache: read cache, id: cur, k: 0)
    } else if op == AFTER && node_num_src(cache: read cache, id: cur) > 0 {
        let buf = uop_buf_uop(cache: mut cache, id: id)
        cur = rangeify_debuf_for_arg(cache: mut cache, ctx: mut ctx, key: buf, arg: id, olds: mut olds, news: mut news, args: mut args)
    } else if op == BUFFER {
        cur = rangeify_debuf_for_arg(cache: mut cache, ctx: mut ctx, key: id, arg: id, olds: mut olds, news: mut news, args: mut args)
    } else if op == PARAM && String.len(value: read node_param_name(cache: read cache, id: id)) == 0 && List.len<Int>(list: read uop_shape(cache: read cache, id: id)) > 0 {
        cur = rangeify_debuf_for_arg(cache: mut cache, ctx: mut ctx, key: id, arg: id, olds: mut olds, news: mut news, args: mut args)
    } else if op == PARAM && String.len(value: read node_param_name(cache: read cache, id: id)) > 0 && node_param_has_vmin_vmax(cache: read cache, id: id) {
        cur = mk_define_var(cache: mut cache, name: read node_param_name(cache: read cache, id: id), min_val: node_param_vmin(cache: read cache, id: id), max_val: node_param_vmax(cache: read cache, id: id), dt: read node_dtype(cache: read cache, id: id))
    } else if op == RANGE {
        match renumber_range(cache: mut cache, ctx: mut ctx, r: cur) {
            Some(r) => { cur = r }
            None => {}
        }
    } else if op == CONST && node_num_src(cache: read cache, id: cur) > 0 {
        local empty = List.new<Int>()
        local arg = node_arg(cache: read cache, id: cur)
        cur = intern(cache: mut cache, op: CONST, dt: read node_full_dtype(cache: read cache, id: cur), src: take empty, arg: take arg)
    } else if op == STAGE {
        local no_dev = mk_bufferize_arg_none(addrspace: read node_bufferize_addrspace(cache: read cache, id: cur), removable: node_bufferize_removable(cache: read cache, id: cur))
        local st_src = uop_copy_src(cache: read cache, id: cur)
        local st_arg = ArgBufferize(value: no_dev)
        cur = intern(cache: mut cache, op: STAGE, dt: read node_full_dtype(cache: read cache, id: cur), src: take st_src, arg: take st_arg)
    }

    List.push<Int>(list: mut olds, value: read id)
    List.push<Int>(list: mut news, value: read cur)
    return cur
}

