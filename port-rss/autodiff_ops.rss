// Widen the ported autodiff with more ALU vjp rules (symbolic, building gradient UOp graphs):
//   d(-a)   = -da                 (adjoint into a: -g)
//   d(exp a)= exp(a)*da           (adjoint: g*exp(a))
//   d(log a)= da/a                (adjoint: g/a)
//   d(a/b)  = da/b - a*db/b^2     (adjoint into a: g/b; into b: -(g*a)/(b*b))
//   d(a+b),(a*b) as before. Validated by the gradient graph's structure.

features: local

sum Ops derives(Clone, Eq, Hash) { Const Var Add Mul Div Neg Exp Log }
struct UOp derives(Clone, Eq, Hash) {
    op: Ops
    src: List<UOp>
    arg: Int
}

fn uconst(v: Int) -> fresh UOp { return UOp(op: Const, src: List.new<UOp>(), arg: v) }
fn uvar(id: Int) -> fresh UOp { return UOp(op: Var, src: List.new<UOp>(), arg: id) }
fn uadd(a: read UOp, b: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    List.push(list: mut s, value: read b)
    return UOp(op: Add, src: take s, arg: 0)
}
fn umul(a: read UOp, b: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    List.push(list: mut s, value: read b)
    return UOp(op: Mul, src: take s, arg: 0)
}
fn udiv(a: read UOp, b: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    List.push(list: mut s, value: read b)
    return UOp(op: Div, src: take s, arg: 0)
}
fn uneg(a: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    return UOp(op: Neg, src: take s, arg: 0)
}
fn uexp(a: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    return UOp(op: Exp, src: take s, arg: 0)
}
fn ulog(a: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    return UOp(op: Log, src: take s, arg: 0)
}

fn is_const(u: read UOp) -> Bool { return u.op == Const }
fn is_unary(u: read UOp) -> Bool {
    if u.op == Neg { return true }
    if u.op == Exp { return true }
    if u.op == Log { return true }
    return false
}

fn clone_uop(u: read UOp) -> fresh UOp {
    if u.op == Const { return uconst(v: u.arg) }
    if u.op == Var { return uvar(id: u.arg) }
    let c0 = List.get(list: read u.src, index: 0)
    if u.op == Neg { return uneg(a: read clone_uop(u: read c0)) }
    if u.op == Exp { return uexp(a: read clone_uop(u: read c0)) }
    if u.op == Log { return ulog(a: read clone_uop(u: read c0)) }
    let c1 = List.get(list: read u.src, index: 1)
    if u.op == Add { return uadd(a: read clone_uop(u: read c0), b: read clone_uop(u: read c1)) }
    if u.op == Div { return udiv(a: read clone_uop(u: read c0), b: read clone_uop(u: read c1)) }
    return umul(a: read clone_uop(u: read c0), b: read clone_uop(u: read c1))
}

// minimal simplify: fold 1*x -> x, x*1 -> x (enough to clean exp/log grads)
fn simplify(u: read UOp) -> fresh UOp {
    if u.op == Const { return uconst(v: u.arg) }
    if u.op == Var { return uvar(id: u.arg) }
    let c0 = List.get(list: read u.src, index: 0)
    if u.op == Neg { return uneg(a: read simplify(u: read c0)) }
    if u.op == Exp { return uexp(a: read simplify(u: read c0)) }
    if u.op == Log { return ulog(a: read simplify(u: read c0)) }
    let c1 = List.get(list: read u.src, index: 1)
    let a = simplify(u: read c0)
    let b = simplify(u: read c1)
    if u.op == Mul {
        if is_const(u: read a) {
            if a.arg == 1 { return simplify(u: read c1) }
        }
        if is_const(u: read b) {
            if b.arg == 1 { return simplify(u: read c0) }
        }
        return umul(a: read a, b: read b)
    }
    if u.op == Div { return udiv(a: read a, b: read b) }
    return uadd(a: read a, b: read b)
}

fn grad_wrt(node: read UOp, g: read UOp, target: Int) -> fresh UOp {
    if node.op == Const { return uconst(v: 0) }
    if node.op == Var {
        if node.arg == target { return clone_uop(u: read g) }
        return uconst(v: 0)
    }
    let c0 = List.get(list: read node.src, index: 0)
    if node.op == Neg { return grad_wrt(node: read c0, g: read uneg(a: read g), target: target) }
    if node.op == Exp {
        let adj = umul(a: read g, b: read uexp(a: read clone_uop(u: read c0)))
        return grad_wrt(node: read c0, g: read adj, target: target)
    }
    if node.op == Log {
        let adj = udiv(a: read g, b: read clone_uop(u: read c0))
        return grad_wrt(node: read c0, g: read adj, target: target)
    }
    let c1 = List.get(list: read node.src, index: 1)
    if node.op == Add {
        let ga = grad_wrt(node: read c0, g: read g, target: target)
        let gb = grad_wrt(node: read c1, g: read g, target: target)
        return uadd(a: read ga, b: read gb)
    }
    if node.op == Div {
        // d(a/b): a gets g/b ; b gets -(g*a)/(b*b)
        let adj_a = udiv(a: read g, b: read clone_uop(u: read c1))
        let ga = grad_wrt(node: read c0, g: read adj_a, target: target)
        let num = umul(a: read g, b: read clone_uop(u: read c0))
        let den = umul(a: read clone_uop(u: read c1), b: read clone_uop(u: read c1))
        let adj_b = uneg(a: read udiv(a: read num, b: read den))
        let gb = grad_wrt(node: read c1, g: read adj_b, target: target)
        return uadd(a: read ga, b: read gb)
    }
    // Mul
    let gb_adj = umul(a: read g, b: read c1)
    let ga = grad_wrt(node: read c0, g: read gb_adj, target: target)
    let ga_adj = umul(a: read g, b: read c0)
    let gb = grad_wrt(node: read c1, g: read ga_adj, target: target)
    return uadd(a: read ga, b: read gb)
}

fn op_name(u: read UOp) -> fresh String {
    if u.op == Const { return "Const" }
    if u.op == Var { return "Var" }
    if u.op == Add { return "Add" }
    if u.op == Mul { return "Mul" }
    if u.op == Div { return "Div" }
    if u.op == Neg { return "Neg" }
    if u.op == Exp { return "Exp" }
    return "Log"
}
fn describe(label: read String, u: read UOp) -> Unit {
    Log.write(message: read String.concat(left: read label, right: read op_name(u: read u)))
    return Unit
}

fn main() -> Unit {
    let one = uconst(v: 1)
    // d(exp(x))/dx = exp(x)  -> root Exp
    let g1 = simplify(u: read grad_wrt(node: read uexp(a: read uvar(id: 7)), g: read one, target: 7))
    describe(label: read "d(exp(x))/dx root = ", u: read g1)                              // Exp
    // d(log(x))/dx = 1/x  -> Div(Const1, Var)
    let g2 = simplify(u: read grad_wrt(node: read ulog(a: read uvar(id: 7)), g: read one, target: 7))
    describe(label: read "d(log(x))/dx root = ", u: read g2)                              // Div
    let g2l = List.get(list: read g2.src, index: 0)
    let g2r = List.get(list: read g2.src, index: 1)
    describe(label: read "  num = ", u: read g2l)                                          // Const(1)
    describe(label: read "  den = ", u: read g2r)                                          // Var
    // d(-x)/dx = -1  -> Neg(Const1)
    let g3 = simplify(u: read grad_wrt(node: read uneg(a: read uvar(id: 7)), g: read one, target: 7))
    describe(label: read "d(-x)/dx root = ", u: read g3)                                   // Neg
    // d(x / c)/dx with c=Var(9) treated as another var: a gets g/b -> Div(1, Var9)
    let g4 = simplify(u: read grad_wrt(node: read udiv(a: read uvar(id: 7), b: read uvar(id: 9)), g: read one, target: 7))
    describe(label: read "d(x/y)/dx root = ", u: read g4)                                  // Div
    return Unit
}
