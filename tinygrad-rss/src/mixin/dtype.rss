// Source-shaped DTypeMixin wrappers over tensor dtype helpers.
features: local

struct DTypeMixin derives(Clone) {
    tensor_id: Int,
}

fn mixin_dtype_package_marker() -> fresh String { return String.copy(value: read "mixin.dtype") }

fn mixin_dtype_element_size(cache: read UOpCache, x: Int) -> Int {
    return element_size(cache: read cache, x: x)
}

fn mixin_dtype_is_floating_point(cache: read UOpCache, x: Int) -> Bool {
    return is_floating_point(cache: read cache, x: x)
}

fn mixin_dtype_float(cache: mut UOpCache, x: Int) -> Int { return float(cache: mut cache, x: x) }
fn mixin_dtype_half(cache: mut UOpCache, x: Int) -> Int { return half(cache: mut cache, x: x) }
fn mixin_dtype_int(cache: mut UOpCache, x: Int) -> Int { return int(cache: mut cache, x: x) }
fn mixin_dtype_bool(cache: mut UOpCache, x: Int) -> Int { return tensor_cast(cache: mut cache, x: x, dt: read dt_bool()) }
fn mixin_dtype_bfloat16(cache: mut UOpCache, x: Int) -> Int { return bfloat16(cache: mut cache, x: x) }
fn mixin_dtype_double(cache: mut UOpCache, x: Int) -> Int { return double(cache: mut cache, x: x) }
fn mixin_dtype_long(cache: mut UOpCache, x: Int) -> Int { return long(cache: mut cache, x: x) }
fn mixin_dtype_short(cache: mut UOpCache, x: Int) -> Int { return short(cache: mut cache, x: x) }
fn mixin_dtype_cast(cache: mut UOpCache, x: Int, dt: read DType) -> Int { return tensor_cast(cache: mut cache, x: x, dt: read dt) }
fn mixin_dtype_dtype(cache: read UOpCache, x: Int) -> fresh DType { return tensor_dtype(cache: read cache, x: x) }
fn mixin_dtype_is_bool(cache: read UOpCache, x: Int) -> Bool { return dtype_is_bool(d: read tensor_dtype(cache: read cache, x: x)) }
fn mixin_dtype_is_int(cache: read UOpCache, x: Int) -> Bool { return dtype_is_int(d: read tensor_dtype(cache: read cache, x: x)) }
