fn tensor_argmax_axis(cache: mut UOpCache, x: Int, axis: Int, keepdim: Bool) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read sh)
    let d = tensor_resolve_dim(ndim: ndim, dim: axis, extra: false)
    let n = List.get<Int>(list: read sh, index: d)
    let max_keep = tensor_max_axis_keepdim(cache: mut cache, x: x, axis: d)
    let m = tensor_eq(cache: mut cache, a: x, b: max_keep)
    let mf = tensor_cast(cache: mut cache, x: m, dt: read dt_float32())
    let desc = tensor_arange_desc(cache: mut cache, dt: read dt_float32(), start: n, n: n)
    local dshape = List.new<Int>()
    push1(l: mut dshape, a: n)
    let mut i = d + 1
    while i < ndim {
        push1(l: mut dshape, a: 1)
        i = i + 1
    }
    let desc_view = tensor_reshape(cache: mut cache, x: desc, new_shape: read dshape)
    let weighted = tensor_mul(cache: mut cache, a: mf, b: desc_view)
    if keepdim {
        let idx_desc = tensor_max_axis_keepdim(cache: mut cache, x: weighted, axis: d)
        let ndt = node_dtype(cache: read cache, id: idx_desc)
        let nconst = mk_const_float(cache: mut cache, dt: read ndt, v: Int.to_float(value: read n))
        let idx = tensor_sub(cache: mut cache, a: nconst, b: idx_desc)
        return tensor_cast(cache: mut cache, x: idx, dt: read dt_int32())
    }
    let idx_desc = tensor_max_axis(cache: mut cache, x: weighted, axis: d)
    let ndt = node_dtype(cache: read cache, id: idx_desc)
    let nconst = mk_const_float(cache: mut cache, dt: read ndt, v: Int.to_float(value: read n))
    let idx = tensor_sub(cache: mut cache, a: nconst, b: idx_desc)
    return tensor_cast(cache: mut cache, x: idx, dt: read dt_int32())
}

fn tensor_argmax_all(cache: mut UOpCache, x: Int) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read sh)
    if ndim == 0 { return tensor_cast(cache: mut cache, x: x, dt: read dt_int32()) }
    let flat = tensor_flatten(cache: mut cache, x: x, start_dim: 0, end_dim: ndim - 1)
    return tensor_argmax_axis(cache: mut cache, x: flat, axis: 0, keepdim: false)
}

