    if d <= 0 { return None }
    let dt = node_full_dtype(cache: read cache, id: x)
    let dc = mk_const_int(cache: mut cache, dt: read dt, v: d)
    let div = mk_alu2(cache: mut cache, op: CDIV, dt: read dt, x: x, y: dc)
    return decomp_cdiv_pow2_to_shr(cache: mut cache, id: div)
}

