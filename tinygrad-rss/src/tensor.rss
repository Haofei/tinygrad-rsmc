fn tensor_upsample2d_zeros_nchw(cache: mut UOpCache, x: Int, sh: Int, sw: Int) -> Int {
    if sh == 1 {
        if sw == 1 { return x }
    }
    local xs = uop_shape(cache: read cache, id: x)
    let bs = List.get<Int>(list: read xs, index: 0)
    let c = List.get<Int>(list: read xs, index: 1)
    let h = List.get<Int>(list: read xs, index: 2)
    let w = List.get<Int>(list: read xs, index: 3)
    local rshape = List.new<Int>()
    push1(l: mut rshape, a: bs)
    push1(l: mut rshape, a: c)
    push1(l: mut rshape, a: h)
    push1(l: mut rshape, a: 1)
    push1(l: mut rshape, a: w)
    push1(l: mut rshape, a: 1)
    let xr = tensor_reshape(cache: mut cache, x: x, new_shape: read rshape)
    local before = List.new<Int>()
    push1(l: mut before, a: 0)
    push1(l: mut before, a: 0)
    push1(l: mut before, a: 0)
    push1(l: mut before, a: 0)
    push1(l: mut before, a: 0)
    push1(l: mut before, a: 0)
    local after = List.new<Int>()
    push1(l: mut after, a: 0)
    push1(l: mut after, a: 0)
    push1(l: mut after, a: 0)
    push1(l: mut after, a: sh - 1)
    push1(l: mut after, a: 0)
    push1(l: mut after, a: sw - 1)
    let xp = tensor_pad_constant(cache: mut cache, x: xr, before: read before, after: read after, value: 0.0)
    local pshape = List.new<Int>()
    push1(l: mut pshape, a: bs)
    push1(l: mut pshape, a: c)
    push1(l: mut pshape, a: h * sh)
    push1(l: mut pshape, a: w * sw)
    let xpr = tensor_reshape(cache: mut cache, x: xp, new_shape: read pshape)
    local out_shape = List.new<Int>()
    push1(l: mut out_shape, a: bs)
    push1(l: mut out_shape, a: c)
    push1(l: mut out_shape, a: h * sh - (sh - 1))
    push1(l: mut out_shape, a: w * sw - (sw - 1))
    return tensor_shrink_to(cache: mut cache, x: xpr, new_shape: read out_shape)
}

fn tensor_conv_transpose2d_weight_nchw(cache: mut UOpCache, weight: Int, groups: Int) -> Int {
    local ws = uop_shape(cache: read cache, id: weight)
    let cin_total = List.get<Int>(list: read ws, index: 0)
    let cout_per_group = List.get<Int>(list: read ws, index: 1)
    let kh = List.get<Int>(list: read ws, index: 2)
    let kw = List.get<Int>(list: read ws, index: 3)
    let cin_per_group = cin_total / groups
    local unflat = List.new<Int>()
    push1(l: mut unflat, a: groups)
    push1(l: mut unflat, a: cin_per_group)
    let w0 = tensor_unflatten(cache: mut cache, x: weight, dim: 0, sizes: read unflat)
    let w1 = tensor_transpose(cache: mut cache, x: w0, dim0: 1, dim1: 2)
    local axes = List.new<Int>()
    push1(l: mut axes, a: 3)
    push1(l: mut axes, a: 4)
    let w2 = tensor_flip(cache: mut cache, x: w1, axes: read axes)
    local out_shape = List.new<Int>()
    push1(l: mut out_shape, a: groups * cout_per_group)
    push1(l: mut out_shape, a: cin_per_group)
    push1(l: mut out_shape, a: kh)
    push1(l: mut out_shape, a: kw)
    return tensor_reshape(cache: mut cache, x: w2, new_shape: read out_shape)
}

fn tensor_conv_transpose2d_nchw_groups_dilated(cache: mut UOpCache, x: Int, weight: Int, groups: Int, sh: Int, sw: Int, dh: Int, dw: Int, pad_top: Int, pad_bottom: Int, pad_left: Int, pad_right: Int, out_pad_h: Int, out_pad_w: Int) -> Int {
    local ws = uop_shape(cache: read cache, id: weight)
    let kh = List.get<Int>(list: read ws, index: 2)
    let kw = List.get<Int>(list: read ws, index: 3)
    let xu = tensor_upsample2d_zeros_nchw(cache: mut cache, x: x, sh: sh, sw: sw)
    let wt = tensor_conv_transpose2d_weight_nchw(cache: mut cache, weight: weight, groups: groups)
    let conv_pad_top = (kh - 1) * dh - pad_top
    let conv_pad_bottom = (kh - 1) * dh - pad_bottom + out_pad_h
    let conv_pad_left = (kw - 1) * dw - pad_left
    let conv_pad_right = (kw - 1) * dw - pad_right + out_pad_w
    return tensor_conv2d_nchw_groups_pad_dilated(cache: mut cache, x: xu, weight: wt, groups: groups, sh: 1, sw: 1, dh: dh, dw: dw, pad_top: conv_pad_top, pad_bottom: conv_pad_bottom, pad_left: conv_pad_left, pad_right: conv_pad_right)
}

