// Phase-2 vertical slice: the FRONTEND, in rsscript, emitting modern-c kernel source.
//
// This is the rss-side counterpart of oracle/mc_renderer.py. It renders an elementwise
// binary float kernel to the exact MC convention proven in Phase 1 (PAddr params, an
// `unsafe` block, `raw.load/store<f32>` via `pa_offset`, a `while` loop). It proves the
// rss frontend can drive the mc backend: `rss run` -> MC text -> mcc -> clang -> native.
//
// NOTE: a fully general UOp-graph renderer needs to carry the heterogeneous `UOp.arg`,
// which rss v0.6 cannot CONSTRUCT for sum-payload variants (RS0206 — see docs/ARCHITECTURE
// "rss frontend finding" / task #5). This slice therefore parameterizes the kernel
// (name, size, op symbol) directly, which is enough to round-trip through the backend.

// Join string parts into one line (concat over a list).
fn line(parts: read List<String>) -> String {
    return String.join(parts: read parts, separator: read "")
}

fn push_line(lines: mut List<String>, text: read String) -> Unit {
    List.push(list: mut lines, value: read text)
    return Unit
}

// Render an elementwise binary kernel: out[i] = in0[i] <op> in1[i], for i in 0..n.
fn render_binary(name: read String, n: Int, op: read String) -> String {
    let lines = List.new<String>()
    let nstr = String.from_int(value: n)

    push_line(lines: mut lines, text: read "import \"std/addr.mc\";")
    push_line(lines: mut lines, text: read "")

    let header_parts = List.new<String>()
    List.push(list: mut header_parts, value: read "export fn ")
    List.push(list: mut header_parts, value: read name)
    List.push(list: mut header_parts, value: read "(data0: PAddr, data1: PAddr, data2: PAddr) -> void {")
    push_line(lines: mut lines, text: read line(parts: read header_parts))

    push_line(lines: mut lines, text: read "  unsafe {")
    push_line(lines: mut lines, text: read "    var Lidx0: usize = 0;")

    let cond_parts = List.new<String>()
    List.push(list: mut cond_parts, value: read "    while Lidx0 < ")
    List.push(list: mut cond_parts, value: read nstr)
    List.push(list: mut cond_parts, value: read " {")
    push_line(lines: mut lines, text: read line(parts: read cond_parts))

    push_line(lines: mut lines, text: read "      let val0: f32 = raw.load<f32>(pa_offset(data1, (Lidx0) * 4));")
    push_line(lines: mut lines, text: read "      let val1: f32 = raw.load<f32>(pa_offset(data2, (Lidx0) * 4));")

    let store_parts = List.new<String>()
    List.push(list: mut store_parts, value: read "      raw.store<f32>(pa_offset(data0, (Lidx0) * 4), (val0")
    List.push(list: mut store_parts, value: read op)
    List.push(list: mut store_parts, value: read "val1));")
    push_line(lines: mut lines, text: read line(parts: read store_parts))

    push_line(lines: mut lines, text: read "      Lidx0 = Lidx0 + 1;")
    push_line(lines: mut lines, text: read "    }")
    push_line(lines: mut lines, text: read "  }")
    push_line(lines: mut lines, text: read "}")

    return String.join(parts: read lines, separator: read "\n")
}

fn main() -> Unit {
    let kernel = render_binary(name: read "E_8", n: 8, op: read "+")
    Log.write(message: read kernel)
    return Unit
}
