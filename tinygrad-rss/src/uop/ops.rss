// shape_to_shape_arg: encode an all-int shape as a CONST vector node (tinygrad uses weakint.vec)
fn shape_to_shape_arg(cache: mut UOpCache, dims: read List<Int>) -> Int {
    let weak = dt_weakint()
    let dt = dtype_vec(base: read weak, sz: List.len<Int>(list: read dims))
    local e = List.new<Int>()
    local d = copy_int_list(l: read dims)
    local a = ArgInts(values: take d)
    return intern(cache: mut cache, op: CONST, dt: read dt, src: take e, arg: take a)
}

// a BUFFER leaf carrying its shape as src[0] (a shape-const)
fn mk_buffer(cache: mut UOpCache, dt: read DType, shape: read List<Int>) -> Int {
    let sh = shape_to_shape_arg(cache: mut cache, dims: read shape)
    local e = List.new<Int>()
    List.push<Int>(list: mut e, value: read sh)
    local a = ArgNone
    return intern(cache: mut cache, op: BUFFER, dt: read dt, src: take e, arg: take a)
}

// RESHAPE/EXPAND: src[1] = the target shape-const
fn mk_reshape(cache: mut UOpCache, x: Int, new_shape: read List<Int>) -> Int {
    let dt = node_full_dtype(cache: read cache, id: x)
    let sh = shape_to_shape_arg(cache: mut cache, dims: read new_shape)
    local e = List.new<Int>()
    List.push<Int>(list: mut e, value: read x)
    List.push<Int>(list: mut e, value: read sh)
    local a = ArgNone
    return intern(cache: mut cache, op: RESHAPE, dt: read dt, src: take e, arg: take a)
}
