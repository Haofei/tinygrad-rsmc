fn tensor_normalize(cache: mut UOpCache, x: Int, p: Float, dim: Int, eps: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: dim, extra: false)
    if p == 0.0 {
        let zero = tensor_const_like_float(cache: mut cache, x: x, value: 0.0)
        let nz = tensor_ne(cache: mut cache, a: x, b: zero)
        let nzf = tensor_cast(cache: mut cache, x: nz, dt: read node_dtype(cache: read cache, id: x))
        let cnt = tensor_sum_axis_keepdim(cache: mut cache, x: nzf, axis: d)
        let epsc = tensor_const_like_float(cache: mut cache, x: cnt, value: eps)
        let denom0 = tensor_maximum(cache: mut cache, a: cnt, b: epsc)
        return tensor_div(cache: mut cache, a: x, b: denom0)
    }
    let ax = tensor_abs(cache: mut cache, x: x)
    let pc = tensor_const_like_float(cache: mut cache, x: x, value: p)
    let powered = tensor_pow(cache: mut cache, a: ax, b: pc)
    let summed = tensor_sum_axis_keepdim(cache: mut cache, x: powered, axis: d)
    let invp = tensor_const_like_float(cache: mut cache, x: summed, value: 1.0 / p)
    let norm = tensor_pow(cache: mut cache, a: summed, b: invp)
    let epsc = tensor_const_like_float(cache: mut cache, x: norm, value: eps)
    let denom = tensor_maximum(cache: mut cache, a: norm, b: epsc)
    return tensor_div(cache: mut cache, a: x, b: denom)
}

fn tensor_layernorm_axis(cache: mut UOpCache, x: Int, axis: Int, eps: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let d = tensor_resolve_dim(ndim: List.len<Int>(list: read sh), dim: axis, extra: false)
    let m = tensor_mean_axis_keepdim(cache: mut cache, x: x, axis: d)
    let y = tensor_sub(cache: mut cache, a: x, b: m)
    let yy = tensor_mul(cache: mut cache, a: y, b: y)
    let v = tensor_mean_axis_keepdim(cache: mut cache, x: yy, axis: d)
    let epsc = tensor_const_like_float(cache: mut cache, x: v, value: eps)
    let denom = tensor_add(cache: mut cache, a: v, b: epsc)
    let inv = tensor_rsqrt(cache: mut cache, x: denom)
    return tensor_mul(cache: mut cache, a: y, b: inv)
}

fn tensor_layernorm_axes(cache: mut UOpCache, x: Int, axes: read List<Int>, eps: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    let m = tensor_mean_axes_keepdim(cache: mut cache, x: x, axes: read resolved)
    let y = tensor_sub(cache: mut cache, a: x, b: m)
    let yy = tensor_mul(cache: mut cache, a: y, b: y)
    let v = tensor_mean_axes_keepdim(cache: mut cache, x: yy, axes: read resolved)
    let epsc = tensor_const_like_float(cache: mut cache, x: v, value: eps)
    let denom = tensor_add(cache: mut cache, a: v, b: epsc)
    let inv = tensor_rsqrt(cache: mut cache, x: denom)
    return tensor_mul(cache: mut cache, a: y, b: inv)
}

fn tensor_shape_for_axes(shape: read List<Int>, axes: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if axis_list_contains(axes: read axes, axis: i) {
            push1(l: mut out, a: List.get<Int>(list: read shape, index: i))
        } else {
            push1(l: mut out, a: 1)
        }
        i = i + 1
    }
    return take out
}

fn tensor_batchnorm_basic(cache: mut UOpCache, x: Int, weight: Int, bias: Int, mean: Int, invstd: Int, axes: read List<Int>) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    local stat_shape = tensor_shape_for_axes(shape: read sh, axes: read resolved)
    let m = tensor_reshape(cache: mut cache, x: mean, new_shape: read stat_shape)
    let w = tensor_reshape(cache: mut cache, x: weight, new_shape: read stat_shape)
    let b = tensor_reshape(cache: mut cache, x: bias, new_shape: read stat_shape)
    let inv = tensor_reshape(cache: mut cache, x: invstd, new_shape: read stat_shape)
    let centered = tensor_sub(cache: mut cache, a: x, b: m)
    let scaled = tensor_mul(cache: mut cache, a: centered, b: w)
    let normed = tensor_mul(cache: mut cache, a: scaled, b: inv)
    return tensor_add(cache: mut cache, a: normed, b: b)
}

fn tensor_batchnorm_no_affine(cache: mut UOpCache, x: Int, mean: Int, invstd: Int, axes: read List<Int>) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_axes(ndim: List.len<Int>(list: read sh), axes: read axes)
    local stat_shape = tensor_shape_for_axes(shape: read sh, axes: read resolved)
    let m = tensor_reshape(cache: mut cache, x: mean, new_shape: read stat_shape)
    let inv = tensor_reshape(cache: mut cache, x: invstd, new_shape: read stat_shape)
    let centered = tensor_sub(cache: mut cache, a: x, b: m)
    return tensor_mul(cache: mut cache, a: centered, b: inv)
}

fn tensor_batchnorm_affine(cache: mut UOpCache, x: Int, weight: Int, bias: Int, mean: Int, invstd: Int, axes: read List<Int>) -> Int {
    return tensor_batchnorm_basic(cache: mut cache, x: x, weight: weight, bias: bias, mean: mean, invstd: invstd, axes: read axes)
}

// 2D matmul A[m,k] @ B[k,n] -> [m,n], built from movement + broadcast-mul + sum (tinygrad dot).
// A.reshape(m,1,k) * B.T.reshape(1,n,k) -> [m,n,k], sum axis 2 -> [m,n,1], reshape -> [m,n].
fn tensor_matmul2d(cache: mut UOpCache, a: Int, b: Int) -> Int {
    local sa = uop_shape(cache: read cache, id: a)
    local sb = uop_shape(cache: read cache, id: b)
    let m = List.get<Int>(list: read sa, index: 0)
    let k = List.get<Int>(list: read sa, index: 1)
    let n = List.get<Int>(list: read sb, index: 1)
    // Ar = A.reshape(m, 1, k)
    local sar = List.new<Int>()
    push1(l: mut sar, a: m)
    push1(l: mut sar, a: 1)
    push1(l: mut sar, a: k)
    let ar = mk_reshape(cache: mut cache, x: a, new_shape: read sar)
    // Bt = B.permute([1,0]).reshape(1, n, k)
    local perm = List.new<Int>()
    push1(l: mut perm, a: 1)
    push1(l: mut perm, a: 0)
    let bt0 = mk_permute(cache: mut cache, x: b, perm: read perm)
    local sbt = List.new<Int>()
    push1(l: mut sbt, a: 1)
    push1(l: mut sbt, a: n)
    push1(l: mut sbt, a: k)
    let bt = mk_reshape(cache: mut cache, x: bt0, new_shape: read sbt)
    // prod = Ar * Bt -> [m,n,k]
    let prod = tensor_binary(cache: mut cache, op: MUL, a: ar, b: bt)
    // sum over contraction axis 2 -> [m,n,1]
    local ax = List.new<Int>()
    push1(l: mut ax, a: 2)
    let summed = mk_sum(cache: mut cache, x: prod, axes: read ax)
    // reshape -> [m,n]
    local smn = List.new<Int>()
    push1(l: mut smn, a: m)
    push1(l: mut smn, a: n)
    return mk_reshape(cache: mut cache, x: summed, new_shape: read smn)
}

fn tensor_dot(cache: mut UOpCache, x: Int, w: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    local ws = uop_shape(cache: read cache, id: w)
    let dx = List.len<Int>(list: read xs)
    let dw = List.len<Int>(list: read ws)
    let mut axis_w = dw - 1
    if dw >= 2 { axis_w = dw - 2 }
    let mut insert_one = 0
    if dx > 1 {
        if dw > 1 { insert_one = 1 }
    }

    local xshape = List.new<Int>()
    let mut xi = 0
    while xi < dx - 1 {
        push1(l: mut xshape, a: List.get<Int>(list: read xs, index: xi))
        xi = xi + 1
    }
    if insert_one == 1 { push1(l: mut xshape, a: 1) }
    push1(l: mut xshape, a: List.get<Int>(list: read xs, index: dx - 1))
    let xr = tensor_reshape(cache: mut cache, x: x, new_shape: read xshape)

    local wshape = List.new<Int>()
    let mut wi = 0
    while wi < dw - 2 {
        push1(l: mut wshape, a: List.get<Int>(list: read ws, index: wi))
        wi = wi + 1
    }
    if insert_one == 1 { push1(l: mut wshape, a: 1) }
    let mut wj = axis_w
    while wj < dw {
        push1(l: mut wshape, a: List.get<Int>(list: read ws, index: wj))
        wj = wj + 1
    }
    let wr = tensor_reshape(cache: mut cache, x: w, new_shape: read wshape)
    let mut wt_axis = List.len<Int>(list: read wshape) - 1
    if dw >= 2 { wt_axis = List.len<Int>(list: read wshape) - 2 }
    let wt = tensor_transpose(cache: mut cache, x: wr, dim0: 0 - 1, dim1: wt_axis)
    let prod = tensor_mul(cache: mut cache, a: xr, b: wt)
    return tensor_sum_axis(cache: mut cache, x: prod, axis: 0 - 1)
}

fn tensor_matmul(cache: mut UOpCache, a: Int, b: Int) -> Int {
    return tensor_dot(cache: mut cache, x: a, w: b)
}

fn tensor_scaled_dot_product_attention(cache: mut UOpCache, query: Int, key: Int, value: Int, dropout_p: Float, training: Bool, seed: Int) -> Int {
    local qshape = uop_shape(cache: read cache, id: query)
    let kdim = List.get<Int>(list: read qshape, index: List.len<Int>(list: read qshape) - 1)
    let kt = tensor_transpose(cache: mut cache, x: key, dim0: 0 - 2, dim1: 0 - 1)
    let qk0 = tensor_matmul(cache: mut cache, a: query, b: kt)
    let scale = tensor_const_like_float(cache: mut cache, x: qk0, value: Math.sqrt(value: Int.to_float(value: read kdim)))
    let qk = tensor_div(cache: mut cache, a: qk0, b: scale)
    let weights = tensor_softmax_axis(cache: mut cache, x: qk, axis: 0 - 1)
    let dropped = tensor_dropout(cache: mut cache, x: weights, p: dropout_p, training: training, seed: seed)
    return tensor_matmul(cache: mut cache, a: dropped, b: value)
}

fn tensor_scaled_dot_product_attention_causal(cache: mut UOpCache, query: Int, key: Int, value: Int, dropout_p: Float, training: Bool, seed: Int) -> Int {
    local qshape = uop_shape(cache: read cache, id: query)
    let kdim = List.get<Int>(list: read qshape, index: List.len<Int>(list: read qshape) - 1)
    let kt = tensor_transpose(cache: mut cache, x: key, dim0: 0 - 2, dim1: 0 - 1)
    let qk0 = tensor_matmul(cache: mut cache, a: query, b: kt)
    let scale = tensor_const_like_float(cache: mut cache, x: qk0, value: Math.sqrt(value: Int.to_float(value: read kdim)))
    let qk_scaled = tensor_div(cache: mut cache, a: qk0, b: scale)
    let ones = tensor_ones_like(cache: mut cache, x: qk_scaled, dt: read dt_bool())
    let causal_mask = tensor_tril(cache: mut cache, x: ones, diagonal: 0)
    let zero = tensor_zeros_like_same(cache: mut cache, x: qk_scaled)
    let low = tensor_full_like_same(cache: mut cache, x: qk_scaled, value: 0.0 - 1000000000000000000.0)
    let bias = tensor_where(cache: mut cache, cond: causal_mask, x: zero, y: low)
    let qk = tensor_add(cache: mut cache, a: qk_scaled, b: bias)
    let weights = tensor_softmax_axis(cache: mut cache, x: qk, axis: 0 - 1)
    let dropped = tensor_dropout(cache: mut cache, x: weights, p: dropout_p, training: training, seed: seed)
    return tensor_matmul(cache: mut cache, a: dropped, b: value)
}

