fn BatchNorm(cache: mut UOpCache, sz: Int, eps: Float, affine: Bool, track_running_stats: Bool, momentum: Float) -> fresh BatchNormLayer {
    local shape = shp1(a: sz)
    let mut weight = 0 - 1
    let mut bias = 0 - 1
    if affine {
        weight = tensor_ones(cache: mut cache, dt: read dt_default_float(), shape: read shape)
        bias = tensor_zeros(cache: mut cache, dt: read dt_default_float(), shape: read shape)
    }
    let running_mean = tensor_zeros(cache: mut cache, dt: read dt_default_float(), shape: read shape)
    let running_var = tensor_ones(cache: mut cache, dt: read dt_default_float(), shape: read shape)
    local scalar = List.new<Int>()
    let batches = tensor_zeros(cache: mut cache, dt: read dt_int64(), shape: read scalar)
    return BatchNormLayer(weight: weight, bias: bias, running_mean: running_mean, running_var: running_var, num_batches_tracked: batches, eps: eps, momentum: momentum, affine: affine, track_running_stats: track_running_stats)
}

fn BatchNorm2d(cache: mut UOpCache, sz: Int, eps: Float, affine: Bool, track_running_stats: Bool, momentum: Float) -> fresh BatchNormLayer {
    return BatchNorm(cache: mut cache, sz: sz, eps: eps, affine: affine, track_running_stats: track_running_stats, momentum: momentum)
}

fn BatchNorm3d(cache: mut UOpCache, sz: Int, eps: Float, affine: Bool, track_running_stats: Bool, momentum: Float) -> fresh BatchNormLayer {
    return BatchNorm(cache: mut cache, sz: sz, eps: eps, affine: affine, track_running_stats: track_running_stats, momentum: momentum)
}

fn calc_stats(cache: mut UOpCache, x: Int) -> fresh BatchNormStats {
    local shape = uop_shape(cache: read cache, id: x)
    local axes = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if i != 1 { push1(l: mut axes, a: i) }
        i = i + 1
    }
    let mean = tensor_mean_axes(cache: mut cache, x: x, axes: read axes)
    let centered = tensor_sub(cache: mut cache, a: x, b: mean)
    let sq = tensor_mul(cache: mut cache, a: centered, b: centered)
    let variance = tensor_mean_axes(cache: mut cache, x: sq, axes: read axes)
    return BatchNormStats(mean: mean, var: variance)
}

fn BatchNorm_calc_stats(cache: mut UOpCache, layer: read BatchNormLayer, x: Int, training: Bool) -> fresh BatchNormStats {
    if layer.track_running_stats && training == false {
        return BatchNormStats(mean: layer.running_mean, var: layer.running_var)
    }
    return calc_stats(cache: mut cache, x: x)
}

fn BatchNorm_call(cache: mut UOpCache, layer: mut BatchNormLayer, x: Int, training: Bool) -> Int {
    local stats = BatchNorm_calc_stats(cache: mut cache, layer: read layer, x: x, training: training)
    if layer.track_running_stats && training {
        let one_minus = tensor_const_like_float(cache: mut cache, x: layer.running_mean, value: 1.0 - layer.momentum)
        let mom = tensor_const_like_float(cache: mut cache, x: stats.mean, value: layer.momentum)
        let rm0 = tensor_mul(cache: mut cache, a: layer.running_mean, b: one_minus)
        let rm1 = tensor_mul(cache: mut cache, a: stats.mean, b: mom)
        layer.running_mean = tensor_add(cache: mut cache, a: rm0, b: rm1)
        let rv0 = tensor_mul(cache: mut cache, a: layer.running_var, b: one_minus)
        let rv1 = tensor_mul(cache: mut cache, a: stats.var, b: mom)
        layer.running_var = tensor_add(cache: mut cache, a: rv0, b: rv1)
        let one = tensor_const_like_float(cache: mut cache, x: layer.num_batches_tracked, value: 1.0)
        layer.num_batches_tracked = tensor_add(cache: mut cache, a: layer.num_batches_tracked, b: one)
    }
    let eps_t = tensor_const_like_float(cache: mut cache, x: stats.var, value: layer.eps)
    let var_eps = tensor_add(cache: mut cache, a: stats.var, b: eps_t)
    let invstd = tensor_rsqrt(cache: mut cache, x: var_eps)
    local axes = shp1(a: 1)
    return tensor_batchnorm(cache: mut cache, x: x, weight: layer.weight, bias: layer.bias, mean: stats.mean, invstd: invstd, axes: read axes)
}

fn Conv1d(cache: mut UOpCache, in_channels: Int, out_channels: Int, kernel_size: Int, stride: Int, padding: Int, dilation: Int, groups: Int, bias: Bool, seed: Int) -> fresh Conv1dLayer {
    local wshape = List.new<Int>()
    push1(l: mut wshape, a: out_channels)
    push1(l: mut wshape, a: in_channels / groups)
    push1(l: mut wshape, a: kernel_size)
    let scale = 1.0 / Math.sqrt(value: Int.to_float(value: read (in_channels * kernel_size)))
    let weight = tensor_uniform(cache: mut cache, dt: read dt_default_float(), shape: read wshape, low: 0.0 - scale, high: scale, seed: seed)
    let mut bias_node = 0 - 1
    if bias {
        local bshape = shp1(a: out_channels)
        bias_node = tensor_uniform(cache: mut cache, dt: read dt_default_float(), shape: read bshape, low: 0.0 - scale, high: scale, seed: seed + 1)
    }
    return Conv1dLayer(weight: weight, bias: bias_node, stride: stride, padding: padding, dilation: dilation, groups: groups)
}

fn Conv1d_call(cache: mut UOpCache, layer: read Conv1dLayer, x: Int) -> Int {
    local x4_shape = List.new<Int>()
    local xs = uop_shape(cache: read cache, id: x)
    push1(l: mut x4_shape, a: List.get<Int>(list: read xs, index: 0))
    push1(l: mut x4_shape, a: List.get<Int>(list: read xs, index: 1))
    push1(l: mut x4_shape, a: 1)
    push1(l: mut x4_shape, a: List.get<Int>(list: read xs, index: 2))
    let x4 = tensor_reshape(cache: mut cache, x: x, new_shape: read x4_shape)
    local w4_shape = List.new<Int>()
    local ws = uop_shape(cache: read cache, id: layer.weight)
    push1(l: mut w4_shape, a: List.get<Int>(list: read ws, index: 0))
    push1(l: mut w4_shape, a: List.get<Int>(list: read ws, index: 1))
    push1(l: mut w4_shape, a: 1)
    push1(l: mut w4_shape, a: List.get<Int>(list: read ws, index: 2))
    let w4 = tensor_reshape(cache: mut cache, x: layer.weight, new_shape: read w4_shape)
    let y4 = tensor_conv2d(cache: mut cache, x: x4, weight: w4, bias: layer.bias, groups: layer.groups, sh: 1, sw: layer.stride, dh: 1, dw: layer.dilation, pad_top: 0, pad_bottom: 0, pad_left: layer.padding, pad_right: layer.padding)
    local ys = uop_shape(cache: read cache, id: y4)
    local y3_shape = List.new<Int>()
    push1(l: mut y3_shape, a: List.get<Int>(list: read ys, index: 0))
    push1(l: mut y3_shape, a: List.get<Int>(list: read ys, index: 1))
    push1(l: mut y3_shape, a: List.get<Int>(list: read ys, index: 3))
    return tensor_reshape(cache: mut cache, x: y4, new_shape: read y3_shape)
}

