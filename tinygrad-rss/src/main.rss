features: local
fn lit2(a: Int, b: Int) -> fresh List<Int> {
    local l = List.new<Int>()
    List.push<Int>(list: mut l, value: read a)
    List.push<Int>(list: mut l, value: read b)
    return take l
}
fn show(label: read String, l: read List<Int>) -> Unit {
    Log.write(message: read label)
    let mut i = 0
    while i < List.len<Int>(list: read l) {
        Log.write(message: read String.from_int(value: List.get<Int>(list: read l, index: i)))
        i = i + 1
    }
    return Unit
}
fn main() -> Unit {
    local cache = cache_new()
    let f32 = dt_float32()
    local sa = lit2(a: 2, b: 3)
    local sb = lit2(a: 3, b: 4)
    let a = mk_buffer(cache: mut cache, dt: read f32, shape: read sa)
    let b = mk_buffer(cache: mut cache, dt: read f32, shape: read sb)
    let c = tensor_matmul2d(cache: mut cache, a: a, b: b)   // [2,3]@[3,4] -> [2,4]
    show(label: read "matmul", l: read uop_shape(cache: read cache, id: c))   // 2 4
    Log.write(message: read String.from_int(value: cache_len(cache: read cache)))
    return Unit
}
