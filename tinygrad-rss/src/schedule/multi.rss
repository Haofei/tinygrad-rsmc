// First integrated slice of tinygrad/schedule/multi.py.
//
// This ports the first multi-device graph rewrites around COPY/MSELECT/MSTACK plus
// passthrough/strip handling for boundary ops that carry a MULTI child.
// Full ALU/reduce/movement/FUNCTION multi rewrite remains future scheduler work.
features: local

struct MultiRewrite derives(Clone) {
    result: Int,
    changed: Bool,
    ok: Bool,
}

fn multi_empty_result(cache: mut UOpCache) -> Int {
    local empty = List.new<Int>()
    return mk_sink(cache: mut cache, ids: read empty)
}

fn multi_copy_broadcast(cache: mut UOpCache, copy: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: copy) != COPY || node_num_src(cache: read cache, id: copy) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let x = node_src_id(cache: read cache, id: copy, k: 0)
    let dev = node_src_id(cache: read cache, id: copy, k: 1)
    let target_count = node_effective_device_count(cache: read cache, id: dev)
    let source_count = node_effective_device_count(cache: read cache, id: x)
    if target_count <= 1 || source_count > 1 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local srcs = List.new<Int>()
    let mut i = 0
    while i < target_count {
        local target = node_effective_device_name(cache: read cache, id: dev, index: i)
        let copied = mk_copy_to_device(cache: mut cache, x: x, device: read target)
        List.push<Int>(list: mut srcs, value: read copied)
        i = i + 1
    }
    let out = mk_mstack(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: x), srcs: read srcs)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_copy_to_one(cache: mut UOpCache, copy: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: copy) != COPY || node_num_src(cache: read cache, id: copy) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let x = node_src_id(cache: read cache, id: copy, k: 0)
    if node_op(cache: read cache, id: x) == MULTI {
        return multi_copy(cache: mut cache, copy: copy)
    }
    let dev = node_src_id(cache: read cache, id: copy, k: 1)
    let target_count = node_effective_device_count(cache: read cache, id: dev)
    let source_count = node_effective_device_count(cache: read cache, id: x)
    if target_count != 1 || source_count <= 1 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local target = node_effective_device_name(cache: read cache, id: dev, index: 0)
    let selected = mk_mselect(cache: mut cache, x: x, index: 0)
    let out = mk_copy_to_device(cache: mut cache, x: selected, device: read target)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_copy(cache: mut UOpCache, copy: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: copy) != COPY || node_num_src(cache: read cache, id: copy) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let multi = node_src_id(cache: read cache, id: copy, k: 0)
    if node_op(cache: read cache, id: multi) != MULTI || node_num_src(cache: read cache, id: multi) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let dev = node_src_id(cache: read cache, id: copy, k: 1)
    if node_op(cache: read cache, id: dev) != DEVICE {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let dcount = node_effective_device_count(cache: read cache, id: multi)
    let target_count = node_effective_device_count(cache: read cache, id: dev)
    if dcount <= 1 || target_count <= 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    if target_count == 1 {
        local target = node_effective_device_name(cache: read cache, id: dev, index: 0)
        let payload = node_src_id(cache: read cache, id: multi, k: 0)
        local pieces = List.new<Int>()
        let mut i = 0
        while i < dcount {
            let selected = mk_mselect(cache: mut cache, x: payload, index: i)
            let copied = mk_copy_to_device(cache: mut cache, x: selected, device: read target)
            List.push<Int>(list: mut pieces, value: read copied)
            i = i + 1
        }
        let out = tensor_cat(cache: mut cache, tensors: read pieces, dim: node_const_int(cache: read cache, id: multi))
        return MultiRewrite(result: out, changed: true, ok: true)
    }
    let out = multi_unshard_to_device(cache: mut cache, multi: multi, dcount: dcount, dev: dev)
    if out < 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_mselect_mstack(cache: mut UOpCache, mselect: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: mselect) != MSELECT || node_num_src(cache: read cache, id: mselect) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let src = node_src_id(cache: read cache, id: mselect, k: 0)
    if node_op(cache: read cache, id: src) != MSTACK {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let idx = node_const_int(cache: read cache, id: mselect)
    if idx < 0 || idx >= node_num_src(cache: read cache, id: src) {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    return MultiRewrite(result: node_src_id(cache: read cache, id: src, k: idx), changed: true, ok: true)
}

fn multi_mselect_movement(cache: mut UOpCache, mselect: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: mselect) != MSELECT || node_num_src(cache: read cache, id: mselect) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let movement = node_src_id(cache: read cache, id: mselect, k: 0)
    let mop = node_op(cache: read cache, id: movement)
    if group_movement(op: read mop) == false || node_num_src(cache: read cache, id: movement) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let base = node_src_id(cache: read cache, id: movement, k: 0)
    let idx = node_const_int(cache: read cache, id: mselect)
    let selected = mk_mselect(cache: mut cache, x: base, index: idx)
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read selected)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: movement) {
        let child = node_src_id(cache: read cache, id: movement, k: i)
        List.push<Int>(list: mut srcs, value: read child)
        i = i + 1
    }
    local dt = node_full_dtype(cache: read cache, id: movement)
    local arg = node_arg(cache: read cache, id: movement)
    let out = intern(cache: mut cache, op: mop, dt: read dt, src: take srcs, arg: take arg)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_mstack_early_shrink(cache: mut UOpCache, shrink: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: shrink) != SHRINK || node_num_src(cache: read cache, id: shrink) < 3 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let ms = node_src_id(cache: read cache, id: shrink, k: 0)
    if node_op(cache: read cache, id: ms) != MSTACK {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local starts = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: shrink, k: 1))
    local ends = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: shrink, k: 2))
    local out_srcs = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: ms) {
        let child = node_src_id(cache: read cache, id: ms, k: i)
        let child_op = node_op(cache: read cache, id: child)
        if child_op == COPY && node_num_src(cache: read cache, id: child) >= 2 {
            let copied_src = node_src_id(cache: read cache, id: child, k: 0)
            let shrunk = mk_shrink(cache: mut cache, x: copied_src, starts: read starts, ends: read ends)
            local target = node_effective_device_name(cache: read cache, id: child, index: 0)
            let recopied = mk_copy_to_device(cache: mut cache, x: shrunk, device: read target)
            List.push<Int>(list: mut out_srcs, value: read recopied)
        } else {
            let shrunk = mk_shrink(cache: mut cache, x: child, starts: read starts, ends: read ends)
            let contig = mk_contiguous(cache: mut cache, x: shrunk)
            List.push<Int>(list: mut out_srcs, value: read contig)
        }
        i = i + 1
    }
    local dt = node_full_dtype(cache: read cache, id: shrink)
    let out = mk_mstack(cache: mut cache, dt: read dt, srcs: read out_srcs)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_param_to_multi(cache: mut UOpCache, param: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: param) != PARAM {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    if node_param_has_axis(cache: read cache, id: param) == false {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let axis = node_param_axis(cache: read cache, id: param)
    let dcount = node_param_device_count(cache: read cache, id: param)
    if axis < 0 || dcount <= 1 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local shape = uop_shape(cache: read cache, id: param)
    if axis >= List.len<Int>(list: read shape) {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let full_dim = List.get<Int>(list: read shape, index: axis)
    if full_dim % dcount != 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    List.set<Int>(list: mut shape, index: axis, value: read (full_dim / dcount))
    local devices = node_param_devices(cache: read cache, id: param)
    local dt = node_full_dtype(cache: read cache, id: param)
    local name = node_param_name(cache: read cache, id: param)
    local addrspace = node_param_addrspace(cache: read cache, id: param)
    let local_param = mk_param_devices_full(cache: mut cache, slot: node_param_slot(cache: read cache, id: param),
                                            dt: read dt, shape: read shape, name: read name,
                                            has_vmin_vmax: node_param_has_vmin_vmax(cache: read cache, id: param),
                                            vmin: node_param_vmin(cache: read cache, id: param),
                                            vmax: node_param_vmax(cache: read cache, id: param),
                                            addrspace: read addrspace, devices: read devices)
    let out = mk_multi(cache: mut cache, x: local_param, axis: axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_rebuild_srcs_replacing_multi_with_payload(cache: read UOpCache, root: Int, start: Int) -> fresh List<Int> {
    local srcs = List.new<Int>()
    let mut i = start
    while i < node_num_src(cache: read cache, id: root) {
        let child = node_src_id(cache: read cache, id: root, k: i)
        if node_op(cache: read cache, id: child) == MULTI && node_num_src(cache: read cache, id: child) > 0 {
            List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: child, k: 0))
        } else {
            List.push<Int>(list: mut srcs, value: read child)
        }
        i = i + 1
    }
    return srcs
}

fn multi_passthrough_root(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_num_src(cache: read cache, id: root) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let multi = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: multi) != MULTI || node_num_src(cache: read cache, id: multi) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: multi, k: 0))
    local tail = multi_rebuild_srcs_replacing_multi_with_payload(cache: read cache, root: root, start: 1)
    let mut i = 0
    while i < List.len<Int>(list: read tail) {
        let child = List.get<Int>(list: read tail, index: i)
        List.push<Int>(list: mut srcs, value: read child)
        i = i + 1
    }
    let op = node_op(cache: read cache, id: root)
    let axis = node_const_int(cache: read cache, id: multi)
    local dt = node_full_dtype(cache: read cache, id: root)
    local arg = node_arg(cache: read cache, id: root)
    let rebuilt = intern(cache: mut cache, op: op, dt: read dt, src: take srcs, arg: take arg)
    let out = mk_multi(cache: mut cache, x: rebuilt, axis: axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_strip_multi_srcs(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_num_src(cache: read cache, id: root) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local srcs = multi_rebuild_srcs_replacing_multi_with_payload(cache: read cache, root: root, start: 0)
    let mut changed = false
    let mut i = 0
    while i < node_num_src(cache: read cache, id: root) {
        let child = node_src_id(cache: read cache, id: root, k: i)
        if node_op(cache: read cache, id: child) == MULTI && node_num_src(cache: read cache, id: child) > 0 {
            changed = true
        }
        i = i + 1
    }
    if changed == false {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let op = node_op(cache: read cache, id: root)
    local dt = node_full_dtype(cache: read cache, id: root)
    local arg = node_arg(cache: read cache, id: root)
    let rebuilt = intern(cache: mut cache, op: op, dt: read dt, src: take srcs, arg: take arg)
    return MultiRewrite(result: rebuilt, changed: true, ok: true)
}

fn multi_call_void_strip(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != CALL {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let dt = node_full_dtype(cache: read cache, id: root)
    if dt.name != "void" {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    return multi_strip_multi_srcs(cache: mut cache, root: root)
}

fn multi_store_after(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != AFTER || node_num_src(cache: read cache, id: root) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let anchor = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: anchor) != MULTI {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let store = node_src_id(cache: read cache, id: root, k: 1)
    if node_op(cache: read cache, id: store) != STORE || node_num_src(cache: read cache, id: store) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let dest = node_src_id(cache: read cache, id: store, k: 0)
    let src = node_src_id(cache: read cache, id: store, k: 1)
    if node_op(cache: read cache, id: dest) != MULTI || node_op(cache: read cache, id: src) != MULTI || node_num_src(cache: read cache, id: src) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = node_src_id(cache: read cache, id: src, k: 0)
    let st = mk_store(cache: mut cache, ptr: dest, value: payload, gate: read None)
    local deps = List.new<Int>()
    List.push<Int>(list: mut deps, value: read st)
    let after = mk_after(cache: mut cache, id: dest, srcs: read deps)
    let out = mk_multi(cache: mut cache, x: after, axis: node_const_int(cache: read cache, id: src))
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_rewrite_function(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != FUNCTION || node_num_src(cache: read cache, id: root) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local call = node_call_arg(cache: read cache, id: root)
    if call.precompile {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let body = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: body) != TUPLE {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local new_body_srcs = List.new<Int>()
    let mut has_multi_body = false
    let mut i = 0
    while i < node_num_src(cache: read cache, id: body) {
        let child = node_src_id(cache: read cache, id: body, k: i)
        if node_op(cache: read cache, id: child) == MULTI && node_num_src(cache: read cache, id: child) > 0 {
            List.push<Int>(list: mut new_body_srcs, value: read node_src_id(cache: read cache, id: child, k: 0))
            has_multi_body = true
        } else {
            List.push<Int>(list: mut new_body_srcs, value: read child)
        }
        i = i + 1
    }
    local new_args = List.new<Int>()
    let mut changed = has_multi_body
    let mut j = 1
    while j < node_num_src(cache: read cache, id: root) {
        let arg = node_src_id(cache: read cache, id: root, k: j)
        if node_op(cache: read cache, id: arg) == MULTI && node_num_src(cache: read cache, id: arg) > 0 {
            List.push<Int>(list: mut new_args, value: read node_src_id(cache: read cache, id: arg, k: 0))
            changed = true
        } else {
            List.push<Int>(list: mut new_args, value: read arg)
        }
        j = j + 1
    }
    if changed == false {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let new_body = mk_tuple(cache: mut cache, srcs: read new_body_srcs)
    let shard_fn = mk_function(cache: mut cache, body_tuple: new_body, args: read new_args, call: read call)
    if has_multi_body == false {
        return MultiRewrite(result: shard_fn, changed: true, ok: true)
    }
    local out_srcs = List.new<Int>()
    let mut k = 0
    while k < node_num_src(cache: read cache, id: body) {
        let child = node_src_id(cache: read cache, id: body, k: k)
        let got = mk_gettuple(cache: mut cache, tuple_id: shard_fn, idx: k)
        if node_op(cache: read cache, id: child) == MULTI && node_num_src(cache: read cache, id: child) > 0 {
            let wrapped = mk_multi(cache: mut cache, x: got, axis: node_const_int(cache: read cache, id: child))
            List.push<Int>(list: mut out_srcs, value: read wrapped)
        } else {
            List.push<Int>(list: mut out_srcs, value: read got)
        }
        k = k + 1
    }
    let out = mk_tuple(cache: mut cache, srcs: read out_srcs)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_root_payload(cache: read UOpCache, root: Int) -> Int {
    if node_num_src(cache: read cache, id: root) == 0 { return -1 }
    let multi = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: multi) != MULTI || node_num_src(cache: read cache, id: multi) == 0 { return -1 }
    return node_src_id(cache: read cache, id: multi, k: 0)
}

fn multi_root_axis(cache: read UOpCache, root: Int) -> Int {
    if node_num_src(cache: read cache, id: root) == 0 { return -1 }
    let multi = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: multi) != MULTI { return -1 }
    return node_const_int(cache: read cache, id: multi)
}

fn multi_reshape(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != RESHAPE || node_num_src(cache: read cache, id: root) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = multi_root_payload(cache: read cache, root: root)
    if payload < 0 { return MultiRewrite(result: fallback, changed: false, ok: false) }
    local payload_shape = uop_shape(cache: read cache, id: payload)
    local new_shape = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: root, k: 1))
    let new_axis = uop_axis(cache: read cache, id: root)
    if new_axis >= 0 && new_axis < List.len<Int>(list: read new_shape) {
        let multi = node_src_id(cache: read cache, id: root, k: 0)
        let dcount = node_effective_device_count(cache: read cache, id: multi)
        if dcount > 1 {
            let dim = List.get<Int>(list: read new_shape, index: new_axis)
            List.set<Int>(list: mut new_shape, index: new_axis, value: read (dim / dcount))
        }
    }
    if prod(x: read payload_shape) != prod(x: read new_shape) {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let reshaped = mk_reshape(cache: mut cache, x: payload, new_shape: read new_shape)
    let out = mk_multi(cache: mut cache, x: reshaped, axis: new_axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_expand(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != EXPAND || node_num_src(cache: read cache, id: root) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = multi_root_payload(cache: read cache, root: root)
    if payload < 0 { return MultiRewrite(result: fallback, changed: false, ok: false) }
    let axis = multi_root_axis(cache: read cache, root: root)
    local new_shape = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: root, k: 1))
    if axis >= 0 && axis < List.len<Int>(list: read new_shape) {
        local payload_shape = uop_shape(cache: read cache, id: payload)
        if axis < List.len<Int>(list: read payload_shape) {
            let shard_dim = List.get<Int>(list: read payload_shape, index: axis)
            List.set<Int>(list: mut new_shape, index: axis, value: read shard_dim)
        }
    }
    let expanded = mk_expand(cache: mut cache, x: payload, new_shape: read new_shape)
    let out = mk_multi(cache: mut cache, x: expanded, axis: axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_pad(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != PAD || node_num_src(cache: read cache, id: root) < 3 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = multi_root_payload(cache: read cache, root: root)
    if payload < 0 { return MultiRewrite(result: fallback, changed: false, ok: false) }
    let axis = multi_root_axis(cache: read cache, root: root)
    local before = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: root, k: 1))
    local after = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: root, k: 2))
    if axis >= 0 && axis < List.len<Int>(list: read before) && axis < List.len<Int>(list: read after) {
        if List.get<Int>(list: read before, index: axis) != 0 || List.get<Int>(list: read after, index: axis) != 0 {
            return MultiRewrite(result: fallback, changed: false, ok: false)
        }
    }
    let padded = mk_pad(cache: mut cache, x: payload, before: read before, after: read after)
    let out = mk_multi(cache: mut cache, x: padded, axis: axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_shrink(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != SHRINK || node_num_src(cache: read cache, id: root) < 3 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let multi = node_src_id(cache: read cache, id: root, k: 0)
    let payload = multi_root_payload(cache: read cache, root: root)
    if payload < 0 { return MultiRewrite(result: fallback, changed: false, ok: false) }
    let axis = multi_root_axis(cache: read cache, root: root)
    local starts = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: root, k: 1))
    local ends = node_argints(cache: read cache, id: node_src_id(cache: read cache, id: root, k: 2))
    if axis >= 0 && axis < List.len<Int>(list: read starts) && axis < List.len<Int>(list: read ends) {
        local payload_shape = uop_shape(cache: read cache, id: payload)
        if axis >= List.len<Int>(list: read payload_shape) {
            return MultiRewrite(result: fallback, changed: false, ok: false)
        }
        let axis_start = List.get<Int>(list: read starts, index: axis)
        let axis_end = List.get<Int>(list: read ends, index: axis)
        let shard_dim = List.get<Int>(list: read payload_shape, index: axis)
        let dcount = node_effective_device_count(cache: read cache, id: multi)
        if dcount > 1 && shard_dim > 0 {
            let global_dim = shard_dim * dcount
            if axis_start == 0 && axis_end == global_dim {
                List.set<Int>(list: mut starts, index: axis, value: read 0)
                List.set<Int>(list: mut ends, index: axis, value: read shard_dim)
            } else {
                if axis_end > axis_start && axis_start % shard_dim == 0 && axis_end - axis_start == shard_dim {
                    let shard_index = axis_start / shard_dim
                    if shard_index >= 0 && shard_index < dcount {
                        List.set<Int>(list: mut starts, index: axis, value: read 0)
                        List.set<Int>(list: mut ends, index: axis, value: read shard_dim)
                        let selected = mk_mselect(cache: mut cache, x: payload, index: shard_index)
                        let dev = multi_effective_device_node(cache: mut cache, id: multi)
                        local copy_src = List.new<Int>()
                        List.push<Int>(list: mut copy_src, value: read selected)
                        List.push<Int>(list: mut copy_src, value: read dev)
                        local dt = node_full_dtype(cache: read cache, id: selected)
                        local copy_arg = ArgNone
                        let copied = intern(cache: mut cache, op: COPY, dt: read dt, src: take copy_src, arg: take copy_arg)
                        let shrunk = mk_shrink(cache: mut cache, x: copied, starts: read starts, ends: read ends)
                        return MultiRewrite(result: shrunk, changed: true, ok: true)
                    }
                }
                return MultiRewrite(result: fallback, changed: false, ok: false)
            }
        } else if axis_start != 0 || axis_end != shard_dim {
            return MultiRewrite(result: fallback, changed: false, ok: false)
        } else {
            List.set<Int>(list: mut starts, index: axis, value: read 0)
            List.set<Int>(list: mut ends, index: axis, value: read shard_dim)
        }
    }
    let shrunk = mk_shrink(cache: mut cache, x: payload, starts: read starts, ends: read ends)
    let out = mk_multi(cache: mut cache, x: shrunk, axis: axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_permute(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != PERMUTE {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = multi_root_payload(cache: read cache, root: root)
    if payload < 0 { return MultiRewrite(result: fallback, changed: false, ok: false) }
    local perm = node_argints(cache: read cache, id: root)
    let new_axis = uop_axis(cache: read cache, id: root)
    let permuted = mk_permute(cache: mut cache, x: payload, perm: read perm)
    let out = mk_multi(cache: mut cache, x: permuted, axis: new_axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_flip(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
