fn tensor_pad(cache: mut UOpCache, x: Int, before: read List<Int>, after: read List<Int>) -> Int {
    return mk_pad(cache: mut cache, x: x, before: read before, after: read after)
}

fn tensor_pad_constant(cache: mut UOpCache, x: Int, before: read List<Int>, after: read List<Int>, value: Float) -> Int {
    let base = tensor_pad(cache: mut cache, x: x, before: read before, after: read after)
    if value == 0.0 { return base }
    local sh = uop_shape(cache: read cache, id: x)
    let ones = tensor_full(cache: mut cache, dt: read dt_bool(), shape: read sh, value: 1.0)
    let mask = tensor_pad(cache: mut cache, x: ones, before: read before, after: read after)
    let fill = tensor_const_like_float(cache: mut cache, x: base, value: value)
    return tensor_where(cache: mut cache, cond: mask, x: base, y: fill)
}

fn tensor_pad_or_shrink2d_nchw_constant(cache: mut UOpCache, x: Int, pad_top: Int, pad_bottom: Int, pad_left: Int, pad_right: Int, value: Float) -> Int {
    local sh = uop_shape(cache: read cache, id: x)
    let bs = List.get<Int>(list: read sh, index: 0)
    let c = List.get<Int>(list: read sh, index: 1)
    let h = List.get<Int>(list: read sh, index: 2)
    let w = List.get<Int>(list: read sh, index: 3)
    let mut crop_top = 0
    let mut crop_bottom = 0
    let mut crop_left = 0
    let mut crop_right = 0
    let mut add_top = pad_top
    let mut add_bottom = pad_bottom
    let mut add_left = pad_left
    let mut add_right = pad_right
    if pad_top < 0 {
        crop_top = 0 - pad_top
        add_top = 0
    }
    if pad_bottom < 0 {
        crop_bottom = 0 - pad_bottom
        add_bottom = 0
    }
    if pad_left < 0 {
        crop_left = 0 - pad_left
        add_left = 0
    }
    if pad_right < 0 {
        crop_right = 0 - pad_right
        add_right = 0
    }
    local starts = List.new<Int>()
    push1(l: mut starts, a: 0)
    push1(l: mut starts, a: 0)
    push1(l: mut starts, a: crop_top)
    push1(l: mut starts, a: crop_left)
    local ends = List.new<Int>()
    push1(l: mut ends, a: bs)
    push1(l: mut ends, a: c)
    push1(l: mut ends, a: h - crop_bottom)
    push1(l: mut ends, a: w - crop_right)
    let shrunk = mk_shrink(cache: mut cache, x: x, starts: read starts, ends: read ends)
    local before = List.new<Int>()
    push1(l: mut before, a: 0)
    push1(l: mut before, a: 0)
    push1(l: mut before, a: add_top)
    push1(l: mut before, a: add_left)
    local after = List.new<Int>()
    push1(l: mut after, a: 0)
    push1(l: mut after, a: 0)
    push1(l: mut after, a: add_bottom)
    push1(l: mut after, a: add_right)
    return tensor_pad_constant(cache: mut cache, x: shrunk, before: read before, after: read after, value: value)
}

