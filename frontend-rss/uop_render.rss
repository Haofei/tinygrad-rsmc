// tinygrad UOp linearizer -> modern-c renderer, ported to rsscript.
//
// Walks a real UOp arena and emits MC, mirroring renderer/cstyle.py `_render`+`base_rewrite`.
// The arena is struct-of-arrays (parallel List<Int>) to stay inside rss v0.6's ownership
// model (no fresh-return of built collections; no take/local needed for primitives).
//   ops[i]  : opcode      argi[i] : int arg (buffer slot / range bound / op symbol id)
//   s0[i],s1[i] : source node indices (-1 = none)
// Verify output against oracle/mc_generated/{add,mul}.mc.

// opcodes
fn OP_PARAM() -> Int { return 0 }
fn OP_RANGE() -> Int { return 1 }
fn OP_INDEX() -> Int { return 2 }
fn OP_LOAD()  -> Int { return 3 }
fn OP_ALU()   -> Int { return 4 }   // argi = symbol id: 0 '+', 1 '*', 2 '-'
fn OP_STORE() -> Int { return 5 }
fn OP_END()   -> Int { return 6 }
fn OP_RELU()  -> Int { return 7 }   // unary: max(0, x) via select_f32 helper
fn OP_CONSTI() -> Int { return 8 }   // integer constant (index); argi = value
fn OP_DEFREG() -> Int { return 9 }   // declare accumulator acc0 (no init)
fn OP_ACCADD() -> Int { return 10 }  // acc0[0] = acc0[0] + s0
fn OP_ACCINIT() -> Int { return 11 } // acc0[0] = 0.0  (reset, e.g. per matmul output cell)

fn alu_sym(id: Int) -> fresh String {
    if id == 0 { return "+" }
    if id == 1 { return "*" }
    return "-"
}

fn cat(a: read String, b: read String) -> fresh String { return String.concat(left: read a, right: read b) }
fn cat3(a: read String, b: read String, c: read String) -> fresh String { return cat(a: read cat(a: read a, b: read b), b: read c) }

// append one node to the SoA arena
fn emit(ops: mut List<Int>, argi: mut List<Int>, s0: mut List<Int>, s1: mut List<Int>,
        op: Int, arg: Int, a: Int, b: Int) -> Unit {
    List.push(list: mut ops,  value: read op)
    List.push(list: mut argi, value: read arg)
    List.push(list: mut s0,   value: read a)
    List.push(list: mut s1,   value: read b)
    return Unit
}

fn render(ops: read List<Int>, argi: read List<Int>, s0: read List<Int>, s1: read List<Int>,
          name: read String, nbuf: Int, with_prelude: Bool) -> fresh String {
    let n = List.len(list: read ops)
    let expr = List.new<String>()
    let mut j = 0
    while j < n {
        List.push(list: mut expr, value: read "")
        j = j + 1
    }

    let lines = List.new<String>()
    let rstack = List.new<String>()   // open loop-variable names, for nested RANGE/END
    let mut i = 0
    while i < n {
        let op = List.get(list: read ops, index: i)
        let arg = List.get(list: read argi, index: i)
        let a = List.get(list: read s0, index: i)
        let b = List.get(list: read s1, index: i)
        if op == OP_PARAM() {
            List.set(list: mut expr, index: i, value: read cat(a: read "data", b: read String.from_int(value: arg)))
        }
        if op == OP_RANGE() {
            let rv = cat(a: read "r", b: read String.from_int(value: i))
            List.set(list: mut expr, index: i, value: read rv)
            List.push(list: mut rstack, value: read rv)
            List.push(list: mut lines, value: read cat3(a: read "    var ", b: read rv, c: read ": usize = 0;"))
            List.push(list: mut lines, value: read cat3(a: read cat3(a: read "    while ", b: read rv, c: read " < "), b: read String.from_int(value: arg), c: read " {"))
        }
        if op == OP_INDEX() {
            let buf = List.get(list: read expr, index: a)
            let idx = List.get(list: read expr, index: b)
            List.set(list: mut expr, index: i, value: read cat3(a: read cat3(a: read "pa_offset(", b: read buf, c: read ", ("), b: read idx, c: read ") * 4)"))
        }
        if op == OP_LOAD() {
            let addr = List.get(list: read expr, index: a)
            let nm = cat(a: read "v", b: read String.from_int(value: i))
            List.set(list: mut expr, index: i, value: read nm)
            List.push(list: mut lines, value: read cat3(a: read cat3(a: read "      let ", b: read nm, c: read ": f32 = raw.load<f32>("), b: read addr, c: read ");"))
        }
        if op == OP_ALU() {
            let ea = List.get(list: read expr, index: a)
            let eb = List.get(list: read expr, index: b)
            List.set(list: mut expr, index: i, value: read cat3(a: read cat3(a: read "(", b: read ea, c: read alu_sym(id: arg)), b: read eb, c: read ")"))
        }
        if op == OP_RELU() {
            let ea = List.get(list: read expr, index: a)
            let nm = cat(a: read "v", b: read String.from_int(value: i))
            List.set(list: mut expr, index: i, value: read nm)
            // let vN: f32 = select_f32((0.0<ea), ea, 0.0);
            let rhs = cat3(a: read cat3(a: read "select_f32((0.0<", b: read ea, c: read "), "), b: read ea, c: read ", 0.0)")
            List.push(list: mut lines, value: read cat3(a: read cat3(a: read "      let ", b: read nm, c: read ": f32 = "), b: read rhs, c: read ";"))
        }
        if op == OP_STORE() {
            let addr = List.get(list: read expr, index: a)
            let val = List.get(list: read expr, index: b)
            List.push(list: mut lines, value: read cat3(a: read cat3(a: read "      raw.store<f32>(", b: read addr, c: read ", "), b: read val, c: read ");"))
        }
        if op == OP_END() {
            match List.pop(list: mut rstack) {
                Some(rv) => {
                    List.push(list: mut lines, value: read cat3(a: read cat3(a: read "      ", b: read rv, c: read " = "), b: read rv, c: read " + 1;"))
                    List.push(list: mut lines, value: read "    }")
                }
                None => { }
            }
        }
        if op == OP_CONSTI() {
            List.set(list: mut expr, index: i, value: read String.from_int(value: arg))
        }
        if op == OP_DEFREG() {
            List.set(list: mut expr, index: i, value: read "acc0[0]")
            List.push(list: mut lines, value: read "    var acc0: [1]f32 = uninit;")
        }
        if op == OP_ACCINIT() {
            List.push(list: mut lines, value: read "      acc0[0] = 0.0;")
        }
        if op == OP_ACCADD() {
            let ev = List.get(list: read expr, index: a)
            List.push(list: mut lines, value: read cat3(a: read "      acc0[0] = (acc0[0]+", b: read ev, c: read ");"))
        }
        i = i + 1
    }

    // parameter list: data0..data(nbuf-1) as PAddr
    let params = List.new<String>()
    let mut p = 0
    while p < nbuf {
        List.push(list: mut params, value: read cat3(a: read "data", b: read String.from_int(value: p), c: read ": PAddr"))
        p = p + 1
    }
    // prelude: emit the select_f32 helper if any RELU/select is present (MC if is a stmt)
    let mut need_select = false
    let mut k = 0
    while k < n {
        if List.get(list: read ops, index: k) == OP_RELU() {
            need_select = true
        }
        k = k + 1
    }
    let mut prelude = ""
    if with_prelude {
        prelude = "import \"std/addr.mc\";\n\n"
        if need_select {
            prelude = cat(a: read prelude, b: read "fn select_f32(c: bool, a: f32, b: f32) -> f32 {\n  if c { return a; } else { return b; }\n}\n\n")
        }
    }

    let body = String.join(parts: read lines, separator: read "\n")
    return cat3(
        a: read cat3(a: read prelude, b: read "export fn ",
                     c: read cat3(a: read name, b: read "(", c: read cat3(a: read String.join(parts: read params, separator: read ", "), b: read ") -> void {\n  unsafe {\n", c: read ""))),
        b: read body,
        c: read "\n  }\n}")
}

// linearized graph for: data0[i] = relu(data1[i])
fn render_relu(name: read String, n: Int, with_prelude: Bool) -> fresh String {
    let mut ops = List.new<Int>()
    let mut argi = List.new<Int>()
    let mut s0 = List.new<Int>()
    let mut s1 = List.new<Int>()
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(), arg: 0, a: -1, b: -1) // 0 out
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(), arg: 1, a: -1, b: -1) // 1 in
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_RANGE(), arg: n, a: -1, b: -1) // 2
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(), arg: 0, a: 1, b: 2)   // 3
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_LOAD(),  arg: 0, a: 3, b: -1)  // 4
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_RELU(),  arg: 0, a: 4, b: -1)  // 5
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(), arg: 0, a: 0, b: 2)   // 6
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_STORE(), arg: 0, a: 6, b: 5)   // 7
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_END(),   arg: 0, a: 2, b: -1)  // 8
    return render(ops: read ops, argi: read argi, s0: read s0, s1: read s1, name: read name, nbuf: 2, with_prelude: with_prelude)
}

// linearized graph for: data0[i] = data1[i] <op> data2[i]
fn render_binary(name: read String, n: Int, opsym: Int, with_prelude: Bool) -> fresh String {
    let mut ops = List.new<Int>()
    let mut argi = List.new<Int>()
    let mut s0 = List.new<Int>()
    let mut s1 = List.new<Int>()
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(), arg: 0, a: -1, b: -1) // 0 out
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(), arg: 1, a: -1, b: -1) // 1
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(), arg: 2, a: -1, b: -1) // 2
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_RANGE(), arg: n, a: -1, b: -1) // 3
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(), arg: 0, a: 1, b: 3)   // 4
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_LOAD(),  arg: 0, a: 4, b: -1)  // 5
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(), arg: 0, a: 2, b: 3)   // 6
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_LOAD(),  arg: 0, a: 6, b: -1)  // 7
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),   arg: opsym, a: 5, b: 7) // 8
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(), arg: 0, a: 0, b: 3)   // 9
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_STORE(), arg: 0, a: 9, b: 8)   // 10
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_END(),   arg: 0, a: 3, b: -1)  // 11
    return render(ops: read ops, argi: read argi, s0: read s0, s1: read s1, name: read name, nbuf: 3, with_prelude: with_prelude)
}

// linearized graph for: data0[0] = sum(data1[0..n])
fn render_sum(name: read String, n: Int) -> fresh String {
    let mut ops = List.new<Int>()
    let mut argi = List.new<Int>()
    let mut s0 = List.new<Int>()
    let mut s1 = List.new<Int>()
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(),   arg: 0, a: -1, b: -1) // 0 out
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(),   arg: 1, a: -1, b: -1) // 1 in
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_DEFREG(),  arg: 0, a: -1, b: -1) // 2 acc
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ACCINIT(), arg: 0, a: -1, b: -1) // 3
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_RANGE(),   arg: n, a: -1, b: -1) // 4
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(),   arg: 0, a: 1, b: 4)   // 5
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_LOAD(),    arg: 0, a: 5, b: -1)  // 6
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ACCADD(),  arg: 0, a: 6, b: 2)   // 7
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_END(),     arg: 0, a: 4, b: -1)  // 8
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_CONSTI(),  arg: 0, a: -1, b: -1) // 9 idx 0
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(),   arg: 0, a: 0, b: 9)   // 10
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_STORE(),   arg: 0, a: 10, b: 2)  // 11
    return render(ops: read ops, argi: read argi, s0: read s0, s1: read s1, name: read name, nbuf: 2, with_prelude: true)
}

// linearized graph for square matmul: out[i*w+j] = sum_k a[i*w+k]*b[k*w+j]
fn render_matmul(name: read String, w: Int) -> fresh String {
    let mut ops = List.new<Int>()
    let mut argi = List.new<Int>()
    let mut s0 = List.new<Int>()
    let mut s1 = List.new<Int>()
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(),   arg: 0, a: -1, b: -1) // 0 out
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(),   arg: 1, a: -1, b: -1) // 1 a
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_PARAM(),   arg: 2, a: -1, b: -1) // 2 b
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_DEFREG(),  arg: 0, a: -1, b: -1) // 3 acc
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_CONSTI(),  arg: w, a: -1, b: -1) // 4 stride
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_RANGE(),   arg: w, a: -1, b: -1) // 5 i
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_RANGE(),   arg: w, a: -1, b: -1) // 6 j
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ACCINIT(), arg: 0, a: -1, b: -1) // 7
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_RANGE(),   arg: w, a: -1, b: -1) // 8 k
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),     arg: 1, a: 5, b: 4)   // 9  i*w
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),     arg: 0, a: 9, b: 8)   // 10 i*w+k
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(),   arg: 0, a: 1, b: 10)  // 11
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_LOAD(),    arg: 0, a: 11, b: -1) // 12 a[i,k]
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),     arg: 1, a: 8, b: 4)   // 13 k*w
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),     arg: 0, a: 13, b: 6)  // 14 k*w+j
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(),   arg: 0, a: 2, b: 14)  // 15
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_LOAD(),    arg: 0, a: 15, b: -1) // 16 b[k,j]
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),     arg: 1, a: 12, b: 16) // 17 a*b
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ACCADD(),  arg: 0, a: 17, b: 3)  // 18
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_END(),     arg: 0, a: 8, b: -1)  // 19 end k
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),     arg: 1, a: 5, b: 4)   // 20 i*w
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_ALU(),     arg: 0, a: 20, b: 6)  // 21 i*w+j
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_INDEX(),   arg: 0, a: 0, b: 21)  // 22
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_STORE(),   arg: 0, a: 22, b: 3)  // 23
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_END(),     arg: 0, a: 6, b: -1)  // 24 end j
    emit(ops: mut ops, argi: mut argi, s0: mut s0, s1: mut s1, op: OP_END(),     arg: 0, a: 5, b: -1)  // 25 end i
    return render(ops: read ops, argi: read argi, s0: read s0, s1: read s1, name: read name, nbuf: 3, with_prelude: true)
}

fn pl(lines: mut List<String>, t: read String) -> Unit {
    List.push(list: mut lines, value: read t)
    return Unit
}

// Assemble a COMPLETE hosted MC program: K_relu then K_add over a shared buffer t.
// out[i] = relu(x[i]) + y[i]. Proves multi-kernel orchestration + a generated host
// driver + shared intermediate buffers -- all produced by the rss frontend.
fn assemble_chain(n: Int) -> fresh String {
    let nb = n * 4
    let nbs = String.from_int(value: nb)
    let ns = String.from_int(value: n)
    let relu_k = render_relu(name: read "K_relu", n: n, with_prelude: false)
    let add_k = render_binary(name: read "K_add", n: n, opsym: 0, with_prelude: false)

    let lines = List.new<String>()
    pl(lines: mut lines, t: read "import \"std/addr.mc\";")
    pl(lines: mut lines, t: read "import \"std/hosted_io.mc\";")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "fn select_f32(c: bool, a: f32, b: f32) -> f32 {")
    pl(lines: mut lines, t: read "  if c { return a; } else { return b; }")
    pl(lines: mut lines, t: read "}")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read relu_k)
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read add_k)
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "fn read_exact(f: Fd, buf: PAddr, m: usize) -> Result<bool, IoError> {")
    pl(lines: mut lines, t: read "  var done: usize = 0;")
    pl(lines: mut lines, t: read "  while done < m {")
    pl(lines: mut lines, t: read "    let r: usize = io_read(f, pa_offset(buf, done), m - done)?;")
    pl(lines: mut lines, t: read "    if r == 0 { return err(.ReadFailed); }")
    pl(lines: mut lines, t: read "    done = done + r;")
    pl(lines: mut lines, t: read "  }")
    pl(lines: mut lines, t: read "  return ok(true);")
    pl(lines: mut lines, t: read "}")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "export fn hosted_kernel_run() -> i32 {")
    pl(lines: mut lines, t: read cat3(a: read "  var x: [", b: read ns, c: read "]f32 = uninit;"))
    pl(lines: mut lines, t: read cat3(a: read "  var y: [", b: read ns, c: read "]f32 = uninit;"))
    pl(lines: mut lines, t: read cat3(a: read "  var t: [", b: read ns, c: read "]f32 = uninit;"))
    pl(lines: mut lines, t: read cat3(a: read "  var o: [", b: read ns, c: read "]f32 = uninit;"))
    pl(lines: mut lines, t: read "  let input: Fd = stdin_fd();")
    pl(lines: mut lines, t: read "  let output: Fd = stdout_fd();")
    pl(lines: mut lines, t: read cat3(a: read "  if let err(e) = read_exact(input, pa((&x[0]) as usize), ", b: read nbs, c: read ") { return 1; }"))
    pl(lines: mut lines, t: read cat3(a: read "  if let err(e) = read_exact(input, pa((&y[0]) as usize), ", b: read nbs, c: read ") { return 2; }"))
    pl(lines: mut lines, t: read "  K_relu(pa((&t[0]) as usize), pa((&x[0]) as usize));")
    pl(lines: mut lines, t: read "  K_add(pa((&o[0]) as usize), pa((&t[0]) as usize), pa((&y[0]) as usize));")
    pl(lines: mut lines, t: read cat3(a: read "  if let err(e) = io_write_all(output, pa((&o[0]) as usize), ", b: read nbs, c: read ") { return 9; }"))
    pl(lines: mut lines, t: read "  return 0;")
    pl(lines: mut lines, t: read "}")
    return String.join(parts: read lines, separator: read "\n")
}

// Emit a COMPLETE hosted MC program that TRAINS linear regression (y=w*x+b) by SGD on a
// hardcoded dataset (t = 2x+1), then writes the learned [w, b]. End-to-end gradient
// descent through the rss frontend -> mc backend. (Gradients explicit here; automatic
// autograd over the UOp graph is the remaining "true port" step.)
fn assemble_linreg(epochs: Int) -> fresh String {
    let eps = String.from_int(value: epochs)
    let lines = List.new<String>()
    pl(lines: mut lines, t: read "import \"std/addr.mc\";")
    pl(lines: mut lines, t: read "import \"std/hosted_io.mc\";")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "export fn hosted_kernel_run() -> i32 {")
    pl(lines: mut lines, t: read "  var x: [4]f32 = uninit;")
    pl(lines: mut lines, t: read "  var t: [4]f32 = uninit;")
    pl(lines: mut lines, t: read "  x[0] = 0.0; x[1] = 1.0; x[2] = 2.0; x[3] = 3.0;")
    pl(lines: mut lines, t: read "  t[0] = 1.0; t[1] = 3.0; t[2] = 5.0; t[3] = 7.0;")
    pl(lines: mut lines, t: read "  var w: f32 = 0.0;")
    pl(lines: mut lines, t: read "  var b: f32 = 0.0;")
    pl(lines: mut lines, t: read "  let lr: f32 = 0.1;")
    pl(lines: mut lines, t: read "  var ep: usize = 0;")
    pl(lines: mut lines, t: read cat3(a: read "  while ep < ", b: read eps, c: read " {"))
    pl(lines: mut lines, t: read "    var gw: f32 = 0.0;")
    pl(lines: mut lines, t: read "    var gb: f32 = 0.0;")
    pl(lines: mut lines, t: read "    var i: usize = 0;")
    pl(lines: mut lines, t: read "    while i < 4 {")
    pl(lines: mut lines, t: read "      let xi: f32 = x[i];")
    pl(lines: mut lines, t: read "      let d: f32 = ((w * xi) + b) - t[i];")
    pl(lines: mut lines, t: read "      gw = gw + ((2.0 * d) * xi);")
    pl(lines: mut lines, t: read "      gb = gb + (2.0 * d);")
    pl(lines: mut lines, t: read "      i = i + 1;")
    pl(lines: mut lines, t: read "    }")
    pl(lines: mut lines, t: read "    gw = gw / 4.0;")
    pl(lines: mut lines, t: read "    gb = gb / 4.0;")
    pl(lines: mut lines, t: read "    w = w - (lr * gw);")
    pl(lines: mut lines, t: read "    b = b - (lr * gb);")
    pl(lines: mut lines, t: read "    ep = ep + 1;")
    pl(lines: mut lines, t: read "  }")
    pl(lines: mut lines, t: read "  var out: [2]f32 = uninit;")
    pl(lines: mut lines, t: read "  out[0] = w;")
    pl(lines: mut lines, t: read "  out[1] = b;")
    pl(lines: mut lines, t: read "  let output: Fd = stdout_fd();")
    pl(lines: mut lines, t: read "  if let err(e) = io_write_all(output, pa((&out[0]) as usize), 8) { return 9; }")
    pl(lines: mut lines, t: read "  return 0;")
    pl(lines: mut lines, t: read "}")
    return String.join(parts: read lines, separator: read "\n")
}

// Emit a COMPLETE hosted MC program that TRAINS a 2->2->1 relu MLP by SGD to fit
// |x0 - x1| (a nonlinear target needing the hidden layer), then writes the 4 predictions.
// End-to-end MLP training through the rss frontend -> mc backend. Relies on the MC fixes
// for negative float literals and float array-element arithmetic.
fn assemble_mlp() -> fresh String {
    let lines = List.new<String>()
    pl(lines: mut lines, t: read "import \"std/addr.mc\";")
    pl(lines: mut lines, t: read "import \"std/hosted_io.mc\";")
    pl(lines: mut lines, t: read "")
    pl(lines: mut lines, t: read "export fn hosted_kernel_run() -> i32 {")
    pl(lines: mut lines, t: read "    var x0: [4]f32 = uninit; var x1: [4]f32 = uninit; var t: [4]f32 = uninit;")
    pl(lines: mut lines, t: read "    x0[0] = 0.0; x0[1] = 1.0; x0[2] = 0.0; x0[3] = 3.0;")
    pl(lines: mut lines, t: read "    x1[0] = 0.0; x1[1] = 0.0; x1[2] = 2.0; x1[3] = 1.0;")
    pl(lines: mut lines, t: read "    t[0] = 0.0; t[1] = 1.0; t[2] = 2.0; t[3] = 2.0;")
    pl(lines: mut lines, t: read "    var W1: [4]f32 = uninit; var b1: [2]f32 = uninit; var W2: [2]f32 = uninit;")
    pl(lines: mut lines, t: read "    W1[0] = 0.5; W1[1] = -0.3; W1[2] = -0.4; W1[3] = 0.6;")
    pl(lines: mut lines, t: read "    b1[0] = 0.0; b1[1] = 0.0; W2[0] = 0.7; W2[1] = 0.8;")
    pl(lines: mut lines, t: read "    var b2: f32 = 0.1;")
    pl(lines: mut lines, t: read "    let lr: f32 = 0.05;")
    pl(lines: mut lines, t: read "    var ep: usize = 0;")
    pl(lines: mut lines, t: read "    while ep < 2000 {")
    pl(lines: mut lines, t: read "        var gW1: [4]f32 = uninit; var gb1: [2]f32 = uninit; var gW2: [2]f32 = uninit; var gb2: f32 = 0.0;")
    pl(lines: mut lines, t: read "        gW1[0] = 0.0; gW1[1] = 0.0; gW1[2] = 0.0; gW1[3] = 0.0;")
    pl(lines: mut lines, t: read "        gb1[0] = 0.0; gb1[1] = 0.0; gW2[0] = 0.0; gW2[1] = 0.0;")
    pl(lines: mut lines, t: read "        var s: usize = 0;")
    pl(lines: mut lines, t: read "        while s < 4 {")
    pl(lines: mut lines, t: read "            let a0: f32 = x0[s]; let a1: f32 = x1[s];")
    pl(lines: mut lines, t: read "            var z: [2]f32 = uninit; var h: [2]f32 = uninit;")
    pl(lines: mut lines, t: read "            var j: usize = 0;")
    pl(lines: mut lines, t: read "            while j < 2 {")
    pl(lines: mut lines, t: read "                let zj: f32 = ((a0 * W1[j]) + (a1 * W1[2 + j])) + b1[j];")
    pl(lines: mut lines, t: read "                z[j] = zj;")
    pl(lines: mut lines, t: read "                if zj > 0.0 { h[j] = zj; } else { h[j] = 0.0; }")
    pl(lines: mut lines, t: read "                j = j + 1;")
    pl(lines: mut lines, t: read "            }")
    pl(lines: mut lines, t: read "            var y: f32 = b2;")
    pl(lines: mut lines, t: read "            var jy: usize = 0;")
    pl(lines: mut lines, t: read "            while jy < 2 { y = y + (h[jy] * W2[jy]); jy = jy + 1; }")
    pl(lines: mut lines, t: read "            let dy: f32 = (2.0 * (y - t[s])) / 4.0;")
    pl(lines: mut lines, t: read "            gb2 = gb2 + dy;")
    pl(lines: mut lines, t: read "            var jb: usize = 0;")
    pl(lines: mut lines, t: read "            while jb < 2 {")
    pl(lines: mut lines, t: read "                gW2[jb] = gW2[jb] + (dy * h[jb]);")
    pl(lines: mut lines, t: read "                var dz: f32 = 0.0;")
    pl(lines: mut lines, t: read "                if z[jb] > 0.0 { dz = dy * W2[jb]; }")
    pl(lines: mut lines, t: read "                gW1[jb] = gW1[jb] + (dz * a0);")
    pl(lines: mut lines, t: read "                gW1[2 + jb] = gW1[2 + jb] + (dz * a1);")
    pl(lines: mut lines, t: read "                gb1[jb] = gb1[jb] + dz;")
    pl(lines: mut lines, t: read "                jb = jb + 1;")
    pl(lines: mut lines, t: read "            }")
    pl(lines: mut lines, t: read "            s = s + 1;")
    pl(lines: mut lines, t: read "        }")
    pl(lines: mut lines, t: read "        var u: usize = 0;")
    pl(lines: mut lines, t: read "        while u < 4 { W1[u] = W1[u] - (lr * gW1[u]); u = u + 1; }")
    pl(lines: mut lines, t: read "        b1[0] = b1[0] - (lr * gb1[0]); b1[1] = b1[1] - (lr * gb1[1]);")
    pl(lines: mut lines, t: read "        W2[0] = W2[0] - (lr * gW2[0]); W2[1] = W2[1] - (lr * gW2[1]);")
    pl(lines: mut lines, t: read "        b2 = b2 - (lr * gb2);")
    pl(lines: mut lines, t: read "        ep = ep + 1;")
    pl(lines: mut lines, t: read "    }")
    pl(lines: mut lines, t: read "    var out: [4]f32 = uninit;")
    pl(lines: mut lines, t: read "    var so: usize = 0;")
    pl(lines: mut lines, t: read "    while so < 4 {")
    pl(lines: mut lines, t: read "        let qa0: f32 = x0[so]; let qa1: f32 = x1[so];")
    pl(lines: mut lines, t: read "        var yy: f32 = b2;")
    pl(lines: mut lines, t: read "        var jj: usize = 0;")
    pl(lines: mut lines, t: read "        while jj < 2 {")
    pl(lines: mut lines, t: read "            let qz: f32 = ((qa0 * W1[jj]) + (qa1 * W1[2 + jj])) + b1[jj];")
    pl(lines: mut lines, t: read "            var hj: f32 = 0.0;")
    pl(lines: mut lines, t: read "            if qz > 0.0 { hj = qz; }")
    pl(lines: mut lines, t: read "            yy = yy + (hj * W2[jj]);")
    pl(lines: mut lines, t: read "            jj = jj + 1;")
    pl(lines: mut lines, t: read "        }")
    pl(lines: mut lines, t: read "        out[so] = yy;")
    pl(lines: mut lines, t: read "        so = so + 1;")
    pl(lines: mut lines, t: read "    }")
    pl(lines: mut lines, t: read "    let output: Fd = stdout_fd();")
    pl(lines: mut lines, t: read "    if let err(e) = io_write_all(output, pa((&out[0]) as usize), 16) { return 9; }")
    pl(lines: mut lines, t: read "    return 0;")
    pl(lines: mut lines, t: read "}")
    return String.join(parts: read lines, separator: read "\n")
}

fn main() -> Unit {
    // emit several kernels separated by a marker the driver splits on
    Log.write(message: read render_binary(name: read "E_8", n: 8, opsym: 0, with_prelude: true))
    Log.write(message: read "//---KERNEL---")
    Log.write(message: read render_binary(name: read "E_8", n: 8, opsym: 1, with_prelude: true))
    Log.write(message: read "//---KERNEL---")
    Log.write(message: read render_relu(name: read "E_8", n: 8, with_prelude: true))
    Log.write(message: read "//---KERNEL---")
    Log.write(message: read render_sum(name: read "E_8", n: 8))
    Log.write(message: read "//---KERNEL---")
    Log.write(message: read render_matmul(name: read "E_8", w: 4))
    Log.write(message: read "//---PROGRAM---")
    Log.write(message: read assemble_chain(n: 8))
    Log.write(message: read "//---TRAIN---")
    Log.write(message: read assemble_linreg(epochs: 300))
    Log.write(message: read "//---MLP---")
    Log.write(message: read assemble_mlp())
    return Unit
}
