    let gwcond = mk_data_tensor(cache: mut tcache, dt: read bl, shape: read gwshape, data: read gwconddata)
    let gwx = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read gwshape, data: read gwxdata)
    let gwy = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read gwshape, data: read gwydata)
    let gwout = tensor_where(cache: mut tcache, cond: gwcond, x: gwx, y: gwy)
    let gwroot = tensor_sum_all(cache: mut tcache, x: gwout)
    let gwgx = grad_wrt(cache: mut tcache, root: gwroot, target: gwx)
    let gwgy = grad_wrt(cache: mut tcache, root: gwroot, target: gwy)
    show(label: read "tensor.grad where wrt true branch", l: read eval_tensor(cache: read tcache, id: gwgx))
    show(label: read "tensor.grad where wrt false branch", l: read eval_tensor(cache: read tcache, id: gwgy))
    local gmxd1 = List.new<Float>()
    pushf(l: mut gmxd1, v: 1.0)
    pushf(l: mut gmxd1, v: 2.0)
    pushf(l: mut gmxd1, v: 3.0)
    pushf(l: mut gmxd1, v: 4.0)
    local gmxd2 = List.new<Float>()
    pushf(l: mut gmxd2, v: 4.0)
    pushf(l: mut gmxd2, v: 2.0)
    pushf(l: mut gmxd2, v: 2.0)
    pushf(l: mut gmxd2, v: 4.0)
    let gmx = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read gwshape, data: read gmxd1)
    let gmy = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read gwshape, data: read gmxd2)
    let gmout = tensor_maximum(cache: mut tcache, a: gmx, b: gmy)
    let gmroot = tensor_sum_all(cache: mut tcache, x: gmout)
    let gmgx = grad_wrt(cache: mut tcache, root: gmroot, target: gmx)
    let gmgy = grad_wrt(cache: mut tcache, root: gmroot, target: gmy)
    show(label: read "tensor.grad maximum wrt left", l: read eval_tensor(cache: read tcache, id: gmgx))
    show(label: read "tensor.grad maximum wrt right", l: read eval_tensor(cache: read tcache, id: gmgy))
    let gnegroot = tensor_sum_all(cache: mut tcache, x: tuneg)
    let gneg = grad_wrt(cache: mut tcache, root: gnegroot, target: tu)
    show(label: read "tensor.grad sum(neg(u)) wrt u", l: read eval_tensor(cache: read tcache, id: gneg))
    let greciproot = tensor_sum_all(cache: mut tcache, x: turecip)
    let grecip = grad_wrt(cache: mut tcache, root: greciproot, target: tu)
    show(label: read "tensor.grad sum(reciprocal(u)) wrt u", l: read eval_tensor(cache: read tcache, id: grecip))
    let gsqrtroot = tensor_sum_all(cache: mut tcache, x: tusqrt)
    let gsqrt = grad_wrt(cache: mut tcache, root: gsqrtroot, target: tu)
    show(label: read "tensor.grad sum(sqrt(u)) wrt u", l: read eval_tensor(cache: read tcache, id: gsqrt))
    let gsinroot = tensor_sum_all(cache: mut tcache, x: tsinout)
    let gsin = grad_wrt(cache: mut tcache, root: gsinroot, target: tsin0)
    show(label: read "tensor.grad sum(sin(0)) wrt input", l: read eval_tensor(cache: read tcache, id: gsin))
    let gtrroot = tensor_sum_all(cache: mut tcache, x: ttrout)
    let gtr = grad_wrt(cache: mut tcache, root: gtrroot, target: ttr)
    show(label: read "tensor.grad sum(trunc(t)) wrt t", l: read eval_tensor(cache: read tcache, id: gtr))
    local gpowexpdata = List.new<Float>()
    pushf(l: mut gpowexpdata, v: 2.0)
    pushf(l: mut gpowexpdata, v: 2.0)
    pushf(l: mut gpowexpdata, v: 2.0)
    pushf(l: mut gpowexpdata, v: 2.0)
    let gpowexp = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tushape, data: read gpowexpdata)
    let gpowout = tensor_pow(cache: mut tcache, a: tu, b: gpowexp)
    let gpowroot = tensor_sum_all(cache: mut tcache, x: gpowout)
    let gpowbase = grad_wrt(cache: mut tcache, root: gpowroot, target: tu)
    show(label: read "tensor.grad sum(u**2) wrt u", l: read eval_tensor(cache: read tcache, id: gpowbase))

    local tdot3_shape = shp1(a: 3)
    local tdot_a_data = List.new<Float>()
    pushf(l: mut tdot_a_data, v: 1.0)
    pushf(l: mut tdot_a_data, v: 2.0)
    pushf(l: mut tdot_a_data, v: 3.0)
    let tdot_a = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tdot3_shape, data: read tdot_a_data)
    local tdot_b_data = List.new<Float>()
    pushf(l: mut tdot_b_data, v: 4.0)
    pushf(l: mut tdot_b_data, v: 5.0)
    pushf(l: mut tdot_b_data, v: 6.0)
    let tdot_b = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tdot3_shape, data: read tdot_b_data)
    let tdot1d = tensor_dot(cache: mut tcache, x: tdot_a, w: tdot_b)
    show(label: read "tensor.dot(1d,1d).value", l: read eval_tensor(cache: read tcache, id: tdot1d))
    local tdot_a2_shape = shp(a: 2, b: 3)
    local tdot_a2_data = List.new<Float>()
    pushf(l: mut tdot_a2_data, v: 1.0)
    pushf(l: mut tdot_a2_data, v: 2.0)
    pushf(l: mut tdot_a2_data, v: 3.0)
    pushf(l: mut tdot_a2_data, v: 4.0)
    pushf(l: mut tdot_a2_data, v: 5.0)
    pushf(l: mut tdot_a2_data, v: 6.0)
    let tdot_a2 = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tdot_a2_shape, data: read tdot_a2_data)
    local tdot_b2_shape = shp(a: 3, b: 2)
    local tdot_b2_data = List.new<Float>()
    pushf(l: mut tdot_b2_data, v: 7.0)
    pushf(l: mut tdot_b2_data, v: 8.0)
    pushf(l: mut tdot_b2_data, v: 9.0)
    pushf(l: mut tdot_b2_data, v: 10.0)
    pushf(l: mut tdot_b2_data, v: 11.0)
    pushf(l: mut tdot_b2_data, v: 12.0)
    let tdot_b2 = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tdot_b2_shape, data: read tdot_b2_data)
    let tdot2d = tensor_dot(cache: mut tcache, x: tdot_a2, w: tdot_b2)
    show(label: read "tensor.dot(2d,2d).values", l: read eval_tensor(cache: read tcache, id: tdot2d))
    let tmatvec = tensor_dot(cache: mut tcache, x: tdot_a2, w: tdot_a)
    show(label: read "tensor.dot(2d,1d).values", l: read eval_tensor(cache: read tcache, id: tmatvec))
    local tvec2_shape = shp1(a: 2)
    local tvec2_data = List.new<Float>()
    pushf(l: mut tvec2_data, v: 1.0)
    pushf(l: mut tvec2_data, v: 2.0)
    let tvec2 = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tvec2_shape, data: read tvec2_data)
    local tmat23_shape = shp(a: 2, b: 3)
    local tmat23_data = List.new<Float>()
    pushf(l: mut tmat23_data, v: 3.0)
    pushf(l: mut tmat23_data, v: 4.0)
    pushf(l: mut tmat23_data, v: 5.0)
    pushf(l: mut tmat23_data, v: 6.0)
    pushf(l: mut tmat23_data, v: 7.0)
    pushf(l: mut tmat23_data, v: 8.0)
    let tmat23 = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tmat23_shape, data: read tmat23_data)
    let tvecmat = tensor_dot(cache: mut tcache, x: tvec2, w: tmat23)
    show(label: read "tensor.dot(1d,2d).values", l: read eval_tensor(cache: read tcache, id: tvecmat))
    let tbat_a0 = tensor_arange(cache: mut tcache, dt: read tf32, n: 12)
    let tbat_a = tensor_reshape(cache: mut tcache, x: tbat_a0, new_shape: read shp3(a: 2, b: 2, c: 3))
    let tbat_b0 = tensor_arange(cache: mut tcache, dt: read tf32, n: 12)
    let tbat_b = tensor_reshape(cache: mut tcache, x: tbat_b0, new_shape: read shp3(a: 2, b: 3, c: 2))
    let tbat = tensor_matmul(cache: mut tcache, a: tbat_a, b: tbat_b)
    show(label: read "tensor.matmul(batched).values", l: read eval_tensor(cache: read tcache, id: tbat))
    local tlin_bias_shape = shp1(a: 2)
    local tlin_bias_data = List.new<Float>()
    pushf(l: mut tlin_bias_data, v: 0.5)
    pushf(l: mut tlin_bias_data, v: 0.0 - 1.0)
    let tlin_bias = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tlin_bias_shape, data: read tlin_bias_data)
    local tlin_w_data = List.new<Float>()
    pushf(l: mut tlin_w_data, v: 1.0)
    pushf(l: mut tlin_w_data, v: 0.0)
    pushf(l: mut tlin_w_data, v: 0.0)
    pushf(l: mut tlin_w_data, v: 1.0)
    pushf(l: mut tlin_w_data, v: 1.0)
    pushf(l: mut tlin_w_data, v: 1.0)
    let tlin_w = mk_data_tensor(cache: mut tcache, dt: read tf32, shape: read tdot_b2_shape, data: read tlin_w_data)
    let tlinear = tensor_linear(cache: mut tcache, x: tdot_a2, weight: tlin_w, bias: tlin_bias)
    show(label: read "tensor.linear(values)", l: read eval_tensor(cache: read tcache, id: tlinear))

    local cache = cache_new()
    let f32 = dt_float32()
    // x = [[1,2,3]] (1x3)
    local sx = shp(a: 1, b: 3)
    local dx = List.new<Float>()
    pushf(l: mut dx, v: 1.0)
    pushf(l: mut dx, v: 2.0)
    pushf(l: mut dx, v: 3.0)
    let x = mk_data_tensor(cache: mut cache, dt: read f32, shape: read sx, data: read dx)
    // W = [[1,0],[0,1],[1,1]] (3x2)
    local sw = shp(a: 3, b: 2)
    local dw = List.new<Float>()
    pushf(l: mut dw, v: 1.0)
    pushf(l: mut dw, v: 0.0)
    pushf(l: mut dw, v: 0.0)
