    while i < List.len<Int>(list: read arg.vars) {
        let v = List.get<Int>(list: read arg.vars, index: i)
        if node_var_name(cache: read cache, id: v) == "core_id" {
            List.push<Int>(list: mut out, value: read i)
        }
        i = i + 1
    }
    return take out
