fn tensor_max_unpool2d_nchw_output(cache: mut UOpCache, x: Int, indices: Int, out_h: Int, out_w: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    let bs = List.get<Int>(list: read xs, index: 0)
    let c = List.get<Int>(list: read xs, index: 1)
    let oh = List.get<Int>(list: read xs, index: 2)
    let ow = List.get<Int>(list: read xs, index: 3)
    let pooled_spatial = oh * ow
    let out_spatial = out_h * out_w
    local flat_shape = List.new<Int>()
    push1(l: mut flat_shape, a: bs)
    push1(l: mut flat_shape, a: c)
    push1(l: mut flat_shape, a: 1)
    push1(l: mut flat_shape, a: pooled_spatial)
    let idx_flat = tensor_reshape(cache: mut cache, x: indices, new_shape: read flat_shape)
    let values_flat = tensor_reshape(cache: mut cache, x: x, new_shape: read flat_shape)
    let mask = tensor_one_hot_along_dim(cache: mut cache, x: idx_flat, num_classes: out_spatial, dim: 2)
    local mask_shape = uop_shape(cache: read cache, id: mask)
    let zero = tensor_full(cache: mut cache, dt: read node_dtype(cache: read cache, id: x), shape: read mask_shape, value: 0.0)
    let placed = tensor_where(cache: mut cache, cond: mask, x: values_flat, y: zero)
    let summed = tensor_sum_axis(cache: mut cache, x: placed, axis: 3)
    local out_shape = List.new<Int>()
    push1(l: mut out_shape, a: bs)
    push1(l: mut out_shape, a: c)
    push1(l: mut out_shape, a: out_h)
    push1(l: mut out_shape, a: out_w)
    return tensor_reshape(cache: mut cache, x: summed, new_shape: read out_shape)
}

fn tensor_max_unpool2d_nchw(cache: mut UOpCache, x: Int, indices: Int, kh: Int, kw: Int, sh: Int, sw: Int, dh: Int, dw: Int, pad_top: Int, pad_bottom: Int, pad_left: Int, pad_right: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    let oh = List.get<Int>(list: read xs, index: 2)
    let ow = List.get<Int>(list: read xs, index: 3)
    let out_h = (oh - 1) * sh - (pad_top + pad_bottom) + (dh * (kh - 1) + 1)
    let out_w = (ow - 1) * sw - (pad_left + pad_right) + (dw * (kw - 1) + 1)
    return tensor_max_unpool2d_nchw_output(cache: mut cache, x: x, indices: indices, out_h: out_h, out_w: out_w)
}

