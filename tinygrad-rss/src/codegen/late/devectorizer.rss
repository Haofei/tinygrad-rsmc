// Integrated source-shaped slice of tinygrad/codegen/late/devectorizer.py.
//
// This first slice ports the devectorize_alu scalarization rule plus the
// pm_render normalization rules: vector ALU/CAST/BITCAST nodes become a STACK
// of scalar lane operations, with CAST(AFTER(...)) pushed through ordering
// deps first, and vector CONST/GEP/STACK nodes are normalized for rendering.
// It also ports the context-free load/store folding rules for STACK-backed
// INDEX, GEP, PTRCAT, add-load insertion, and nested-load cleanup.
// Folded-index regrouping, load/store splitting, buffer/index devectorization,
// REDUCE lowering, and image rewrites remain later slices.
features: local

fn devectorizer_supported_alu(op: read Ops) -> Bool {
    if group_alu(op: read op) { return true }
    if op == CAST || op == BITCAST { return true }
    return false
}

fn devectorizer_lane_src(cache: mut UOpCache, id: Int, lane: Int) -> Int {
    local idxs = List.new<Int>()
    List.push<Int>(list: mut idxs, value: read lane)
    return mk_gep(cache: mut cache, x: id, idxs: read idxs)
}

fn devectorizer_no_vectorized_alu(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if devectorizer_supported_alu(op: read op) == false { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    if dt.count == 1 { return None }
    let sdt = dtype_scalar(d: read dt)
    local lanes = List.new<Int>()
    let mut lane = 0
    while lane < dt.count {
        local srcs = List.new<Int>()
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let src = node_src_id(cache: read cache, id: id, k: i)
            let lane_src = devectorizer_lane_src(cache: mut cache, id: src, lane: lane)
            List.push<Int>(list: mut srcs, value: read lane_src)
            i = i + 1
        }
        local arg = node_arg(cache: read cache, id: id)
        let scalar = intern(cache: mut cache, op: op.clone(), dt: read sdt, src: take srcs, arg: take arg)
        List.push<Int>(list: mut lanes, value: read scalar)
        lane = lane + 1
    }
    return Some(uop_stack(cache: mut cache, dt: read dt, srcs: read lanes))
}

fn devectorizer_gep_range(cache: mut UOpCache, id: Int, start: Int, count: Int) -> Int {
    local idxs = List.new<Int>()
    let mut i = 0
    while i < count {
        List.push<Int>(list: mut idxs, value: read (start + i))
        i = i + 1
    }
    return mk_gep(cache: mut cache, x: id, idxs: read idxs)
}

fn devectorizer_no_vectorized_wmma(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != WMMA { return None }
    if node_num_src(cache: read cache, id: id) != 3 { return None }
    local args = node_argints(cache: read cache, id: id)
    if List.len<Int>(list: read args) < 7 { return None }
    let a_elems = List.get<Int>(list: read args, index: 4)
    let b_elems = List.get<Int>(list: read args, index: 5)
    let out_sz = List.get<Int>(list: read args, index: 6)
    if a_elems <= 0 || b_elems <= 0 || out_sz <= 0 { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    if dt.count == out_sz { return None }
    if dt.count < out_sz { return None }
    let groups = dt.count / out_sz
    if groups * out_sz != dt.count { return None }
    let a_src = node_src_id(cache: read cache, id: id, k: 0)
    let b_src = node_src_id(cache: read cache, id: id, k: 1)
    let c_src = node_src_id(cache: read cache, id: id, k: 2)
    if node_full_dtype(cache: read cache, id: a_src).count < groups * a_elems { return None }
    if node_full_dtype(cache: read cache, id: b_src).count < groups * b_elems { return None }
    if node_full_dtype(cache: read cache, id: c_src).count < groups * out_sz { return None }
    let wdt = dtype_vec(base: read dtype_scalar(d: read dt), sz: out_sz)
    local lanes = List.new<Int>()
    let mut g = 0
    while g < groups {
        let aa = devectorizer_gep_range(cache: mut cache, id: a_src, start: g * a_elems, count: a_elems)
        let bb = devectorizer_gep_range(cache: mut cache, id: b_src, start: g * b_elems, count: b_elems)
        let cc = devectorizer_gep_range(cache: mut cache, id: c_src, start: g * out_sz, count: out_sz)
        let ww = mk_wmma(cache: mut cache, a_id: aa, b_id: bb, acc_id: cc, dt: read wdt, arg: read args)
        let mut lane = 0
        while lane < out_sz {
            local one = List.new<Int>()
            List.push<Int>(list: mut one, value: read lane)
            List.push<Int>(list: mut lanes, value: read mk_gep(cache: mut cache, x: ww, idxs: read one))
            lane = lane + 1
        }
        g = g + 1
    }
    return Some(uop_stack(cache: mut cache, dt: read dt, srcs: read lanes))
}

fn devectorizer_scalar_const(cache: mut UOpCache, id: Int, lane: Int) -> Int {
    let sdt = dtype_scalar(d: read node_full_dtype(cache: read cache, id: id))
    local src = List.new<Int>()
    let arg = node_arg(cache: read cache, id: id)
    match arg {
        ArgInts(vals) => {
            let mut v = 0
            if lane < List.len<Int>(list: read vals) { v = List.get<Int>(list: read vals, index: lane) }
            local a = ArgInt(value: v)
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgInt(v) => {
            local a = ArgInt(value: v)
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgFloat(v) => {
            local a = ArgFloat(value: v)
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgBool(v) => {
            local a = ArgBool(value: v)
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgNone => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgStr(v) => {
            local a = ArgStr(text: String.copy(value: read v))
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgReduce(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgVar(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgRange(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgParam(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgAxisSizes(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgDevice(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgOp(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgBufferize(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgProgram(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
        ArgCall(v) => {
            local a = ArgNone
            return intern(cache: mut cache, op: CONST, dt: read sdt, src: take src, arg: take a)
        }
    }
}

fn devectorizer_render_const(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CONST { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    if dt.count <= 1 { return None }
    local lanes = List.new<Int>()
    let mut i = 0
    while i < dt.count {
        List.push<Int>(list: mut lanes, value: read devectorizer_scalar_const(cache: mut cache, id: id, lane: i))
        i = i + 1
    }
    return Some(uop_stack(cache: mut cache, dt: read dt, srcs: read lanes))
}

fn devectorizer_render_gep(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != GEP { return None }
    local idxs = node_argints(cache: read cache, id: id)
    let src = node_src_id(cache: read cache, id: id, k: 0)
    if List.len<Int>(list: read idxs) > 1 {
        local lanes = List.new<Int>()
        let mut i = 0
        while i < List.len<Int>(list: read idxs) {
            local one = List.new<Int>()
            List.push<Int>(list: mut one, value: read List.get<Int>(list: read idxs, index: i))
            List.push<Int>(list: mut lanes, value: read mk_gep(cache: mut cache, x: src, idxs: read one))
            i = i + 1
        }
        let dt = node_full_dtype(cache: read cache, id: id)
        return Some(uop_stack(cache: mut cache, dt: read dt, srcs: read lanes))
    }
    if List.len<Int>(list: read idxs) == 1 && List.get<Int>(list: read idxs, index: 0) == 0 {
        if node_full_dtype(cache: read cache, id: src).count == 1 { return Some(src) }
    }
    return None
}

fn devectorizer_render_stack(cache: read UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != STACK { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    return Some(node_src_id(cache: read cache, id: id, k: 0))
}

fn devectorizer_load_with_ptr(cache: mut UOpCache, id: Int, ptr: Int, dt: read DType) -> Int {
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read ptr)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: id) {
        List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: id, k: i))
        i = i + 1
    }
    local arg = node_arg(cache: read cache, id: id)
    return intern(cache: mut cache, op: LOAD, dt: read dt, src: take srcs, arg: take arg)
}

fn devectorizer_store_with_ptr_value(cache: mut UOpCache, id: Int, ptr: Int, value: Int) -> Int {
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read ptr)
    List.push<Int>(list: mut srcs, value: read value)
    let mut i = 2
    while i < node_num_src(cache: read cache, id: id) {
        List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: id, k: i))
        i = i + 1
    }
    local arg = node_arg(cache: read cache, id: id)
    let dt = node_full_dtype(cache: read cache, id: id)
    return intern(cache: mut cache, op: STORE, dt: read dt, src: take srcs, arg: take arg)
}

fn devectorizer_expand_index_stack(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != INDEX { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let base = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: base) != STACK { return None }
    let vec = node_src_id(cache: read cache, id: id, k: 1)
    let cnt = node_num_src(cache: read cache, id: base)
    if cnt <= 1 { return None }
    local lanes = List.new<Int>()
    let mut lane = 0
    while lane < cnt {
        let buf = node_src_id(cache: read cache, id: base, k: lane)
        local lane_idx_arg = List.new<Int>()
        List.push<Int>(list: mut lane_idx_arg, value: read lane)
        let lane_idx = mk_gep(cache: mut cache, x: vec, idxs: read lane_idx_arg)
        local idx_srcs = List.new<Int>()
        List.push<Int>(list: mut idx_srcs, value: read lane_idx)
        let idx = mk_index(cache: mut cache, base: buf, srcs: read idx_srcs, ptr: true)
        List.push<Int>(list: mut lanes, value: read idx)
        lane = lane + 1
    }
    let dt = node_full_dtype(cache: read cache, id: base)
    return Some(uop_stack(cache: mut cache, dt: read dt, srcs: read lanes))
}

fn devectorizer_gep_after_load(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != LOAD { return None }
    if node_num_src(cache: read cache, id: id) < 1 { return None }
    let ptr = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: ptr) != GEP { return None }
    local idxs = node_argints(cache: read cache, id: ptr)
    let base = node_src_id(cache: read cache, id: ptr, k: 0)
    let ldt = node_full_dtype(cache: read cache, id: id)
    let scalar = dtype_scalar(d: read ldt)
    let ndt = dtype_vec(base: read scalar, sz: List.len<Int>(list: read idxs))
    let nload = devectorizer_load_with_ptr(cache: mut cache, id: id, ptr: base, dt: read ndt)
    return Some(mk_gep(cache: mut cache, x: nload, idxs: read idxs))
}

fn devectorizer_gep_on_store(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != STORE { return None }
    if node_num_src(cache: read cache, id: id) < 2 { return None }
    let ptr = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: ptr) != GEP { return None }
    local idxs = node_argints(cache: read cache, id: ptr)
    if List.len<Int>(list: read idxs) == 0 { return None }
    local inv = argsort(x: read idxs)
    let data = node_src_id(cache: read cache, id: id, k: 1)
    let ndata = mk_gep(cache: mut cache, x: data, idxs: read inv)
    let base = node_src_id(cache: read cache, id: ptr, k: 0)
    return Some(devectorizer_store_with_ptr_value(cache: mut cache, id: id, ptr: base, value: ndata))
}

fn devectorizer_ptrcat_after_load(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != LOAD { return None }
    if node_num_src(cache: read cache, id: id) < 1 { return None }
    let ptr = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: ptr) != PTRCAT { return None }
    local loads = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: ptr) {
        let child = node_src_id(cache: read cache, id: ptr, k: i)
        let cdt = node_dtype(cache: read cache, id: child)
        let load = devectorizer_load_with_ptr(cache: mut cache, id: id, ptr: child, dt: read cdt)
        List.push<Int>(list: mut loads, value: read load)
        i = i + 1
    }
    let dt = node_full_dtype(cache: read cache, id: id)
    return Some(mk_vcat(cache: mut cache, dt: read dt, srcs: read loads))
}

fn devectorizer_ptrcat_after_store(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != STORE { return None }
    if node_num_src(cache: read cache, id: id) < 2 { return None }
    let ptr = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: ptr) != PTRCAT { return None }
    let data = node_src_id(cache: read cache, id: id, k: 1)
    local stores = List.new<Int>()
    let mut offset = 0
    let mut i = 0
    while i < node_num_src(cache: read cache, id: ptr) {
        let child = node_src_id(cache: read cache, id: ptr, k: i)
        let cnt = node_full_dtype(cache: read cache, id: child).count
        local idxs = List.new<Int>()
        let mut j = 0
        while j < cnt {
            List.push<Int>(list: mut idxs, value: read (offset + j))
            j = j + 1
        }
        let val = mk_gep(cache: mut cache, x: data, idxs: read idxs)
        let st = devectorizer_store_with_ptr_value(cache: mut cache, id: id, ptr: child, value: val)
        List.push<Int>(list: mut stores, value: read st)
        offset = offset + cnt
        i = i + 1
    }
    return Some(mk_group(cache: mut cache, srcs: read stores))
}

fn devectorizer_store_load_ptr_cleanup(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != STORE { return None }
    if node_num_src(cache: read cache, id: id) < 2 { return None }
    let ptr = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: ptr) != LOAD { return None }
    if node_num_src(cache: read cache, id: ptr) < 1 { return None }
    let raw_ptr = node_src_id(cache: read cache, id: ptr, k: 0)
    let value = node_src_id(cache: read cache, id: id, k: 1)
    return Some(devectorizer_store_with_ptr_value(cache: mut cache, id: id, ptr: raw_ptr, value: value))
}

fn devectorizer_load_load_ptr_cleanup(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != LOAD { return None }
    if node_num_src(cache: read cache, id: id) < 1 { return None }
    let ptr = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: ptr) != LOAD { return None }
    if node_num_src(cache: read cache, id: ptr) < 1 { return None }
    let raw_ptr = node_src_id(cache: read cache, id: ptr, k: 0)
    let dt = node_full_dtype(cache: read cache, id: id)
    return Some(devectorizer_load_with_ptr(cache: mut cache, id: id, ptr: raw_ptr, dt: read dt))
}

fn devectorizer_add_load_to_value_index(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != INDEX { return None }
    if node_index_is_ptr(cache: read cache, id: id) { return None }
    if node_num_src(cache: read cache, id: id) < 2 { return None }
    let base = node_src_id(cache: read cache, id: id, k: 0)
    local idx_srcs = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: id) {
        List.push<Int>(list: mut idx_srcs, value: read node_src_id(cache: read cache, id: id, k: i))
        i = i + 1
    }
    let ptr = mk_index(cache: mut cache, base: base, srcs: read idx_srcs, ptr: true)
    local load_srcs = List.new<Int>()
    let dt = node_full_dtype(cache: read cache, id: id)
    return Some(mk_load(cache: mut cache, ptr: ptr, srcs: read load_srcs, dt: read dt))
}

fn devectorizer_cast_after(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CAST { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    let after = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: after) != AFTER { return None }
    if node_num_src(cache: read cache, id: after) < 2 { return None }
    let root = node_src_id(cache: read cache, id: after, k: 0)
    let dt = node_full_dtype(cache: read cache, id: id)
    let casted = mk_cast(cache: mut cache, x: root, dt: read dt)
    local deps = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: after) {
        List.push<Int>(list: mut deps, value: read node_src_id(cache: read cache, id: after, k: i))
        i = i + 1
    }
    return Some(mk_after(cache: mut cache, id: casted, srcs: read deps))
}

fn devectorizer_rewrite(cache: mut UOpCache, id: Int) -> Option<Int> {
    match devectorizer_cast_after(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_expand_index_stack(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_gep_after_load(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_gep_on_store(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_ptrcat_after_load(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_ptrcat_after_store(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_store_load_ptr_cleanup(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_load_load_ptr_cleanup(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_add_load_to_value_index(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_no_vectorized_wmma(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_no_vectorized_alu(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_render_const(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_render_gep(cache: mut cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    match devectorizer_render_stack(cache: read cache, id: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    return None
}
