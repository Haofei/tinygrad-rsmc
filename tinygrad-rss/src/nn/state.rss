// First source-shaped slice of tinygrad/nn/state.py.
features: native, local

struct TensorIOState derives(Clone) {
    tensor: Int,
    position: Int,
}

struct StateDict derives(Clone) {
    names: List<String>,
    tensors: List<Int>,
}

fn tensor_io_new(t: Int) -> fresh TensorIOState {
    return TensorIOState(tensor: t, position: 0)
}

fn readable(io: read TensorIOState) -> Bool { return true }
fn seekable(io: read TensorIOState) -> Bool { return true }

fn read(cache: read UOpCache, io: mut TensorIOState, size: Int) -> fresh Bytes {
    local data = tensor_data(cache: read cache, x: io.tensor)
    let total = List.len<Float>(list: read data)
    let mut nread = size
    if nread < 0 { nread = total - io.position }
    let end_pos = io.position + nread
    if end_pos > total { nread = total - io.position }
    local ints = tensor_data_uints_slice(data: read data, start: io.position, len: nread)
    io.position = io.position + nread
    return Bytes.from_uints(values: read ints)
}

fn readinto(cache: read UOpCache, io: mut TensorIOState, size: Int) -> Int {
    local data = tensor_data(cache: read cache, x: io.tensor)
    let total = List.len<Float>(list: read data)
    let mut nread = size
    if nread < 0 { nread = total - io.position }
    let end_pos = io.position + nread
    if end_pos > total { nread = total - io.position }
    io.position = io.position + nread
    return nread
}

fn seek(cache: read UOpCache, io: mut TensorIOState, offset: Int, whence: Int) -> Int {
    local data = tensor_data(cache: read cache, x: io.tensor)
    let total = List.len<Float>(list: read data)
    let mut pos = offset
    if whence == 1 { pos = io.position + offset }
    if whence == 2 { pos = total + offset }
    if pos < 0 { pos = 0 }
    if pos > total { pos = total }
    io.position = pos
    return io.position
}

fn __enter__(io: read TensorIOState) -> fresh TensorIOState {
    return TensorIOState(tensor: io.tensor, position: io.position)
}

fn write(io: mut TensorIOState, bytes_len: Int) -> Bool { return false }
fn writelines(io: mut TensorIOState, lines: read List<String>) -> Bool { return false }

fn accept_filename(cache: mut UOpCache, path: read String) -> Int {
    return fs_load(cache: mut cache, hash: 0, path: read path, size: 2147483647)
}

fn state_dict_new() -> fresh StateDict {
    local names = List.new<String>()
    local tensors = List.new<Int>()
    return StateDict(names: take names, tensors: take tensors)
}

fn state_safe_dtype(name: read String) -> fresh DType {
    if name == "BOOL" { return dt_bool() }
    if name == "I8" { return dt_int8() }
    if name == "U8" { return dt_uint8() }
    if name == "I16" { return dt_int16() }
    if name == "U16" { return dt_uint16() }
    if name == "I32" { return dt_int32() }
    if name == "U32" { return dt_uint32() }
    if name == "I64" { return dt_int64() }
    if name == "U64" { return dt_uint64() }
    if name == "F16" { return dt_float16() }
    if name == "BF16" { return dt_bfloat16() }
    if name == "F64" { return dt_float64() }
    return dt_float32()
}

fn state_safe_dtype_name(dt: read DType) -> fresh String {
    if dt.name == dt_bool().name { return String.copy(value: read "BOOL") }
    if dt.name == dt_int8().name { return String.copy(value: read "I8") }
    if dt.name == dt_uint8().name { return String.copy(value: read "U8") }
    if dt.name == dt_int16().name { return String.copy(value: read "I16") }
    if dt.name == dt_uint16().name { return String.copy(value: read "U16") }
    if dt.name == dt_int32().name { return String.copy(value: read "I32") }
    if dt.name == dt_uint32().name { return String.copy(value: read "U32") }
    if dt.name == dt_int64().name { return String.copy(value: read "I64") }
    if dt.name == dt_uint64().name { return String.copy(value: read "U64") }
    if dt.name == dt_float16().name { return String.copy(value: read "F16") }
    if dt.name == dt_bfloat16().name { return String.copy(value: read "BF16") }
    if dt.name == dt_float64().name { return String.copy(value: read "F64") }
    return String.copy(value: read "F32")
}

fn state_header_len_from_data(data: read List<Float>) -> Int {
    let mut out = 0
    let mut mul = 1
    let mut i = 0
    while i < 8 && i < List.len<Float>(list: read data) {
        let b = trunc_float_to_int(v: List.get<Float>(list: read data, index: i)) & 255
        out = out + b * mul
        mul = mul * 256
        i = i + 1
    }
    return out
}

fn state_bytes_from_tensor_slice(cache: read UOpCache, t: Int, start: Int, len: Int) -> fresh Bytes {
    local data = tensor_data(cache: read cache, x: t)
    local ints = tensor_data_uints_slice(data: read data, start: start, len: len)
    return Bytes.from_uints(values: read ints)
}

fn state_json_array_ints_into(value: read JsonValue, out: mut List<Int>) -> Unit {
    match Json.array_ints(value: read value) {
        Ok(items) => {
            let mut i = 0
            while i < List.len<Int>(list: read items) {
                let v = List.get<Int>(list: read items, index: i)
                push1(l: mut out, a: v)
                i = i + 1
            }
        }
        Err(error) => {}
    }
    return Unit
}

fn state_tensor_from_safetensor_bytes(cache: mut UOpCache, bytes: read Bytes, dtype: read DType, shape: read List<Int>) -> Int {
    let raw = tensor_bytes_to_1d(cache: mut cache, bytes: read bytes)
    if dtype.name == dt_uint8().name {
        return tensor_reshape(cache: mut cache, x: raw, new_shape: read shape)
    }
    let casted = tensor_bitcast(cache: mut cache, x: raw, dt: read dtype)
    return tensor_reshape(cache: mut cache, x: casted, new_shape: read shape)
}

fn safe_load_metadata(cache: read UOpCache, t: Int) -> fresh StateDict {
    local sd = state_dict_new()
    local data = tensor_data(cache: read cache, x: t)
    let header_len = state_header_len_from_data(data: read data)
    if header_len <= 0 || header_len + 8 > List.len<Float>(list: read data) { return take sd }
    local header_bytes = state_bytes_from_tensor_slice(cache: read cache, t: t, start: 8, len: header_len)
    local header_text = Bytes.to_string(value: read header_bytes)
    match Json.parse(text: read header_text) {
        Ok(doc) => {
            match Json.object_keys(value: read doc) {
                Ok(keys) => {
                    let mut i = 0
                    while i < List.len<String>(list: read keys) {
                        local name = List.get<String>(list: read keys, index: i)
                        if name != "__metadata__" {
                            List.push<String>(list: mut sd.names, value: read (manage name))
                        }
                        i = i + 1
                    }
                }
                Err(error) => {}
            }
        }
        Err(error) => {}
    }
    return take sd
}

fn safe_load(cache: mut UOpCache, t: Int) -> fresh StateDict {
    local sd = state_dict_new()
    local data = tensor_data(cache: read cache, x: t)
    let header_len = state_header_len_from_data(data: read data)
    if header_len <= 0 || header_len + 8 > List.len<Float>(list: read data) { return take sd }
    local header_bytes = state_bytes_from_tensor_slice(cache: read cache, t: t, start: 8, len: header_len)
    local header_text = Bytes.to_string(value: read header_bytes)
    match Json.parse(text: read header_text) {
        Ok(doc) => {
            match Json.object_keys(value: read doc) {
                Ok(keys) => {
                    let mut i = 0
                    while i < List.len<String>(list: read keys) {
                        local name = List.get<String>(list: read keys, index: i)
                        if name != "__metadata__" {
                            match Json.field(value: read doc, name: read name) {
                                Ok(entry) => {
                                    let mut dtype_name = String.copy(value: read "F32")
                                    match Json.field_string(value: read entry, name: read "dtype") {
                                        Ok(v) => { dtype_name = String.copy(value: read v) }
                                        Err(error) => {}
                                    }
                                    local shape = List.new<Int>()
                                    match Json.field(value: read entry, name: read "shape") {
                                        Ok(shape_json) => { state_json_array_ints_into(value: read shape_json, out: mut shape) }
                                        Err(error) => {}
                                    }
                                    local offsets = List.new<Int>()
                                    match Json.field(value: read entry, name: read "data_offsets") {
                                        Ok(offset_json) => { state_json_array_ints_into(value: read offset_json, out: mut offsets) }
                                        Err(error) => {}
                                    }
                                    if List.len<Int>(list: read offsets) >= 2 {
                                        let start = List.get<Int>(list: read offsets, index: 0)
                                        let end = List.get<Int>(list: read offsets, index: 1)
                                        if end >= start {
                                            local raw = state_bytes_from_tensor_slice(cache: read cache, t: t, start: 8 + header_len + start, len: end - start)
                                            local dtype = state_safe_dtype(name: read dtype_name)
                                            let tensor = state_tensor_from_safetensor_bytes(cache: mut cache, bytes: read raw, dtype: read dtype, shape: read shape)
                                            List.push<String>(list: mut sd.names, value: read (manage name))
                                            push1(l: mut sd.tensors, a: tensor)
                                        }
                                    }
                                }
                                Err(error) => {}
                            }
                        }
                        i = i + 1
                    }
                }
                Err(error) => {}
            }
        }
        Err(error) => {}
    }
    return take sd
}

fn safe_save(cache: read UOpCache, tensors: read StateDict, path: read String) -> Bool {
    let p = Path.from_string(value: read path)
    local empty_ints = List.new<Int>()
    local empty = Bytes.from_uints(values: read empty_ints)
    match File.write_bytes(path: read p, data: read empty) {
        Ok(unit) => { return true }
        Err(error) => { return false }
    }
}

fn get_state_dict(tensors: read List<TensorState>, prefix: read String) -> fresh StateDict {
    local names = List.new<String>()
    local vals = List.new<Int>()
    let mut i = 0
    while i < List.len<TensorState>(list: read tensors) {
        local nm = String.concat(left: read prefix, right: read Int.to_string(value: read i))
        List.push<String>(list: mut names, value: read (manage nm))
        local t = List.get<TensorState>(list: read tensors, index: i)
        push1(l: mut vals, a: t.uop)
        i = i + 1
    }
    return StateDict(names: take names, tensors: take vals)
}

fn get_parameters(tensors: read List<TensorState>) -> fresh List<TensorState> {
    local out = List.new<TensorState>()
    let mut i = 0
    while i < List.len<TensorState>(list: read tensors) {
        local t = List.get<TensorState>(list: read tensors, index: i)
        if t.is_param { List.push<TensorState>(list: mut out, value: read (manage t)) }
        i = i + 1
    }
    return take out
}

fn load_state_dict(cache: mut UOpCache, model: read List<TensorState>, state_dict: read StateDict, strict: Bool) -> fresh List<TensorState> {
    local out = List.new<TensorState>()
    let mut i = 0
    while i < List.len<TensorState>(list: read model) {
        local t = List.get<TensorState>(list: read model, index: i)
        if i < List.len<Int>(list: read state_dict.tensors) {
            local nt = tensor_state_assign(cache: mut cache, t: read t, value: List.get<Int>(list: read state_dict.tensors, index: i))
            List.push<TensorState>(list: mut out, value: read (manage nt))
        } else {
            List.push<TensorState>(list: mut out, value: read (manage t))
        }
        i = i + 1
    }
    return take out
}

fn zip_extract(cache: read UOpCache, t: Int) -> fresh StateDict { return state_dict_new() }

fn tar_is_zero_block(data: read List<Float>, offset: Int) -> Bool {
    if offset + 512 > List.len<Float>(list: read data) { return true }
    let mut i = 0
    while i < 512 {
        if (trunc_float_to_int(v: List.get<Float>(list: read data, index: offset + i)) & 255) != 0 { return false }
        i = i + 1
    }
    return true
}

fn tar_read_octal(data: read List<Float>, offset: Int, len: Int) -> Int {
    let mut out = 0
    let mut i = 0
    while i < len && offset + i < List.len<Float>(list: read data) {
        let b = trunc_float_to_int(v: List.get<Float>(list: read data, index: offset + i)) & 255
        if b >= 48 && b <= 55 { out = out * 8 + (b - 48) }
        i = i + 1
    }
    return out
}

fn tar_name_from_header(data: read List<Float>, offset: Int) -> fresh String {
    local name_bytes = List.new<Int>()
    let mut i = 0
    while i < 100 && offset + i < List.len<Float>(list: read data) {
        let b = trunc_float_to_int(v: List.get<Float>(list: read data, index: offset + i)) & 255
        if b == 0 { return Bytes.to_string(value: read Bytes.from_uints(values: read name_bytes)) }
        push1(l: mut name_bytes, a: b)
        i = i + 1
    }
    return Bytes.to_string(value: read Bytes.from_uints(values: read name_bytes))
}

fn tar_next_offset(offset: Int, size: Int) -> Int {
    return offset + 512 + round_up(num: size, amt: 512)
}

fn tar_extract(cache: mut UOpCache, t: Int) -> fresh StateDict {
    local sd = state_dict_new()
    local data = tensor_data(cache: read cache, x: t)
    let mut offset = 0
    while offset + 512 <= List.len<Float>(list: read data) && tar_is_zero_block(data: read data, offset: offset) == false {
        let size = tar_read_octal(data: read data, offset: offset + 124, len: 12)
        let typeflag = trunc_float_to_int(v: List.get<Float>(list: read data, index: offset + 156)) & 255
        if offset + 512 + size <= List.len<Float>(list: read data) && (typeflag == 0 || typeflag == 48) {
            local name = tar_name_from_header(data: read data, offset: offset)
            local raw = state_bytes_from_tensor_slice(cache: read cache, t: t, start: offset + 512, len: size)
            let tensor = tensor_bytes_to_1d(cache: mut cache, bytes: read raw)
            List.push<String>(list: mut sd.names, value: read (manage name))
            push1(l: mut sd.tensors, a: tensor)
        }
        offset = tar_next_offset(offset: offset, size: size)
    }
    return take sd
}

fn tar_smoke_push_zero(dst: mut List<Int>, n: Int) -> Unit {
    let mut i = 0
    while i < n {
        push1(l: mut dst, a: 0)
        i = i + 1
    }
    return Unit
}

fn tar_smoke_push_bytes(dst: mut List<Int>, src: read List<Int>) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read src) {
        push1(l: mut dst, a: List.get<Int>(list: read src, index: i))
        i = i + 1
    }
    return Unit
}

fn tar_smoke_push_string_padded(dst: mut List<Int>, s: read String, width: Int) -> Unit {
    local bs = Bytes.to_uints(value: read String.to_bytes(value: read s))
    let mut i = 0
    while i < width {
        if i < List.len<Int>(list: read bs) {
            push1(l: mut dst, a: List.get<Int>(list: read bs, index: i))
        } else {
            push1(l: mut dst, a: 0)
        }
        i = i + 1
    }
    return Unit
}

fn tar_smoke_push_octal_size(dst: mut List<Int>, size: Int) -> Unit {
    let mut div = 1073741824
    let mut remaining = size
    let mut i = 0
    while i < 11 {
        let digit = remaining / div
        push1(l: mut dst, a: 48 + digit)
        remaining = remaining - digit * div
        div = div / 8
        i = i + 1
    }
    push1(l: mut dst, a: 0)
    return Unit
}

fn tar_smoke_append_header(dst: mut List<Int>, name: read String, size: Int, typeflag: Int) -> Unit {
    tar_smoke_push_string_padded(dst: mut dst, s: read name, width: 100)
    tar_smoke_push_string_padded(dst: mut dst, s: read "0000777", width: 8)
    tar_smoke_push_string_padded(dst: mut dst, s: read "0000000", width: 8)
    tar_smoke_push_string_padded(dst: mut dst, s: read "0000000", width: 8)
    tar_smoke_push_octal_size(dst: mut dst, size: size)
    tar_smoke_push_string_padded(dst: mut dst, s: read "00000000000", width: 12)
    tar_smoke_push_string_padded(dst: mut dst, s: read "        ", width: 8)
    push1(l: mut dst, a: typeflag)
    tar_smoke_push_zero(dst: mut dst, n: 100)
    tar_smoke_push_zero(dst: mut dst, n: 255)
    return Unit
}

fn tar_extract_smoke(cache: mut UOpCache) -> Bool {
    local bytes = List.new<Int>()
    tar_smoke_append_header(dst: mut bytes, name: read "a.txt", size: 4, typeflag: 48)
    tar_smoke_push_bytes(dst: mut bytes, src: read [65, 66, 67, 68])
    tar_smoke_push_zero(dst: mut bytes, n: 508)
    tar_smoke_append_header(dst: mut bytes, name: read "dir/", size: 0, typeflag: 53)
    tar_smoke_append_header(dst: mut bytes, name: read "dir/b.bin", size: 3, typeflag: 48)
    tar_smoke_push_bytes(dst: mut bytes, src: read [9, 8, 7])
    tar_smoke_push_zero(dst: mut bytes, n: 509)
    tar_smoke_push_zero(dst: mut bytes, n: 1024)
    let tar_tensor = tensor_bytes_to_1d(cache: mut cache, bytes: read Bytes.from_uints(values: read bytes))
    local extracted = tar_extract(cache: mut cache, t: tar_tensor)
    if List.len<String>(list: read extracted.names) != 2 { return false }
    if List.get<String>(list: read extracted.names, index: 0) != "a.txt" { return false }
    if List.get<String>(list: read extracted.names, index: 1) != "dir/b.bin" { return false }
    local a_vals = eval_tensor(cache: read cache, id: List.get<Int>(list: read extracted.tensors, index: 0))
    local b_vals = eval_tensor(cache: read cache, id: List.get<Int>(list: read extracted.tensors, index: 1))
    return List.len<Float>(list: read a_vals) == 4 && List.get<Float>(list: read a_vals, index: 0) == 65.0 && List.get<Float>(list: read a_vals, index: 3) == 68.0 && List.len<Float>(list: read b_vals) == 3 && List.get<Float>(list: read b_vals, index: 0) == 9.0 && List.get<Float>(list: read b_vals, index: 2) == 7.0
}

fn torch_load(cache: read UOpCache, t: Int) -> fresh StateDict { return state_dict_new() }
