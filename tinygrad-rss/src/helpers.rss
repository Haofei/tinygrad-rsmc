fn flat_to_grouped(flat: read List<Int>, counts: read List<Int>) -> fresh List<List<Int>> {
    local out = List.new<List<Int>>()
    let mut off = 0
    let mut i = 0
    while i < List.len<Int>(list: read counts) {
        local group = List.new<Int>()
        let mut j = 0
        let n = List.get<Int>(list: read counts, index: i)
        while j < n && off < List.len<Int>(list: read flat) {
            List.push<Int>(list: mut group, value: read List.get<Int>(list: read flat, index: off))
            off = off + 1
            j = j + 1
        }
        List.push<List<Int>>(list: mut out, value: read (manage group))
        i = i + 1
    }
    return take out
}
