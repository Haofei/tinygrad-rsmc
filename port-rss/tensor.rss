// Port of the CORE of tinygrad/tensor.py: a Tensor is a thin wrapper over a lazy UOp graph
// (tensor.py: `Tensor.uop`), and tensor ops build UOp nodes rather than computing eagerly.
// This integrates the ported layers: Tensor ops build a UOp graph, which the ported
// PatternMatcher (simplify) rewrites -- exactly tinygrad's lazy build-then-rewrite flow.
//
// NOTE: self-contained (re-declares the UOp core + simplify) because rss has no per-file
// import; a real port would make port-rss/ an rss package so dtype/uop/rewrite/tensor share
// definitions. Faithful in behavior; arg/dtype simplified as in uop.rss.

features: local

sum Ops derives(Clone, Eq, Hash) { Const Var Add Mul }

struct UOp derives(Clone, Eq, Hash) {
    op: Ops
    src: List<UOp>
    arg: Int
}

fn uconst(v: Int) -> fresh UOp { return UOp(op: Const, src: List.new<UOp>(), arg: v) }
fn uvar(id: Int) -> fresh UOp { return UOp(op: Var, src: List.new<UOp>(), arg: id) }
fn uadd(a: read UOp, b: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    List.push(list: mut s, value: read b)
    return UOp(op: Add, src: take s, arg: 0)
}
fn umul(a: read UOp, b: read UOp) -> fresh UOp {
    local s = List.new<UOp>()
    List.push(list: mut s, value: read a)
    List.push(list: mut s, value: read b)
    return UOp(op: Mul, src: take s, arg: 0)
}
fn is_const(u: read UOp) -> Bool { return u.op == Const }

fn simplify(u: read UOp) -> fresh UOp {
    if u.op == Const { return uconst(v: u.arg) }
    if u.op == Var { return uvar(id: u.arg) }
    let c0 = List.get(list: read u.src, index: 0)
    let c1 = List.get(list: read u.src, index: 1)
    let a = simplify(u: read c0)
    let b = simplify(u: read c1)
    if u.op == Mul {
        if is_const(u: read a) {
            if is_const(u: read b) { return uconst(v: a.arg * b.arg) }
            if a.arg == 1 { return simplify(u: read c1) }
            if a.arg == 0 { return uconst(v: 0) }
        }
        if is_const(u: read b) {
            if b.arg == 1 { return simplify(u: read c0) }
            if b.arg == 0 { return uconst(v: 0) }
        }
        return umul(a: read a, b: read b)
    }
    if u.op == Add {
        if is_const(u: read a) {
            if is_const(u: read b) { return uconst(v: a.arg + b.arg) }
            if a.arg == 0 { return simplify(u: read c1) }
        }
        if is_const(u: read b) {
            if b.arg == 0 { return simplify(u: read c0) }
        }
        return uadd(a: read a, b: read b)
    }
    return uadd(a: read a, b: read b)
}

// ---- Tensor: a wrapper over a lazy UOp graph (tensor.py) ----
struct Tensor derives(Clone) {
    uop: UOp
}
fn t_const(v: Int) -> fresh Tensor { return Tensor(uop: uconst(v: v)) }
fn t_var(id: Int) -> fresh Tensor { return Tensor(uop: uvar(id: id)) }
fn t_add(a: read Tensor, b: read Tensor) -> fresh Tensor { return Tensor(uop: uadd(a: read a.uop, b: read b.uop)) }
fn t_mul(a: read Tensor, b: read Tensor) -> fresh Tensor { return Tensor(uop: umul(a: read a.uop, b: read b.uop)) }

fn op_name(u: read UOp) -> fresh String {
    if u.op == Const { return "Const" }
    if u.op == Var { return "Var" }
    if u.op == Add { return "Add" }
    return "Mul"
}
fn describe(label: read String, u: read UOp) -> Unit {
    let mut s = String.concat(left: read label, right: read op_name(u: read u))
    s = String.concat(left: read s, right: read "(arg=")
    s = String.concat(left: read s, right: read Int.to_string(value: read u.arg))
    s = String.concat(left: read s, right: read ")")
    Log.write(message: read s)
    return Unit
}

fn main() -> Unit {
    // Build the Tensor expression  (x * 1) + (2 + 3)  with Tensor ops...
    let x = t_var(id: 7)
    let lhs = t_mul(a: read x, b: read t_const(v: 1))
    let rhs = t_add(a: read t_const(v: 2), b: read t_const(v: 3))
    let expr = t_add(a: read lhs, b: read rhs)
    // ...the graph is lazy: root is an Add over a Mul and an Add (nothing computed yet)
    describe(label: read "lazy graph root = ", u: read expr.uop)   // Add

    // PatternMatcher rewrite the Tensor's UOp graph -> Add(Var(7), Const(5))
    let s = simplify(u: read expr.uop)
    describe(label: read "after simplify root = ", u: read s)       // Add
    let l = List.get(list: read s.src, index: 0)
    let r = List.get(list: read s.src, index: 1)
    describe(label: read "  left  = ", u: read l)   // Var(7)
    describe(label: read "  right = ", u: read r)   // Const(5)

    // Fully-constant Tensor expr folds to a single Const: (2*3) + 4 -> Const(10)
    let k = t_add(a: read t_mul(a: read t_const(v: 2), b: read t_const(v: 3)), b: read t_const(v: 4))
    describe(label: read "simplify((2*3)+4) = ", u: read simplify(u: read k.uop))  // Const(10)
    return Unit
}
