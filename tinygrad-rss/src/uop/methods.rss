fn uop_expand(cache: mut UOpCache, id: Int, new_shape: read List<Int>) -> Int {
    if List.len<Int>(list: read new_shape) == 0 {
        if List.len<Int>(list: read uop_shape(cache: read cache, id: id)) == 0 { return id }
    }
    return mk_expand(cache: mut cache, x: id, new_shape: read new_shape)
}

fn uop_permute(cache: mut UOpCache, id: Int, perm: read List<Int>) -> Int {
    return mk_permute(cache: mut cache, x: id, perm: read perm)
}

fn uop_flip(cache: mut UOpCache, id: Int, axes: read List<Int>) -> Int {
    return mk_flip(cache: mut cache, x: id, axes: read axes)
}

fn uop_shrink(cache: mut UOpCache, id: Int, starts: read List<Int>, ends: read List<Int>) -> Int {
    if List.len<Int>(list: read starts) == 0 && List.len<Int>(list: read ends) == 0 {
        if List.len<Int>(list: read uop_shape(cache: read cache, id: id)) == 0 { return id }
    }
    return mk_shrink(cache: mut cache, x: id, starts: read starts, ends: read ends)
}

fn uop_pad(cache: mut UOpCache, id: Int, before: read List<Int>, after: read List<Int>) -> Int {
    if List.len<Int>(list: read before) == 0 && List.len<Int>(list: read after) == 0 {
        if List.len<Int>(list: read uop_shape(cache: read cache, id: id)) == 0 { return id }
    }
    return mk_pad(cache: mut cache, x: id, before: read before, after: read after)
}

fn uop_call_opaque_body(op: read Ops) -> Bool {
    if op == SINK || op == PROGRAM || op == LINEAR || op == COPY || op == SLICE || op == CUSTOM_FUNCTION { return true }
    return false
}

fn uop_call(cache: mut UOpCache, id: Int, args: read List<Int>, call: read CallArg) -> Int {
    let op = node_op(cache: read cache, id: id)
    if uop_call_opaque_body(op: read op) {
        return mk_call(cache: mut cache, body: id, args: read args, call: read call)
    }
    let mut body = id
    if op != TUPLE {
        local srcs = List.new<Int>()
        List.push<Int>(list: mut srcs, value: read id)
        body = mk_tuple(cache: mut cache, srcs: read srcs)
    }
    return mk_function(cache: mut cache, body_tuple: body, args: read args, call: read call)
}

fn uop_set(cache: mut UOpCache, id: Int, value: Int, ends: read List<Int>) -> Int {
    if node_op(cache: read cache, id: id) != INDEX { return id }
    let base = node_src_id(cache: read cache, id: id, k: 0)
    let store = uop_store(cache: mut cache, id: id, value: value, gate: read None)
    let ended = uop_end(cache: mut cache, id: store, srcs: read ends)
    local deps = List.new<Int>()
    List.push<Int>(list: mut deps, value: read ended)
    return uop_after(cache: mut cache, id: base, srcs: read deps)
}

fn uop_substitute(cache: mut UOpCache, id: Int, old_id: Int, new_id: Int) -> Int {
    if id == old_id { return new_id }
    local new_src = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        let repl = uop_substitute(cache: mut cache, id: child, old_id: old_id, new_id: new_id)
        List.push<Int>(list: mut new_src, value: read repl)
        i = i + 1
    }
    let op = node_op(cache: read cache, id: id)
    let dt = node_full_dtype(cache: read cache, id: id)
    local arg = node_arg(cache: read cache, id: id)
    return intern(cache: mut cache, op: op, dt: read dt, src: take new_src, arg: take arg)
}

fn uop_visit_toposort_with_enter_calls(cache: read UOpCache, id: Int, seen: mut Set<Int>, order: mut List<Int>, enter_calls: Bool) -> Unit {
    if Set.contains(set: read seen, value: read id) { return Unit }
    let op = node_op(cache: read cache, id: id)
    let mut i = 0
    if enter_calls == false {
        if op == CALL || op == FUNCTION { i = 1 }
    }
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        uop_visit_toposort_with_enter_calls(cache: read cache, id: child, seen: mut seen, order: mut order, enter_calls: enter_calls)
        i = i + 1
    }
    Set.insert(set: mut seen, value: read id)
    List.push<Int>(list: mut order, value: read id)
    return Unit
}

fn uop_toposort_enter_calls(cache: read UOpCache, id: Int, enter_calls: Bool) -> fresh List<Int> {
    local seen = Set.new<Int>()
    local order = List.new<Int>()
    uop_visit_toposort_with_enter_calls(cache: read cache, id: id, seen: mut seen, order: mut order, enter_calls: enter_calls)
    return take order
}

fn uop_toposort(cache: read UOpCache, id: Int) -> fresh List<Int> {
    return uop_toposort_enter_calls(cache: read cache, id: id, enter_calls: true)
}

fn uop_backward_slice(cache: read UOpCache, id: Int) -> fresh List<Int> {
    local order = uop_toposort(cache: read cache, id: id)
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read order) {
        let node = List.get<Int>(list: read order, index: i)
        if node != id { List.push<Int>(list: mut out, value: read node) }
        i = i + 1
    }
    return take out
}

fn uop_op_in_backward_slice_with_self(cache: read UOpCache, id: Int, op: Ops) -> Bool {
    if node_op(cache: read cache, id: id) == op { return true }
    local nodes = uop_backward_slice(cache: read cache, id: id)
    let mut i = 0
    while i < List.len<Int>(list: read nodes) {
        let node = List.get<Int>(list: read nodes, index: i)
        if node_op(cache: read cache, id: node) == op { return true }
        i = i + 1
    }
    return false
}

fn uop_sparents_count(cache: read UOpCache, id: Int) -> Int {
    let order = uop_toposort(cache: read cache, id: id)
    return List.len<Int>(list: read order)
}

fn uop_axis(cache: read UOpCache, id: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if op == COPY { return 0 - 1 }
    if op == MULTI { return node_const_int(cache: read cache, id: id) }
    if op == GETTUPLE {
        if node_num_src(cache: read cache, id: id) == 0 { return 0 - 1 }
        let src = node_src_id(cache: read cache, id: id, k: 0)
        let in_tuple = uop_tuple_source_for_gettuple(cache: read cache, id: src)
        if node_op(cache: read cache, id: in_tuple) == TUPLE {
            let idx = node_const_int(cache: read cache, id: id)
            if idx >= 0 && idx < node_num_src(cache: read cache, id: in_tuple) {
                let child = node_src_id(cache: read cache, id: in_tuple, k: idx)
                return uop_axis(cache: read cache, id: child)
            }
        }
        return 0 - 1
    }
    if op == PARAM {
        if node_param_has_axis(cache: read cache, id: id) { return node_param_axis(cache: read cache, id: id) }
        return 0 - 1
    }
    if group_alu(op: read op) {
        let mut axis = 0 - 1
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            let child_axis = uop_axis(cache: read cache, id: child)
            if child_axis >= 0 { axis = child_axis }
            i = i + 1
        }
        return axis
    }
    if node_num_src(cache: read cache, id: id) == 0 { return 0 - 1 }
    let src_axis = uop_axis(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
    if op == REDUCE {
        if src_axis < 0 { return 0 - 1 }
        local axes = node_argints(cache: read cache, id: id)
        if uop_ints_contains(vals: read axes, v: src_axis) { return 0 - 1 }
        return src_axis
    }
    if op == PERMUTE {
        if src_axis < 0 { return 0 - 1 }
        local perm = node_argints(cache: read cache, id: id)
        let mut i = 0
        while i < List.len<Int>(list: read perm) {
            if List.get<Int>(list: read perm, index: i) == src_axis { return i }
            i = i + 1
        }
        return 0 - 1
    }
    return src_axis
}

fn uop_device_key_from_arg(arg: read Arg) -> fresh String {
    match arg {
        ArgDevice(dv) => { return device_arg_key(d: read dv) }
        ArgParam(p) => {
            if List.len<String>(list: read p.devices) > 0 {
                local dv = DeviceArg(devices: copy_string_list(l: read p.devices))
                return device_arg_key(d: read dv)
            }
            return String.copy(value: read p.device)
        }
        ArgBufferize(b) => {
            if b.has_device == false { return String.copy(value: read "") }
            if b.is_device_int { return Int.to_string(value: read b.device_int) }
            local dv = DeviceArg(devices: copy_string_list(l: read b.devices))
            return device_arg_key(d: read dv)
        }
        ArgNone => { return String.copy(value: read "") }
        ArgInt(v) => { return String.copy(value: read "") }
        ArgFloat(f) => { return String.copy(value: read "") }
        ArgBool(b) => { return String.copy(value: read "") }
        ArgStr(t) => { return String.copy(value: read "") }
        ArgInts(vals) => { return String.copy(value: read "") }
        ArgReduce(r) => { return String.copy(value: read "") }
        ArgVar(v) => { return String.copy(value: read "") }
        ArgRange(r) => { return String.copy(value: read "") }
        ArgAxisSizes(a) => { return String.copy(value: read "") }
        ArgOp(o) => { return String.copy(value: read "") }
        ArgProgram(p) => { return String.copy(value: read "") }
        ArgCall(c) => { return String.copy(value: read "") }
    }
}

fn uop_device_count_from_key(key: read String) -> Int {
    if String.len(value: read key) == 0 { return 0 }
    let mut n = 1
    let mut i = 0
    while i < String.len(value: read key) {
        match String.char_at(value: read key, index: i) {
            Some(ch) => {
                if Char.to_code(value: read ch) == 124 { n = n + 1 }
            }
            None => {}
        }
        i = i + 1
    }
    return n
}

fn uop_device_name_at(cache: read UOpCache, id: Int, index: Int) -> fresh String {
    let op = node_op(cache: read cache, id: id)
    if op == DEVICE {
        return node_device_name(cache: read cache, id: id, index: index)
    }
    if op == BUFFER {
        if node_is_upstream_buffer(cache: read cache, id: id) {
            return uop_device_name_at(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1), index: index)
        }
    }
    if op == COPY || op == ALLREDUCE {
        if node_num_src(cache: read cache, id: id) >= 2 {
            return uop_device_name_at(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1), index: index)
        }
    }
    if op == MSELECT {
        if index == 0 { return uop_device_key(cache: read cache, id: id) }
        return String.copy(value: read "")
    }
    if op == MSTACK {
        if index >= 0 && index < node_num_src(cache: read cache, id: id) {
            return uop_device_key(cache: read cache, id: node_src_id(cache: read cache, id: id, k: index))
        }
        return String.copy(value: read "")
    }
    if node_num_src(cache: read cache, id: id) > 0 {
        return uop_device_name_at(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0), index: index)
    }
    let key = uop_device_key(cache: read cache, id: id)
    if index == 0 { return String.copy(value: read key) }
    return String.copy(value: read "")
}

fn uop_device_key(cache: read UOpCache, id: Int) -> fresh String {
    let op = node_op(cache: read cache, id: id)
    if op == PARAM || op == DEVICE || op == STAGE {
        local arg = node_arg(cache: read cache, id: id)
        return uop_device_key_from_arg(arg: read arg)
    }
    if op == AFTER {
        if node_num_src(cache: read cache, id: id) > 0 {
            return uop_device_key(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
        return String.copy(value: read "")
    }
    if op == MSELECT {
        if node_num_src(cache: read cache, id: id) == 0 { return String.copy(value: read "") }
        let src = node_src_id(cache: read cache, id: id, k: 0)
        let idx = node_const_int(cache: read cache, id: id)
        return uop_device_name_at(cache: read cache, id: src, index: idx)
    }
    if op == MSTACK {
        let mut out = String.copy(value: read "")
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            let key = uop_device_key(cache: read cache, id: child)
            if i > 0 { out = String.concat(left: read out, right: read "|") }
            out = String.concat(left: read out, right: read key)
            i = i + 1
        }
        return String.copy(value: read out)
    }
    if op == BUFFER {
        local arg = node_arg(cache: read cache, id: id)
        let param_key = uop_device_key_from_arg(arg: read arg)
        if String.len(value: read param_key) > 0 { return String.copy(value: read param_key) }
        if node_is_upstream_buffer(cache: read cache, id: id) {
            return uop_device_key(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1))
        }
        return String.copy(value: read "")
    }
    if op == COPY || op == ALLREDUCE {
        if node_num_src(cache: read cache, id: id) >= 2 {
            return uop_device_key(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 1))
        }
        return String.copy(value: read "")
    }
    if node_num_src(cache: read cache, id: id) > 0 {
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            let key = uop_device_key(cache: read cache, id: child)
            if String.len(value: read key) > 0 { return String.copy(value: read key) }
            i = i + 1
        }
    }
    return String.copy(value: read "")
}

fn uop_device_count(cache: read UOpCache, id: Int) -> Int {
    let key = uop_device_key(cache: read cache, id: id)
    return uop_device_count_from_key(key: read key)
}

fn uop_addrspace_key(cache: read UOpCache, id: Int) -> fresh String {
    let op = node_op(cache: read cache, id: id)
    if op == PARAM {
        return addr_space_name(a: read node_param_addrspace(cache: read cache, id: id))
    }
    if op == BUFFER {
        if node_arg_is_param(cache: read cache, id: id) {
            return addr_space_name(a: read node_param_addrspace(cache: read cache, id: id))
        }
        return addr_space_name(a: read ADDR_GLOBAL)
    }
    if op == DEFINE_LOCAL { return addr_space_name(a: read ADDR_LOCAL) }
    if op == DEFINE_REG { return addr_space_name(a: read ADDR_REG) }
    if op == LOAD { return addr_space_name(a: read ADDR_REG) }
    if op == INDEX || op == CAST || op == AFTER || op == REDUCE || op == GEP || op == STORE || group_movement(op: read op) {
        if node_num_src(cache: read cache, id: id) > 0 {
            return uop_addrspace_key(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
        return String.copy(value: read "")
    }
    if op == STACK || op == WMMA || group_elementwise(op: read op) {
        let mut seen = false
        let mut first = String.copy(value: read "")
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            let key = uop_addrspace_key(cache: read cache, id: child)
            if String.len(value: read key) > 0 {
                if seen == false {
                    first = String.copy(value: read key)
                    seen = true
                } else {
                    if first != key { return String.copy(value: read "") }
                }
            }
            i = i + 1
        }
        if seen { return String.copy(value: read first) }
        return String.copy(value: read "")
    }
    return String.copy(value: read "")
}

fn uop_ints_contains(vals: read List<Int>, v: Int) -> Bool {
    let mut i = 0
    while i < List.len<Int>(list: read vals) {
        if List.get<Int>(list: read vals, index: i) == v { return true }
        i = i + 1
    }
    return false
}

fn uop_push_unique(vals: mut List<Int>, v: Int) -> Unit {
    if uop_ints_contains(vals: read vals, v: v) == false {
        List.push<Int>(list: mut vals, value: read v)
    }
    return Unit
}

fn uop_remove_value(vals: read List<Int>, v: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read vals) {
        let x = List.get<Int>(list: read vals, index: i)
        if x != v { List.push<Int>(list: mut out, value: read x) }
        i = i + 1
    }
    return take out
}

fn uop_range_start_index(op: read Ops) -> Int {
    if op == STAGE { return 1 }
    if op == REDUCE { return 1 }
    if op == WMMA { return 3 }
    if op == END { return 1 }
    if op == CALL { return 1 }
    if op == FUNCTION { return 1 }
    if op == COPY { return 2 }
    if op == SLICE { return 2 }
    if op == LINEAR { return 0 }
    return 0 - 1
}

fn uop_contract_axis_ids(cache: read UOpCache, id: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let pairs = node_axis_size_pairs(cache: read cache, id: id)
    let mut i = 0
    while i + 1 < List.len<Int>(list: read pairs) {
        let axis = List.get<Int>(list: read pairs, index: i)
        uop_push_unique(vals: mut out, v: axis)
        i = i + 2
    }
    return take out
}

fn uop_ended_ranges(cache: read UOpCache, id: Int) -> fresh List<Int> {
    let op = node_op(cache: read cache, id: id)
    let start = uop_range_start_index(op: read op)
    local out = List.new<Int>()
    if start >= 0 {
        let mut i = start
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            uop_push_unique(vals: mut out, v: child)
            i = i + 1
        }
        return take out
    }
    if op == AFTER {
        let mut i = 1
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            local cr = uop_ended_ranges(cache: read cache, id: child)
            let mut j = 0
            while j < List.len<Int>(list: read cr) {
                uop_push_unique(vals: mut out, v: List.get<Int>(list: read cr, index: j))
                j = j + 1
            }
            i = i + 1
        }
        return take out
    }
    if op == CONTRACT {
        let ids = uop_contract_axis_ids(cache: read cache, id: id)
        if node_num_src(cache: read cache, id: id) > 0 {
            let base = node_src_id(cache: read cache, id: id, k: 0)
            local ranges = uop_ranges(cache: read cache, id: base)
            let mut i = 0
            while i < List.len<Int>(list: read ranges) {
                let r = List.get<Int>(list: read ranges, index: i)
                if node_op(cache: read cache, id: r) == RANGE {
                    if uop_ints_contains(vals: read ids, v: node_range_axis_id(cache: read cache, id: r)) {
                        uop_push_unique(vals: mut out, v: r)
                    }
                }
                i = i + 1
            }
        }
        return take out
    }
    return take out
}

fn uop_ranges_base(cache: read UOpCache, id: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let child = node_src_id(cache: read cache, id: id, k: i)
        local child_ranges = uop_ranges(cache: read cache, id: child)
        let mut j = 0
        while j < List.len<Int>(list: read child_ranges) {
            uop_push_unique(vals: mut out, v: List.get<Int>(list: read child_ranges, index: j))
            j = j + 1
        }
        i = i + 1
    }
    local ended = uop_ended_ranges(cache: read cache, id: id)
    local removals = List.new<Int>()
    let mut e = 0
    while e < List.len<Int>(list: read ended) {
        let er = List.get<Int>(list: read ended, index: e)
        if node_op(cache: read cache, id: er) == RANGE {
            uop_push_unique(vals: mut removals, v: er)
        } else {
            local er_ranges = uop_ranges(cache: read cache, id: er)
            let mut k = 0
            while k < List.len<Int>(list: read er_ranges) {
                uop_push_unique(vals: mut removals, v: List.get<Int>(list: read er_ranges, index: k))
                k = k + 1
            }
        }
        e = e + 1
    }
    local filtered = List.new<Int>()
    let mut f = 0
    while f < List.len<Int>(list: read out) {
        let r = List.get<Int>(list: read out, index: f)
        if uop_ints_contains(vals: read removals, v: r) == false {
            List.push<Int>(list: mut filtered, value: read r)
        }
        f = f + 1
    }
    return take filtered
}

fn uop_ranges(cache: read UOpCache, id: Int) -> fresh List<Int> {
    local out = uop_ranges_base(cache: read cache, id: id)
    if node_op(cache: read cache, id: id) == RANGE {
        local with_self = List.new<Int>()
        List.push<Int>(list: mut with_self, value: read id)
        let mut i = 0
        while i < List.len<Int>(list: read out) {
            uop_push_unique(vals: mut with_self, v: List.get<Int>(list: read out, index: i))
            i = i + 1
        }
        return take with_self
    }
    return take out
}

fn uop_gettuple(cache: read UOpCache, id: Int, idx: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if op == STACK {
        return node_src_id(cache: read cache, id: id, k: idx)
    }
    if op == TUPLE {
        return node_src_id(cache: read cache, id: id, k: idx)
    }
    if op == FUNCTION {
        let in_tuple = node_src_id(cache: read cache, id: id, k: 0)
        if node_op(cache: read cache, id: in_tuple) == TUPLE {
            return node_src_id(cache: read cache, id: in_tuple, k: idx)
        }
    }
    return id
}

fn uop_split_by_op(cache: read UOpCache, id: Int, sep: Ops) -> fresh List<Int> {
    local out = List.new<Int>()
    let op = node_op(cache: read cache, id: id)
    if op == sep {
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            local parts = uop_split_by_op(cache: read cache, id: child, sep: sep.clone())
            let mut j = 0
            while j < List.len<Int>(list: read parts) {
                let part = List.get<Int>(list: read parts, index: j)
                List.push<Int>(list: mut out, value: read part)
                j = j + 1
            }
            i = i + 1
        }
    } else {
        List.push<Int>(list: mut out, value: read id)
    }
    return take out
}

fn uop_base(cache: read UOpCache, id: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if group_movement(op: read op) {
        return uop_base(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
    }
    if op == MULTI {
        return uop_base(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
    }
    if op == DETACH {
        return uop_base(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
    }
    return id
}

fn uop_multibase(cache: read UOpCache, id: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if group_movement(op: read op) {
        return uop_base(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
    }
    if op == DETACH {
        return uop_base(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
    }
    return id
}

fn uop_buf_uop(cache: mut UOpCache, id: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if op == BUFFER || op == PARAM { return id }
    if op == MSELECT {
        if node_num_src(cache: read cache, id: id) == 0 { return id }
        let src = node_src_id(cache: read cache, id: id, k: 0)
        let idx = node_const_int(cache: read cache, id: id)
        let buf = uop_buf_uop(cache: mut cache, id: src)
        return mk_mselect(cache: mut cache, x: buf, index: idx)
    }
    if op == MSTACK {
        local srcs = List.new<Int>()
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            let buf = uop_buf_uop(cache: mut cache, id: child)
            List.push<Int>(list: mut srcs, value: read buf)
            i = i + 1
        }
        let dt = node_full_dtype(cache: read cache, id: id)
        return mk_mstack(cache: mut cache, dt: read dt, srcs: read srcs)
    }
    let b = uop_base(cache: read cache, id: id)
    if node_op(cache: read cache, id: b) == AFTER {
        if node_num_src(cache: read cache, id: b) > 0 {
            let first = node_src_id(cache: read cache, id: b, k: 0)
            let buf = uop_buf_uop(cache: mut cache, id: first)
            return uop_base(cache: read cache, id: buf)
        }
    }
    let mut s = id
    let mut sop = node_op(cache: read cache, id: s)
    while node_num_src(cache: read cache, id: s) > 0 && sop != BUFFER && sop != PARAM && sop != STAGE && sop != MSTACK {
        s = node_src_id(cache: read cache, id: s, k: 0)
        sop = node_op(cache: read cache, id: s)
    }
    return s
}

fn uop_has_buffer_identity(cache: read UOpCache, id: Int) -> Bool {
    let op = node_op(cache: read cache, id: id)
    if op == RESHAPE || op == MULTI {
        if node_num_src(cache: read cache, id: id) == 0 { return false }
        return uop_has_buffer_identity(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
    }
    if op == GETTUPLE {
        if node_num_src(cache: read cache, id: id) == 0 { return false }
        let src = node_src_id(cache: read cache, id: id, k: 0)
        if node_op(cache: read cache, id: src) == TUPLE {
            let idx = node_const_int(cache: read cache, id: id)
            if idx >= 0 && idx < node_num_src(cache: read cache, id: src) {
                return uop_has_buffer_identity(cache: read cache, id: node_src_id(cache: read cache, id: src, k: idx))
            }
        }
        return false
    }
    if op == BUFFER { return true }
    if op == SLICE { return true }
    if op == PARAM { return true }
    return false
}

