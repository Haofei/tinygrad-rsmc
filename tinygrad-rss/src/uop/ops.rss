fn node_addrspace(cache: read UOpCache, id: Int) -> fresh AddrSpace {
    let op = node_op(cache: read cache, id: id)
    if op == PARAM { return node_param_addrspace(cache: read cache, id: id) }
    if op == DEFINE_LOCAL { return ADDR_LOCAL }
    if op == DEFINE_REG { return ADDR_REG }
    if op == BUFFER { return ADDR_GLOBAL }
    if op == LOAD { return ADDR_REG }
    if op == INDEX {
        if node_num_src(cache: read cache, id: id) > 0 {
            return node_addrspace(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
    }
    if op == CAST {
        if node_num_src(cache: read cache, id: id) > 0 {
            return node_addrspace(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
    }
    if op == AFTER {
        if node_num_src(cache: read cache, id: id) > 0 {
            return node_addrspace(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
    }
    if op == REDUCE {
        if node_num_src(cache: read cache, id: id) > 0 {
            return node_addrspace(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
    }
    if op == GEP {
        if node_num_src(cache: read cache, id: id) > 0 {
            return node_addrspace(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
    }
    if op == STORE {
        if node_num_src(cache: read cache, id: id) > 0 {
            return node_addrspace(cache: read cache, id: node_src_id(cache: read cache, id: id, k: 0))
        }
    }
    return ADDR_GLOBAL
}

