fn Linear(cache: mut UOpCache, in_features: Int, out_features: Int, bias: Bool, seed: Int) -> fresh LinearLayer {
    local wshape = List.new<Int>()
    push1(l: mut wshape, a: out_features)
    push1(l: mut wshape, a: in_features)
    let bound = 1.0 / Math.sqrt(value: Int.to_float(value: read in_features))
    let weight = tensor_uniform(cache: mut cache, dt: read dt_default_float(), shape: read wshape, low: 0.0 - bound, high: bound, seed: seed)
    let mut bias_node = 0 - 1
    if bias {
        local bshape = shp1(a: out_features)
        bias_node = tensor_uniform(cache: mut cache, dt: read dt_default_float(), shape: read bshape, low: 0.0 - bound, high: bound, seed: seed + 1)
    }
    return LinearLayer(weight: weight, bias: bias_node, has_bias: bias)
}

fn Linear_call(cache: mut UOpCache, layer: read LinearLayer, x: Int) -> Int {
    if layer.has_bias { return tensor_linear(cache: mut cache, x: x, weight: layer.weight, bias: layer.bias) }
    return tensor_dot(cache: mut cache, x: x, w: layer.weight)
}

fn _norm(cache: mut UOpCache, x: Int, eps: Float) -> Int {
    let sq = tensor_mul(cache: mut cache, a: x, b: x)
    let mean = tensor_mean_dim(cache: mut cache, x: sq, dim: 0 - 1)
    let eps_t = tensor_const_like_float(cache: mut cache, x: mean, value: eps)
    let mean_eps = tensor_add(cache: mut cache, a: mean, b: eps_t)
    let denom = tensor_rsqrt(cache: mut cache, x: mean_eps)
    return tensor_mul(cache: mut cache, a: x, b: denom)
}

fn LayerNorm(cache: mut UOpCache, normalized_size: Int, eps: Float, elementwise_affine: Bool) -> fresh NormLayer {
    local shape = shp1(a: normalized_size)
    let mut weight = 0 - 1
    let mut bias = 0 - 1
    if elementwise_affine {
        weight = tensor_ones(cache: mut cache, dt: read dt_default_float(), shape: read shape)
        bias = tensor_zeros(cache: mut cache, dt: read dt_default_float(), shape: read shape)
    }
    return NormLayer(weight: weight, bias: bias, eps: eps, has_weight: elementwise_affine, has_bias: elementwise_affine, size: normalized_size, groups: 1)
}

fn LayerNorm_call(cache: mut UOpCache, layer: read NormLayer, x: Int) -> Int {
    local axes = shp1(a: 0 - 1)
    let y = tensor_layernorm_axes(cache: mut cache, x: x, axes: read axes, eps: layer.eps)
    if layer.has_weight == false { return y }
    let yw = tensor_mul(cache: mut cache, a: y, b: layer.weight)
    return tensor_add(cache: mut cache, a: yw, b: layer.bias)
}

fn LayerNorm2d_call(cache: mut UOpCache, layer: read NormLayer, x: Int) -> Int {
    local p0 = List.new<Int>()
    push1(l: mut p0, a: 0)
    push1(l: mut p0, a: 2)
    push1(l: mut p0, a: 3)
    push1(l: mut p0, a: 1)
    let xp = tensor_permute(cache: mut cache, x: x, perm: read p0)
    let yp = LayerNorm_call(cache: mut cache, layer: read layer, x: xp)
    local p1 = List.new<Int>()
    push1(l: mut p1, a: 0)
    push1(l: mut p1, a: 3)
    push1(l: mut p1, a: 1)
    push1(l: mut p1, a: 2)
    return tensor_permute(cache: mut cache, x: yp, perm: read p1)
}

fn GroupNorm(cache: mut UOpCache, num_groups: Int, num_channels: Int, eps: Float, affine: Bool) -> fresh NormLayer {
    local shape = shp1(a: num_channels)
    let mut weight = 0 - 1
    let mut bias = 0 - 1
    if affine {
        weight = tensor_ones(cache: mut cache, dt: read dt_default_float(), shape: read shape)
        bias = tensor_zeros(cache: mut cache, dt: read dt_default_float(), shape: read shape)
    }
    return NormLayer(weight: weight, bias: bias, eps: eps, has_weight: affine, has_bias: affine, size: num_channels, groups: num_groups)
}

fn GroupNorm_call(cache: mut UOpCache, layer: read NormLayer, x: Int) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    local rshape = List.new<Int>()
    push1(l: mut rshape, a: List.get<Int>(list: read xs, index: 0))
    push1(l: mut rshape, a: layer.groups)
    push1(l: mut rshape, a: 0 - 1)
    let xr = tensor_reshape(cache: mut cache, x: x, new_shape: read rshape)
    local axes = shp1(a: 0 - 1)
    let yn = tensor_layernorm_axes(cache: mut cache, x: xr, axes: read axes, eps: layer.eps)
    let y = tensor_reshape(cache: mut cache, x: yn, new_shape: read xs)
    if layer.has_weight == false { return y }
    local aff_shape = List.new<Int>()
    push1(l: mut aff_shape, a: 1)
    push1(l: mut aff_shape, a: layer.size)
    let mut i = 2
    while i < List.len<Int>(list: read xs) {
        push1(l: mut aff_shape, a: 1)
        i = i + 1
    }
    let w = tensor_reshape(cache: mut cache, x: layer.weight, new_shape: read aff_shape)
    let b = tensor_reshape(cache: mut cache, x: layer.bias, new_shape: read aff_shape)
    let yw = tensor_mul(cache: mut cache, a: y, b: w)
    return tensor_add(cache: mut cache, a: yw, b: b)
}

fn InstanceNorm(cache: mut UOpCache, num_features: Int, eps: Float, affine: Bool) -> fresh NormLayer {
    return GroupNorm(cache: mut cache, num_groups: num_features, num_channels: num_features, eps: eps, affine: affine)
}

fn InstanceNorm_call(cache: mut UOpCache, layer: read NormLayer, x: Int) -> Int {
    return GroupNorm_call(cache: mut cache, layer: read layer, x: x)
}

fn RMSNorm(cache: mut UOpCache, dim: Int, eps: Float, elementwise_affine: Bool) -> fresh RMSNormLayer {
    local shape = shp1(a: dim)
    let mut weight = 0 - 1
    if elementwise_affine {
        weight = tensor_ones(cache: mut cache, dt: read dt_default_float(), shape: read shape)
    }
    return RMSNormLayer(weight: weight, eps: eps, has_weight: elementwise_affine)
}

fn RMSNorm_call(cache: mut UOpCache, layer: read RMSNormLayer, x: Int) -> Int {
    let y = _norm(cache: mut cache, x: x, eps: layer.eps)
    if layer.has_weight { return tensor_mul(cache: mut cache, a: y, b: layer.weight) }
    return y
}

fn _embedding_fwd(cache: mut UOpCache, weight: Int, idx: Int) -> Int {
    local idx_vals = tensor_data(cache: read cache, x: idx)
    local wshape = uop_shape(cache: read cache, id: weight)
    local wdata = tensor_data(cache: read cache, x: weight)
    let vocab = List.get<Int>(list: read wshape, index: 0)
    let embed = List.get<Int>(list: read wshape, index: 1)
    local out_shape = uop_shape(cache: read cache, id: idx)
    push1(l: mut out_shape, a: embed)
    local out = List.new<Float>()
    let mut i = 0
    while i < List.len<Float>(list: read idx_vals) {
        let mut token = trunc_float_to_int(v: List.get<Float>(list: read idx_vals, index: i))
        if token < 0 { token = 0 }
        if token >= vocab { token = vocab - 1 }
        let mut j = 0
        while j < embed {
            pushf1(l: mut out, a: List.get<Float>(list: read wdata, index: token * embed + j))
            j = j + 1
        }
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read node_dtype(cache: read cache, id: weight), shape: read out_shape, data: read out)
}

fn _embedding_bwd(cache: mut UOpCache, grad_emb: Int, weight: Int, idx: Int) -> Int {
    local wshape = uop_shape(cache: read cache, id: weight)
    let vocab = List.get<Int>(list: read wshape, index: 0)
    let embed = List.get<Int>(list: read wshape, index: 1)
    local out = List.new<Float>()
    let mut z = 0
    while z < vocab * embed {
        pushf1(l: mut out, a: 0.0)
        z = z + 1
    }
    local idx_vals = tensor_data(cache: read cache, x: idx)
    local grad_vals = tensor_data(cache: read cache, x: grad_emb)
    let mut i = 0
    while i < List.len<Float>(list: read idx_vals) {
        let mut token = trunc_float_to_int(v: List.get<Float>(list: read idx_vals, index: i))
        if token < 0 { token = 0 }
        if token >= vocab { token = vocab - 1 }
        let mut j = 0
        while j < embed {
            let pos = token * embed + j
            let old = List.get<Float>(list: read out, index: pos)
            List.set<Float>(list: mut out, index: pos, value: read (old + List.get<Float>(list: read grad_vals, index: i * embed + j)))
            j = j + 1
        }
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read node_dtype(cache: read cache, id: weight), shape: read wshape, data: read out)
}

fn _embedding_fwd_fxn(cache: mut UOpCache, weight: Int, idx: Int, device: read String) -> Int {
    return _embedding_fwd(cache: mut cache, weight: weight, idx: idx)
}

fn Embedding(cache: mut UOpCache, vocab_size: Int, embed_size: Int, seed: Int) -> fresh EmbeddingLayer {
    local shape = List.new<Int>()
    push1(l: mut shape, a: vocab_size)
    push1(l: mut shape, a: embed_size)
    let weight = tensor_glorot_uniform(cache: mut cache, dt: read dt_default_float(), shape: read shape, seed: seed)
    return EmbeddingLayer(weight: weight, vocab_size: vocab_size, embed_size: embed_size)
}

fn Embedding_call(cache: mut UOpCache, layer: read EmbeddingLayer, idx: Int) -> Int {
    return _embedding_fwd(cache: mut cache, weight: layer.weight, idx: idx)
}
