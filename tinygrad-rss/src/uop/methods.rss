fn safe_exp2(x: Int) -> Int {
    if x < 0 { return 0 }
    if x >= 62 { return 4611686018427387904 }
    return 1 << x
}

fn safe_pow(x: Int, y: Int) -> Int {
    if y < 0 { return 0 }
    let mut out = 1
    let mut i = 0
    while i < y {
        out = out * x
        i = i + 1
    }
    return out
}

