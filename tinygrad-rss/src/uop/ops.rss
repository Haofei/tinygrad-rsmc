fn copy_int_list(l: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read l) {
        let v = List.get<Int>(list: read l, index: i)
        List.push<Int>(list: mut out, value: read v)
        i = i + 1
    }
    return take out
}

fn copy_string_list(l: read List<String>) -> fresh List<String> {
    local out = List.new<String>()
    let mut i = 0
    while i < List.len<String>(list: read l) {
        let v = List.get<String>(list: read l, index: i)
        List.push<String>(list: mut out, value: read String.copy(value: read v))
        i = i + 1
    }
    return take out
}

fn device_arg_from_list(devices: read List<String>) -> fresh DeviceArg {
    local d = copy_string_list(l: read devices)
    return DeviceArg(devices: take d)
}

fn device_arg_single(device: read String) -> fresh DeviceArg {
    local d = List.new<String>()
    List.push<String>(list: mut d, value: read String.copy(value: read device))
    return DeviceArg(devices: take d)
}

fn device_arg_key(d: read DeviceArg) -> fresh String {
    let mut s = String.copy(value: read "")
    let mut i = 0
    while i < List.len<String>(list: read d.devices) {
        if i > 0 { s = String.concat(left: read s, right: read "|") }
        let v = List.get<String>(list: read d.devices, index: i)
        s = String.concat(left: read s, right: read v)
        i = i + 1
    }
    return String.copy(value: read s)
}

fn append_ints(dst: mut List<Int>, src: read List<Int>) -> Unit {
    let mut i = 0
    while i < List.len<Int>(list: read src) {
        let v = List.get<Int>(list: read src, index: i)
        List.push<Int>(list: mut dst, value: read v)
        i = i + 1
    }
    return Unit
}

fn make_key(op: Ops, dt: read DType, src: read List<Int>, arg: read Arg) -> fresh NodeKey {
    let dtn = String.copy(value: read dt.name)
    local s = copy_int_list(l: read src)
    local kd0 = List.new<Int>()
    match arg {
        ArgNone => {
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 0, ai: 0, af: "", sv: "", kd: take kd0)
        }
        ArgInt(v) => {
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 1, ai: v, af: "", sv: "", kd: take kd0)
        }
        ArgFloat(f) => {
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 2, ai: 0, af: Float.to_string(value: read f), sv: "", kd: take kd0)
        }
        ArgBool(b) => {
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 3, ai: bool_to_int(b: b), af: "", sv: "", kd: take kd0)
        }
        ArgStr(t) => {
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 4, ai: 0, af: "", sv: String.copy(value: read t), kd: take kd0)
        }
        ArgInts(vals) => {
            local d = copy_int_list(l: read vals)
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 5, ai: 0, af: "", sv: "", kd: take d)
        }
        ArgReduce(r) => {
            local d = copy_int_list(l: read r.axes)
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 6, ai: r.kind, af: "", sv: "", kd: take d)
        }
        ArgVar(v) => {
            local d = List.new<Int>()
            List.push<Int>(list: mut d, value: read v.min_val)
            List.push<Int>(list: mut d, value: read v.max_val)
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 7, ai: 0, af: "", sv: String.copy(value: read v.name), kd: take d)
        }
        ArgRange(r) => {
            local d = copy_int_list(l: read r.axes)
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 8, ai: axis_type_ord(t: read r.axis_type), af: "", sv: "", kd: take d)
        }
        ArgParam(p) => {
            local d = List.new<Int>()
            List.push<Int>(list: mut d, value: read p.slot)
            List.push<Int>(list: mut d, value: read bool_to_int(b: p.has_vmin_vmax))
            List.push<Int>(list: mut d, value: read p.vmin)
            List.push<Int>(list: mut d, value: read p.vmax)
            List.push<Int>(list: mut d, value: read addr_space_ord(a: read p.addrspace))
            List.push<Int>(list: mut d, value: read bool_to_int(b: p.has_axis))
            List.push<Int>(list: mut d, value: read p.axis)
            let ndev = String.concat(left: read p.name, right: read "|")
            local ndev2 = String.concat(left: read ndev, right: read p.device)
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 9, ai: 0, af: "", sv: take ndev2, kd: take d)
        }
        ArgAxisSizes(a) => {
            local d = copy_int_list(l: read a.pairs)
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 10, ai: 0, af: "", sv: "", kd: take d)
        }
        ArgDevice(dv) => {
            local d = List.new<Int>()
            List.push<Int>(list: mut d, value: read List.len<String>(list: read dv.devices))
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 11, ai: 0, af: "", sv: device_arg_key(d: read dv), kd: take d)
        }
        ArgOp(o) => {
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 12, ai: 0, af: "", sv: ops_key_name(op: read o), kd: take kd0)
        }
        ArgBufferize(b) => {
            local d = List.new<Int>()
            List.push<Int>(list: mut d, value: read bool_to_int(b: b.has_device))
            List.push<Int>(list: mut d, value: read bool_to_int(b: b.is_device_int))
            List.push<Int>(list: mut d, value: read b.device_int)
            List.push<Int>(list: mut d, value: read addr_space_ord(a: read b.addrspace))
            List.push<Int>(list: mut d, value: read bool_to_int(b: b.removable))
            List.push<Int>(list: mut d, value: read List.len<String>(list: read b.devices))
            local dev = DeviceArg(devices: copy_string_list(l: read b.devices))
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 13, ai: 0, af: "", sv: device_arg_key(d: read dev), kd: take d)
        }
        ArgProgram(p) => {
            local d = List.new<Int>()
            append_ints(dst: mut d, src: read p.global_size)
            List.push<Int>(list: mut d, value: read bool_to_int(b: p.has_local_size))
            append_ints(dst: mut d, src: read p.local_size)
            append_ints(dst: mut d, src: read p.vars)
            append_ints(dst: mut d, src: read p.globals)
            append_ints(dst: mut d, src: read p.outs)
            append_ints(dst: mut d, src: read p.ins)
            List.push<Int>(list: mut d, value: read bool_to_int(b: p.has_estimates))
            List.push<Int>(list: mut d, value: read p.estimate_ops)
            List.push<Int>(list: mut d, value: read p.estimate_lds)
            List.push<Int>(list: mut d, value: read p.estimate_mem)
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 14, ai: 0, af: "", sv: String.copy(value: read p.name), kd: take d)
        }
        ArgCall(c) => {
            local d = List.new<Int>()
            List.push<Int>(list: mut d, value: read bool_to_int(b: c.has_name))
            List.push<Int>(list: mut d, value: read bool_to_int(b: c.precompile))
            List.push<Int>(list: mut d, value: read bool_to_int(b: c.precompile_backward))
            return NodeKey(op: op, dtype: dtn, src: take s, ak: 15, ai: 0, af: "", sv: String.copy(value: read c.name), kd: take d)
        }
    }
}

// UOpMetaClass.__call__: dedup by structural key, return the (shared) node id.
fn intern(cache: mut UOpCache, op: Ops, dt: read DType, src: take List<Int>, arg: take Arg) -> Int {
    let key = make_key(op: op.clone(), dt: read dt, src: read src, arg: read arg)
    match Map.get<NodeKey, Int>(map: read cache.index, key: read key) {
        Some(id) => { return id }
        None => {
            let id = cache_len(cache: read cache)
            let node = UOp(op: op, dtype: dtype_copy(d: read dt), src: take src, arg: take arg)
            List.push<UOp>(list: mut cache.nodes, value: read node)
            Map.insert<NodeKey, Int>(map: mut cache.index, key: read key, value: read id)
            return id
        }
    }
}

// UOp.const(dtype, int_value)
fn mk_const_int(cache: mut UOpCache, dt: read DType, v: Int) -> Int {
    local e = List.new<Int>()
    local a = ArgInt(value: v)
    return intern(cache: mut cache, op: CONST, dt: read dt, src: take e, arg: take a)
}

// UOp.const(dtype, float_value)
fn mk_const_float(cache: mut UOpCache, dt: read DType, v: Float) -> Int {
    local e = List.new<Int>()
    local a = ArgFloat(value: v)
    return intern(cache: mut cache, op: CONST, dt: read dt, src: take e, arg: take a)
}

fn mk_define_var(cache: mut UOpCache, name: read String, min_val: Int, max_val: Int, dt: read DType) -> Int {
    local e = List.new<Int>()
    local v = VarArg(name: String.copy(value: read name), min_val: min_val, max_val: max_val)
    local a = ArgVar(value: take v)
    return intern(cache: mut cache, op: DEFINE_VAR, dt: read dt, src: take e, arg: take a)
}

fn mk_bind(cache: mut UOpCache, var: Int, value: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: var)
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read var)
    List.push<Int>(list: mut src, value: read value)
    local a = ArgNone
    return intern(cache: mut cache, op: BIND, dt: read dt, src: take src, arg: take a)
}

fn mk_bind_int(cache: mut UOpCache, var: Int, value: Int) -> Int {
    let dt = node_dtype(cache: read cache, id: var)
    let c = mk_const_int(cache: mut cache, dt: read dt, v: value)
    return mk_bind(cache: mut cache, var: var, value: c)
}

fn mk_param_arg(slot: Int, has_vmin_vmax: Bool, vmin: Int, vmax: Int, name: read String,
                addrspace: read AddrSpace, has_axis: Bool, axis: Int, device: read String) -> fresh ParamArg {
    return ParamArg(slot: slot, has_vmin_vmax: has_vmin_vmax, vmin: vmin, vmax: vmax,
                    name: String.copy(value: read name), addrspace: addr_space_copy(a: read addrspace),
                    has_axis: has_axis, axis: axis, device: String.copy(value: read device))
}

fn mk_param(cache: mut UOpCache, slot: Int, dt: read DType, shape: read List<Int>, name: read String) -> Int {
    local src = List.new<Int>()
    if List.len<Int>(list: read shape) > 0 {
        let sh = shape_to_shape_arg(cache: mut cache, dims: read shape)
        List.push<Int>(list: mut src, value: read sh)
    }
    local p = mk_param_arg(slot: slot, has_vmin_vmax: false, vmin: 0, vmax: 0, name: read name,
                           addrspace: read ADDR_GLOBAL, has_axis: false, axis: 0, device: read "")
    local a = ArgParam(value: take p)
    return intern(cache: mut cache, op: PARAM, dt: read dt, src: take src, arg: take a)
}

fn mk_param_bounded(cache: mut UOpCache, slot: Int, dt: read DType, shape: read List<Int>, name: read String,
                    vmin: Int, vmax: Int) -> Int {
    local src = List.new<Int>()
    if List.len<Int>(list: read shape) > 0 {
        let sh = shape_to_shape_arg(cache: mut cache, dims: read shape)
        List.push<Int>(list: mut src, value: read sh)
    }
    local p = mk_param_arg(slot: slot, has_vmin_vmax: true, vmin: vmin, vmax: vmax, name: read name,
                           addrspace: read ADDR_GLOBAL, has_axis: false, axis: 0, device: read "")
    local a = ArgParam(value: take p)
