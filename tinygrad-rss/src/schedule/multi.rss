fn multi_gettuple_tuple(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != GETTUPLE || node_num_src(cache: read cache, id: root) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let src = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: src) != TUPLE {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let idx = node_const_int(cache: read cache, id: root)
    if idx < 0 || idx >= node_num_src(cache: read cache, id: src) {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    return MultiRewrite(result: node_src_id(cache: read cache, id: src, k: idx), changed: true, ok: true)
}

fn multi_gettuple_multi(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != GETTUPLE || node_num_src(cache: read cache, id: root) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let multi = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: multi) != MULTI || node_num_src(cache: read cache, id: multi) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = node_src_id(cache: read cache, id: multi, k: 0)
    let pop = node_op(cache: read cache, id: payload)
    if pop != TUPLE && pop != FUNCTION {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let tuple_src = uop_tuple_source_for_gettuple(cache: read cache, id: payload)
    let idx = node_const_int(cache: read cache, id: root)
    if node_op(cache: read cache, id: tuple_src) != TUPLE || idx < 0 || idx >= node_num_src(cache: read cache, id: tuple_src) {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let got = mk_gettuple(cache: mut cache, tuple_id: payload, idx: idx)
    let out = mk_multi(cache: mut cache, x: got, axis: node_const_int(cache: read cache, id: multi))
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_reduce_kind_to_op(kind: Int) -> fresh Ops {
    if kind == 1 { return MUL }
    if kind == 2 { return MAX }
    return ADD
}

fn multi_effective_device_node(cache: mut UOpCache, id: Int) -> Int {
    let cnt = node_effective_device_count(cache: read cache, id: id)
    if cnt <= 1 {
        local name = node_effective_device_name(cache: read cache, id: id, index: 0)
        return mk_device(cache: mut cache, device: read name)
    }
    local devices = List.new<String>()
    let mut i = 0
    while i < cnt {
        local name = node_effective_device_name(cache: read cache, id: id, index: i)
        List.push<String>(list: mut devices, value: read manage name)
        i = i + 1
    }
    return mk_device_tuple(cache: mut cache, devices: read devices)
}

fn multi_reduce(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != REDUCE || node_num_src(cache: read cache, id: root) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let multi = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: multi) != MULTI || node_num_src(cache: read cache, id: multi) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = node_src_id(cache: read cache, id: multi, k: 0)
    let axis = node_const_int(cache: read cache, id: multi)
    local axes = node_argints(cache: read cache, id: root)
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read payload)
    let mut i = 1
    while i < node_num_src(cache: read cache, id: root) {
        let child = node_src_id(cache: read cache, id: root, k: i)
        List.push<Int>(list: mut srcs, value: read child)
        i = i + 1
    }
    local dt = node_full_dtype(cache: read cache, id: root)
    local arg = node_arg(cache: read cache, id: root)
    let local_reduce = intern(cache: mut cache, op: REDUCE, dt: read dt, src: take srcs, arg: take arg)
    if axis >= 0 && uop_ints_contains(vals: read axes, v: axis) {
        let dev = multi_effective_device_node(cache: mut cache, id: multi)
        local ar_src = List.new<Int>()
        List.push<Int>(list: mut ar_src, value: read local_reduce)
        List.push<Int>(list: mut ar_src, value: read dev)
        local ar_arg = ArgOp(value: multi_reduce_kind_to_op(kind: node_reduce_kind(cache: read cache, id: root)))
        let out = intern(cache: mut cache, op: ALLREDUCE, dt: read dt, src: take ar_src, arg: take ar_arg)
        return MultiRewrite(result: out, changed: true, ok: true)
    }
    let out = mk_multi(cache: mut cache, x: local_reduce, axis: axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_allreduce(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: root) != ALLREDUCE || node_num_src(cache: read cache, id: root) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let multi = node_src_id(cache: read cache, id: root, k: 0)
    if node_op(cache: read cache, id: multi) != MULTI || node_num_src(cache: read cache, id: multi) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let dev = node_src_id(cache: read cache, id: root, k: 1)
    if node_op(cache: read cache, id: dev) != DEVICE || node_effective_device_count(cache: read cache, id: dev) <= 1 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let payload = node_src_id(cache: read cache, id: multi, k: 0)
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read payload)
    List.push<Int>(list: mut srcs, value: read dev)
    local dt = node_full_dtype(cache: read cache, id: root)
    local arg = node_arg(cache: read cache, id: root)
    let local_allreduce = intern(cache: mut cache, op: ALLREDUCE, dt: read dt, src: take srcs, arg: take arg)
    let out = mk_multi(cache: mut cache, x: local_allreduce, axis: node_const_int(cache: read cache, id: multi))
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_alu_device_count(cache: read UOpCache, root: Int) -> Int {
    let mut i = 0
    while i < node_num_src(cache: read cache, id: root) {
        let child = node_src_id(cache: read cache, id: root, k: i)
        let cnt = node_effective_device_count(cache: read cache, id: child)
        if cnt > 1 { return cnt }
        i = i + 1
    }
    return 0
}

fn multi_shard_shape_to_axis(cache: mut UOpCache, id: Int, shape: read List<Int>, axis: Int, dcount: Int) -> Int {
    if List.len<Int>(list: read shape) == 0 { return id }
    if axis < 0 || axis >= List.len<Int>(list: read shape) || dcount <= 0 { return 0 - 1 }
    let full_dim = List.get<Int>(list: read shape, index: axis)
    if full_dim % dcount != 0 { return 0 - 1 }
    let shard_dim = full_dim / dcount
    let weak = dt_weakint()
    let dnum = mk_define_var(cache: mut cache, name: read "_device_num", min_val: 0, max_val: dcount - 1, dt: read weak)
    let shard_const = mk_const_int(cache: mut cache, dt: read weak, v: shard_dim)
    let axis_start = mk_alu2(cache: mut cache, op: MUL, dt: read weak, x: dnum, y: shard_const)
    let axis_end = mk_alu2(cache: mut cache, op: ADD, dt: read weak, x: axis_start, y: shard_const)
    local starts = List.new<Int>()
    local ends = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read shape) {
        if i == axis {
            List.push<Int>(list: mut starts, value: read axis_start)
            List.push<Int>(list: mut ends, value: read axis_end)
        } else {
            let zero = mk_const_int(cache: mut cache, dt: read weak, v: 0)
            let dim = mk_const_int(cache: mut cache, dt: read weak, v: List.get<Int>(list: read shape, index: i))
            List.push<Int>(list: mut starts, value: read zero)
            List.push<Int>(list: mut ends, value: read dim)
        }
        i = i + 1
    }
    return mk_shrink_expr(cache: mut cache, x: id, starts: read starts, ends: read ends)
}

fn multi_shard_to_axis(cache: mut UOpCache, id: Int, axis: Int, dcount: Int) -> Int {
    local shape = uop_shape(cache: read cache, id: id)
    return multi_shard_shape_to_axis(cache: mut cache, id: id, shape: read shape, axis: axis, dcount: dcount)
}

fn multi_unshard_to_device(cache: mut UOpCache, multi: Int, dcount: Int, dev: Int) -> Int {
    if node_op(cache: read cache, id: multi) != MULTI || node_num_src(cache: read cache, id: multi) == 0 {
        return 0 - 1
    }
    if node_op(cache: read cache, id: dev) != DEVICE {
        return 0 - 1
    }
    let old_axis = node_const_int(cache: read cache, id: multi)
    let payload = node_src_id(cache: read cache, id: multi, k: 0)
    local payload_shape = uop_shape(cache: read cache, id: payload)
    if old_axis < 0 || old_axis >= List.len<Int>(list: read payload_shape) || dcount <= 1 {
        return 0 - 1
    }
    let shard_dim = List.get<Int>(list: read payload_shape, index: old_axis)
    let weak = dt_weakint()
    let dnum = mk_define_var(cache: mut cache, name: read "_device_num", min_val: 0, max_val: dcount - 1, dt: read weak)
    let shard_const = mk_const_int(cache: mut cache, dt: read weak, v: shard_dim)
    let before_axis = mk_alu2(cache: mut cache, op: MUL, dt: read weak, x: dnum, y: shard_const)
    let full_tail = mk_const_int(cache: mut cache, dt: read weak, v: shard_dim * (dcount - 1))
    let after_axis = mk_alu2(cache: mut cache, op: SUB, dt: read weak, x: full_tail, y: before_axis)
    local before = List.new<Int>()
    local after = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read payload_shape) {
        if i == old_axis {
            List.push<Int>(list: mut before, value: read before_axis)
            List.push<Int>(list: mut after, value: read after_axis)
        } else {
            let zero = mk_const_int(cache: mut cache, dt: read weak, v: 0)
            List.push<Int>(list: mut before, value: read zero)
            List.push<Int>(list: mut after, value: read zero)
        }
        i = i + 1
    }
    let padded = mk_pad_expr(cache: mut cache, x: payload, before: read before, after: read after)
    local srcs = List.new<Int>()
    List.push<Int>(list: mut srcs, value: read padded)
    List.push<Int>(list: mut srcs, value: read dev)
    local dt = node_full_dtype(cache: read cache, id: payload)
    local arg = ArgOp(value: ADD)
    return intern(cache: mut cache, op: ALLREDUCE, dt: read dt, src: take srcs, arg: take arg)
}

fn multi_unshard_to_tuple(cache: mut UOpCache, multi: Int, dcount: Int) -> Int {
    let dev = multi_effective_device_node(cache: mut cache, id: multi)
    return multi_unshard_to_device(cache: mut cache, multi: multi, dcount: dcount, dev: dev)
}

fn multi_unsharded_shape(cache: read UOpCache, multi: Int, dcount: Int) -> fresh List<Int> {
    let payload = node_src_id(cache: read cache, id: multi, k: 0)
    local shape = uop_shape(cache: read cache, id: payload)
    let axis = node_const_int(cache: read cache, id: multi)
    if axis >= 0 && axis < List.len<Int>(list: read shape) {
        let shard_dim = List.get<Int>(list: read shape, index: axis)
        List.set<Int>(list: mut shape, index: axis, value: read (shard_dim * dcount))
    }
    return shape
}

fn multi_alu_same_axis(cache: mut UOpCache, root: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    let op = node_op(cache: read cache, id: root)
    if group_alu(op: read op) == false || node_num_src(cache: read cache, id: root) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let axis = uop_axis(cache: read cache, id: root)
    if axis < 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let dcount = multi_alu_device_count(cache: read cache, root: root)
    if dcount <= 1 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local srcs = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: root) {
        let child = node_src_id(cache: read cache, id: root, k: i)
        if node_op(cache: read cache, id: child) == MULTI && node_num_src(cache: read cache, id: child) > 0 {
            if node_const_int(cache: read cache, id: child) != axis {
                let unsharded = multi_unshard_to_tuple(cache: mut cache, multi: child, dcount: dcount)
                if unsharded < 0 {
                    return MultiRewrite(result: fallback, changed: false, ok: false)
                }
                local full_shape = multi_unsharded_shape(cache: read cache, multi: child, dcount: dcount)
                let resharded = multi_shard_shape_to_axis(cache: mut cache, id: unsharded, shape: read full_shape, axis: axis, dcount: dcount)
                if resharded < 0 {
                    return MultiRewrite(result: fallback, changed: false, ok: false)
                }
                List.push<Int>(list: mut srcs, value: read resharded)
            } else {
                List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: child, k: 0))
            }
        } else {
            if uop_axis(cache: read cache, id: child) >= 0 {
                return MultiRewrite(result: fallback, changed: false, ok: false)
            }
            local child_shape = uop_shape(cache: read cache, id: child)
            if List.len<Int>(list: read child_shape) != 0 {
                let sharded = multi_shard_to_axis(cache: mut cache, id: child, axis: axis, dcount: dcount)
                if sharded < 0 {
                    return MultiRewrite(result: fallback, changed: false, ok: false)
                }
                List.push<Int>(list: mut srcs, value: read sharded)
            } else {
                List.push<Int>(list: mut srcs, value: read child)
            }
        }
        i = i + 1
    }
    local dt = node_full_dtype(cache: read cache, id: root)
    local arg = node_arg(cache: read cache, id: root)
    let local_alu = intern(cache: mut cache, op: op, dt: read dt, src: take srcs, arg: take arg)
    let out = mk_multi(cache: mut cache, x: local_alu, axis: axis)
    return MultiRewrite(result: out, changed: true, ok: true)
}

