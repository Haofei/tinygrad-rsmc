// @port upstream: tinygrad/uop/ops.py
// @port status: implemented
// Port of tinygrad/uop/symbolic.py — rewrite rules + graph_rewrite over the interned DAG.
// A rule has the PatternMatcher shape (cache, id) -> Option<Int> (Some = rewritten id, None = no match).
// graph_rewrite rebuilds bottom-up; intern dedups, so identical results share one node.
features: local

fn const_int_eq(cache: read UOpCache, id: Int, k: Int) -> Bool {
    if node_is_const_int(cache: read cache, id: id) {
        let v = node_const_int(cache: read cache, id: id)
        if v == k { return true }
    }
    return false
}

fn const_one_eq(cache: read UOpCache, id: Int) -> Bool {
    if const_int_eq(cache: read cache, id: id, k: 1) { return true }
    if node_is_const(cache: read cache, id: id) {
        let dt = node_dtype(cache: read cache, id: id)
        if dtype_is_float(d: read dt) {
            if node_const_float(cache: read cache, id: id) == 1.0 { return true }
        }
    }
    return false
}

fn const_bool_eq(cache: read UOpCache, id: Int, k: Int) -> Bool {
    if node_is_const_int(cache: read cache, id: id) {
        let dt = node_dtype(cache: read cache, id: id)
        if dtype_is_bool(d: read dt) {
            if node_const_int(cache: read cache, id: id) == k { return true }
        }
    }
    return false
}

fn symbolic_const_zero(cache: read UOpCache, id: Int) -> Bool {
    if node_is_const_int(cache: read cache, id: id) {
        return node_const_int(cache: read cache, id: id) == 0
    }
    if node_is_const(cache: read cache, id: id) {
        let dt = node_dtype(cache: read cache, id: id)
        if dtype_is_float(d: read dt) {
            return node_const_float(cache: read cache, id: id) == 0.0
        }
    }
    return false
}

fn symbolic_bool_true(cache: mut UOpCache) -> Int {
    return mk_const_int(cache: mut cache, dt: read dt_bool(), v: 1)
}

fn symbolic_bool_logical_not(cache: mut UOpCache, id: Int) -> Int {
    let truth = symbolic_bool_true(cache: mut cache)
    return mk_alu2(cache: mut cache, op: CMPNE, dt: read dt_bool(), x: id, y: truth)
}

fn int_gcd(a: Int, b: Int) -> Int {
    let mut x = iabs(x: a)
    let mut y = iabs(x: b)
    while y != 0 {
        let r = x % y
        x = y
        y = r
    }
    return x
}

struct UOpConstSplit derives(Clone) {
    factor: Int,
    value: Int,
}

struct UOpTermConst derives(Clone) {
    term: Int,
    value: Int,
    ok: Bool,
}

struct SymbolicValidParse derives(Clone) {
    ok: Bool,
    expr: Int,
    is_upper: Bool,
    c: Int,
}

struct SymbolicIndexCastMatch derives(Clone) {
    ok: Bool,
    buf: Int,
    idx: Int,
    idx1: Int,
    count: Int,
    index_node: Int,
    or_cast: Int,
}

fn uop_identity_element(op: read Ops) -> Int {
    if op == ADD { return 0 }
    if op == MUL { return 1 }
    return 0
}

fn symbolic_const_exponent_int(cache: read UOpCache, id: Int) -> Option<Int> {
    if node_is_const_int(cache: read cache, id: id) { return Some(node_const_int(cache: read cache, id: id)) }
    if node_is_const(cache: read cache, id: id) {
        let dt = node_dtype(cache: read cache, id: id)
        if dtype_is_float(d: read dt) {
            let f = node_const_float(cache: read cache, id: id)
            if f == 0.0 { return Some(0) }
            if f == 1.0 { return Some(1) }
            if f == 2.0 { return Some(2) }
            if f == 3.0 { return Some(3) }
            if f == 4.0 { return Some(4) }
            if f == 0.0 - 1.0 { return Some(0 - 1) }
            if f == 0.0 - 2.0 { return Some(0 - 2) }
            if f == 0.0 - 3.0 { return Some(0 - 3) }
            if f == 0.0 - 4.0 { return Some(0 - 4) }
        }
    }
    return None
}

fn symbolic_pow_const_int(cache: mut UOpCache, x: Int, exp: Int) -> Int {
    let dt = node_full_dtype(cache: read cache, id: x)
    if exp < 0 {
        let recip = mk_alu1(cache: mut cache, op: RECIPROCAL, dt: read dt, x: x)
        return symbolic_pow_const_int(cache: mut cache, x: recip, exp: 0 - exp)
    }
    if exp == 0 { return decomp_const_one_like(cache: mut cache, x: x) }
    if exp == 1 { return x }
    let y = symbolic_pow_const_int(cache: mut cache, x: x, exp: exp / 2)
    let yy = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: y, y: y)
    if exp % 2 == 1 {
        return mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: yy, y: x)
    }
    return yy
}

fn uop_pop_const(cache: read UOpCache, id: Int, op: Ops) -> fresh UOpConstSplit {
    let nodeop = node_op(cache: read cache, id: id)
    if nodeop == op {
        if node_num_src(cache: read cache, id: id) == 2 {
            let s0 = node_src_id(cache: read cache, id: id, k: 0)
            let s1 = node_src_id(cache: read cache, id: id, k: 1)
            if node_is_const_int(cache: read cache, id: s1) {
                return UOpConstSplit(factor: s0, value: node_const_int(cache: read cache, id: s1))
            }
            if node_is_const_int(cache: read cache, id: s0) {
                return UOpConstSplit(factor: s1, value: node_const_int(cache: read cache, id: s0))
            }
        }
    }
    return UOpConstSplit(factor: id, value: uop_identity_element(op: read op))
}

fn uop_add_term_const(cache: read UOpCache, id: Int) -> fresh UOpTermConst {
    if node_op(cache: read cache, id: id) != ADD { return UOpTermConst(term: id, value: 0, ok: false) }
    if node_num_src(cache: read cache, id: id) != 2 { return UOpTermConst(term: id, value: 0, ok: false) }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    if node_is_const_int(cache: read cache, id: b) {
        return UOpTermConst(term: a, value: node_const_int(cache: read cache, id: b), ok: true)
    }
    if node_is_const_int(cache: read cache, id: a) {
        return UOpTermConst(term: b, value: node_const_int(cache: read cache, id: a), ok: true)
    }
    return UOpTermConst(term: id, value: 0, ok: false)
}

fn symbolic_mul_const(cache: mut UOpCache, dt: read DType, x: Int, coeff: Int) -> Int {
    if coeff == 1 { return x }
    if coeff == 0 { return mk_const_int(cache: mut cache, dt: read dt, v: 0) }
    if coeff == 0 - 1 { return mk_alu1(cache: mut cache, op: NEG, dt: read dt, x: x) }
    let c = mk_const_int(cache: mut cache, dt: read dt, v: coeff)
    return mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: x, y: c)
}

fn symbolic_try_combine_add_pair(cache: mut UOpCache, dt: read DType, a: Int, b: Int) -> Option<Int> {
    let pa = uop_pop_const(cache: read cache, id: a, op: MUL)
    let pb = uop_pop_const(cache: read cache, id: b, op: MUL)
    if pa.factor != pb.factor { return None }
    return Some(symbolic_mul_const(cache: mut cache, dt: read dt, x: pa.factor, coeff: pa.value + pb.value))
}

fn symbolic_try_combine_add_nested(cache: mut UOpCache, dt: read DType, parent: Int, other: Int) -> Option<Int> {
    if node_op(cache: read cache, id: parent) != ADD { return None }
    if node_num_src(cache: read cache, id: parent) != 2 { return None }
    let a = node_src_id(cache: read cache, id: parent, k: 0)
    let b = node_src_id(cache: read cache, id: parent, k: 1)
    match symbolic_try_combine_add_pair(cache: mut cache, dt: read dt, a: a, b: other) {
        Some(combined) => { return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: b, y: combined)) }
        None => {}
    }
    match symbolic_try_combine_add_pair(cache: mut cache, dt: read dt, a: b, b: other) {
        Some(combined) => { return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: a, y: combined)) }
        None => {}
    }
    return None
}

fn symbolic_binop_const(cache: mut UOpCache, op: Ops, dt: read DType, a: Int, b: Int) -> Int {
    local vals = List.new<Int>()
    List.push<Int>(list: mut vals, value: read a)
    List.push<Int>(list: mut vals, value: read b)
    let out = exec_alu_int(op: read op, operands: read vals)
    return mk_const_int(cache: mut cache, dt: read dt, v: out)
}

fn simplify_pow(cache: mut UOpCache, x: Int, c: Int) -> Option<Int> {
    match symbolic_const_exponent_int(cache: read cache, id: c) {
        Some(exp) => { return Some(symbolic_pow_const_int(cache: mut cache, x: x, exp: exp)) }
        None => {}
    }
    return None
}

fn const_arg(cache: read UOpCache, u: Int) -> Option<Arg> {
    if node_op(cache: read cache, id: u) == CONST {
        local a = node_arg(cache: read cache, id: u)
        return Some(a)
    }
    if node_op(cache: read cache, id: u) == STACK {
        local vals = List.new<Int>()
        let mut i = 0
        while i < node_num_src(cache: read cache, id: u) {
            let child = node_src_id(cache: read cache, id: u, k: i)
            if node_is_const_int(cache: read cache, id: child) == false { return None }
            List.push<Int>(list: mut vals, value: read node_const_int(cache: read cache, id: child))
            i = i + 1
        }
        local a = ArgInts(values: take vals)
        return Some(a)
    }
    return None
}

fn fold_bitcast(cache: mut UOpCache, root: Int, c: Int) -> Option<Int> {
    if node_op(cache: read cache, id: root) != BITCAST { return None }
    if node_op(cache: read cache, id: c) != CONST { return None }
    let from_dt = node_full_dtype(cache: read cache, id: c)
    let to_dt = node_full_dtype(cache: read cache, id: root)
    if from_dt.count != to_dt.count { return None }
    if from_dt.bitsize != to_dt.bitsize { return None }
    local arg = node_arg(cache: read cache, id: c)
    match arg {
        ArgInt(v) => {
            local src = List.new<Int>()
            local out_arg = ArgInt(value: v)
            return Some(intern(cache: mut cache, op: CONST, dt: read to_dt, src: take src, arg: take out_arg))
        }
        ArgBool(v) => {
            local src = List.new<Int>()
            local out_arg = ArgBool(value: v)
            return Some(intern(cache: mut cache, op: CONST, dt: read to_dt, src: take src, arg: take out_arg))
        }
        ArgInts(vals) => {
            local src = List.new<Int>()
            local out_vals = copy_int_list(l: read vals)
            local out_arg = ArgInts(values: take out_vals)
            return Some(intern(cache: mut cache, op: CONST, dt: read to_dt, src: take src, arg: take out_arg))
        }
        ArgNone => { return None }
        ArgFloat(f) => { return None }
        ArgStr(t) => { return None }
        ArgReduce(r) => { return None }
        ArgVar(v) => { return None }
        ArgRange(r) => { return None }
        ArgParam(p) => { return None }
        ArgAxisSizes(a) => { return None }
        ArgDevice(dv) => { return None }
        ArgOp(o) => { return None }
        ArgBufferize(b) => { return None }
        ArgProgram(p) => { return None }
        ArgCall(ca) => { return None }
    }
}

fn symbolic_const_rhs(cache: read UOpCache, id: Int) -> fresh UOpTermConst {
    if node_num_src(cache: read cache, id: id) != 2 { return UOpTermConst(term: id, value: 0, ok: false) }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    if node_is_const_int(cache: read cache, id: b) {
        return UOpTermConst(term: a, value: node_const_int(cache: read cache, id: b), ok: true)
    }
    if node_is_const_int(cache: read cache, id: a) {
        return UOpTermConst(term: b, value: node_const_int(cache: read cache, id: a), ok: true)
    }
    return UOpTermConst(term: id, value: 0, ok: false)
}

fn symbolic_dtype_same(a: read DType, b: read DType) -> Bool {
    if a.name != b.name { return false }
    if a.scalar_name != b.scalar_name { return false }
    if a.count != b.count { return false }
    if a.bitsize != b.bitsize { return false }
    if a.priority != b.priority { return false }
    return true
}

fn symbolic_const_vector_int(cache: mut UOpCache, dt: read DType, vals: read List<Int>) -> Int {
    local src = List.new<Int>()
    local payload = copy_int_list(l: read vals)
    local arg = ArgInts(values: take payload)
    return intern(cache: mut cache, op: CONST, dt: read dt, src: take src, arg: take arg)
}

fn symbolic_side_effect_op(op: read Ops) -> Bool {
    if op == RANGE { return true }
    if op == STORE { return true }
    if op == CALL { return true }
    if op == FUNCTION { return true }
    if op == BARRIER { return true }
    if op == END { return true }
    if op == UNROLL { return true }
    if op == LINEAR { return true }
    if op == STAGE { return true }
    return false
}

fn symbolic_int_list_same(a: read List<Int>, b: read List<Int>) -> Bool {
    if List.len<Int>(list: read a) != List.len<Int>(list: read b) { return false }
    let mut i = 0
    while i < List.len<Int>(list: read a) {
        if List.get<Int>(list: read a, index: i) != List.get<Int>(list: read b, index: i) { return false }
        i = i + 1
    }
    return true
}

fn symbolic_remove_from_sink_like(op: read Ops) -> Bool {
    if op == UNROLL { return true }
    if op == NOOP { return true }
    if op == STACK { return true }
    if op == SINK { return true }
    if op == GROUP { return true }
    return false
}

fn symbolic_mk_same_op_list(cache: mut UOpCache, op: Ops, dt: read DType, srcs: read List<Int>) -> Int {
    if op == SINK { return mk_sink(cache: mut cache, ids: read srcs) }
    if op == GROUP { return mk_group(cache: mut cache, srcs: read srcs) }
    local arg = ArgNone
    local src = copy_int_list(l: read srcs)
    return intern(cache: mut cache, op: op, dt: read dt, src: take src, arg: take arg)
}

fn symbolic_is_reciprocal_of_one_plus(cache: read UOpCache, recip: Int, x: Int) -> Bool {
    if node_op(cache: read cache, id: recip) != RECIPROCAL { return false }
    if node_num_src(cache: read cache, id: recip) != 1 { return false }
    let add = node_src_id(cache: read cache, id: recip, k: 0)
    if node_op(cache: read cache, id: add) != ADD { return false }
    if node_num_src(cache: read cache, id: add) != 2 { return false }
    let a = node_src_id(cache: read cache, id: add, k: 0)
    let b = node_src_id(cache: read cache, id: add, k: 1)
    if a == x && const_one_eq(cache: read cache, id: b) { return true }
    if b == x && const_one_eq(cache: read cache, id: a) { return true }
    return false
}

fn uop_is_increasing(cache: read UOpCache, id: Int) -> Bool {
    let op = node_op(cache: read cache, id: id)
    if group_irreducible(op: read op) { return true }
    if op == ADD {
        let a = node_src_id(cache: read cache, id: id, k: 0)
        let b = node_src_id(cache: read cache, id: id, k: 1)
        return uop_is_increasing(cache: read cache, id: a) && uop_is_increasing(cache: read cache, id: b)
    }
    if op == MUL || op == CDIV || op == FLOORDIV {
        if node_num_src(cache: read cache, id: id) == 2 {
            let rhs = node_src_id(cache: read cache, id: id, k: 1)
            if node_is_const_int(cache: read cache, id: rhs) {
                if node_const_int(cache: read cache, id: rhs) >= 0 {
                    let lhs = node_src_id(cache: read cache, id: id, k: 0)
                    return uop_is_increasing(cache: read cache, id: lhs)
                }
            }
        }
    }
    return false
}

fn uop_const_factor(cache: read UOpCache, id: Int) -> Int {
    let op = node_op(cache: read cache, id: id)
    if op == CONST {
        if node_is_const_int(cache: read cache, id: id) { return node_const_int(cache: read cache, id: id) }
        return 1
    }
    if op == STACK {
        let mut g = 0
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            let cf = uop_const_factor(cache: read cache, id: child)
            if i == 0 { g = cf } else { g = int_gcd(a: g, b: cf) }
            i = i + 1
        }
        if node_num_src(cache: read cache, id: id) == 0 { return 1 }
        return g
    }
    if op == ADD {
        let a = node_src_id(cache: read cache, id: id, k: 0)
        let b = node_src_id(cache: read cache, id: id, k: 1)
        return int_gcd(a: uop_const_factor(cache: read cache, id: a), b: uop_const_factor(cache: read cache, id: b))
    }
    if op == MUL {
        let a = node_src_id(cache: read cache, id: id, k: 0)
        let b = node_src_id(cache: read cache, id: id, k: 1)
        if node_is_const_int(cache: read cache, id: a) { return node_const_int(cache: read cache, id: a) }
        if node_is_const_int(cache: read cache, id: b) { return node_const_int(cache: read cache, id: b) }
    }
    return 1
}

fn uop_divides(cache: mut UOpCache, id: Int, v: Int) -> Option<Int> {
    if v == 1 { return Some(id) }
    let op = node_op(cache: read cache, id: id)
    if op == CONST {
        if node_is_const_int(cache: read cache, id: id) {
            let n = node_const_int(cache: read cache, id: id)
            if n % v == 0 {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: n / v))
            }
        }
        return None
    }
    if op == STACK {
        local parts = List.new<Int>()
        let mut i = 0
        while i < node_num_src(cache: read cache, id: id) {
            let child = node_src_id(cache: read cache, id: id, k: i)
            let d = uop_divides(cache: mut cache, id: child, v: v)?
            List.push<Int>(list: mut parts, value: read d)
            i = i + 1
        }
        let dt = node_dtype(cache: read cache, id: id)
        return Some(uop_stack(cache: mut cache, dt: read dt, srcs: read parts))
    }
    if op == ADD {
        let a = node_src_id(cache: read cache, id: id, k: 0)
        let b = node_src_id(cache: read cache, id: id, k: 1)
        let da = uop_divides(cache: mut cache, id: a, v: v)?
        let db = uop_divides(cache: mut cache, id: b, v: v)?
        let dt = node_dtype(cache: read cache, id: id)
        return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: da, y: db))
    }
    if op == MUL {
        let a = node_src_id(cache: read cache, id: id, k: 0)
        let b = node_src_id(cache: read cache, id: id, k: 1)
        match uop_divides(cache: mut cache, id: a, v: v) {
            Some(da) => {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: da, y: b))
            }
            None => {}
        }
        match uop_divides(cache: mut cache, id: b, v: v) {
            Some(db) => {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: a, y: db))
            }
            None => {}
        }
    }
    return None
}

fn uop_gcd2(cache: mut UOpCache, a: Int, b: Int) -> Int {
    let af = uop_const_factor(cache: read cache, id: a)
    let bf = uop_const_factor(cache: read cache, id: b)
    let mut aterm = a
    let mut bterm = b
    match uop_divides(cache: mut cache, id: a, v: af) {
        Some(v) => { aterm = v }
        None => {}
    }
    match uop_divides(cache: mut cache, id: b, v: bf) {
        Some(v) => { bterm = v }
        None => {}
    }
    local aparts = uop_split_by_op(cache: read cache, id: aterm, sep: MUL)
    local bparts = uop_split_by_op(cache: read cache, id: bterm, sep: MUL)
    local used = List.new<Int>()
    let mut ui = 0
    while ui < List.len<Int>(list: read bparts) {
        List.push<Int>(list: mut used, value: read 0)
        ui = ui + 1
    }
    let dt = node_dtype(cache: read cache, id: a)
    let mut out = mk_const_int(cache: mut cache, dt: read dt, v: int_gcd(a: af, b: bf))
    let mut i = 0
    while i < List.len<Int>(list: read aparts) {
        let apart = List.get<Int>(list: read aparts, index: i)
        let mut j = 0
        let mut matched = false
        while j < List.len<Int>(list: read bparts) {
            let bpart = List.get<Int>(list: read bparts, index: j)
            let is_used = List.get<Int>(list: read used, index: j)
            if matched == false {
                if is_used == 0 {
                    if apart == bpart {
                        out = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: out, y: apart)
                        List.set<Int>(list: mut used, index: j, value: read 1)
                        matched = true
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

fn uop_divide_exact(cache: mut UOpCache, id: Int, divisor: Int) -> Option<Int> {
    if id == divisor {
        let dt = node_dtype(cache: read cache, id: id)
        return Some(mk_const_int(cache: mut cache, dt: read dt, v: 1))
    }
    let dop = node_op(cache: read cache, id: divisor)
    if dop == CONST {
        if node_is_const_int(cache: read cache, id: divisor) {
            let dv = node_const_int(cache: read cache, id: divisor)
            if dv != 0 { return uop_divides(cache: mut cache, id: id, v: dv) }
        }
        return None
    }
    let op = node_op(cache: read cache, id: id)
    if op == ADD {
        let a = node_src_id(cache: read cache, id: id, k: 0)
        let b = node_src_id(cache: read cache, id: id, k: 1)
        let da = uop_divide_exact(cache: mut cache, id: a, divisor: divisor)?
        let db = uop_divide_exact(cache: mut cache, id: b, divisor: divisor)?
        let dt = node_dtype(cache: read cache, id: id)
        return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: da, y: db))
    }
    if op == MUL {
        let a = node_src_id(cache: read cache, id: id, k: 0)
        let b = node_src_id(cache: read cache, id: id, k: 1)
        if a == divisor { return Some(b) }
        if b == divisor { return Some(a) }
        let lhs = uop_pop_const(cache: read cache, id: id, op: MUL)
        let rhs = uop_pop_const(cache: read cache, id: divisor, op: MUL)
        if lhs.factor == rhs.factor {
            if rhs.value != 0 {
                if lhs.value % rhs.value == 0 {
                    let dt = node_dtype(cache: read cache, id: id)
                    return Some(mk_const_int(cache: mut cache, dt: read dt, v: lhs.value / rhs.value))
                }
            }
        }
    }
    return None
}

// fold a binary ALU of two integer CONSTs -> CONST(exec_alu_int(...))
fn rule_fold_const_alu(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if group_binary(op: read op) {
        if node_num_src(cache: read cache, id: id) == 2 {
            let s0 = node_src_id(cache: read cache, id: id, k: 0)
            let s1 = node_src_id(cache: read cache, id: id, k: 1)
            if node_is_const_int(cache: read cache, id: s0) {
                if node_is_const_int(cache: read cache, id: s1) {
                    local ops = List.new<Int>()
                    let v0 = node_const_int(cache: read cache, id: s0)
                    let v1 = node_const_int(cache: read cache, id: s1)
                    List.push<Int>(list: mut ops, value: read v0)
                    List.push<Int>(list: mut ops, value: read v1)
                    let folded = exec_alu_int(op: read op, operands: read ops)
                    let dt = node_dtype(cache: read cache, id: id)
                    return Some(mk_const_int(cache: mut cache, dt: read dt, v: folded))
                }
            }
        }
    }
    return None
}

fn fold_const_alu(cache: mut UOpCache, a: Int) -> Option<Int> {
    return rule_fold_const_alu(cache: mut cache, id: a)
}

fn rule_simplify_pow_const(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != POW { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let x = node_src_id(cache: read cache, id: id, k: 0)
    let c = node_src_id(cache: read cache, id: id, k: 1)
    return simplify_pow(cache: mut cache, x: x, c: c)
}

fn rule_simplify_where(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != WHERE { return None }
    if node_num_src(cache: read cache, id: id) != 3 { return None }
    let cond = node_src_id(cache: read cache, id: id, k: 0)
    let tval = node_src_id(cache: read cache, id: id, k: 1)
    let fval = node_src_id(cache: read cache, id: id, k: 2)
    if tval == fval { return Some(tval) }
    let cdt = node_dtype(cache: read cache, id: cond)
    if dtype_is_bool(d: read cdt) {
        if const_bool_eq(cache: read cache, id: tval, k: 1) {
            if const_bool_eq(cache: read cache, id: fval, k: 0) { return Some(cond) }
        }
        if const_bool_eq(cache: read cache, id: tval, k: 0) {
            if const_bool_eq(cache: read cache, id: fval, k: 1) {
                return Some(symbolic_bool_logical_not(cache: mut cache, id: cond))
            }
        }
    }
    if dtype_is_bool(d: read cdt) {
        if node_is_const_int(cache: read cache, id: cond) {
            if node_const_int(cache: read cache, id: cond) == 0 { return Some(fval) }
            return Some(tval)
        }
    }
    return None
}

fn rule_simplify_bool_cast_compare(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPNE { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    let mut cast_id = lhs
    let mut const_id = rhs
    if node_op(cache: read cache, id: cast_id) != CAST {
        cast_id = rhs
        const_id = lhs
    }
    if node_op(cache: read cache, id: cast_id) != CAST { return None }
    if node_is_const_int(cache: read cache, id: const_id) == false { return None }
    let cast_dt = node_dtype(cache: read cache, id: cast_id)
    if dtype_is_int(d: read cast_dt) == false { return None }
    let x = node_src_id(cache: read cache, id: cast_id, k: 0)
    let xdt = node_dtype(cache: read cache, id: x)
    if dtype_is_bool(d: read xdt) == false { return None }
    let c = node_const_int(cache: read cache, id: const_id)
    if c == 0 { return Some(x) }
    if c == 1 { return Some(symbolic_bool_logical_not(cache: mut cache, id: x)) }
    return Some(symbolic_bool_true(cache: mut cache))
}

fn rule_simplify_bool_not(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPNE { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    let mut inner = lhs
    if const_bool_eq(cache: read cache, id: rhs, k: 1) == false {
        if const_bool_eq(cache: read cache, id: lhs, k: 1) == false { return None }
        inner = rhs
    }
    if node_op(cache: read cache, id: inner) != CMPNE { return None }
    if node_num_src(cache: read cache, id: inner) != 2 { return None }
    let i0 = node_src_id(cache: read cache, id: inner, k: 0)
    let i1 = node_src_id(cache: read cache, id: inner, k: 1)
    if const_bool_eq(cache: read cache, id: i1, k: 1) { return Some(i0) }
    if const_bool_eq(cache: read cache, id: i0, k: 1) { return Some(i1) }
    return None
}

fn rule_simplify_trunc_int(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != TRUNC { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    let x = node_src_id(cache: read cache, id: id, k: 0)
    let dt = node_dtype(cache: read cache, id: x)
    if dtype_is_int(d: read dt) || dtype_is_bool(d: read dt) { return Some(x) }
    return None
}

fn rule_simplify_bool_alu_to_logic(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if op != MUL && op != ADD && op != MAX { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let adt = node_dtype(cache: read cache, id: a)
    let bdt = node_dtype(cache: read cache, id: b)
    if dtype_is_bool(d: read adt) == false { return None }
    if dtype_is_bool(d: read bdt) == false { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    if op == MUL { return Some(mk_alu2(cache: mut cache, op: AND, dt: read dt, x: a, y: b)) }
    return Some(mk_alu2(cache: mut cache, op: OR, dt: read dt, x: a, y: b))
}

fn rule_simplify_bool_or_not(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != OR { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    if symbolic_is_logical_not_of(cache: read cache, not_id: a, x: b) {
        return Some(symbolic_bool_true(cache: mut cache))
    }
    if symbolic_is_logical_not_of(cache: read cache, not_id: b, x: a) {
        return Some(symbolic_bool_true(cache: mut cache))
    }
    return None
}

fn symbolic_is_logical_not_of(cache: read UOpCache, not_id: Int, x: Int) -> Bool {
    if node_op(cache: read cache, id: not_id) != CMPNE { return false }
    if node_num_src(cache: read cache, id: not_id) != 2 { return false }
    let a = node_src_id(cache: read cache, id: not_id, k: 0)
    let b = node_src_id(cache: read cache, id: not_id, k: 1)
    if a == x && const_bool_eq(cache: read cache, id: b, k: 1) { return true }
    if b == x && const_bool_eq(cache: read cache, id: a, k: 1) { return true }
    return false
}

struct SymbolicDivModTerm derives(Clone) {
    ok: Bool,
    base: Int,
    div: Int,
    mul: Int,
}

fn symbolic_divmod_term(cache: read UOpCache, u: Int) -> fresh SymbolicDivModTerm {
    if node_op(cache: read cache, id: u) == FLOORMOD {
        let den = node_src_id(cache: read cache, id: u, k: 1)
        if node_is_const_int(cache: read cache, id: den) {
            return SymbolicDivModTerm(ok: true, base: node_src_id(cache: read cache, id: u, k: 0),
                                      div: node_const_int(cache: read cache, id: den), mul: 1)
        }
    }
    if node_op(cache: read cache, id: u) == MUL {
        let mul = symbolic_const_rhs(cache: read cache, id: u)
        if mul.ok {
            if node_op(cache: read cache, id: mul.term) == FLOORMOD {
                let den = node_src_id(cache: read cache, id: mul.term, k: 1)
                if node_is_const_int(cache: read cache, id: den) {
                    return SymbolicDivModTerm(ok: true, base: node_src_id(cache: read cache, id: mul.term, k: 0),
                                              div: node_const_int(cache: read cache, id: den), mul: mul.value)
                }
            }
        }
    }
    return SymbolicDivModTerm(ok: false, base: u, div: 1, mul: 1)
}

fn symbolic_usum_with_replacement(cache: mut UOpCache, dt: read DType, parts: read List<Int>, repl: Int, i: Int, j: Int) -> Int {
    local out = List.new<Int>()
    List.push<Int>(list: mut out, value: read repl)
    let mut k = 0
    while k < List.len<Int>(list: read parts) {
        if k != i && k != j {
            List.push<Int>(list: mut out, value: read List.get<Int>(list: read parts, index: k))
        }
        k = k + 1
    }
    return divmod_usum(cache: mut cache, dt: read dt, parts: read out)
}

fn fold_add_divmod_recombine(cache: mut UOpCache, x: Int) -> Option<Int> {
    if node_op(cache: read cache, id: x) != ADD { return None }
    local terms = uop_split_by_op(cache: read cache, id: x, sep: ADD)
    let dt = node_full_dtype(cache: read cache, id: x)
    let mut i = 0
    while i < List.len<Int>(list: read terms) {
        let u = List.get<Int>(list: read terms, index: i)
        let dm = symbolic_divmod_term(cache: read cache, u: u)
        if dm.ok {
            let mut j = 0
            while j < List.len<Int>(list: read terms) {
                if i != j {
                    let v = List.get<Int>(list: read terms, index: j)
                    if node_op(cache: read cache, id: v) == MUL {
                        let mul = symbolic_const_rhs(cache: read cache, id: v)
                        if mul.ok && mul.value == dm.div * dm.mul {
                            let q = mul.term
                            let mut exact = false
                            if node_op(cache: read cache, id: q) == FLOORDIV {
                                let qden = node_src_id(cache: read cache, id: q, k: 1)
                                if node_is_const_int(cache: read cache, id: qden) {
                                    if node_const_int(cache: read cache, id: qden) == dm.div {
                                        if node_src_id(cache: read cache, id: q, k: 0) == dm.base {
                                            exact = true
                                        }
                                    }
                                }
                            }
                            if exact == false && dm.div > 0 && node_op(cache: read cache, id: dm.base) == FLOORDIV {
                                let bden = node_src_id(cache: read cache, id: dm.base, k: 1)
                                if node_is_const_int(cache: read cache, id: bden) {
                                    if node_op(cache: read cache, id: q) == FLOORDIV {
                                        let qden = node_src_id(cache: read cache, id: q, k: 1)
                                        if node_is_const_int(cache: read cache, id: qden) {
                                            if node_src_id(cache: read cache, id: q, k: 0) == node_src_id(cache: read cache, id: dm.base, k: 0) {
                                                if node_const_int(cache: read cache, id: qden) == node_const_int(cache: read cache, id: bden) * dm.div {
                                                    exact = true
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if exact {
                                let repl = symbolic_mul_const(cache: mut cache, dt: read dt, x: dm.base, coeff: dm.mul)
                                return Some(symbolic_usum_with_replacement(cache: mut cache, dt: read dt, parts: read terms, repl: repl, i: i, j: j))
                            }
                            if dm.div > 0 && node_op(cache: read cache, id: q) == FLOORMOD {
                                let qden = node_src_id(cache: read cache, id: q, k: 1)
                                let qbase = node_src_id(cache: read cache, id: q, k: 0)
                                if node_is_const_int(cache: read cache, id: qden) && node_op(cache: read cache, id: qbase) == FLOORDIV {
                                    let inner_den = node_src_id(cache: read cache, id: qbase, k: 1)
                                    if node_is_const_int(cache: read cache, id: inner_den) {
                                        if node_src_id(cache: read cache, id: qbase, k: 0) == dm.base && node_const_int(cache: read cache, id: inner_den) == dm.div {
                                            let d = node_const_int(cache: read cache, id: qden)
                                            if d > 0 {
                                                let mod_den = mk_const_int(cache: mut cache, dt: read node_dtype(cache: read cache, id: inner_den), v: dm.div * d)
                                                let rem = mk_alu2(cache: mut cache, op: FLOORMOD, dt: read dt, x: dm.base, y: mod_den)
                                                let repl = symbolic_mul_const(cache: mut cache, dt: read dt, x: rem, coeff: dm.mul)
                                                return Some(symbolic_usum_with_replacement(cache: mut cache, dt: read dt, parts: read terms, repl: repl, i: i, j: j))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return None
}

fn rule_simplify_combine_add_terms(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != ADD { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    match fold_add_divmod_recombine(cache: mut cache, x: id) {
        Some(r) => { return Some(r) }
        None => {}
    }
    let dt = node_full_dtype(cache: read cache, id: id)
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    match symbolic_try_combine_add_pair(cache: mut cache, dt: read dt, a: a, b: b) {
        Some(combined) => { return Some(combined) }
        None => {}
    }
    match symbolic_try_combine_add_nested(cache: mut cache, dt: read dt, parent: a, other: b) {
        Some(combined) => { return Some(combined) }
        None => {}
    }
    match symbolic_try_combine_add_nested(cache: mut cache, dt: read dt, parent: b, other: a) {
        Some(combined) => { return Some(combined) }
        None => {}
    }
    return None
}

fn rule_simplify_const_mul_add(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != MUL { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let mut cnode = a
    let mut addnode = b
    if node_is_const_int(cache: read cache, id: cnode) == false {
        cnode = b
        addnode = a
    }
    if node_is_const_int(cache: read cache, id: cnode) == false { return None }
    let add = uop_add_term_const(cache: read cache, id: addnode)
    if add.ok == false { return None }
    let c = node_const_int(cache: read cache, id: cnode)
    let dt = node_dtype(cache: read cache, id: id)
    let left = symbolic_mul_const(cache: mut cache, dt: read dt, x: add.term, coeff: c)
    let right = mk_const_int(cache: mut cache, dt: read dt, v: c * add.value)
    return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: left, y: right))
}

fn rule_simplify_where_not_condition(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != WHERE { return None }
    if node_num_src(cache: read cache, id: id) != 3 { return None }
    let cond = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: cond) != CMPNE { return None }
    if node_num_src(cache: read cache, id: cond) != 2 { return None }
    let a = node_src_id(cache: read cache, id: cond, k: 0)
    let b = node_src_id(cache: read cache, id: cond, k: 1)
    let mut inner = a
    if const_bool_eq(cache: read cache, id: b, k: 1) == false {
        if const_bool_eq(cache: read cache, id: a, k: 1) == false { return None }
        inner = b
    }
    let tval = node_src_id(cache: read cache, id: id, k: 1)
    let fval = node_src_id(cache: read cache, id: id, k: 2)
    let dt = node_dtype(cache: read cache, id: id)
    return Some(mk_where(cache: mut cache, dt: read dt, cond: inner, tval: fval, fval: tval))
}

fn rule_fold_exact_minmax(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    let mut eligible = false
    if op == CMPLT || op == CMPNE || op == FLOORDIV || op == FLOORMOD { eligible = true }
    if op == DEFINE_VAR || op == BIND || op == SPECIAL || op == RANGE { eligible = true }
    if eligible == false { return None }
    let r = uop_min_max(cache: read cache, id: id)
    if r.lo != r.hi { return None }
    let dt = node_dtype(cache: read cache, id: id)
    return Some(mk_const_int(cache: mut cache, dt: read dt, v: r.lo))
}

fn rule_simplify_max_by_bounds(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != MAX { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let ra = uop_min_max(cache: read cache, id: a)
    let rb = uop_min_max(cache: read cache, id: b)
    if ra.lo >= rb.hi { return Some(a) }
    if ra.hi <= rb.lo { return Some(b) }
    return None
}

fn rule_simplify_assoc_const_chain(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if group_associative(op: read op) == false { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let outer = symbolic_const_rhs(cache: read cache, id: id)
    if outer.ok == false { return None }
    if node_op(cache: read cache, id: outer.term) != op { return None }
    let inner = symbolic_const_rhs(cache: read cache, id: outer.term)
    if inner.ok == false { return None }
    let dt = node_dtype(cache: read cache, id: id)
    let c = symbolic_binop_const(cache: mut cache, op: op.clone(), dt: read dt, a: inner.value, b: outer.value)
    return Some(mk_alu2(cache: mut cache, op: op.clone(), dt: read dt, x: inner.term, y: c))
}

fn rule_simplify_add_lt_const(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPLT { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    if node_is_const_int(cache: read cache, id: rhs) == false { return None }
    if node_op(cache: read cache, id: lhs) != ADD { return None }
    let add = symbolic_const_rhs(cache: read cache, id: lhs)
    if add.ok == false { return None }
    let c1 = node_const_int(cache: read cache, id: rhs)
    let ndt = node_dtype(cache: read cache, id: add.term)
    let new_rhs = mk_const_int(cache: mut cache, dt: read ndt, v: c1 - add.value)
    let dt = node_dtype(cache: read cache, id: id)
    return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt, x: add.term, y: new_rhs))
}

fn lt_folding(cache: mut UOpCache, x: Int, c: Int) -> Option<Int> {
    local terms = uop_split_by_op(cache: read cache, id: x, sep: ADD)
    local p = List.new<Int>()
    local np = List.new<Int>()
    let mut g = 0
    let mut i = 0
    while i < List.len<Int>(list: read terms) {
        let u = List.get<Int>(list: read terms, index: i)
        let cf = uop_const_factor(cache: read cache, id: u)
        if cf == 1 {
            List.push<Int>(list: mut p, value: read u)
        } else {
            List.push<Int>(list: mut np, value: read u)
            if g == 0 { g = cf } else { g = int_gcd(a: g, b: cf) }
        }
        i = i + 1
    }
    g = int_gcd(a: g, b: c)
    if List.len<Int>(list: read np) == 0 || g <= 1 { return None }
    let mut plo = 0
    let mut phi = 0
    let mut pi = 0
    while pi < List.len<Int>(list: read p) {
        let r = uop_min_max(cache: read cache, id: List.get<Int>(list: read p, index: pi))
        plo = plo + r.lo
        phi = phi + r.hi
        pi = pi + 1
    }
    if plo < 0 || phi >= g { return None }
    let dt = node_full_dtype(cache: read cache, id: x)
    let np_sum = divmod_usum(cache: mut cache, dt: read dt, parts: read np)
    match uop_divides(cache: mut cache, id: np_sum, v: g) {
        Some(divided) => {
            let rhs = mk_const_int(cache: mut cache, dt: read dt, v: c / g)
            return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: divided, y: rhs))
        }
        None => {}
    }
    return None
}

fn canonicalize_simplex(cache: mut UOpCache, X: Int) -> Option<Int> {
    local terms = uop_split_by_op(cache: read cache, id: X, sep: ADD)
    local out = List.new<Int>()
    let mut changed = false
    let mut i = 0
    while i < List.len<Int>(list: read terms) {
        let mut u = List.get<Int>(list: read terms, index: i)
        if node_op(cache: read cache, id: u) == MUL {
            let mul = symbolic_const_rhs(cache: read cache, id: u)
            if mul.ok && mul.value > 0 {
                u = mul.term
                changed = true
            }
        }
        let op = node_op(cache: read cache, id: u)
        let r = uop_min_max(cache: read cache, id: u)
        if group_irreducible(op: read op) == false || r.lo < 0 { return None }
        List.push<Int>(list: mut out, value: read u)
        i = i + 1
    }
    if changed == false { return None }
    let dt = node_full_dtype(cache: read cache, id: X)
    return Some(divmod_usum(cache: mut cache, dt: read dt, parts: read out))
}

fn rule_simplify_chained_floordiv_const(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != FLOORDIV { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    if node_is_const_int(cache: read cache, id: rhs) == false { return None }
    let c2 = node_const_int(cache: read cache, id: rhs)
    if c2 <= 0 { return None }
    if node_op(cache: read cache, id: lhs) != FLOORDIV { return None }
    if node_num_src(cache: read cache, id: lhs) != 2 { return None }
    let x = node_src_id(cache: read cache, id: lhs, k: 0)
    let c1n = node_src_id(cache: read cache, id: lhs, k: 1)
    if node_is_const_int(cache: read cache, id: c1n) == false { return None }
    let c1 = node_const_int(cache: read cache, id: c1n)
    let dt = node_dtype(cache: read cache, id: id)
    let c = mk_const_int(cache: mut cache, dt: read node_dtype(cache: read cache, id: c1n), v: c1 * c2)
    return Some(mk_alu2(cache: mut cache, op: FLOORDIV, dt: read dt, x: x, y: c))
}

fn rule_simplify_linear_lt_const(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPLT { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    if node_is_const_int(cache: read cache, id: rhs) == false { return None }
    let c = node_const_int(cache: read cache, id: rhs)
    if c > 0 {
        match lt_folding(cache: mut cache, x: lhs, c: c) {
            Some(r) => { return Some(r) }
            None => {}
        }
    }
    if node_op(cache: read cache, id: lhs) == MUL {
        let mul = symbolic_const_rhs(cache: read cache, id: lhs)
        if mul.ok {
            if mul.value > 0 && c > 0 {
                let ndt = node_dtype(cache: read cache, id: mul.term)
                let bound = (c + mul.value - 1) / mul.value
                let nrhs = mk_const_int(cache: mut cache, dt: read ndt, v: bound)
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt, x: mul.term, y: nrhs))
            }
        }
    }
    if node_op(cache: read cache, id: lhs) == FLOORDIV {
        if node_num_src(cache: read cache, id: lhs) != 2 { return None }
        let x = node_src_id(cache: read cache, id: lhs, k: 0)
        let d = node_src_id(cache: read cache, id: lhs, k: 1)
        if node_is_const_int(cache: read cache, id: d) {
            let dv = node_const_int(cache: read cache, id: d)
            if dv > 0 {
                let ndt = node_dtype(cache: read cache, id: x)
                let nrhs = mk_const_int(cache: mut cache, dt: read ndt, v: c * dv)
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_alu2(cache: mut cache, op: CMPLT, dt: read dt, x: x, y: nrhs))
            }
        }
    }
    return None
}

fn rule_simplify_move_const_to_end(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if op != ADD && op != MUL { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    if node_op(cache: read cache, id: lhs) != op { return None }
    let inner = symbolic_const_rhs(cache: read cache, id: lhs)
    if inner.ok == false { return None }
    if node_is_const_int(cache: read cache, id: rhs) { return None }
    let dt = node_dtype(cache: read cache, id: id)
    let mid = mk_alu2(cache: mut cache, op: op.clone(), dt: read dt, x: inner.term, y: rhs)
    let c = mk_const_int(cache: mut cache, dt: read dt, v: inner.value)
    return Some(mk_alu2(cache: mut cache, op: op.clone(), dt: read dt, x: mid, y: c))
}

fn rule_simplify_range_own_end(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if op != FLOORMOD && op != FLOORDIV { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let r = node_src_id(cache: read cache, id: id, k: 0)
    let end = node_src_id(cache: read cache, id: id, k: 1)
    if node_op(cache: read cache, id: r) != RANGE { return None }
    if node_num_src(cache: read cache, id: r) != 1 { return None }
    if node_src_id(cache: read cache, id: r, k: 0) != end { return None }
    if op == FLOORMOD { return Some(r) }
    let dt = node_dtype(cache: read cache, id: id)
    return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
}

fn rule_simplify_cast_chain(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CAST { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    let inner = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: inner) != CAST { return None }
    if node_num_src(cache: read cache, id: inner) != 1 { return None }
    let x = node_src_id(cache: read cache, id: inner, k: 0)
    let xdt = node_full_dtype(cache: read cache, id: x)
    let innerdt = node_full_dtype(cache: read cache, id: inner)
    let outdt = node_full_dtype(cache: read cache, id: id)
    if symbolic_dtype_same(a: read xdt, b: read outdt) {
        if can_lossless_cast(dt0: read outdt, dt1: read innerdt) { return Some(x) }
    }
    if can_lossless_cast(dt0: read xdt, dt1: read innerdt) {
        return Some(mk_cast(cache: mut cache, x: x, dt: read outdt))
    }
    if dtype_is_int(d: read xdt) && dtype_is_int(d: read innerdt) {
        let r = uop_min_max(cache: read cache, id: x)
        if dtype_imin(d: read innerdt) <= r.lo {
            if r.hi <= dtype_imax(d: read innerdt) {
                return Some(mk_cast(cache: mut cache, x: x, dt: read outdt))
            }
        }
    }
    return None
}

fn rule_simplify_after_cleanup(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != AFTER { return None }
    let n = node_num_src(cache: read cache, id: id)
    if n == 0 { return None }
    let root = node_src_id(cache: read cache, id: id, k: 0)
    if n == 1 { return Some(root) }
    local deps = List.new<Int>()
    let mut changed = false
    let mut i = 1
    while i < n {
        let dep = node_src_id(cache: read cache, id: id, k: i)
        let dop = node_op(cache: read cache, id: dep)
        if symbolic_side_effect_op(op: read dop) {
            List.push<Int>(list: mut deps, value: read dep)
        } else {
            changed = true
            let mut j = 0
            while j < node_num_src(cache: read cache, id: dep) {
                let s = node_src_id(cache: read cache, id: dep, k: j)
                List.push<Int>(list: mut deps, value: read s)
                j = j + 1
            }
        }
        i = i + 1
    }
    local deduped = dedup(x: read deps)
    if symbolic_int_list_same(a: read deps, b: read deduped) == false { changed = true }
    if changed == false { return None }
    return Some(mk_after(cache: mut cache, id: root, srcs: read deduped))
}

fn rule_simplify_stack_const(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != STACK { return None }
    let n = node_num_src(cache: read cache, id: id)
    if n <= 0 { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    if dt.count != n { return None }
    local vals = List.new<Int>()
    let mut i = 0
    while i < n {
        let child = node_src_id(cache: read cache, id: id, k: i)
        if node_is_const_int(cache: read cache, id: child) == false { return None }
        List.push<Int>(list: mut vals, value: read node_const_int(cache: read cache, id: child))
        i = i + 1
    }
    return Some(symbolic_const_vector_int(cache: mut cache, dt: read dt, vals: read vals))
}

fn rule_simplify_group_sink_cleanup(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if op != GROUP && op != SINK { return None }
    let n = node_num_src(cache: read cache, id: id)
    if op == GROUP && n == 1 { return Some(node_src_id(cache: read cache, id: id, k: 0)) }
    local out = List.new<Int>()
    let mut changed = false
    let mut i = 0
    while i < n {
        let child = node_src_id(cache: read cache, id: id, k: i)
        let cop = node_op(cache: read cache, id: child)
        if symbolic_remove_from_sink_like(op: read cop) {
            changed = true
            let mut j = 0
            while j < node_num_src(cache: read cache, id: child) {
                let s = node_src_id(cache: read cache, id: child, k: j)
                List.push<Int>(list: mut out, value: read s)
                j = j + 1
            }
        } else {
            List.push<Int>(list: mut out, value: read child)
        }
        i = i + 1
    }
    if changed == false { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    return Some(symbolic_mk_same_op_list(cache: mut cache, op: op.clone(), dt: read dt, srcs: read out))
}

fn rule_simplify_vectorized_binary_alu(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if group_binary(op: read op) == false { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    if node_op(cache: read cache, id: a) != STACK { return None }
    if node_op(cache: read cache, id: b) != STACK { return None }
    let n = node_num_src(cache: read cache, id: a)
    if n <= 0 { return None }
    if node_num_src(cache: read cache, id: b) != n { return None }
    let dt = node_full_dtype(cache: read cache, id: id)
    if dt.count != n { return None }
    let sdt = dtype_scalar(d: read dt)
    local lanes = List.new<Int>()
    let mut i = 0
    while i < n {
        let ax = node_src_id(cache: read cache, id: a, k: i)
        let bx = node_src_id(cache: read cache, id: b, k: i)
        let lane = mk_alu2(cache: mut cache, op: op.clone(), dt: read sdt, x: ax, y: bx)
        List.push<Int>(list: mut lanes, value: read lane)
        i = i + 1
    }
    return Some(uop_stack(cache: mut cache, dt: read dt, srcs: read lanes))
}

fn rule_simplify_cast_where_pushdown(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CAST { return None }
    if node_num_src(cache: read cache, id: id) != 1 { return None }
    let w = node_src_id(cache: read cache, id: id, k: 0)
    if node_op(cache: read cache, id: w) != WHERE { return None }
    if node_num_src(cache: read cache, id: w) != 3 { return None }
    let cond = node_src_id(cache: read cache, id: w, k: 0)
    let t = node_src_id(cache: read cache, id: w, k: 1)
    let f = node_src_id(cache: read cache, id: w, k: 2)
    let dt = node_full_dtype(cache: read cache, id: id)
    let tc = mk_cast(cache: mut cache, x: t, dt: read dt)
    let fc = mk_cast(cache: mut cache, x: f, dt: read dt)
    return Some(mk_where(cache: mut cache, dt: read dt, cond: cond, tval: tc, fval: fc))
}

fn rule_simplify_reciprocal_algebra(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) == RECIPROCAL {
        if node_num_src(cache: read cache, id: id) != 1 { return None }
        let x = node_src_id(cache: read cache, id: id, k: 0)
        if node_op(cache: read cache, id: x) == MUL && node_num_src(cache: read cache, id: x) == 2 {
            let a = node_src_id(cache: read cache, id: x, k: 0)
            let b = node_src_id(cache: read cache, id: x, k: 1)
            if a != b && node_is_const(cache: read cache, id: a) == false && node_is_const(cache: read cache, id: b) == false { return None }
            let dt = node_full_dtype(cache: read cache, id: id)
            let ra = mk_alu1(cache: mut cache, op: RECIPROCAL, dt: read dt, x: a)
            let rb = mk_alu1(cache: mut cache, op: RECIPROCAL, dt: read dt, x: b)
            return Some(mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: ra, y: rb))
        }
    }
    if node_op(cache: read cache, id: id) != MUL { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if symbolic_is_reciprocal_of_one_plus(cache: read cache, recip: b, x: a) {
        let one = decomp_const_one_like(cache: mut cache, x: id)
        return Some(mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: one, y: b))
    }
    if symbolic_is_reciprocal_of_one_plus(cache: read cache, recip: a, x: b) {
        let one = decomp_const_one_like(cache: mut cache, x: id)
        return Some(mk_alu2(cache: mut cache, op: SUB, dt: read dt, x: one, y: a))
    }
    return None
}

fn rule_simplify_distribution(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != MUL { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let a = node_src_id(cache: read cache, id: id, k: 0)
    let b = node_src_id(cache: read cache, id: id, k: 1)
    let mut cnode = a
    let mut add = b
    if node_is_const_int(cache: read cache, id: cnode) == false {
        cnode = b
        add = a
    }
    if node_op(cache: read cache, id: add) != ADD { return None }
    if node_num_src(cache: read cache, id: add) != 2 { return None }
    let x = node_src_id(cache: read cache, id: add, k: 0)
    let y = node_src_id(cache: read cache, id: add, k: 1)
    let dt = node_full_dtype(cache: read cache, id: id)
    if node_is_const_int(cache: read cache, id: cnode) {
        let c = node_const_int(cache: read cache, id: cnode)
        if c == 0 - 1 {
            let nx = mk_alu1(cache: mut cache, op: NEG, dt: read dt, x: x)
            let ny = mk_alu1(cache: mut cache, op: NEG, dt: read dt, x: y)
            return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: nx, y: ny))
        }
        let sdt = dtype_scalar(d: read dt)
        if sdt.name == "weakint" {
            let cx = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: x, y: cnode)
            let cy = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: y, y: cnode)
            return Some(mk_alu2(cache: mut cache, op: ADD, dt: read dt, x: cx, y: cy))
        }
    }
    return None
}

fn rule_simplify_canonicalize_simplex(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != CMPNE { return None }
    if node_num_src(cache: read cache, id: id) != 2 { return None }
    let lhs = node_src_id(cache: read cache, id: id, k: 0)
    let rhs = node_src_id(cache: read cache, id: id, k: 1)
    if const_bool_eq(cache: read cache, id: rhs, k: 1) == false { return None }
    if node_op(cache: read cache, id: lhs) != CMPLT { return None }
    if node_num_src(cache: read cache, id: lhs) != 2 { return None }
    let simplex = node_src_id(cache: read cache, id: lhs, k: 0)
    let bound = node_src_id(cache: read cache, id: lhs, k: 1)
    if const_int_eq(cache: read cache, id: bound, k: 1) == false { return None }
    match canonicalize_simplex(cache: mut cache, X: simplex) {
        Some(newx) => {
            let lt = mk_alu2(cache: mut cache, op: CMPLT, dt: read dt_bool(), x: newx, y: bound)
            return Some(mk_alu2(cache: mut cache, op: CMPNE, dt: read dt_bool(), x: lt, y: rhs))
        }
        None => {}
    }
    return None
}

// algebraic identities: x+0->x, x*1->x, x*0->0, x^0->x, x//1->x, x-0->x. Returning a child id reuses
// the (shared) node directly.
fn rule_identities(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if node_num_src(cache: read cache, id: id) == 2 {
        let s0 = node_src_id(cache: read cache, id: id, k: 0)
        let s1 = node_src_id(cache: read cache, id: id, k: 1)
        // same-operand rules: with interning, identical operands share an id, so this is id equality.
        // x-x->0, x^x->0, x%x->0, x//x->1 (tinygrad symbolic.py).
        if s0 == s1 {
            if group_idempotent(op: read op) { return Some(s0) }
            if op == SUB {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if op == XOR {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if op == FLOORMOD {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if op == FLOORDIV {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 1))
            }
            if op == CMPLT {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if op == CMPNE {
                let dt0 = node_dtype(cache: read cache, id: s0)
                if dtype_is_int(d: read dt0) || dtype_is_bool(d: read dt0) {
                    let dt = node_dtype(cache: read cache, id: id)
                    return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
                }
            }
        }
        if op == ADD {
            if const_int_eq(cache: read cache, id: s1, k: 0) { return Some(s0) }
            if const_int_eq(cache: read cache, id: s0, k: 0) { return Some(s1) }
        }
        if op == MUL {
            if const_int_eq(cache: read cache, id: s1, k: 1) { return Some(s0) }
            if const_int_eq(cache: read cache, id: s0, k: 1) { return Some(s1) }
            if const_int_eq(cache: read cache, id: s1, k: 0) {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if const_int_eq(cache: read cache, id: s0, k: 0) {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
        }
        if op == XOR {
            if const_int_eq(cache: read cache, id: s1, k: 0) { return Some(s0) }
            if const_int_eq(cache: read cache, id: s0, k: 0) { return Some(s1) }
            if node_op(cache: read cache, id: s0) == XOR {
                let x0 = node_src_id(cache: read cache, id: s0, k: 0)
                let x1 = node_src_id(cache: read cache, id: s0, k: 1)
                if x1 == s1 { return Some(x0) }
                if x0 == s1 { return Some(x1) }
            }
        }
        if op == AND {
            if const_int_eq(cache: read cache, id: s1, k: 0) {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if const_int_eq(cache: read cache, id: s0, k: 0) {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_const_int(cache: mut cache, dt: read dt, v: 0))
            }
            if const_bool_eq(cache: read cache, id: s1, k: 1) { return Some(s0) }
            if const_bool_eq(cache: read cache, id: s0, k: 1) { return Some(s1) }
        }
        if op == OR {
            if const_bool_eq(cache: read cache, id: s1, k: 0) { return Some(s0) }
            if const_bool_eq(cache: read cache, id: s0, k: 0) { return Some(s1) }
            if const_bool_eq(cache: read cache, id: s1, k: 1) { return Some(s1) }
            if const_bool_eq(cache: read cache, id: s0, k: 1) { return Some(s0) }
        }
        if op == FLOORDIV {
            if const_int_eq(cache: read cache, id: s1, k: 1) { return Some(s0) }
            if const_int_eq(cache: read cache, id: s1, k: 0 - 1) {
                let dt = node_dtype(cache: read cache, id: id)
                return Some(mk_alu1(cache: mut cache, op: NEG, dt: read dt, x: s0))
            }
        }
        if op == SUB {
            if const_int_eq(cache: read cache, id: s1, k: 0) { return Some(s0) }
        }
    }
    return None
}

// bound-dependent fold: a comparison whose value range collapses to a point is that constant.
fn rule_fold_known_bound(cache: mut UOpCache, id: Int) -> Option<Int> {
    let op = node_op(cache: read cache, id: id)
    if group_comparison(op: read op) {
        let r = uop_min_max(cache: read cache, id: id)
        if r.lo == r.hi {
            let dt = node_dtype(cache: read cache, id: id)
            return Some(mk_const_int(cache: mut cache, dt: read dt, v: r.lo))
        }
    }
    return None
}

fn parse_valid(cache: read UOpCache, v: Int) -> fresh SymbolicValidParse {
    if node_op(cache: read cache, id: v) == CMPNE && node_num_src(cache: read cache, id: v) == 2 {
        let s0 = node_src_id(cache: read cache, id: v, k: 0)
        let s1 = node_src_id(cache: read cache, id: v, k: 1)
        if const_bool_eq(cache: read cache, id: s1, k: 1) && node_op(cache: read cache, id: s0) == CMPLT && node_num_src(cache: read cache, id: s0) == 2 {
            let x = node_src_id(cache: read cache, id: s0, k: 0)
            let c = node_src_id(cache: read cache, id: s0, k: 1)
            let xdt = node_dtype(cache: read cache, id: x)
            if dtype_is_int(d: read xdt) && node_is_const_int(cache: read cache, id: c) {
                return SymbolicValidParse(ok: true, expr: x, is_upper: false, c: node_const_int(cache: read cache, id: c))
            }
        }
    }
    if node_op(cache: read cache, id: v) == CMPLT && node_num_src(cache: read cache, id: v) == 2 {
        let x = node_src_id(cache: read cache, id: v, k: 0)
        let c = node_src_id(cache: read cache, id: v, k: 1)
        let xdt = node_dtype(cache: read cache, id: x)
        if dtype_is_int(d: read xdt) && node_is_const_int(cache: read cache, id: c) {
            return SymbolicValidParse(ok: true, expr: x, is_upper: true, c: node_const_int(cache: read cache, id: c) - 1)
        }
    }
    return SymbolicValidParse(ok: false, expr: v, is_upper: true, c: 0)
}

fn symbolic_and_product(cache: mut UOpCache, parts: read List<Int>) -> Int {
    let bdt = dt_bool()
    if List.len<Int>(list: read parts) == 0 { return mk_const_int(cache: mut cache, dt: read bdt, v: 1) }
    let mut out = List.get<Int>(list: read parts, index: 0)
    let mut i = 1
    while i < List.len<Int>(list: read parts) {
        out = mk_alu2(cache: mut cache, op: AND, dt: read bdt, x: out, y: List.get<Int>(list: read parts, index: i))
        i = i + 1
    }
    return out
}

fn symbolic_mul_product(cache: mut UOpCache, dt: read DType, parts: read List<Int>) -> Int {
    if List.len<Int>(list: read parts) == 0 { return mk_const_int(cache: mut cache, dt: read dt, v: 1) }
    let mut out = List.get<Int>(list: read parts, index: 0)
    let mut i = 1
    while i < List.len<Int>(list: read parts) {
        out = mk_alu2(cache: mut cache, op: MUL, dt: read dt, x: out, y: List.get<Int>(list: read parts, index: i))
        i = i + 1
    }
    return out
}

fn symbolic_find_expr_index(exprs: read List<Int>, expr: Int) -> Int {
    let mut i = 0
    while i < List.len<Int>(list: read exprs) {
        if List.get<Int>(list: read exprs, index: i) == expr { return i }
        i = i + 1
    }
    return 0 - 1
}

fn symbolic_contains_node(cache: read UOpCache, root: Int, want: Int) -> Bool {
    if root == want { return true }
    local nodes = backward_slice_with_self(cache: read cache, id: root)
    return uop_ints_contains(vals: read nodes, v: want)
}

fn symbolic_simplex_part_ok(cache: read UOpCache, id: Int) -> Bool {
    let op = node_op(cache: read cache, id: id)
    if op == DEFINE_VAR || op == RANGE || op == SPECIAL || op == PARAM { return true }
    return false
}

fn uop_given_valid(cache: mut UOpCache, valid: Int, uop: Int, try_simplex: Bool) -> Int {
    if const_bool_eq(cache: read cache, id: valid, k: 1) { return uop }
    local clauses = uop_split_by_op(cache: read cache, id: valid, sep: AND)
    local exprs = List.new<Int>()
    local lower_seen = List.new<Bool>()
    local upper_seen = List.new<Bool>()
    local lowers = List.new<Int>()
    local uppers = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read clauses) {
        let p = parse_valid(cache: read cache, v: List.get<Int>(list: read clauses, index: i))
        if p.ok {
            let mut bi = symbolic_find_expr_index(exprs: read exprs, expr: p.expr)
            if bi < 0 {
                List.push<Int>(list: mut exprs, value: read p.expr)
                List.push<Bool>(list: mut lower_seen, value: read false)
                List.push<Bool>(list: mut upper_seen, value: read false)
                List.push<Int>(list: mut lowers, value: read 0)
                List.push<Int>(list: mut uppers, value: read 0)
                bi = List.len<Int>(list: read exprs) - 1
            }
            if p.is_upper {
                List.set<Bool>(list: mut upper_seen, index: bi, value: read true)
                List.set<Int>(list: mut uppers, index: bi, value: read p.c)
            } else {
                List.set<Bool>(list: mut lower_seen, index: bi, value: read true)
                List.set<Int>(list: mut lowers, index: bi, value: read p.c)
            }
        }
        i = i + 1
    }
    let exact_i = symbolic_find_expr_index(exprs: read exprs, expr: uop)
    if exact_i >= 0 {
        if List.get<Bool>(list: read lower_seen, index: exact_i) && List.get<Bool>(list: read upper_seen, index: exact_i) {
            let lower = List.get<Int>(list: read lowers, index: exact_i)
            let upper = List.get<Int>(list: read uppers, index: exact_i)
            if lower == upper {
                let dt = node_dtype(cache: read cache, id: uop)
                return mk_const_int(cache: mut cache, dt: read dt, v: lower)
            }
        }
    }
    local all_old = List.new<Int>()
    local all_new = List.new<Int>()
    let mut out_uop = uop
    let mut bi = 0
    while bi < List.len<Int>(list: read exprs) {
        let expr = List.get<Int>(list: read exprs, index: bi)
        local rng = uop_min_max(cache: read cache, id: expr)
        let mut v0 = rng.lo
        let mut v1 = rng.hi
        if List.get<Bool>(list: read lower_seen, index: bi) { v0 = List.get<Int>(list: read lowers, index: bi) }
        if List.get<Bool>(list: read upper_seen, index: bi) { v1 = List.get<Int>(list: read uppers, index: bi) }
        let fake = uop_variable(cache: mut cache, name: read String.concat(left: read "fake", right: read Int.to_string(value: read bi)), min_val: v0, max_val: v1, dt: read node_dtype(cache: read cache, id: expr))
        List.push<Int>(list: mut all_old, value: read expr)
        List.push<Int>(list: mut all_new, value: read fake)
        let subbed = uop_substitute(cache: mut cache, id: out_uop, old_id: expr, new_id: fake)
        if subbed != out_uop {
            let sim = uop_simplify(cache: mut cache, id: subbed)
            let restored = uop_substitute(cache: mut cache, id: sim, old_id: fake, new_id: expr)
            let resim = uop_simplify(cache: mut cache, id: restored)
            out_uop = resim
        }
        if try_simplex && node_op(cache: read cache, id: expr) == ADD && v0 == 1 {
            local parts = uop_split_by_op(cache: read cache, id: expr, sep: ADD)
            let mut parts_ok = List.len<Int>(list: read parts) > 0
            let mut pi = 0
            while pi < List.len<Int>(list: read parts) {
                if symbolic_simplex_part_ok(cache: read cache, id: List.get<Int>(list: read parts, index: pi)) == false { parts_ok = false }
                pi = pi + 1
            }
            if parts_ok {
                local newuops = List.new<Int>()
                pi = 0
                while pi < List.len<Int>(list: read parts) {
                    let part = List.get<Int>(list: read parts, index: pi)
                    local prng = uop_min_max(cache: read cache, id: part)
                    let pfake = uop_variable(cache: mut cache, name: read String.concat(left: read "fakep", right: read Int.to_string(value: read pi)), min_val: 1, max_val: prng.hi, dt: read node_dtype(cache: read cache, id: part))
                    let psub = uop_substitute(cache: mut cache, id: out_uop, old_id: part, new_id: pfake)
                    if psub != out_uop {
                        let psim = uop_simplify(cache: mut cache, id: psub)
                        let prest = uop_substitute(cache: mut cache, id: psim, old_id: pfake, new_id: part)
                        List.push<Int>(list: mut newuops, value: read uop_simplify(cache: mut cache, id: prest))
                    }
                    pi = pi + 1
                }
                if List.len<Int>(list: read newuops) == List.len<Int>(list: read parts) {
                    if all_same(items: read newuops) {
                        out_uop = List.get<Int>(list: read newuops, index: 0)
                    } else {
                        if node_op(cache: read cache, id: out_uop) == STACK && node_num_src(cache: read cache, id: out_uop) == 2 {
                            let mut lane0_same = true
                            let mut lane1_same = true
                            let u0 = node_src_id(cache: read cache, id: List.get<Int>(list: read newuops, index: 0), k: 0)
                            let u1 = node_src_id(cache: read cache, id: List.get<Int>(list: read newuops, index: 0), k: 1)
                            let mut ni = 1
                            while ni < List.len<Int>(list: read newuops) {
                                let nu = List.get<Int>(list: read newuops, index: ni)
                                if node_src_id(cache: read cache, id: nu, k: 0) != u0 { lane0_same = false }
                                if node_src_id(cache: read cache, id: nu, k: 1) != u1 { lane1_same = false }
                                ni = ni + 1
                            }
                            if lane0_same || lane1_same {
                                local srcs = List.new<Int>()
                                if lane0_same { List.push<Int>(list: mut srcs, value: read u0) } else { List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: out_uop, k: 0)) }
                                if lane1_same { List.push<Int>(list: mut srcs, value: read u1) } else { List.push<Int>(list: mut srcs, value: read node_src_id(cache: read cache, id: out_uop, k: 1)) }
                                out_uop = uop_stack(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: out_uop), srcs: read srcs)
                            }
                        }
                    }
                }
            }
        }
        bi = bi + 1
    }
    let all_subbed = uop_substitute_many(cache: mut cache, id: out_uop, old_ids: read all_old, new_ids: read all_new)
    if all_subbed != out_uop {
        let all_sim = uop_simplify(cache: mut cache, id: all_subbed)
        let restored = uop_substitute_many(cache: mut cache, id: all_sim, old_ids: read all_new, new_ids: read all_old)
        out_uop = uop_simplify(cache: mut cache, id: restored)
    }
    return out_uop
}

fn _valid_priority(cache: read UOpCache, v: Int, valids: read List<Int>) -> Int {
    let parsed = parse_valid(cache: read cache, v: v)
    if parsed.ok {
        let mut pri = 0
        let mut i = 0
        while i < List.len<Int>(list: read valids) {
            let other = List.get<Int>(list: read valids, index: i)
            if other != v && symbolic_contains_node(cache: read cache, root: other, want: parsed.expr) { pri = pri - 1 }
            i = i + 1
        }
        return pri
    }
    return 0
}

fn simplify_valid(cache: mut UOpCache, valid: Int) -> Option<Int> {
    if node_op(cache: read cache, id: valid) != AND { return None }
    if uop_op_in_backward_slice_with_self(cache: read cache, id: valid, op: INDEX) { return None }
    local clauses0 = uop_split_by_op(cache: read cache, id: valid, sep: AND)
    local clauses = dedup(x: read clauses0)
    local out = List.new<Int>()
    let mut changed = symbolic_int_list_same(a: read clauses0, b: read clauses) == false
    let mut i = 0
    while i < List.len<Int>(list: read clauses) {
        let mut stmt = List.get<Int>(list: read clauses, index: i)
        if List.len<Int>(list: read out) > 0 {
            let known = symbolic_and_product(cache: mut cache, parts: read out)
            let rewritten = uop_given_valid(cache: mut cache, valid: known, uop: stmt, try_simplex: true)
            if rewritten != stmt { changed = true }
            stmt = rewritten
        }
        List.push<Int>(list: mut out, value: read stmt)
        i = i + 1
    }
    if changed == false { return None }
    return Some(symbolic_and_product(cache: mut cache, parts: read out))
}

fn reduce_mul_chain(cache: mut UOpCache, r: Int) -> Option<Int> {
    if node_op(cache: read cache, id: r) != REDUCE { return None }
    let kind = node_reduce_kind(cache: read cache, id: r)
    if kind != 0 && kind != 2 { return None }
    if node_num_src(cache: read cache, id: r) < 1 { return None }
    let inner = node_src_id(cache: read cache, id: r, k: 0)
    if node_op(cache: read cache, id: inner) != MUL { return None }
    let rdt = node_full_dtype(cache: read cache, id: r)
    let idt = node_full_dtype(cache: read cache, id: inner)
    if symbolic_dtype_same(a: read rdt, b: read idt) == false { return None }
    local parts = uop_split_by_op(cache: read cache, id: inner, sep: MUL)
    local inside = List.new<Int>()
    local outside = List.new<Int>()
    let mut i = 0
    while i < List.len<Int>(list: read parts) {
        let m = List.get<Int>(list: read parts, index: i)
        if node_is_const_int(cache: read cache, id: m) {
            List.push<Int>(list: mut outside, value: read m)
        } else {
            List.push<Int>(list: mut inside, value: read m)
        }
        i = i + 1
    }
    if List.len<Int>(list: read outside) == 0 { return None }
    let new_inner = symbolic_mul_product(cache: mut cache, dt: read idt, parts: read inside)
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read new_inner)
    local arg = node_arg(cache: read cache, id: r)
    let new_reduce = intern(cache: mut cache, op: REDUCE, dt: read rdt, src: take src, arg: take arg)
    let outside_prod = symbolic_mul_product(cache: mut cache, dt: read rdt, parts: read outside)
    return Some(mk_alu2(cache: mut cache, op: MUL, dt: read rdt, x: new_reduce, y: outside_prod))
}

fn drop_and_clauses(cache: mut UOpCache, cond: Int, x: Int, i: Int) -> Option<Int> {
    local clauses = uop_split_by_op(cache: read cache, id: cond, sep: AND)
    local x_ranges = uop_ranges(cache: read cache, id: x)
    local keep = List.new<Int>()
    let mut dropped = false
    let mut ci = 0
    while ci < List.len<Int>(list: read clauses) {
        let clause = List.get<Int>(list: read clauses, index: ci)
        local cranges = uop_ranges(cache: read cache, id: clause)
        let mut overlaps = false
        let mut ri = 0
        while ri < List.len<Int>(list: read cranges) {
            if uop_ints_contains(vals: read x_ranges, v: List.get<Int>(list: read cranges, index: ri)) { overlaps = true }
            ri = ri + 1
        }
        if overlaps { List.push<Int>(list: mut keep, value: read clause) }
        else { dropped = true }
        ci = ci + 1
    }
    if dropped == false { return None }
    let kcond = symbolic_and_product(cache: mut cache, parts: read keep)
    let dt = node_full_dtype(cache: read cache, id: x)
    return Some(mk_where(cache: mut cache, dt: read dt, cond: kcond, tval: x, fval: i))
}

fn symbolic_index_nodes(cache: read UOpCache, id: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    local topo = uop_toposort(cache: read cache, id: id)
    let mut i = 0
    while i < List.len<Int>(list: read topo) {
        let node = List.get<Int>(list: read topo, index: i)
        if node_op(cache: read cache, id: node) == INDEX { List.push<Int>(list: mut out, value: read node) }
        i = i + 1
    }
    return take out
}

fn symbolic_ranges_subset(cache: read UOpCache, child: Int, parent: Int) -> Bool {
    local cranges = uop_ranges(cache: read cache, id: child)
    local pranges = uop_ranges(cache: read cache, id: parent)
    let mut i = 0
    while i < List.len<Int>(list: read cranges) {
        if uop_ints_contains(vals: read pranges, v: List.get<Int>(list: read cranges, index: i)) == false { return false }
        i = i + 1
    }
    return true
}

fn symbolic_clause_index_allowed(cache: read UOpCache, clause: Int, allowed: read List<Int>) -> Bool {
    local indexes = symbolic_index_nodes(cache: read cache, id: clause)
    let mut i = 0
    while i < List.len<Int>(list: read indexes) {
        if uop_ints_contains(vals: read allowed, v: List.get<Int>(list: read indexes, index: i)) == false { return false }
        i = i + 1
    }
    return true
}

fn symbolic_can_move_where_clause(cache: read UOpCache, clause: Int, idx: Int, idx_indexes: read List<Int>) -> Bool {
    if symbolic_ranges_subset(cache: read cache, child: clause, parent: idx) == false { return false }
    return symbolic_clause_index_allowed(cache: read cache, clause: clause, allowed: read idx_indexes)
}

fn where_on_load(cache: mut UOpCache, cond: Int, buf: Int, idx: Int, or_cast: Int) -> Option<Int> {
    local where_clauses = uop_split_by_op(cache: read cache, id: cond, sep: AND)
    let load_valid = uop_get_valid(cache: mut cache, id: idx)
    local in_load = uop_split_by_op(cache: read cache, id: load_valid, sep: AND)
    local idx_indexes = symbolic_index_nodes(cache: read cache, id: idx)
    local moved = List.new<Int>()
    local keep = List.new<Int>()
    let mut dropped_existing = false
    let mut i = 0
    while i < List.len<Int>(list: read where_clauses) {
        let clause = List.get<Int>(list: read where_clauses, index: i)
        if uop_ints_contains(vals: read in_load, v: clause) {
            dropped_existing = true
        } else if symbolic_can_move_where_clause(cache: read cache, clause: clause, idx: idx, idx_indexes: read idx_indexes) {
            List.push<Int>(list: mut moved, value: read clause)
        } else {
            List.push<Int>(list: mut keep, value: read clause)
        }
        i = i + 1
    }
    if List.len<Int>(list: read moved) == 0 && dropped_existing == false { return None }
    local valid_parts = List.new<Int>()
    List.push<Int>(list: mut valid_parts, value: read load_valid)
    i = 0
    while i < List.len<Int>(list: read moved) {
        List.push<Int>(list: mut valid_parts, value: read List.get<Int>(list: read moved, index: i))
        i = i + 1
    }
    let new_valid = symbolic_and_product(cache: mut cache, parts: read valid_parts)
    let raw_idx = uop_get_idx(cache: read cache, id: idx)
    let valid_idx = uop_valid(cache: mut cache, id: raw_idx, cond: new_valid)
    local idx_srcs = List.new<Int>()
    List.push<Int>(list: mut idx_srcs, value: read valid_idx)
    let new_idx = mk_index(cache: mut cache, base: buf, srcs: read idx_srcs, ptr: false)
    let mut ret_idx = new_idx
    if node_op(cache: read cache, id: or_cast) == CAST {
        ret_idx = mk_cast(cache: mut cache, x: new_idx, dt: read node_full_dtype(cache: read cache, id: or_cast))
    }
    let keep_cond = symbolic_and_product(cache: mut cache, parts: read keep)
    let zero = uop_const_like(cache: mut cache, id: ret_idx, v: 0)
    let dt = node_full_dtype(cache: read cache, id: ret_idx)
    return Some(mk_where(cache: mut cache, dt: read dt, cond: keep_cond, tval: ret_idx, fval: zero))
}

fn symbolic_match_index_or_cast(cache: read UOpCache, id: Int) -> fresh SymbolicIndexCastMatch {
    let mut cur = id
    if node_op(cache: read cache, id: cur) == CAST {
        if node_num_src(cache: read cache, id: cur) != 1 {
            return SymbolicIndexCastMatch(ok: false, buf: 0, idx: 0, idx1: 0, count: 0, index_node: 0, or_cast: id)
        }
        cur = node_src_id(cache: read cache, id: cur, k: 0)
    }
    if node_op(cache: read cache, id: cur) != INDEX {
        return SymbolicIndexCastMatch(ok: false, buf: 0, idx: 0, idx1: 0, count: 0, index_node: 0, or_cast: id)
    }
    let n = node_num_src(cache: read cache, id: cur)
    if n != 2 && n != 3 {
        return SymbolicIndexCastMatch(ok: false, buf: 0, idx: 0, idx1: 0, count: 0, index_node: 0, or_cast: id)
    }
    let mut idx1 = 0
    if n == 3 { idx1 = node_src_id(cache: read cache, id: cur, k: 2) }
    return SymbolicIndexCastMatch(ok: true,
                                  buf: node_src_id(cache: read cache, id: cur, k: 0),
                                  idx: node_src_id(cache: read cache, id: cur, k: 1),
                                  idx1: idx1,
                                  count: n - 1,
                                  index_node: cur,
                                  or_cast: id)
}

fn where_on_index(cache: mut UOpCache, cond: Int, m: read SymbolicIndexCastMatch) -> Option<Int> {
    if m.count == 1 {
        return where_on_load(cache: mut cache, cond: cond, buf: m.buf, idx: m.idx, or_cast: m.or_cast)
    }
    if m.count != 2 { return None }
    let valid0 = uop_get_valid(cache: mut cache, id: m.idx)
    let valid1 = uop_get_valid(cache: mut cache, id: m.idx1)
    local valid_base = List.new<Int>()
    List.push<Int>(list: mut valid_base, value: read valid0)
    List.push<Int>(list: mut valid_base, value: read valid1)
    let load_valid = symbolic_and_product(cache: mut cache, parts: read valid_base)
    local where_clauses = uop_split_by_op(cache: read cache, id: cond, sep: AND)
    local in_load = uop_split_by_op(cache: read cache, id: load_valid, sep: AND)
    local idx_indexes = symbolic_index_nodes(cache: read cache, id: m.index_node)
    local moved = List.new<Int>()
    local keep = List.new<Int>()
    let mut dropped_existing = false
    let mut i = 0
    while i < List.len<Int>(list: read where_clauses) {
        let clause = List.get<Int>(list: read where_clauses, index: i)
        if uop_ints_contains(vals: read in_load, v: clause) {
            dropped_existing = true
        } else if symbolic_can_move_where_clause(cache: read cache, clause: clause, idx: m.index_node, idx_indexes: read idx_indexes) {
            List.push<Int>(list: mut moved, value: read clause)
        } else {
            List.push<Int>(list: mut keep, value: read clause)
        }
        i = i + 1
    }
    if List.len<Int>(list: read moved) == 0 && dropped_existing == false { return None }
    local valid_parts = List.new<Int>()
    List.push<Int>(list: mut valid_parts, value: read load_valid)
    i = 0
    while i < List.len<Int>(list: read moved) {
        List.push<Int>(list: mut valid_parts, value: read List.get<Int>(list: read moved, index: i))
        i = i + 1
    }
    let new_valid = symbolic_and_product(cache: mut cache, parts: read valid_parts)
    let raw0 = uop_get_idx(cache: read cache, id: m.idx)
    let raw1 = uop_get_idx(cache: read cache, id: m.idx1)
    let valid0_new = uop_valid(cache: mut cache, id: raw0, cond: new_valid)
    let valid1_new = uop_valid(cache: mut cache, id: raw1, cond: new_valid)
    local idx_srcs = List.new<Int>()
    List.push<Int>(list: mut idx_srcs, value: read valid0_new)
    List.push<Int>(list: mut idx_srcs, value: read valid1_new)
    let new_idx = mk_index(cache: mut cache, base: m.buf, srcs: read idx_srcs, ptr: false)
    let mut ret_idx = new_idx
    if node_op(cache: read cache, id: m.or_cast) == CAST {
        let cast_dt = node_full_dtype(cache: read cache, id: m.or_cast)
        ret_idx = mk_cast(cache: mut cache, x: new_idx, dt: read cast_dt)
    }
    let keep_cond = symbolic_and_product(cache: mut cache, parts: read keep)
    let zero = uop_const_like(cache: mut cache, id: ret_idx, v: 0)
    let dt = node_full_dtype(cache: read cache, id: ret_idx)
    return Some(mk_where(cache: mut cache, dt: read dt, cond: keep_cond, tval: ret_idx, fval: zero))
}

fn rule_symbolic_drop_and_clauses(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != WHERE { return None }
    if node_num_src(cache: read cache, id: id) != 3 { return None }
    let i = node_src_id(cache: read cache, id: id, k: 2)
    if uop_is_invalid(cache: read cache, id: i) == false { return None }
    return drop_and_clauses(cache: mut cache,
                            cond: node_src_id(cache: read cache, id: id, k: 0),
                            x: node_src_id(cache: read cache, id: id, k: 1),
                            i: i)
}

fn rule_symbolic_where_on_load(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != WHERE { return None }
    if node_num_src(cache: read cache, id: id) != 3 { return None }
    let cond = node_src_id(cache: read cache, id: id, k: 0)
    let tval = node_src_id(cache: read cache, id: id, k: 1)
    let fval = node_src_id(cache: read cache, id: id, k: 2)
    if symbolic_const_zero(cache: read cache, id: fval) {
        let m = symbolic_match_index_or_cast(cache: read cache, id: tval)
        if m.ok {
            return where_on_index(cache: mut cache, cond: cond, m: read m)
        }
    }
    if symbolic_const_zero(cache: read cache, id: tval) {
        let m = symbolic_match_index_or_cast(cache: read cache, id: fval)
        if m.ok {
            let ncond = symbolic_bool_logical_not(cache: mut cache, id: cond)
            return where_on_index(cache: mut cache, cond: ncond, m: read m)
        }
    }
    return None
}

fn rule_symbolic_gated_given_valid(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != WHERE { return None }
    if node_num_src(cache: read cache, id: id) != 3 { return None }
    let i = node_src_id(cache: read cache, id: id, k: 2)
    if uop_is_invalid(cache: read cache, id: i) == false { return None }
    return gated_given_valid(cache: mut cache,
                             cond: node_src_id(cache: read cache, id: id, k: 0),
                             x: node_src_id(cache: read cache, id: id, k: 1),
                             i: i)
}

fn gated_given_valid(cache: mut UOpCache, cond: Int, x: Int, i: Int) -> Option<Int> {
    let xdt = node_dtype(cache: read cache, id: x)
    if xdt.name != "weakint" { return None }
    let sx = uop_given_valid(cache: mut cache, valid: cond, uop: x, try_simplex: false)
    if sx == x { return None }
    let dt = node_full_dtype(cache: read cache, id: i)
    return Some(mk_where(cache: mut cache, dt: read dt, cond: cond, tval: sx, fval: i))
}

fn gep_through_wmma(cache: mut UOpCache, gep: Int, wmma: Int) -> Option<Int> {
    if node_op(cache: read cache, id: gep) != GEP { return None }
    if node_op(cache: read cache, id: wmma) != WMMA { return None }
    local idxs = node_argints(cache: read cache, id: gep)
    let wdt = node_full_dtype(cache: read cache, id: wmma)
    if List.len<Int>(list: read idxs) == wdt.count {
        let mut i = 0
        let mut identity = true
        while i < List.len<Int>(list: read idxs) {
            if List.get<Int>(list: read idxs, index: i) != i { identity = false }
            i = i + 1
        }
        if identity { return Some(wmma) }
    }
    return None
}

