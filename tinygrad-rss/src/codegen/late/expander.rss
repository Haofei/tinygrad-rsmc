fn expander_pre_range_unroll(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != RANGE { return None }
    let at = node_range_type(cache: read cache, id: id)
    if at != AXIS_UNROLL && at != AXIS_UPCAST { return None }
    let mm = uop_min_max(cache: read cache, id: id)
    let count = mm.hi + 1
    if count <= 0 { return None }
    let base = expander_const_iota(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: id), count: count)
    local pairs = List.new<Int>()
    List.push<Int>(list: mut pairs, value: read node_range_axis_id(cache: read cache, id: id))
    List.push<Int>(list: mut pairs, value: read count)
    return Some(mk_unroll(cache: mut cache, x: base, pairs: read pairs))
}

fn expander_pre_reduce_unroll(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != REDUCE { return None }
    local reduce_ranges = List.new<Int>()
    local reduce_unrolls = List.new<Int>()
    let mut i = 1
    while i < node_num_src(cache: read cache, id: id) {
        let src = node_src_id(cache: read cache, id: id, k: i)
        let op = node_op(cache: read cache, id: src)
        if op == RANGE {
            List.push<Int>(list: mut reduce_ranges, value: read src)
        } else {
            if op == UNROLL {
                List.push<Int>(list: mut reduce_unrolls, value: read src)
            } else {
                if op != CONST { return None }
            }
        }
        i = i + 1
    }
    if List.len<Int>(list: read reduce_unrolls) == 0 { return None }
    local contract_axis = List.new<Int>()
    let mut j = 0
    while j < List.len<Int>(list: read reduce_unrolls) {
        let unroll = List.get<Int>(list: read reduce_unrolls, index: j)
        local pairs = node_axis_size_pairs(cache: read cache, id: unroll)
        let mut k = 0
        while k < List.len<Int>(list: read pairs) {
            List.push<Int>(list: mut contract_axis, value: read List.get<Int>(list: read pairs, index: k))
            k = k + 1
        }
        j = j + 1
    }
    let value = node_src_id(cache: read cache, id: id, k: 0)
    let mut ret = value
    if List.len<Int>(list: read contract_axis) > 0 {
        ret = mk_contract(cache: mut cache, x: value, pairs: read contract_axis)
    }
    return Some(expander_reduce_with_srcs(cache: mut cache, id: id, value: ret, tails: read reduce_ranges))
}

fn expander_pre_store_unroll(cache: mut UOpCache, id: Int) -> Option<Int> {
    if node_op(cache: read cache, id: id) != STORE { return None }
    local keep_tail = List.new<Int>()
    local contract_axis = List.new<Int>()
    let mut found = false
    let mut i = 2
    while i < node_num_src(cache: read cache, id: id) {
        let src = node_src_id(cache: read cache, id: id, k: i)
        if node_op(cache: read cache, id: src) == UNROLL {
            local pairs = node_axis_size_pairs(cache: read cache, id: src)
            let mut j = 0
            while j < List.len<Int>(list: read pairs) {
                List.push<Int>(list: mut contract_axis, value: read List.get<Int>(list: read pairs, index: j))
                j = j + 1
            }
            found = true
        } else {
            List.push<Int>(list: mut keep_tail, value: read src)
        }
        i = i + 1
    }
    if found == false { return None }
    let st = expander_store_with_tail(cache: mut cache, id: id, tails: read keep_tail)
    return Some(mk_contract(cache: mut cache, x: st, pairs: read contract_axis))
}

fn expander_pre_rewrite(cache: mut UOpCache, id: Int) -> Option<Int> {
    match expander_pre_range_unroll(cache: mut cache, id: id) {
