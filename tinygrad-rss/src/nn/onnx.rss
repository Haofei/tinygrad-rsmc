fn onnx_find_attr(node: read OnnxNodeProto, name: read String) -> fresh OnnxAttributeProto {
    let mut i = 0
    while i < List.len<OnnxAttributeProto>(list: read node.attributes) {
        local a = List.get<OnnxAttributeProto>(list: read node.attributes, index: i)
        if a.name == name { return a.clone() }
        i = i + 1
    }
    return onnx_attr_empty()
}

fn onnx_attr_int_or(node: read OnnxNodeProto, name: read String, default_value: Int) -> Int {
    local a = onnx_find_attr(node: read node, name: read name)
    if List.len<Int>(list: read a.ints) > 0 { return List.get<Int>(list: read a.ints, index: 0) }
    return default_value
