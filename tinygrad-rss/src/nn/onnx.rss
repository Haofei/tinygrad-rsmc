    List.push<String>(list: mut gemm_out, value: read "gemm")
    local gemm_node = onnx_node_new(op: read "Gemm", inputs: read gemm_in, outputs: read gemm_out)
    local gemm_ids = onnx_execute_node(cache: mut cache, runner: mut runner, node: read gemm_node)
    local gemm_vals = eval_tensor(cache: read cache, id: List.get<Int>(list: read gemm_ids, index: 0))

    local conv_x_shape = shp4(a: 1, b: 1, c: 2, d: 2)
    local conv_x_data = List.new<Float>()
    pushf(l: mut conv_x_data, v: 1.0)
    pushf(l: mut conv_x_data, v: 2.0)
    pushf(l: mut conv_x_data, v: 3.0)
    pushf(l: mut conv_x_data, v: 4.0)
    let conv_x = mk_data_tensor(cache: mut cache, dt: read dt_float32(), shape: read conv_x_shape, data: read conv_x_data)
    local conv_w_shape = shp4(a: 1, b: 1, c: 1, d: 1)
    local conv_w_data = List.new<Float>()
    pushf(l: mut conv_w_data, v: 2.0)
    let conv_w = mk_data_tensor(cache: mut cache, dt: read dt_float32(), shape: read conv_w_shape, data: read conv_w_data)
    local conv_bias_shape = shp1(a: 1)
    local conv_bias_data = List.new<Float>()
    pushf(l: mut conv_bias_data, v: 1.0)
    let conv_bias = mk_data_tensor(cache: mut cache, dt: read dt_float32(), shape: read conv_bias_shape, data: read conv_bias_data)
    onnx_runner_set_value(runner: mut runner, name: read "cx", tensor: conv_x)
    onnx_runner_set_value(runner: mut runner, name: read "cw", tensor: conv_w)
    onnx_runner_set_value(runner: mut runner, name: read "cb", tensor: conv_bias)
    local conv_in = List.new<String>()
    List.push<String>(list: mut conv_in, value: read "cx")
    List.push<String>(list: mut conv_in, value: read "cw")
    List.push<String>(list: mut conv_in, value: read "cb")
    local conv_out = List.new<String>()
    List.push<String>(list: mut conv_out, value: read "conv")
    local conv_node = onnx_node_new(op: read "Conv", inputs: read conv_in, outputs: read conv_out)
    local conv_ids = onnx_execute_node(cache: mut cache, runner: mut runner, node: read conv_node)
    local conv_vals = eval_tensor(cache: read cache, id: List.get<Int>(list: read conv_ids, index: 0))

    let mut ok = List.len<Float>(list: read add_vals) == 4
    ok = ok && List.get<Float>(list: read add_vals, index: 0) == 6.0
    ok = ok && List.get<Float>(list: read add_vals, index: 1) == 4.0
    ok = ok && List.get<Float>(list: read relu_vals, index: 0) == 6.0
    ok = ok && List.len<Int>(list: read reshape_shape) == 1
    ok = ok && List.get<Int>(list: read reshape_shape, index: 0) == 4
    ok = ok && List.get<Float>(list: read trans_vals, index: 1) == 3.0
    ok = ok && List.len<Float>(list: read mm_vals) == 1
    ok = ok && List.get<Float>(list: read mm_vals, index: 0) == 23.0
    ok = ok && List.len<Float>(list: read gemm_vals) == 1
    ok = ok && List.get<Float>(list: read gemm_vals, index: 0) == 24.0
    ok = ok && List.len<Float>(list: read conv_vals) == 4
    ok = ok && List.get<Float>(list: read conv_vals, index: 0) == 3.0
    ok = ok && List.get<Float>(list: read conv_vals, index: 3) == 9.0
    return ok
}
