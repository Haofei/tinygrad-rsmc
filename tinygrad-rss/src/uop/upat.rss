// @port upstream: tinygrad/uop/ops.py
// Integrated UPat/PatternMatcher slice over the real interned UOp DAG.
//
// The standalone port-rss UPat demos used recursive toy UOps. This file keeps
// tinygrad-rss' actual representation: a UOp is an Int id into UOpCache, and
// patterns match/rewrite by inspecting ids through node_* accessors.
features: local

sum UPatKind derives(Clone, Eq) {
    UpatAny
    UpatConst
    UpatOp
}

sum UPatAction derives(Clone, Eq) {
    PActReturnName
    PActConstZero
    PActFoldAdd
    PActFoldMul
}

struct UPat derives(Clone) {
    kind: UPatKind,
    op: Ops,
    cval: Int,
    exact_const: Bool,
    name: String,
    ops: List<Ops>,
    dtype_name: String,
    allow_any_len: Bool,
    children: List<UPat>,
}

struct PatternRule derives(Clone) {
    pat: UPat,
    act: UPatAction,
    ret_name: String,
    lhs_name: String,
    rhs_name: String,
}

fn upat_empty_ops() -> fresh List<Ops> {
    return List.new<Ops>()
}

fn upat_no_children() -> fresh List<UPat> {
    return List.new<UPat>()
}

fn upat_copy_ops(xs: read List<Ops>) -> fresh List<Ops> {
    local out = List.new<Ops>()
    let mut i = 0
    while i < List.len<Ops>(list: read xs) {
        let v = List.get<Ops>(list: read xs, index: i)
        List.push<Ops>(list: mut out, value: read v)
        i = i + 1
    }
    return take out
}

fn upat_copy_children(xs: read List<UPat>) -> fresh List<UPat> {
    local out = List.new<UPat>()
    let mut i = 0
    while i < List.len<UPat>(list: read xs) {
        let v = List.get<UPat>(list: read xs, index: i)
        List.push<UPat>(list: mut out, value: read v)
        i = i + 1
    }
    return take out
}

fn upat_any(name: read String) -> fresh UPat {
    return UPat(kind: UpatAny, op: NOOP, cval: 0, exact_const: false,
                name: String.copy(value: read name), ops: upat_empty_ops(),
                dtype_name: "", allow_any_len: false, children: upat_no_children())
}

fn upat_var(name: read String) -> fresh UPat {
