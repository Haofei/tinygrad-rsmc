fn or_casted(x: read UPat, name: read String) -> fresh UPat {
    let mut self_pat = x.clone()
    if String.len(value: read name) > 0 {
        self_pat = named(x: read x, name: read name)
    }
    let cast_pat = upat_cast(x: read x)
    return upat_sink_anylen(a: read self_pat, b: read cast_pat)
}

fn or_after(x: read UPat, name: read String) -> fresh UPat {
    let mut self_pat = x.clone()
    if String.len(value: read name) > 0 {
        self_pat = named(x: read x, name: read name)
    }
    local after_pat = upat_op1(op: AFTER, a: read x)
    return upat_sink_anylen(a: read self_pat, b: read after_pat)
}

