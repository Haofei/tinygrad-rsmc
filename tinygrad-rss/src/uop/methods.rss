// Integrated UOp method/helper surface over the real interned UOp DAG.
//
// This mirrors part of tinygrad/uop/ops.py's UOp convenience API, but keeps
// tinygrad-rss' explicit cache/id representation: every "method" receives
// (cache, id) and returns an interned node id.
features: local

struct UOpBindValue derives(Clone) {
    var_id: Int,
    value: Int,
}

struct UOpUnbindAllResult derives(Clone) {
    root: Int,
    bindings: List<UOpBindValue>,
}

struct UOpConsumerEntry derives(Clone) {
    id: Int,
    consumers: List<Int>,
}

fn uop_string_compare(a: read String, b: read String) -> Int {
    let alen = String.len(value: read a)
    let blen = String.len(value: read b)
    let mut i = 0
    while i < alen && i < blen {
        let mut ac = 0
        let mut bc = 0
        match String.char_at(value: read a, index: i) {
            Some(ch) => { ac = Char.to_code(value: read ch) }
            None => {}
        }
        match String.char_at(value: read b, index: i) {
            Some(ch) => { bc = Char.to_code(value: read ch) }
            None => {}
        }
        if ac < bc { return 0 - 1 }
        if ac > bc { return 1 }
        i = i + 1
    }
    if alen < blen { return 0 - 1 }
    if alen > blen { return 1 }
    return 0
}

fn uop_var_less(cache: read UOpCache, a: Int, b: Int) -> Bool {
    let an = node_var_name(cache: read cache, id: a)
    let bn = node_var_name(cache: read cache, id: b)
    let nc = uop_string_compare(a: read an, b: read bn)
    if nc < 0 { return true }
    if nc > 0 { return false }
    let amin = node_var_min(cache: read cache, id: a)
    let bmin = node_var_min(cache: read cache, id: b)
    if amin < bmin { return true }
    if amin > bmin { return false }
    return node_var_max(cache: read cache, id: a) < node_var_max(cache: read cache, id: b)
}

fn uop_copy_src(cache: read UOpCache, id: Int) -> fresh List<Int> {
    local out = List.new<Int>()
    let mut i = 0
    while i < node_num_src(cache: read cache, id: id) {
        let s = node_src_id(cache: read cache, id: id, k: i)
        List.push<Int>(list: mut out, value: read s)
        i = i + 1
    }
    return take out
}

fn uop_int_list_to_string(vals: read List<Int>) -> fresh String {
    let mut s = String.copy(value: read "[")
    let mut i = 0
    while i < List.len<Int>(list: read vals) {
        s = String.concat(left: read s, right: read Int.to_string(value: read List.get<Int>(list: read vals, index: i)))
        if i < List.len<Int>(list: read vals) - 1 { s = String.concat(left: read s, right: read ",") }
        i = i + 1
    }
    return String.concat(left: read s, right: read "]")
}

fn uop_arg_to_string(arg: read Arg) -> fresh String {
    match arg {
        ArgNone => { return "None" }
        ArgInt(v) => { return Int.to_string(value: read v) }
        ArgFloat(f) => { return Float.to_string(value: read f) }
        ArgBool(b) => {
            if b { return "true" }
            return "false"
        }
        ArgStr(t) => { return String.copy(value: read t) }
        ArgInts(vals) => {
            return uop_int_list_to_string(vals: read vals)
        }
        ArgReduce(r) => {
            let axes = uop_int_list_to_string(vals: read r.axes)
            let mut s = String.copy(value: read "Reduce(kind=")
            s = String.concat(left: read s, right: read Int.to_string(value: read r.kind))
            s = String.concat(left: read s, right: read ",axes=")
            s = String.concat(left: read s, right: read axes)
            return String.concat(left: read s, right: read ")")
        }
        ArgVar(v) => {
            let mut s = String.copy(value: read v.name)
            s = String.concat(left: read s, right: read "[")
            s = String.concat(left: read s, right: read Int.to_string(value: read v.min_val))
            s = String.concat(left: read s, right: read ",")
            s = String.concat(left: read s, right: read Int.to_string(value: read v.max_val))
            return String.concat(left: read s, right: read "]")
        }
        ArgRange(r) => {
            let axes = uop_int_list_to_string(vals: read r.axes)
            let mut s = String.copy(value: read "Range(axes=")
            s = String.concat(left: read s, right: read axes)
            s = String.concat(left: read s, right: read ",type=")
            s = String.concat(left: read s, right: read axis_type_name(t: read r.axis_type))
            return String.concat(left: read s, right: read ")")
        }
        ArgParam(p) => {
            let mut s = String.copy(value: read "ParamArg(")
            s = String.concat(left: read s, right: read Int.to_string(value: read p.slot))
            if String.len(value: read p.name) > 0 {
                s = String.concat(left: read s, right: read ",name=")
                s = String.concat(left: read s, right: read p.name)
            }
            s = String.concat(left: read s, right: read ",addrspace=")
            s = String.concat(left: read s, right: read addr_space_name(a: read p.addrspace))
            if p.has_vmin_vmax {
                s = String.concat(left: read s, right: read ",vmin=")
                s = String.concat(left: read s, right: read Int.to_string(value: read p.vmin))
                s = String.concat(left: read s, right: read ",vmax=")
                s = String.concat(left: read s, right: read Int.to_string(value: read p.vmax))
            }
            if p.has_axis {
                s = String.concat(left: read s, right: read ",axis=")
                s = String.concat(left: read s, right: read Int.to_string(value: read p.axis))
            }
            if String.len(value: read p.device) > 0 {
                s = String.concat(left: read s, right: read ",device=")
                s = String.concat(left: read s, right: read p.device)
            }
            if List.len<String>(list: read p.devices) > 1 {
                local dv = DeviceArg(devices: copy_string_list(l: read p.devices))
                s = String.concat(left: read s, right: read ",devices=")
                s = String.concat(left: read s, right: read device_arg_key(d: read dv))
            }
            return String.concat(left: read s, right: read ")")
        }
        ArgAxisSizes(a) => {
            let pairs = uop_int_list_to_string(vals: read a.pairs)
            let mut s = String.copy(value: read "AxisSizes(")
            s = String.concat(left: read s, right: read pairs)
            return String.concat(left: read s, right: read ")")
        }
        ArgDevice(dv) => {
            let mut s = String.copy(value: read "Device(")
            let mut i = 0
            while i < List.len<String>(list: read dv.devices) {
                let d = List.get<String>(list: read dv.devices, index: i)
                s = String.concat(left: read s, right: read d)
                if i < List.len<String>(list: read dv.devices) - 1 { s = String.concat(left: read s, right: read ",") }
                i = i + 1
            }
            return String.concat(left: read s, right: read ")")
        }
        ArgOp(o) => {
            return ops_key_name(op: read o)
        }
        ArgBufferize(b) => {
            let mut s = String.copy(value: read "Bufferize(")
            s = String.concat(left: read s, right: read addr_space_name(a: read b.addrspace))
            if b.has_device {
                s = String.concat(left: read s, right: read ",device=")
                if b.is_device_int {
                    s = String.concat(left: read s, right: read Int.to_string(value: read b.device_int))
                } else {
                    local dv = DeviceArg(devices: copy_string_list(l: read b.devices))
                    s = String.concat(left: read s, right: read device_arg_key(d: read dv))
                }
            }
            if b.removable { s = String.concat(left: read s, right: read ",removable") }
            return String.concat(left: read s, right: read ")")
        }
        ArgProgram(p) => {
            let mut s = String.copy(value: read "Program(")
            s = String.concat(left: read s, right: read p.name)
            return String.concat(left: read s, right: read ")")
        }
        ArgCall(c) => {
            let mut s = String.copy(value: read "Call(")
            if c.has_name { s = String.concat(left: read s, right: read c.name) }
            if c.precompile { s = String.concat(left: read s, right: read ",precompile") }
            if c.precompile_backward { s = String.concat(left: read s, right: read ",precompile_backward") }
            return String.concat(left: read s, right: read ")")
        }
    }
}

fn uop_range_str(cache: read UOpCache, id: Int) -> fresh String {
    let axes = node_range_axes(cache: read cache, id: id)
    let mut s = String.copy(value: read "")
    let mut i = 0
    while i < List.len<Int>(list: read axes) {
        if i > 0 { s = String.concat(left: read s, right: read "_") }
        s = String.concat(left: read s, right: read Int.to_string(value: read List.get<Int>(list: read axes, index: i)))
        i = i + 1
    }
    return String.concat(left: read s, right: read axis_type_letter(t: read node_range_type(cache: read cache, id: id)))
}

