// a data-carrying BUFFER leaf: data stored in cache.datas[idx], arg = ArgInt(idx), src[0] = shape.
// (idx makes each buffer unique, so they aren't deduped by data — matches tinygrad's UNIQUE buffers.)
fn mk_data_tensor(cache: mut UOpCache, dt: read DType, shape: read List<Int>, data: read List<Float>) -> Int {
    let di = List.len<List<Float>>(list: read cache.datas)
    List.push<List<Float>>(list: mut cache.datas, value: read data)
    let sh = shape_to_shape_arg(cache: mut cache, dims: read shape)
    local e = List.new<Int>()
    List.push<Int>(list: mut e, value: read sh)
    local a = ArgInt(value: di)
    return intern(cache: mut cache, op: BUFFER, dt: read dt, src: take e, arg: take a)
}
fn node_data_idx(cache: read UOpCache, id: Int) -> Int { return node_const_int(cache: read cache, id: id) }
