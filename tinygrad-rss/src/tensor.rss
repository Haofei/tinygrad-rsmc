    let idx_pad = tensor_pad_constant(cache: mut cache, x: idx_map, before: read before, after: read after, value: 0.0 - 1000000000000000000.0)
    let idx_windows = tensor_pool2d_windows_nchw_dilated(cache: mut cache, x: idx_pad, kh: kh, kw: kw, sh: sh, sw: sw, dh: dh, dw: dw)
