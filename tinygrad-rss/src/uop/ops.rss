            let idx = List.get<Int>(list: read idxs, index: 0)
            return node_src_id(cache: read cache, id: x, k: idx)
        }
    }
    let xdt = node_dtype(cache: read cache, id: x)
    let scalar = dtype_scalar(d: read xdt)
    let odt = dtype_vec(base: read scalar, sz: List.len<Int>(list: read idxs))
    local src = List.new<Int>()
    List.push<Int>(list: mut src, value: read x)
    local arg_idxs = copy_int_list(l: read idxs)
