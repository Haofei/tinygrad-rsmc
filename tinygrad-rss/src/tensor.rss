    let a = tensor_const_like_float(cache: mut cache, x: x, value: alpha)
    let xa = tensor_div(cache: mut cache, a: x, b: a)
    let e = tensor_exp(cache: mut cache, x: xa)
    let one = tensor_const_like_float(cache: mut cache, x: x, value: 1.0)
    let em1 = tensor_sub(cache: mut cache, a: e, b: one)
    let scaled = tensor_mul(cache: mut cache, a: a, b: em1)
    let neg = tensor_minimum(cache: mut cache, a: scaled, b: zero)
    return tensor_add(cache: mut cache, a: pos, b: neg)
}

fn tensor_selu(cache: mut UOpCache, x: Int, alpha: Float, gamma: Float) -> Int {
    let zero = tensor_const_like_float(cache: mut cache, x: x, value: 0.0)
    let cond = tensor_lt(cache: mut cache, a: x, b: zero)
    let e = tensor_exp(cache: mut cache, x: x)
    let one = tensor_const_like_float(cache: mut cache, x: x, value: 1.0)
    let em1 = tensor_sub(cache: mut cache, a: e, b: one)
    let a = tensor_const_like_float(cache: mut cache, x: x, value: alpha)
    let neg = tensor_mul(cache: mut cache, a: a, b: em1)
    let mixed = tensor_where(cache: mut cache, cond: cond, x: neg, y: x)
    let g = tensor_const_like_float(cache: mut cache, x: x, value: gamma)
    return tensor_mul(cache: mut cache, a: g, b: mixed)
}

fn tensor_softsign(cache: mut UOpCache, x: Int) -> Int {
    let ax = tensor_abs(cache: mut cache, x: x)
    let one = tensor_const_like_float(cache: mut cache, x: x, value: 1.0)
    let denom = tensor_add(cache: mut cache, a: one, b: ax)
    return tensor_div(cache: mut cache, a: x, b: denom)
}

fn tensor_lerp(cache: mut UOpCache, x: Int, end: Int, weight: Float) -> Int {
    let diff = tensor_sub(cache: mut cache, a: end, b: x)
    let w = tensor_const_like_float(cache: mut cache, x: x, value: weight)
    let scaled = tensor_mul(cache: mut cache, a: diff, b: w)
    return tensor_add(cache: mut cache, a: x, b: scaled)
}

fn tensor_lerp_weight(cache: mut UOpCache, x: Int, end: Int, weight: Int) -> Int {
    let diff = tensor_sub(cache: mut cache, a: end, b: x)
    let scaled = tensor_mul(cache: mut cache, a: diff, b: weight)
    return tensor_add(cache: mut cache, a: x, b: scaled)
}

fn tensor_interpolate_axis_index(cache: mut UOpCache, x: Int, axis: Int, out_size: Int, align_corners: Bool, nearest: Bool, exact: Bool) -> Int {
    local xs = uop_shape(cache: read cache, id: x)
    let ndim = List.len<Int>(list: read xs)
    let d = tensor_resolve_dim(ndim: ndim, dim: axis, extra: false)
    let in_size = List.get<Int>(list: read xs, index: d)
    let ai = tensor_arange(cache: mut cache, dt: read dt_float32(), n: out_size)
    let mut scale = Int.to_float(value: read in_size) / Int.to_float(value: read out_size)
    if align_corners {
        if out_size <= 1 {
            scale = 0.0
        } else {
            scale = Int.to_float(value: read (in_size - 1)) / Int.to_float(value: read (out_size - 1))
        }
    }
    let sc = tensor_const_like_float(cache: mut cache, x: ai, value: scale)
    let half = tensor_const_like_float(cache: mut cache, x: ai, value: 0.5)
    let mut idxf = tensor_mul(cache: mut cache, a: ai, b: sc)
    if align_corners == false {
        if nearest {
            if exact {
                let aip = tensor_add(cache: mut cache, a: ai, b: half)
                idxf = tensor_mul(cache: mut cache, a: aip, b: sc)
            }
        } else {
            let aip = tensor_add(cache: mut cache, a: ai, b: half)
            let scaled = tensor_mul(cache: mut cache, a: aip, b: sc)
            idxf = tensor_sub(cache: mut cache, a: scaled, b: half)
        }
    }
    if nearest == false {
        idxf = tensor_clip(cache: mut cache, x: idxf, min_value: 0.0, max_value: Int.to_float(value: read (in_size - 1)))
    }
    local reshape = List.new<Int>()
    local expand = shape_copy_ints(src: read xs)
    let mut i = 0
    while i < ndim {
        if i == d {
            push1(l: mut reshape, a: out_size)
            List.set<Int>(list: mut expand, index: i, value: read out_size)
        } else {
            push1(l: mut reshape, a: 1)
        }
        i = i + 1
    }
    let viewed = tensor_reshape(cache: mut cache, x: idxf, new_shape: read reshape)
    return tensor_expand(cache: mut cache, x: viewed, new_shape: read expand)
}

fn tensor_interpolate_axis_nearest(cache: mut UOpCache, x: Int, axis: Int, out_size: Int) -> Int {
    let idxf = tensor_interpolate_axis_index(cache: mut cache, x: x, axis: axis, out_size: out_size, align_corners: false, nearest: true, exact: false)
    let idx = tensor_cast(cache: mut cache, x: idxf, dt: read dt_int32())
    return tensor_gather(cache: mut cache, x: x, dim: axis, index: idx)
}

fn tensor_interpolate_axis_nearest_exact(cache: mut UOpCache, x: Int, axis: Int, out_size: Int) -> Int {
    let idxf = tensor_interpolate_axis_index(cache: mut cache, x: x, axis: axis, out_size: out_size, align_corners: false, nearest: true, exact: true)
    let idx = tensor_cast(cache: mut cache, x: idxf, dt: read dt_int32())
    return tensor_gather(cache: mut cache, x: x, dim: axis, index: idx)
}

fn tensor_interpolate_axis_linear(cache: mut UOpCache, x: Int, axis: Int, out_size: Int, align_corners: Bool) -> Int {
    let idx = tensor_interpolate_axis_index(cache: mut cache, x: x, axis: axis, out_size: out_size, align_corners: align_corners, nearest: false, exact: false)
    let lowf = tensor_floor(cache: mut cache, x: idx)
    let highf = tensor_ceil(cache: mut cache, x: idx)
    let low = tensor_cast(cache: mut cache, x: lowf, dt: read dt_int32())
    let high = tensor_cast(cache: mut cache, x: highf, dt: read dt_int32())
    let perc = tensor_sub(cache: mut cache, a: idx, b: lowf)
    let lx = tensor_gather(cache: mut cache, x: x, dim: axis, index: low)
    let hx = tensor_gather(cache: mut cache, x: x, dim: axis, index: high)
    return tensor_lerp_weight(cache: mut cache, x: lx, end: hx, weight: perc)
}

fn tensor_float_predicate(cache: mut UOpCache, x: Int, pred: Int) -> Int {
    local vals = eval_tensor(cache: read cache, id: x)
    local shape = uop_shape(cache: read cache, id: x)
    local out = List.new<Float>()
    let mut i = 0
    while i < List.len<Float>(list: read vals) {
        let v = List.get<Float>(list: read vals, index: i)
        let mut ok = false
        if pred == 0 { ok = Float.is_nan(value: read v) }
        if pred == 1 { ok = Float.is_infinite(value: read v) }
        if pred == 2 { ok = Float.is_finite(value: read v) }
        if ok { pushf1(l: mut out, a: 1.0) } else { pushf1(l: mut out, a: 0.0) }
        i = i + 1
    }
    return mk_data_tensor(cache: mut cache, dt: read dt_bool(), shape: read shape, data: read out)
}

fn tensor_isnan(cache: mut UOpCache, x: Int) -> Int {
    return tensor_float_predicate(cache: mut cache, x: x, pred: 0)
}

fn tensor_isinf(cache: mut UOpCache, x: Int) -> Int {
    return tensor_float_predicate(cache: mut cache, x: x, pred: 1)
}

fn tensor_isfinite(cache: mut UOpCache, x: Int) -> Int {
    return tensor_float_predicate(cache: mut cache, x: x, pred: 2)
}

fn tensor_isclose_finite(cache: mut UOpCache, x: Int, other: Int, rtol: Float, atol: Float) -> Int {
    let diff = tensor_sub(cache: mut cache, a: x, b: other)
    let adiff = tensor_abs(cache: mut cache, x: diff)
    let aother = tensor_abs(cache: mut cache, x: other)
    let r = tensor_const_like_float(cache: mut cache, x: other, value: rtol)
    let rel = tensor_mul(cache: mut cache, a: r, b: aother)
    let a = tensor_const_like_float(cache: mut cache, x: other, value: atol)
    let tol = tensor_add(cache: mut cache, a: a, b: rel)
    return tensor_le(cache: mut cache, a: adiff, b: tol)
}

fn tensor_isclose(cache: mut UOpCache, x: Int, other: Int, rtol: Float, atol: Float, equal_nan: Bool) -> Int {
    let close = tensor_isclose_finite(cache: mut cache, x: x, other: other, rtol: rtol, atol: atol)
    let xinf = tensor_isinf(cache: mut cache, x: x)
    let yinf = tensor_isinf(cache: mut cache, x: other)
    let both_inf = tensor_and(cache: mut cache, a: xinf, b: yinf)
    let same_value = tensor_eq(cache: mut cache, a: x, b: other)
    let inf_close = tensor_and(cache: mut cache, a: both_inf, b: same_value)
    let mut out = tensor_or(cache: mut cache, a: close, b: inf_close)
    if equal_nan {
        let xnan = tensor_isnan(cache: mut cache, x: x)
        let ynan = tensor_isnan(cache: mut cache, x: other)
        let both_nan = tensor_and(cache: mut cache, a: xnan, b: ynan)
        out = tensor_or(cache: mut cache, a: out, b: both_nan)
    }
    return out
}

fn tensor_allclose_finite(cache: mut UOpCache, x: Int, other: Int, rtol: Float, atol: Float) -> Int {
    let close = tensor_isclose_finite(cache: mut cache, x: x, other: other, rtol: rtol, atol: atol)
    return tensor_all_all(cache: mut cache, x: close)
}

fn tensor_allclose(cache: mut UOpCache, x: Int, other: Int, rtol: Float, atol: Float, equal_nan: Bool) -> Int {
    let close = tensor_isclose(cache: mut cache, x: x, other: other, rtol: rtol, atol: atol, equal_nan: equal_nan)
    return tensor_all_all(cache: mut cache, x: close)
}

fn tensor_hardtanh(cache: mut UOpCache, x: Int, min_value: Float, max_value: Float) -> Int {
    return tensor_clip(cache: mut cache, x: x, min_value: min_value, max_value: max_value)
}

fn tensor_resolve_reshape_shape(old_shape: read List<Int>, new_shape: read List<Int>) -> fresh List<Int> {
    local out = List.new<Int>()
    let old_total = prod(x: read old_shape)
    let mut known = 1
    let mut infer_index = 0 - 1
    let mut i = 0
    while i < List.len<Int>(list: read new_shape) {
        let d = List.get<Int>(list: read new_shape, index: i)
        if d == 0 - 1 {
            if infer_index < 0 { infer_index = i }
            push1(l: mut out, a: d)
        } else {
            known = known * d
            push1(l: mut out, a: d)
        }
        i = i + 1
    }
    if infer_index >= 0 {
        let inferred = old_total / known
        List.set<Int>(list: mut out, index: infer_index, value: read inferred)
    }
    return take out
}

fn tensor_reshape(cache: mut UOpCache, x: Int, new_shape: read List<Int>) -> Int {
    local old_shape = uop_shape(cache: read cache, id: x)
    local resolved = tensor_resolve_reshape_shape(old_shape: read old_shape, new_shape: read new_shape)
    return mk_reshape(cache: mut cache, x: x, new_shape: read resolved)
}

fn tensor_view(cache: mut UOpCache, x: Int, new_shape: read List<Int>) -> Int {
    return tensor_reshape(cache: mut cache, x: x, new_shape: read new_shape)
}

fn tensor_permute(cache: mut UOpCache, x: Int, perm: read List<Int>) -> Int {
