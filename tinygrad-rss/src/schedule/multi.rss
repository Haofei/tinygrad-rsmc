// First integrated slice of tinygrad/schedule/multi.py.
//
// This ports the first multi-device graph rewrites around COPY/MSELECT/MSTACK:
// broadcast a single-device COPY to a tuple device as MSTACK(copy-to-each-device), copy a
// multi-device value to one device by selecting shard 0, and eliminate MSELECT(MSTACK).
// Full ALU/reduce/movement/FUNCTION multi rewrite remains future scheduler work.
features: local

struct MultiRewrite derives(Clone) {
    result: Int,
    changed: Bool,
    ok: Bool,
}

fn multi_empty_result(cache: mut UOpCache) -> Int {
    local empty = List.new<Int>()
    return mk_sink(cache: mut cache, ids: read empty)
}

fn multi_copy_broadcast(cache: mut UOpCache, copy: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: copy) != COPY || node_num_src(cache: read cache, id: copy) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let x = node_src_id(cache: read cache, id: copy, k: 0)
    let dev = node_src_id(cache: read cache, id: copy, k: 1)
    let target_count = node_effective_device_count(cache: read cache, id: dev)
    let source_count = node_effective_device_count(cache: read cache, id: x)
    if target_count <= 1 || source_count > 1 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local srcs = List.new<Int>()
    let mut i = 0
    while i < target_count {
        local target = node_effective_device_name(cache: read cache, id: dev, index: i)
        let copied = mk_copy_to_device(cache: mut cache, x: x, device: read target)
        List.push<Int>(list: mut srcs, value: read copied)
        i = i + 1
    }
    let out = mk_mstack(cache: mut cache, dt: read node_full_dtype(cache: read cache, id: x), srcs: read srcs)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_copy_to_one(cache: mut UOpCache, copy: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: copy) != COPY || node_num_src(cache: read cache, id: copy) < 2 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let x = node_src_id(cache: read cache, id: copy, k: 0)
    let dev = node_src_id(cache: read cache, id: copy, k: 1)
    let target_count = node_effective_device_count(cache: read cache, id: dev)
    let source_count = node_effective_device_count(cache: read cache, id: x)
    if target_count != 1 || source_count <= 1 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    local target = node_effective_device_name(cache: read cache, id: dev, index: 0)
    let selected = mk_mselect(cache: mut cache, x: x, index: 0)
    let out = mk_copy_to_device(cache: mut cache, x: selected, device: read target)
    return MultiRewrite(result: out, changed: true, ok: true)
}

fn multi_mselect_mstack(cache: mut UOpCache, mselect: Int) -> fresh MultiRewrite {
    let fallback = multi_empty_result(cache: mut cache)
    if node_op(cache: read cache, id: mselect) != MSELECT || node_num_src(cache: read cache, id: mselect) == 0 {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let src = node_src_id(cache: read cache, id: mselect, k: 0)
    if node_op(cache: read cache, id: src) != MSTACK {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    let idx = node_const_int(cache: read cache, id: mselect)
    if idx < 0 || idx >= node_num_src(cache: read cache, id: src) {
        return MultiRewrite(result: fallback, changed: false, ok: false)
    }
    return MultiRewrite(result: node_src_id(cache: read cache, id: src, k: idx), changed: true, ok: true)
}
